# Imported rows already satisfy the canonical panel identity byte limit.
statement ok
COPY (
  SELECT CASE WHEN starts_with(line, E'chr1\t10\t')
    THEN repeat('r', 1025) || substring(line, 5) ELSE line END AS line
  FROM (
    SELECT unnest(string_split(trim(content, E'\n'), E'\n')) AS line
    FROM read_text('__WORKING_DIRECTORY__/test/data/somalier_sites.vcf')
  )
) TO '__WORKING_DIRECTORY__/test_somalier_sites_long_region.vcf'
  (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

statement error
SELECT * FROM duckhts_somalier_import_sites(
  '__WORKING_DIRECTORY__/test_somalier_sites_long_region.vcf', 'GRCh38'
);
----
region must be 1..1024 bytes

# Missing AF is an input error, not a frequency invented from AC/AN or a NULL
# row silently admitted into the canonical frequency relation.
statement ok
COPY (
  SELECT CASE WHEN starts_with(line, E'chr1\t30\t')
    THEN replace(line, 'AF=0.25', '.') ELSE line END AS line
  FROM (
    SELECT unnest(string_split(trim(content, E'\n'), E'\n')) AS line
    FROM read_text('__WORKING_DIRECTORY__/test/data/somalier_sites.vcf')
  )
) TO '__WORKING_DIRECTORY__/test_somalier_sites_missing_af.vcf'
  (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

statement error
SELECT * FROM duckhts_somalier_import_sites(
  '__WORKING_DIRECTORY__/test_somalier_sites_missing_af.vcf', 'GRCh38'
);
----
every record must have one finite INFO/AF value

# A Somalier fingerprint site is one canonical biallelic SNV. Multiallelic
# population records belong in the panel-selection method, not this importer.
statement ok
COPY (
  SELECT CASE WHEN starts_with(line, E'chr2\t20\t')
    THEN replace(replace(line, E'\tT\tC\t', E'\tT\tC,G\t'),
                 'AF=0.30', 'AF=0.30,0.10') ELSE line END AS line
  FROM (
    SELECT unnest(string_split(trim(content, E'\n'), E'\n')) AS line
    FROM read_text('__WORKING_DIRECTORY__/test/data/somalier_sites.vcf')
  )
) TO '__WORKING_DIRECTORY__/test_somalier_sites_multiallelic.vcf'
  (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

statement error
SELECT * FROM duckhts_somalier_import_sites(
  '__WORKING_DIRECTORY__/test_somalier_sites_multiallelic.vcf', 'GRCh38'
);
----
records must be distinct uppercase canonical biallelic SNVs

statement ok
CREATE TEMP TABLE somalier_vcf_panel AS
SELECT * FROM (VALUES
  ('GRCh38', 0::UBIGINT, 'chr1', 100::UBIGINT, 'A', 'C'),
  ('GRCh38', 1::UBIGINT, 'chr1', 200::UBIGINT, 'A', 'G'),
  ('GRCh38', 2::UBIGINT, 'chr1', 300::UBIGINT, 'C', 'T')
) AS p(assembly, site_index, region, position, allele_a, allele_b);

# AD slots follow exact [REF]+ALT identity. At the triallelic second site the
# panel A allele is ALT 1, panel G is REF and other is the remaining ALT 2.
# Every selected sample retains the absent third panel site.
query TIIIITIITTII
SELECT sample_id, site_index, a, b, other, status, source_record_index,
       source_sample_index, source_ref, source_alt::VARCHAR,
       source_allele_a_index, source_allele_b_index
FROM duckhts_somalier_vcf_counts(
  '__WORKING_DIRECTORY__/test/data/mapping_number_families.vcf',
  'somalier_vcf_panel'
)
ORDER BY source_sample_index, site_index;
----
S1	0	9	3	0	measured	0	0	A	[C]	0	1
S1	1	5	9	4	measured	1	0	G	[A, T]	1	0
S1	2	NULL	NULL	NULL	unavailable_no_record	NULL	0	NULL	NULL	NULL	NULL
S2	0	0	20	0	measured	0	1	A	[C]	0	1
S2	1	0	10	5	measured	1	1	G	[A, T]	1	0
S2	2	NULL	NULL	NULL	unavailable_no_record	NULL	1	NULL	NULL	NULL	NULL

# Measured zero channels are not availability sentinels. Method, scope and
# policy are explicit and stable across the complete sample x panel relation.
query IIII
SELECT count(*), count(*) FILTER (WHERE a = 0),
       count(*) FILTER (WHERE a IS NULL AND b IS NULL AND other IS NULL),
       count(*) FILTER (WHERE source_method = 'vcf_bcf_format_ad'
         AND count_scope = 'declared_alleles_only'
         AND filter_policy = 'pass_or_unapplied')
FROM duckhts_somalier_vcf_counts(
  '__WORKING_DIRECTORY__/test/data/mapping_number_families.vcf',
  'somalier_vcf_panel'
);
----
6	2	2	6


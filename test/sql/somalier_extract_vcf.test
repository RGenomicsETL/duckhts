S1	1	5	9	measured	[q10]
S2	0	0	20	measured	NULL
S2	1	0	10	measured	[q10]

# A physical source record that lacks either exact panel allele is unavailable;
# the producer does not orient by assuming ALT 1.
statement ok
CREATE TEMP TABLE somalier_mismatch_panel AS
SELECT 'GRCh38' AS assembly, 0::UBIGINT AS site_index, 'chr1' AS region,
       100::UBIGINT AS position, 'A' AS allele_a, 'G' AS allele_b;

query TIIIT
SELECT status, source_record_index, source_allele_a_index,
       source_allele_b_index, source_alt::VARCHAR
FROM duckhts_somalier_vcf_counts(
  '__WORKING_DIRECTORY__/test/data/mapping_number_families.vcf',
  'somalier_mismatch_panel', samples := 'S1'
);
----
unavailable_allele_mismatch	0	0	NULL	[C]

# Retained physical duplicates at a selected panel position are ambiguous.
statement ok
CREATE TEMP TABLE somalier_duplicate_record_panel AS
SELECT 'GRCh38' AS assembly, 0::UBIGINT AS site_index, 'chrG' AS region,
       30::UBIGINT AS position, 'A' AS allele_a, 'G' AS allele_b;

statement error
SELECT * FROM duckhts_somalier_vcf_counts(

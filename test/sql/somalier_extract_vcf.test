FORMAT/AD cardinality does not match REF plus ALT

# Header Type/Number are validated independently of payload decoding.
statement ok
COPY (
  WITH lines AS (
    SELECT unnest(string_split(trim(content, E'\n'), E'\n')) AS line
    FROM read_text('__WORKING_DIRECTORY__/test/data/mapping_number_families.vcf')
  )
  SELECT CASE
    WHEN starts_with(line, '##FORMAT=<ID=AD,Number=R,Type=Integer')
      THEN replace(line, '##FORMAT=<ID=AD,Number=R,Type=Integer',
                         '##FORMAT=<ID=AD,Number=1,Type=Integer')
    WHEN starts_with(line, E'chr1\t100\t')
      THEN replace(replace(line, '0/1:12:9,3:', '0/1:12:9:'),
                   '1/1:20:0,20:', '1/1:20:20:')
    ELSE line
  END
  FROM lines
  WHERE starts_with(line, '#') OR starts_with(line, E'chr1\t100\t')
) TO '__WORKING_DIRECTORY__/test_somalier_vcf_bad_header.vcf'
  (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

statement error
SELECT * FROM duckhts_somalier_vcf_counts(
  '__WORKING_DIRECTORY__/test_somalier_vcf_bad_header.vcf',
  'somalier_mismatch_panel'
);
----
FORMAT/AD must declare Number=R,Type=Integer

statement ok
COPY (

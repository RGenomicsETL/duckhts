# Symbolic extra alleles cannot silently become declared-allele other counts.
statement ok
COPY (
  WITH lines AS (
    SELECT unnest(string_split(trim(content, E'\n'), E'\n')) AS line
    FROM read_text('__WORKING_DIRECTORY__/test/data/mapping_number_families.vcf')
  )
  SELECT CASE WHEN starts_with(line, E'chr1\t200\t')
              THEN replace(line, E'\tG\tA,T\t', E'\tG\tA,<NON_REF>\t')
              ELSE line END
  FROM lines
) TO '__WORKING_DIRECTORY__/test_somalier_vcf_symbolic.vcf'

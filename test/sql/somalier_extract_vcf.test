# Nonadjacent duplicate positions are rejected before malformed AD, duplicate
# allele, and failing-FILTER handling at that panel site.
statement ok
COPY (
  WITH lines AS (
    SELECT unnest(string_split(trim(content, E'\n'), E'\n')) AS line,
           generate_subscripts(
             string_split(trim(content, E'\n'), E'\n'), 1
           ) AS ordinal
    FROM read_text('__WORKING_DIRECTORY__/test/data/mapping_number_families.vcf')
  ), rewritten AS (
    SELECT ordinal * 10 AS sort_key, line
    FROM lines
    UNION ALL
    SELECT ordinal * 10 - 1, '##FILTER=<ID=q10,Description="Low quality">'
    FROM lines
    WHERE starts_with(line, '#CHROM')
    UNION ALL
    SELECT 1000000 + ordinal, line
    FROM (VALUES
      (1, E'chr1\t300\tfirst\tC\tT\t.\tPASS\t.\tGT:DP:AD:PL:FT:LAA\t0/1:10:4,6:0,10,20:PASS:1\t1/1:20:0,10:50,5,0:PASS:1'),
      (2, E'chr1\t400\tbetween\tT\tG\t.\tPASS\t.\tGT:DP:AD:PL:FT:LAA\t0/1:10:4,6:0,10,20:PASS:1\t1/1:20:0,10:50,5,0:PASS:1'),
      (3, E'chr1\t100\tbad_ad\tA\tG\t.\tPASS\t.\tGT:DP:AD:PL:FT:LAA\t0/1:12:9:0,10,20:PASS:1\t1/1:20:0,20:50,5,0:PASS:1'),
      (4, E'chr1\t200\tduplicate_alt\tG\tA,A\t.\tPASS\t.\tGT:DP:AD:PL:FT:LAA\t1/2:18:9,5,4:0,10,20,30,40,50:PASS:1,2\t0/2:15:10,0,5:0,15,25,35,45,55:PASS:2'),
      (5, E'chr1\t300\tfailing_filter\tC\tT\t.\tq10\t.\tGT:DP:AD:PL:FT:LAA\t0/1:10:4,6:0,10,20:PASS:1\t1/1:20:0,10:50,5,0:PASS:1')
    ) AS additions(ordinal, line)
  )
  SELECT line FROM rewritten ORDER BY sort_key
) TO '__WORKING_DIRECTORY__/test_somalier_duplicate_edges.vcf'
  (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

statement ok
CREATE TEMP TABLE somalier_duplicate_panel_100 AS
SELECT 'GRCh38' AS assembly, 0::UBIGINT AS site_index, 'chr1' AS region,
       100::UBIGINT AS position, 'A' AS allele_a, 'C' AS allele_b;

statement ok
CREATE TEMP TABLE somalier_duplicate_panel_200 AS
SELECT 'GRCh38' AS assembly, 0::UBIGINT AS site_index, 'chr1' AS region,
       200::UBIGINT AS position, 'A' AS allele_a, 'G' AS allele_b;

statement ok
CREATE TEMP TABLE somalier_duplicate_panel_300 AS
SELECT 'GRCh38' AS assembly, 0::UBIGINT AS site_index, 'chr1' AS region,
       300::UBIGINT AS position, 'C' AS allele_a, 'T' AS allele_b;


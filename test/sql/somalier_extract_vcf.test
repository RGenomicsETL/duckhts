----
source record has duplicate REF/ALT alleles

# Non-missing short/long AD vectors are malformed, while a literal single '.'
# was already retained above as unavailable_ad_missing.
statement ok
COPY (
  WITH lines AS (
    SELECT unnest(string_split(trim(content, E'\n'), E'\n')) AS line
    FROM read_text('__WORKING_DIRECTORY__/test/data/mapping_number_families.vcf')
  )
  SELECT CASE WHEN starts_with(line, E'chr1\t100\t')
              THEN replace(line, '0/1:12:9,3:', '0/1:12:9,3,2:')
              ELSE line END
  FROM lines
) TO '__WORKING_DIRECTORY__/test_somalier_vcf_bad_ad.vcf'
  (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

statement error

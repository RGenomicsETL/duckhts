# name: test/sql/somalier_extract_vcf.test
# description: Canonical Somalier sites import and complete VCF/BCF FORMAT/AD count evidence
# group: [duckhts]

require duckhts

# The importer is deliberately narrower than Somalier find-sites: it consumes
# an already selected sites VCF, assigns stable lexical-order site ordinals,
# and keeps AF oriented to the same B allele as downstream counts.
query ITITTRTTRT
SELECT site_index, region, position, allele_a, allele_b,
       round(population_b_af, 2), source_ref, source_alt,
       round(source_alt_af, 2), source_filter::VARCHAR
FROM duckhts_somalier_import_sites(
  '__WORKING_DIRECTORY__/test/data/somalier_sites.vcf', 'GRCh38'
);
----
0	chr1	10	A	G	0.20	G	A	0.80	[PASS]
1	chr1	30	A	G	0.25	A	G	0.25	[q10]
2	chr2	20	C	T	0.70	T	C	0.30	[PASS]

statement ok
CREATE TEMP TABLE somalier_imported_sites AS
SELECT * FROM duckhts_somalier_import_sites(
  '__WORKING_DIRECTORY__/test/data/somalier_sites.vcf', 'GRCh38'
);

# One imported relation satisfies both the panel and population-frequency
# contracts; no private sites payload or separately oriented AF table is needed.
query III
SELECT (SELECT count(*) FROM somalier_imported_sites),
       length(duckhts_somalier_panel_sha256('somalier_imported_sites')),
       length(duckhts_somalier_frequency_sha256(
         'somalier_imported_sites', 'somalier_imported_sites'));
----
3	64	64

statement error
SELECT * FROM duckhts_somalier_import_sites(

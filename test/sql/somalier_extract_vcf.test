multiple source records occur at a panel site

# One million repeated panel-coordinate records produce the duplicate-source
# diagnostic under a bounded DuckDB memory budget.
statement ok
COPY (
  SELECT line
  FROM (
    SELECT * FROM (VALUES
      (0::BIGINT, '##fileformat=VCFv4.2'),
      (1::BIGINT, '##contig=<ID=chr1>'),
      (2::BIGINT, '##FILTER=<ID=PASS,Description="All filters passed">'),
      (3::BIGINT, '##FORMAT=<ID=GT,Number=1,Type=String,Description="Genotype">'),
      (4::BIGINT, '##FORMAT=<ID=AD,Number=R,Type=Integer,Description="Allelic depths">'),
      (5::BIGINT, E'#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\tS1')
    ) AS header(ordinal, line)
    UNION ALL
    SELECT 6 + i, E'chr1\t100\t.\tA\tC\t.\tPASS\t.\tGT:AD\t0/1:9,3'
    FROM range(1000000) AS records(i)
  ) AS vcf_lines(ordinal, line)
  ORDER BY ordinal
) TO '__WORKING_DIRECTORY__/test_somalier_duplicate_stress.vcf'
  (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

statement ok
SET memory_limit='128MB';


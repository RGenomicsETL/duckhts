# Duplicate physical allele identities are ambiguous even when the AD vector
# has matching length.
statement ok
COPY (
  WITH lines AS (
    SELECT unnest(string_split(trim(content, E'\n'), E'\n')) AS line
    FROM read_text('__WORKING_DIRECTORY__/test/data/mapping_number_families.vcf')
  )
  SELECT CASE WHEN starts_with(line, E'chr1\t100\t') THEN
           replace(
             replace(
               replace(line, E'\tA\tC\t', E'\tA\tC,C\t'),
               '0/1:12:9,3:', '0/1:12:9,3,0:'
             ),
             '1/1:20:0,20:', '1/1:20:0,20,0:'
           )
         ELSE line END
  FROM lines
) TO '__WORKING_DIRECTORY__/test_somalier_vcf_duplicate_allele.vcf'
  (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

statement error
SELECT * FROM duckhts_somalier_vcf_counts(
  '__WORKING_DIRECTORY__/test_somalier_vcf_duplicate_allele.vcf',

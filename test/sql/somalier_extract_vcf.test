# A complete panel grid spanning multiple DuckDB output chunks is identical
# with one and four query threads. The source reader remains in explicit
# sequential physical-record mode; this checks the downstream grid/chunk plan.
statement ok
CREATE TEMP TABLE somalier_chunk_panel AS
SELECT 'GRCh38'::VARCHAR AS assembly, i::UBIGINT AS site_index,
       'chrZ'::VARCHAR AS region, (i + 1)::UBIGINT AS position,
       'A'::VARCHAR AS allele_a, 'C'::VARCHAR AS allele_b
FROM range(3000) sites(i);

statement ok
SET threads=1;

statement ok
CREATE TEMP TABLE somalier_chunks_one AS
SELECT * FROM duckhts_somalier_vcf_counts(
  '__WORKING_DIRECTORY__/test/data/mapping_number_families.vcf',
  'somalier_chunk_panel'
);

statement ok
SET threads=4;

statement ok
CREATE TEMP TABLE somalier_chunks_four AS
SELECT * FROM duckhts_somalier_vcf_counts(
  '__WORKING_DIRECTORY__/test/data/mapping_number_families.vcf',
  'somalier_chunk_panel'
);

query III
SELECT count(*) AS rows, count(DISTINCT sample_id) AS samples,
       count(*) FILTER (WHERE status = 'unavailable_no_record') AS unavailable
FROM somalier_chunks_four;
----
6000	2	6000

query I
SELECT count(*) FROM (
  (SELECT * FROM somalier_chunks_one EXCEPT ALL SELECT * FROM somalier_chunks_four)
  UNION ALL
  (SELECT * FROM somalier_chunks_four EXCEPT ALL SELECT * FROM somalier_chunks_one)
);
----
0

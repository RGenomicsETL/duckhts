# name: test/sql/somalier_extract_vcf.test
# description: Canonical Somalier sites import and complete VCF/BCF FORMAT/AD count evidence
# group: [duckhts]

require duckhts

# The importer is deliberately narrower than Somalier find-sites: it consumes
# an already selected sites VCF, assigns stable lexical-order site ordinals
# with every autosomal site before any X/Y site, and keeps AF oriented to the
# same B allele as downstream counts. X/Y records are kept as they are:
# excluding PAR sites is the site selector's job, as in Somalier.
query ITITTRTTRT
SELECT site_index, region, position, allele_a, allele_b,
       round(population_b_af, 2), source_ref, source_alt,
       round(source_alt_af, 2), source_filter::VARCHAR
FROM duckhts_somalier_import_sites(
  '__WORKING_DIRECTORY__/test/data/somalier_sites.vcf', 'GRCh38'
);
----
0	chr1	10	A	G	0.20	G	A	0.80	[PASS]
1	chr1	30	A	G	0.25	A	G	0.25	[q10]
2	chr2	20	C	T	0.70	T	C	0.30	[PASS]
3	chrX	100	A	C	0.40	A	C	0.40	[PASS]

statement ok
CREATE TEMP TABLE somalier_imported_sites AS
SELECT * FROM duckhts_somalier_import_sites(
  '__WORKING_DIRECTORY__/test/data/somalier_sites.vcf', 'GRCh38'
);

# One imported relation satisfies both the panel and population-frequency
# contracts; no private sites payload or separately oriented AF table is needed.
query III
SELECT (SELECT count(*) FROM somalier_imported_sites),
       length(duckhts_somalier_panel_sha256('somalier_imported_sites')),
       length(duckhts_somalier_frequency_sha256(
         'somalier_imported_sites', 'somalier_imported_sites'));
----
4	64	64

statement error
SELECT * FROM duckhts_somalier_import_sites(
  '__WORKING_DIRECTORY__/test/data/somalier_sites.vcf', '', max_sites := 3
);
----
assembly must be a nonempty string

statement error
SELECT * FROM duckhts_somalier_import_sites(
  '__WORKING_DIRECTORY__/test/data/somalier_sites.vcf', 'GRCh38', max_sites := 2
);
----
sites file exceeds max_sites

# max_sites bounds every physical input record, including X/Y rows.
statement error
SELECT * FROM duckhts_somalier_import_sites(
  '__WORKING_DIRECTORY__/test/data/somalier_sites.vcf', 'GRCh38', max_sites := 3
);
----
sites file exceeds max_sites

# Sex-chromosome aliases sort after every autosomal site even when their name
# sorts first lexically ('X' precedes 'chr1'); the panel identity requires it.
statement ok
COPY (
  SELECT replace(line, E'chrX\t100\t', E'X\t100\t') AS line
  FROM (
    SELECT unnest(string_split(trim(content, E'\n'), E'\n')) AS line
    FROM read_text('__WORKING_DIRECTORY__/test/data/somalier_sites.vcf')
  )
) TO '__WORKING_DIRECTORY__/test_somalier_sites_x_alias.vcf'
  (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

query IT
SELECT site_index, region
FROM duckhts_somalier_import_sites(
  '__WORKING_DIRECTORY__/test_somalier_sites_x_alias.vcf', 'GRCh38'
)
ORDER BY site_index;
----
0	chr1
1	chr1
2	chr2
3	X

# A sites file without an autosomal record cannot normalise sex-chromosome depth.
statement ok
COPY (
  SELECT line FROM (
    SELECT unnest(string_split(trim(content, E'\n'), E'\n')) AS line
    FROM read_text('__WORKING_DIRECTORY__/test/data/somalier_sites.vcf')
  ) WHERE starts_with(line, '#') OR starts_with(line, E'chrX\t')
) TO '__WORKING_DIRECTORY__/test_somalier_sites_only_x.vcf'
  (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

statement error
SELECT * FROM duckhts_somalier_import_sites(
  '__WORKING_DIRECTORY__/test_somalier_sites_only_x.vcf', 'GRCh38'
);
----
sites file has no autosomal records

statement error
SELECT * FROM duckhts_somalier_import_sites(
  '__WORKING_DIRECTORY__/test/data/somalier_sites.vcf', 'GRCh38', max_sites := 4.5
);
----
max_sites must be an integer in [1, 100000000]

# Imported rows already satisfy the canonical panel identity byte limit.
statement ok
COPY (
  SELECT CASE WHEN starts_with(line, E'chr1\t10\t')
    THEN repeat('r', 1025) || substring(line, 5) ELSE line END AS line
  FROM (
    SELECT unnest(string_split(trim(content, E'\n'), E'\n')) AS line
    FROM read_text('__WORKING_DIRECTORY__/test/data/somalier_sites.vcf')
  )
) TO '__WORKING_DIRECTORY__/test_somalier_sites_long_region.vcf'
  (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

statement error
SELECT * FROM duckhts_somalier_import_sites(
  '__WORKING_DIRECTORY__/test_somalier_sites_long_region.vcf', 'GRCh38'
);
----
region must be 1..1024 bytes

# Missing AF is an input error, not a frequency invented from AC/AN or a NULL
# row silently admitted into the canonical frequency relation.
statement ok
COPY (
  SELECT CASE WHEN starts_with(line, E'chr1\t30\t')
    THEN replace(line, 'AF=0.25', '.') ELSE line END AS line
  FROM (
    SELECT unnest(string_split(trim(content, E'\n'), E'\n')) AS line
    FROM read_text('__WORKING_DIRECTORY__/test/data/somalier_sites.vcf')
  )
) TO '__WORKING_DIRECTORY__/test_somalier_sites_missing_af.vcf'
  (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

statement error
SELECT * FROM duckhts_somalier_import_sites(
  '__WORKING_DIRECTORY__/test_somalier_sites_missing_af.vcf', 'GRCh38'
);
----
every record must have one finite INFO/AF value

# A Somalier fingerprint site is one canonical biallelic SNV. Multiallelic
# population records belong in the panel-selection method, not this importer.
statement ok
COPY (
  SELECT CASE WHEN starts_with(line, E'chr2\t20\t')
    THEN replace(replace(line, E'\tT\tC\t', E'\tT\tC,G\t'),
                 'AF=0.30', 'AF=0.30,0.10') ELSE line END AS line
  FROM (
    SELECT unnest(string_split(trim(content, E'\n'), E'\n')) AS line
    FROM read_text('__WORKING_DIRECTORY__/test/data/somalier_sites.vcf')
  )
) TO '__WORKING_DIRECTORY__/test_somalier_sites_multiallelic.vcf'
  (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

statement error
SELECT * FROM duckhts_somalier_import_sites(
  '__WORKING_DIRECTORY__/test_somalier_sites_multiallelic.vcf', 'GRCh38'
);
----
records must be distinct uppercase canonical biallelic SNVs

statement ok
CREATE TEMP TABLE somalier_vcf_panel AS
SELECT * FROM (VALUES
  ('GRCh38', 0::UBIGINT, 'chr1', 100::UBIGINT, 'A', 'C'),
  ('GRCh38', 1::UBIGINT, 'chr1', 200::UBIGINT, 'A', 'G'),
  ('GRCh38', 2::UBIGINT, 'chr1', 300::UBIGINT, 'C', 'T')
) AS p(assembly, site_index, region, position, allele_a, allele_b);

# AD slots follow exact [REF]+ALT identity. At the triallelic second site the
# panel A allele is ALT 1, panel G is REF and other is the remaining ALT 2.
# Every selected sample retains the absent third panel site.
query TIIIITIITTII
SELECT sample_id, site_index, a, b, other, status, source_record_index,
       source_sample_index, source_ref, source_alt::VARCHAR,
       source_allele_a_index, source_allele_b_index
FROM duckhts_somalier_vcf_counts(
  '__WORKING_DIRECTORY__/test/data/mapping_number_families.vcf',
  'somalier_vcf_panel'
)
ORDER BY source_sample_index, site_index;
----
S1	0	9	3	0	measured	0	0	A	[C]	0	1
S1	1	5	9	4	measured	1	0	G	[A, T]	1	0
S1	2	NULL	NULL	NULL	unavailable_no_record	NULL	0	NULL	NULL	NULL	NULL
S2	0	0	20	0	measured	0	1	A	[C]	0	1
S2	1	0	10	5	measured	1	1	G	[A, T]	1	0
S2	2	NULL	NULL	NULL	unavailable_no_record	NULL	1	NULL	NULL	NULL	NULL

# Measured zero channels are not availability sentinels. Method, scope and
# policy are explicit and stable across the complete sample x panel relation.
query IIII
SELECT count(*), count(*) FILTER (WHERE a = 0),
       count(*) FILTER (WHERE a IS NULL AND b IS NULL AND other IS NULL),
       count(*) FILTER (WHERE source_method = 'vcf_bcf_format_ad'
         AND count_scope = 'declared_alleles_only'
         AND filter_policy = 'pass_or_unapplied')
FROM duckhts_somalier_vcf_counts(
  '__WORKING_DIRECTORY__/test/data/mapping_number_families.vcf',
  'somalier_vcf_panel'
);
----
6	2	2	6

# BCF uses the same sequential producer and original-header sample ordinal.
statement ok

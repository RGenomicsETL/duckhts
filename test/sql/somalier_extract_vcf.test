SELECT * FROM (VALUES
  ('GRCh38', 0::UBIGINT, 'chrG', 20::UBIGINT, 'C', 'T'),
  ('GRCh38', 1::UBIGINT, 'chrG', 60::UBIGINT, 'A', 'G')
) AS p(assembly, site_index, region, position, allele_a, allele_b);

query TIIIITII
SELECT sample_id, site_index, a, b, other, status,
       source_record_index, source_sample_index
FROM duckhts_somalier_vcf_counts(
  '__WORKING_DIRECTORY__/test/data/geno_format.bcf',

S1	1	NULL	NULL	unavailable_filtered	[q10]	pass_or_unapplied
S2	0	0	20	measured	NULL	pass_or_unapplied
S2	1	NULL	NULL	unavailable_filtered	[q10]	pass_or_unapplied

query TIIIIT

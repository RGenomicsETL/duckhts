statement ok
CREATE TEMP TABLE somalier_missing_ad_panel AS
SELECT * FROM (VALUES
  ('GRCh38', 0::UBIGINT, 'chrG', 10::UBIGINT, 'A', 'C'),
  ('GRCh38', 1::UBIGINT, 'chrG', 40::UBIGINT, 'C', 'T')
) AS p(assembly, site_index, region, position, allele_a, allele_b);

query TITIIT
SELECT sample_id, site_index, status, source_allele_a_index,
       source_allele_b_index, source_filter::VARCHAR
FROM duckhts_somalier_vcf_counts(
  '__WORKING_DIRECTORY__/test/data/geno_format.vcf',
  'somalier_missing_ad_panel'
)
ORDER BY source_sample_index, site_index;
----
S1	0	unavailable_ad_missing	0	1	[PASS]
S1	1	unavailable_ad_absent	1	0	[PASS]
S2	0	unavailable_ad_missing	0	1	[PASS]
S2	1	unavailable_ad_absent	1	0	[PASS]

# Generate a compact FILTER-policy fixture from the vcfppR-authored AD fixture.
# POS 100 has an unapplied filter and POS 200 has a named failing filter.
statement ok
COPY (
  WITH lines AS (
    SELECT unnest(string_split(trim(content, E'\n'), E'\n')) AS line,
           generate_subscripts(string_split(trim(content, E'\n'), E'\n'), 1) AS ordinal
    FROM read_text('__WORKING_DIRECTORY__/test/data/mapping_number_families.vcf')
  ), rewritten AS (
    SELECT ordinal * 2 AS sort_key,
           CASE
             WHEN starts_with(line, E'chr1\t100\t')
               THEN replace(line, E'\tPASS\t', E'\t.\t')
             WHEN starts_with(line, E'chr1\t200\t')
               THEN replace(line, E'\tPASS\t', E'\tq10\t')
             ELSE line
           END AS line
    FROM lines
    UNION ALL
    SELECT ordinal * 2 - 1, '##FILTER=<ID=q10,Description="Low quality">'
    FROM lines WHERE starts_with(line, '#CHROM')
  )
  SELECT line FROM rewritten ORDER BY sort_key
) TO '__WORKING_DIRECTORY__/test_somalier_vcf_filters.vcf'
  (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

statement ok
CREATE TEMP TABLE somalier_filter_panel AS
SELECT * FROM somalier_vcf_panel WHERE site_index < 2;

query TIIITTT
SELECT sample_id, site_index, a, b, status,
       source_filter::VARCHAR, filter_policy
FROM duckhts_somalier_vcf_counts(
  '__WORKING_DIRECTORY__/test_somalier_vcf_filters.vcf',
  'somalier_filter_panel'
)
ORDER BY source_sample_index, site_index;

# X/Y sites ignore the FILTER policy, as in Somalier extraction: the q10 record
# at POS 200 is relabelled chrX, so it stays measured under every policy while
# the autosomal FILTER failures above remain unavailable or an error.
statement ok
COPY (
  SELECT replace(line, E'chr1\t200\t', E'chrX\t200\t') AS line
  FROM (
    SELECT unnest(string_split(trim(content, E'\n'), E'\n')) AS line
    FROM read_text('__WORKING_DIRECTORY__/test_somalier_vcf_filters.vcf')
  )
) TO '__WORKING_DIRECTORY__/test_somalier_vcf_x_filter.vcf'
  (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

statement ok
CREATE TEMP TABLE somalier_x_filter_panel AS
SELECT * FROM (VALUES
  ('GRCh38', 0::UBIGINT, 'chr1', 100::UBIGINT, 'A', 'C'),
  ('GRCh38', 1::UBIGINT, 'chrX', 200::UBIGINT, 'A', 'G')
) AS p(assembly, site_index, region, position, allele_a, allele_b);

query TIIITT
SELECT sample_id, site_index, a, b, status, source_filter::VARCHAR
FROM duckhts_somalier_vcf_counts(
  '__WORKING_DIRECTORY__/test_somalier_vcf_x_filter.vcf',
  'somalier_x_filter_panel', filter_policy := 'error'
)
ORDER BY source_sample_index, site_index;
----

statement ok
CREATE TABLE duckvep_prepared_regions AS
SELECT * FROM duckvep_ensembl_regions(
  'duckvep_core', 'duckvep_reference_chunks', 'GRCh38'
);

query ITIITI
SELECT seq_region, seq_region_name, sequence_length, source_seq_region_id,
       coord_system_name, coord_system_rank
FROM duckvep_prepared_regions;
----
0	1	40	10	chromosome	1

query I
SELECT source_seq_region_id FROM duckvep_ensembl_regions(
  'duckvep_core', 'duckvep_reference_chunks', 'GRCh38', species_id := 2
);
----
11

statement ok
CREATE TABLE duckvep_prepared_transcripts AS
SELECT * FROM duckvep_ensembl_transcripts(
  'duckvep_core', 'duckvep_reference_chunks', 'GRCh38'
);

query IITTIITI
SELECT transcript_index, transcript_flags, CAST(cds_sequence AS VARCHAR),
       CAST(post_cds_bases AS VARCHAR), cds_start, cds_end,
       sequence_withheld_reason, length(exons)
FROM duckvep_prepared_transcripts ORDER BY transcript_index;
----
0	21507	ATGAAAGGGTAA	CC	1	16	NULL	2
1	8197	ATGCCCTAA	AGG	24	32	NULL	1
2	259	NULL	NULL	24	32	rna_edit,initial_methionine	1

query IIII
SELECT transcript_index, exon.rank, exon.exon_cdna_start, exon.exon_cdna_end
FROM duckvep_prepared_transcripts,
LATERAL unnest(exons) AS u(exon)
ORDER BY transcript_index, exon.rank;
----
0	1	1	6
0	2	7	14
1	1	1	12
2	1	1	12

statement ok
CREATE TABLE duckvep_prepared_receipt AS
SELECT * FROM duckvep_model_receipt(
  'duckvep_prepared_regions', 'duckvep_prepared_transcripts',
  'Ensembl', '116', 'GRCh38',
  repeat('a', 64), repeat('b', 64),
  'all current transcripts on FASTA-covered assembly regions'
);

query IIIIIII
SELECT region_count, transcript_count, gene_count, coding_transcript_count,
       sequence_backed_transcript_count, sequence_withheld_transcript_count,
       exon_membership_count
FROM duckvep_prepared_receipt;
----
1	3	2	3	2	1	4

query II
SELECT length(model_sha256), cds_base_count FROM duckvep_prepared_receipt;
----
64	21

query I
SELECT model_sha256 != (
  SELECT model_sha256 FROM duckvep_model_receipt(
    'duckvep_prepared_regions', 'duckvep_prepared_transcripts',
    'Ensembl', '116', 'GRCh38',
    repeat('a', 64), repeat('b', 64),
    'MANE transcripts only'
  )
) FROM duckvep_prepared_receipt;
----
1

statement error
SELECT * FROM duckvep_model_receipt(
  'duckvep_prepared_regions', 'duckvep_prepared_transcripts',
  'Ensembl', '116', 'GRCh38',
  NULL, repeat('b', 64),
  'all current transcripts on FASTA-covered assembly regions'
);
----
source and reference SHA-256 values must contain 64 hexadecimal digits

query I
SELECT loaded FROM duckvep_model_load(
  'ensembl-test',
  'SELECT seq_region, sequence_length FROM duckvep_ensembl_regions(''duckvep_core'', ''duckvep_reference_chunks'', ''GRCh38'') ORDER BY seq_region',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, post_cds_bases FROM duckvep_prepared_transcripts ORDER BY seq_region, transcript_start, transcript_index',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, exon.exon_cdna_start, exon.exon_cdna_end, exon.phase, exon.end_phase FROM duckvep_prepared_transcripts, LATERAL unnest(exons) AS u(exon) ORDER BY transcript_index, exon.exon_cdna_start',
  transcript_coverage_complete := true
);
----
1

query TTT
SELECT annotation.consequence, annotation.status, coalesce(annotation.reason, '-')
FROM unnest(duckvep_annotate(
  'ensembl-test', 0::UINTEGER, 4::UBIGINT, 'A', 'G', 0::UBIGINT
)) AS u(annotation);
----
missense_variant&splice_region_variant	supported	-

query TTT
SELECT annotation.consequence, annotation.status, coalesce(annotation.reason, '-')
FROM unnest(duckvep_annotate(
  'ensembl-test', 0::UINTEGER, 28::UBIGINT, 'G', 'A', 0::UBIGINT
)) AS u(annotation)
ORDER BY annotation.transcript_index;
----
missense_variant&NMD_transcript_variant	supported	-
coding_sequence_variant	unresolved	missing_sequence

query I
SELECT duckvep_model_drop('ensembl-test');
----
1

statement ok
CREATE TABLE duckvep_invalid_reference_chunks AS
SELECT * REPLACE (
  CASE WHEN "start" = 20 THEN 21::BIGINT ELSE "start" END AS "start",
  CASE WHEN "start" = 20 THEN substring(seq, 2) ELSE seq END AS seq
) FROM duckvep_reference_chunks;

statement error
SELECT * FROM duckvep_ensembl_regions(
  'duckvep_core',
  'duckvep_invalid_reference_chunks',
  'GRCh38'
);
----
reference chunks must cover each contig contiguously from zero

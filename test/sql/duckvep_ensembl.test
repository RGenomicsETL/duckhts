query IITT
SELECT annotation.regulation_feature_index, annotation.overlap_object,
       annotation.consequence, annotation.status
FROM unnest(duckvep_annotate(
  'ensembl-grch38-fixture', 1::UINTEGER, 75::UBIGINT,
  'A', 'C', 0::UBIGINT
)) AS u(annotation)
WHERE annotation.overlap_object = 'transcription_factor_binding_site'
ORDER BY annotation.regulation_feature_index;
----
0	transcription_factor_binding_site	TF_binding_site_variant	supported
1	transcription_factor_binding_site	TF_binding_site_variant	supported


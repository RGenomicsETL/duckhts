query I
SELECT loaded FROM duckvep_model_load(
  'ensembl-test',
  'SELECT seq_region, sequence_length FROM duckvep_ensembl_regions(''duckvep_core'', ''duckvep_reference_chunks'', ''GRCh38'') ORDER BY seq_region',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM duckvep_prepared_transcripts ORDER BY seq_region, transcript_start, transcript_index',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, exon.exon_cdna_start, exon.exon_cdna_end, exon.phase, exon.end_phase FROM duckvep_prepared_transcripts, LATERAL unnest(exons) AS u(exon) ORDER BY transcript_index, exon.exon_cdna_start',
  peptide_edit_query := 'SELECT transcript_index, edit.protein_position, edit.alternate_amino_acid FROM duckvep_prepared_transcripts, LATERAL unnest(peptide_edits) AS u(edit) ORDER BY transcript_index, edit.protein_position',
  transcript_coverage_complete := true
);
----
1

query TTT
SELECT annotation.consequence, annotation.status, coalesce(annotation.reason, '-')
FROM unnest(duckvep_annotate(
  'ensembl-test', 0::UINTEGER, 4::UBIGINT, 'A', 'G', 0::UBIGINT
)) AS u(annotation);
----
missense_variant&splice_region_variant	supported	-

query TT
SELECT annotation.reference_amino_acid, annotation.alternate_amino_acid
FROM unnest(duckvep_annotate(

# Real release-116 fixtures: GRCh38 exercises a real MANE pair and GRCh37
# exercises the archived GENCODE-19 model. Both include MT fail-closed edits.
# Network access is confined to the explicit staging script.
statement ok
CREATE MACRO duckvep_fixture_file(assembly_dir, table_name) AS TABLE
SELECT * FROM read_parquet(
  '__WORKING_DIRECTORY__/test/data/duckvep/ensembl_core/' ||
  assembly_dir || '/' || table_name || '.parquet'
);

statement ok
CREATE SCHEMA duckvep_grch38_core;

statement ok
CREATE VIEW duckvep_grch38_core.attrib_type AS FROM duckvep_fixture_file('grch38', 'attrib_type');

statement ok
CREATE VIEW duckvep_grch38_core.coord_system AS FROM duckvep_fixture_file('grch38', 'coord_system');

statement ok
CREATE VIEW duckvep_grch38_core.exon AS FROM duckvep_fixture_file('grch38', 'exon');

statement ok
CREATE VIEW duckvep_grch38_core.exon_transcript AS FROM duckvep_fixture_file('grch38', 'exon_transcript');

statement ok
CREATE VIEW duckvep_grch38_core.gene AS FROM duckvep_fixture_file('grch38', 'gene');

statement ok
CREATE VIEW duckvep_grch38_core.seq_region AS FROM duckvep_fixture_file('grch38', 'seq_region');

statement ok

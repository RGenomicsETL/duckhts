FROM duckvep_model_receipt(
  'duckvep_grch38_regions', 'duckvep_grch38_transcripts',
  'Ensembl', '116', 'GRCh38',
  '34eaee64f47916f2a9d3d864377f911424741c7ead12883e47dcf998f9677703',
  '4fb2dcf3cc1844c54e8105695826d099be075c8cd5b18f74ccd80fb0d38d2cdf',
  'all current transcripts and funcgen features on MT, KI270395.1, and HG2047_PATCH',
  regulation_features_table := 'duckvep_grch38_regulation'
);
----
3	0	3


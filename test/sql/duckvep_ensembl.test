CREATE TABLE duckvep_invalid_reference_chunks AS
SELECT * REPLACE (
  CASE WHEN "start" = 20 THEN 21::BIGINT ELSE "start" END AS "start",
  CASE WHEN "start" = 20 THEN substring(seq, 2) ELSE seq END AS seq
) FROM duckvep_reference_chunks;

statement error
SELECT * FROM duckvep_ensembl_regions(
  'duckvep_core',
  'duckvep_invalid_reference_chunks',
  'GRCh38'
);
----
reference chunks must cover each contig contiguously from zero

# VEP's core transcript source rejects records without a stable ID, artifact
# biotypes, and readthrough_tra transcripts before assigning resident ordinals.

query IIIIIII
SELECT
  (SELECT count(*) FROM duckvep_grch38_regions),
  (SELECT sum(sequence_length) FROM duckvep_grch38_regions),
  count(*),
  count(*) FILTER (WHERE cds_sequence IS NOT NULL),
  count(*) FILTER (WHERE sequence_withheld_reason IS NOT NULL),
  sum(length(exons)),
  count(*) FILTER (WHERE mane_select_refseq IS NOT NULL)
FROM duckvep_grch38_transcripts;
----
2	81258	39	1	13	40	1


)) AS u(annotation);
----
U	E

query TTT
SELECT annotation.consequence, annotation.status, coalesce(annotation.reason, '-')
FROM unnest(duckvep_annotate(
  'ensembl-test', 0::UINTEGER, 28::UBIGINT, 'G', 'A', 0::UBIGINT
)) AS u(annotation)
ORDER BY annotation.transcript_index;
----

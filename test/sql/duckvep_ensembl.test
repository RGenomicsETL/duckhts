query I
SELECT loaded FROM duckvep_model_load(
  'ensembl-grch38-fixture',
  'SELECT seq_region, sequence_length FROM duckvep_grch38_regions ORDER BY seq_region',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM duckvep_grch38_transcripts ORDER BY seq_region, transcript_start, transcript_index',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, exon.exon_cdna_start, exon.exon_cdna_end, exon.phase, exon.end_phase FROM duckvep_grch38_transcripts, LATERAL unnest(exons) AS u(exon) ORDER BY transcript_index, exon.exon_cdna_start',
  peptide_edit_query := 'SELECT transcript_index, edit.protein_position, edit.alternate_amino_acid FROM duckvep_grch38_transcripts, LATERAL unnest(peptide_edits) AS u(edit) ORDER BY transcript_index, edit.protein_position',
  interval_feature_query := 'SELECT regulation_feature_index, seq_region, feature_start, feature_end, feature_kind FROM duckvep_grch38_regulation ORDER BY regulation_feature_index',
  transcript_coverage_complete := true
);
----
1

query I
SELECT loaded FROM duckvep_model_load(
  'ensembl-grch37-fixture',
  'SELECT seq_region, sequence_length FROM duckvep_grch37_regions ORDER BY seq_region',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM duckvep_grch37_transcripts ORDER BY seq_region, transcript_start, transcript_index',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, exon.exon_cdna_start, exon.exon_cdna_end, exon.phase, exon.end_phase FROM duckvep_grch37_transcripts, LATERAL unnest(exons) AS u(exon) ORDER BY transcript_index, exon.exon_cdna_start',
  peptide_edit_query := 'SELECT transcript_index, edit.protein_position, edit.alternate_amino_acid FROM duckvep_grch37_transcripts, LATERAL unnest(peptide_edits) AS u(edit) ORDER BY transcript_index, edit.protein_position',
  interval_feature_query := 'SELECT regulation_feature_index, seq_region, feature_start, feature_end, feature_kind FROM duckvep_no_regulation ORDER BY regulation_feature_index',
  transcript_coverage_complete := true
);
----
1

query ITTIITT
SELECT annotation.transcript_index, annotation.consequence,
       annotation.status, annotation.cds_position, annotation.protein_position,
       annotation.reference_amino_acid, annotation.alternate_amino_acid
FROM unnest(duckvep_annotate(
  'ensembl-grch38-fixture', 2::UINTEGER, 32522::UBIGINT,
  'C', 'T', 0::UBIGINT
)) AS u(annotation);

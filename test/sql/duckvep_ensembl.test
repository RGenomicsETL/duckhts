# Official Ensembl dump staging may infer numeric-only attribute columns as
# integers. The importer casts values at its boundary instead of requiring a
# staging-only VARCHAR schema.
statement ok
BEGIN TRANSACTION;

statement ok
CREATE TABLE duckvep_core.transcript_attrib_numeric AS
SELECT transcript_id, attrib_type_id, try_cast(value AS BIGINT) AS value
FROM duckvep_core.transcript_attrib
WHERE try_cast(value AS BIGINT) IS NOT NULL;

statement ok
CREATE TABLE duckvep_core.translation_attrib_numeric AS
SELECT translation_id, attrib_type_id, try_cast(value AS BIGINT) AS value
FROM duckvep_core.translation_attrib
WHERE false;

statement ok
ALTER TABLE duckvep_core.transcript_attrib RENAME TO transcript_attrib_text;

statement ok
ALTER TABLE duckvep_core.transcript_attrib_numeric RENAME TO transcript_attrib;

statement ok
ALTER TABLE duckvep_core.translation_attrib RENAME TO translation_attrib_text;

statement ok
ALTER TABLE duckvep_core.translation_attrib_numeric RENAME TO translation_attrib;


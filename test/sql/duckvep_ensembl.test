statement ok
CREATE TABLE duckvep_prepared_transcripts AS
SELECT * FROM duckvep_ensembl_transcripts(
  'duckvep_core', 'duckvep_reference_chunks', 'GRCh38'
);

query IITTITIITI
SELECT transcript_index, transcript_flags, CAST(cds_sequence AS VARCHAR),
       CAST(post_cds_bases AS VARCHAR),
       octet_length(pre_cds_sequence),
       CAST(post_cds_sequence AS VARCHAR), cds_start, cds_end,
       sequence_withheld_reason, length(exons)
FROM duckvep_prepared_transcripts ORDER BY transcript_index;

require duckhts

# Pinned VEP-116 observations and sequence evidence are recorded in ERRATA.md.
# Each physical source record is a separate sample, including duplicate alleles.
query I
SELECT loaded FROM duckvep_model_load('hap_anchor',
 'SELECT 0::UINTEGER seq_region,55::UBIGINT sequence_length,''chrA1''::VARCHAR seq_region_name',
 'SELECT 0::UINTEGER transcript_index,0::UINTEGER seq_region,
  11::UBIGINT transcript_start,45::UBIGINT transcript_end,1::TINYINT strand,
  0::UINTEGER gene_index,3::UBIGINT transcript_flags,11::UBIGINT cds_start,
  22::UBIGINT cds_end,''ATGGGTCCTTAA''::BLOB cds_sequence,1::UTINYINT codon_table,
  ''''::BLOB pre_cds_sequence,''AAAGAACAATAATAACTAGCTGA''::BLOB post_cds_sequence',
 'SELECT 0::UINTEGER transcript_index,11::UBIGINT exon_start,45::UBIGINT exon_end,
  1::UBIGINT exon_cdna_start,35::UBIGINT exon_cdna_end,0::TINYINT phase,0::TINYINT end_phase',
 reference_fasta:='test/data/duckvep/hgvs_anchor.fa');
----
1

statement ok
CREATE TABLE hap_anchor_calls AS SELECT event_index,0 seq_region,position,reference,alternate,
 1 alt_index,0 transcript_index,event_index-1 sample_index,[1,1] alleles,
 [true,true] phase_before,NULL::BIGINT phase_set FROM
 (VALUES (1,19,'T','TT'),(2,20,'T','TT'),(3,20,'T','TT'),(4,21,'A','TA'))
 v(event_index,position,reference,alternate);

query ITTTTIII
SELECT contributors[1].event_index,cds,protein,hgvsp,hgvsp_status,carrier_count,
 len(contributors),contributors[1].position FROM
 duckvep_haplotypes('SELECT * FROM hap_anchor_calls','hap_anchor',hgvs:=true)
 ORDER BY contributors[1].event_index;
----
1	ATGGGTCCTTTAA	MGPL	p.(Ter4LeufsTer9)	ok	2	1	19
2	ATGGGTCCTTTAA	MGPL	p.(Ter4delinsLeuTer)	ok	2	1	20
3	ATGGGTCCTTTAA	MGPL	p.(Ter4delinsLeuTer)	ok	2	1	20
4	ATGGGTCCTTTAA	MGPL	p.(Ter4delinsLeuTer)	ok	2	1	21

# Simultaneous duplicate records follow Haplosaurus last-source retention.
# The shadowed source remains an output contributor, with reference replay.
query ITTTTIIIT
SELECT contributors[1].event_index,cds,protein,hgvsp,hgvsp_status,carrier_count,
 len(contributors),contributors[1].position,contributors[1].projection_status FROM duckvep_haplotypes(
 'SELECT event_index,seq_region,position,reference,[alternate] alternates,
  transcript_index,sample_index,''1|1'' gt FROM hap_anchor_calls','hap_anchor',
 phase_policy:='vep116_compat',input_mode:='source_records',hgvs:=true)
 ORDER BY contributors[1].event_index;
----
1	ATGGGTCCTTTAA	MGPL	p.(Ter4LeufsTer9)	ok	2	1	19	ok
2	ATGGGTCCTTAA	MGP*	p.(=)	ok	2	1	20	shadowed_duplicate
3	ATGGGTCCTTTAA	MGPL	p.(Ter4delinsLeuTer)	ok	2	1	20	ok
4	ATGGGTCCTTTAA	MGPL	p.(Ter4delinsLeuTer)	ok	2	1	21	ok

# Independent raw-record queries compare every source with its VEP observation.
query IT
SELECT contributors[1].event_index,hgvsp FROM (
 SELECT * FROM duckvep_haplotypes(
 'SELECT event_index,seq_region,position,reference,[alternate] alternates,
  transcript_index,sample_index,''1|1'' gt FROM hap_anchor_calls WHERE event_index=1',
 'hap_anchor',phase_policy:='vep116_compat',input_mode:='source_records',hgvs:=true)
 UNION ALL SELECT * FROM duckvep_haplotypes(
 'SELECT event_index,seq_region,position,reference,[alternate] alternates,
  transcript_index,sample_index,''1|1'' gt FROM hap_anchor_calls WHERE event_index=2',
 'hap_anchor',phase_policy:='vep116_compat',input_mode:='source_records',hgvs:=true)
 UNION ALL SELECT * FROM duckvep_haplotypes(
 'SELECT event_index,seq_region,position,reference,[alternate] alternates,
  transcript_index,sample_index,''1|1'' gt FROM hap_anchor_calls WHERE event_index=3',
 'hap_anchor',phase_policy:='vep116_compat',input_mode:='source_records',hgvs:=true)
 UNION ALL SELECT * FROM duckvep_haplotypes(
 'SELECT event_index,seq_region,position,reference,[alternate] alternates,
  transcript_index,sample_index,''1|1'' gt FROM hap_anchor_calls WHERE event_index=4',
 'hap_anchor',phase_policy:='vep116_compat',input_mode:='source_records',hgvs:=true))
 ORDER BY contributors[1].event_index;
----
1	p.(Ter4LeufsTer9)
2	p.(Ter4delinsLeuTer)
3	p.(Ter4delinsLeuTer)
4	p.(Ter4delinsLeuTer)

# The complete 55-base reference needs 55 bases, one newline scratch byte and NUL.
statement error
SELECT * FROM duckvep_haplotypes('SELECT * FROM hap_anchor_calls','hap_anchor',
 hgvs:=true,max_hgvs_reference_bytes:=56);
----
reference workspace bytes=56, required=57

query II
SELECT count(*),count(hgvsp) FROM duckvep_haplotypes('SELECT * FROM hap_anchor_calls','hap_anchor',
 hgvs:=true,max_hgvs_reference_bytes:=57);
----
4	4

query II
SELECT count(*),count(hgvsp) FROM duckvep_haplotypes('SELECT * FROM hap_anchor_calls','hap_anchor',
 hgvs:=false,max_hgvs_reference_bytes:=1);
----
4	0

statement ok
CREATE TEMP TABLE hap_anchor_without_hgvs AS SELECT * EXCLUDE(hgvsp,hgvsp_status)
 FROM duckvep_haplotypes('SELECT * FROM hap_anchor_calls','hap_anchor');

statement ok
CREATE TEMP TABLE hap_anchor_with_hgvs AS SELECT * EXCLUDE(hgvsp,hgvsp_status)
 FROM duckvep_haplotypes('SELECT * FROM hap_anchor_calls','hap_anchor',
 hgvs:=true,max_hgvs_reference_bytes:=57);

query I
SELECT count(*) FROM ((SELECT * FROM hap_anchor_with_hgvs EXCEPT ALL SELECT * FROM hap_anchor_without_hgvs)
 UNION ALL (SELECT * FROM hap_anchor_without_hgvs EXCEPT ALL SELECT * FROM hap_anchor_with_hgvs));
----
0

statement ok
DROP TABLE hap_anchor_without_hgvs;

statement ok
DROP TABLE hap_anchor_with_hgvs;

statement ok
CREATE TABLE hap_tx AS SELECT 0::UINTEGER transcript_index, 0::UINTEGER seq_region,
  100::UBIGINT transcript_start, 111::UBIGINT transcript_end, 1::TINYINT strand,
  0::UINTEGER gene_index, 3::UBIGINT transcript_flags, 100::UBIGINT cds_start,
  111::UBIGINT cds_end, 'AAAAAAAAAAAA'::BLOB cds_sequence, 1::UTINYINT codon_table;

statement ok
CREATE TABLE hap_exons AS SELECT 0::UINTEGER transcript_index, 100::UBIGINT exon_start,
  111::UBIGINT exon_end, 1::UBIGINT exon_cdna_start, 12::UBIGINT exon_cdna_end,
  0::TINYINT phase, 0::TINYINT end_phase;

query I
SELECT loaded FROM duckvep_model_load('hap', 'SELECT i::UINTEGER seq_region FROM range(2) r(i)',
  'SELECT * FROM hap_tx', 'SELECT * FROM hap_exons');
----
1

# First annotation on this connection has zero transcript and feature hits:
# the shared model lookup must work before any seed buffer has been allocated.
query TTT
SELECT a.consequence,a.status,a.reason FROM unnest(_duckvep_annotate_small_rich(
 'hap',1::UINTEGER,100::UBIGINT,'A','C',0::UBIGINT)) u(a);
----
sequence_variant	unresolved	no_feature_in_loaded_model

# Curated reference proteins are not raw translations of the uploaded path.
statement ok
CREATE TABLE hap_protein_tx AS SELECT i::UINTEGER transcript_index,0::UINTEGER seq_region,
 (100+20*i)::UBIGINT transcript_start,(99+20*i+len(cds))::UBIGINT transcript_end,
 1::TINYINT strand,0::UINTEGER gene_index,3::UBIGINT transcript_flags,
 transcript_start cds_start,transcript_end cds_end,cds::BLOB cds_sequence,code::UTINYINT codon_table
 FROM (VALUES (0,'CTGGCCTAA',1),(1,'ATGTGAGCCTAA',1),(2,'ATGGCCTAA',1),
 (3,'ATGGCCTGA',2),(4,'ctggcctaa',1),(5,'AT',1)) v(i,cds,code);

query I
SELECT loaded FROM duckvep_model_load('hap_proteins','SELECT 0::UINTEGER seq_region',
 'SELECT * FROM hap_protein_tx',
 'SELECT transcript_index,transcript_start exon_start,transcript_end exon_end,
  1::UBIGINT exon_cdna_start,(transcript_end-transcript_start+1)::UBIGINT exon_cdna_end,
  0::TINYINT phase,0::TINYINT end_phase FROM hap_protein_tx',
 peptide_edit_query := 'SELECT * FROM (VALUES (1::UINTEGER,2::UINTEGER,''U''::VARCHAR),
  (2::UINTEGER,3::UINTEGER,''W''::VARCHAR)) e(transcript_index,protein_position,alternate_amino_acid)');
----
1

statement ok
CREATE TABLE hap_protein_calls AS SELECT transcript_index+1 event_index,0 seq_region,
 transcript_start+CASE transcript_index WHEN 1 THEN 8 WHEN 5 THEN 1 ELSE 5 END AS position,
 CASE transcript_index WHEN 5 THEN 'T' ELSE 'C' END AS reference,
 CASE transcript_index WHEN 5 THEN 'C' ELSE 'T' END alternate,1 alt_index,transcript_index,
 0 sample_index,[1] alleles,[true] phase_before,NULL::BIGINT phase_set FROM hap_protein_tx;

query ITI
SELECT transcript_index,protein,len(protein_differences) FROM
 duckvep_haplotypes('SELECT * FROM hap_protein_calls','hap_proteins') ORDER BY transcript_index;
----
0	LA*	1
1	M*	2
2	MA*	2
3	MAW	1
4	LA*	2
5	(empty)	NULL

query IIITTI
SELECT transcript_index,d.ref_start0,d.alt_start0,'['||d.reference||']',
 '['||d.alternate||']',d.alignment_start0 FROM (
 SELECT transcript_index,unnest(protein_differences) d FROM
 duckvep_haplotypes('SELECT * FROM hap_protein_calls','hap_proteins'))
 ORDER BY transcript_index,d.alignment_start0;
----
0	0	0	[M]	[L]	0
1	1	1	[U]	[*]	1
1	2	2	[A*]	[]	2
2	2	2	[W]	[*]	2
2	3	3	[*]	[]	3
3	3	3	[*]	[]	3
4	0	0	[M]	[L]	0
4	2	2	[]	[*]	2

# CDS has one run but protein has two: the shared per-axis descriptor limit
# must report protein exhaustion without truncating either difference list.
statement error
SELECT * FROM duckvep_haplotypes('SELECT * FROM hap_protein_calls WHERE transcript_index=1',
 'hap_proteins',max_leaf_differences := 1);
----
protein difference status 4, max_leaf_differences=1, required=2 at transcript 1

# Omitted missing calls use the curated reference peptide. Raw REF lanes of
# retained 0|1 calls still use mutation translation, even with no coding edit.
query ITIIIIT
SELECT transcript_index,protein,sequence_flags,edit_count,carrier_count,
 len(protein_differences),sequence_status FROM duckvep_haplotypes(
 'SELECT event_index,seq_region,position,reference,[alternate] alternates,
  transcript_index,sample_index,''.'' gt FROM hap_protein_calls',
 'hap_proteins',input_mode:='source_records',phase_policy:='vep116_compat')
 ORDER BY transcript_index;
----
0	MA*	0	0	2	0	conditional
1	MUA*	0	0	2	0	conditional
2	MAW*	0	0	2	0	conditional
3	MAW*	0	0	2	0	conditional
4	MA	0	0	2	0	conditional
5	(empty)	0	0	2	NULL	conditional

query ITI
SELECT transcript_index,protein,edit_count FROM duckvep_haplotypes(
 'SELECT event_index,seq_region,position,reference,[alternate] alternates,
  transcript_index,sample_index,''0|1'' gt FROM hap_protein_calls',
 'hap_proteins',input_mode:='source_records',phase_policy:='vep116_compat'),
 unnest(carriers) c(carrier) WHERE carrier.haplotype_lane=1 ORDER BY transcript_index;
----
0	LA*	0
1	M*	0
2	MA*	0
3	MAW	0
4	LA*	0
5	(empty)	0

# Intronic source context is not an exon-admitted genotype, including short
# introns whose consequence classification has frameshift-intron semantics.
statement ok
CREATE TABLE hap_route_tx AS SELECT i::UINTEGER transcript_index,i::UINTEGER seq_region,
 11::UBIGINT transcript_start,(22+gap)::UBIGINT transcript_end,1::TINYINT strand,
 i::UINTEGER gene_index,3::UBIGINT transcript_flags,transcript_start cds_start,
 transcript_end cds_end,cds::BLOB cds_sequence,1::UTINYINT codon_table,gap FROM
 (VALUES (0,12,'ATGAAACCCTAA'),(1,12,'ATGAAATAACCC'),(2,12,'CTGAAACCCTAA'),
 (3,24,'ATGAAACCCTAA'),(4,24,'ATGAAATAACCC'),(5,24,'CTGAAACCCTAA')) v(i,gap,cds);

query I
SELECT loaded FROM duckvep_model_load('hap_routes','SELECT seq_region FROM hap_route_tx',
 'SELECT * EXCLUDE(gap) FROM hap_route_tx',
 'SELECT transcript_index,(11+(6+gap)*i)::UBIGINT exon_start,(16+(6+gap)*i)::UBIGINT exon_end,
  (1+6*i)::UBIGINT exon_cdna_start,(6+6*i)::UBIGINT exon_cdna_end,
  0::TINYINT phase,0::TINYINT end_phase FROM hap_route_tx,range(2) e(i) ORDER BY transcript_index,i');
----
1

statement ok
CREATE TABLE hap_route_result AS SELECT * FROM duckvep_haplotypes(
 'SELECT transcript_index*2+e.i event_index,seq_region,CASE e.i WHEN 1 THEN 14 ELSE 22 END AS position,
  CASE e.i WHEN 1 THEN ''A'' ELSE ''C'' END AS reference,
  CASE e.i WHEN 1 THEN [''C''] ELSE [''T''] END alternates,transcript_index,s.i sample_index,
  CASE WHEN s.i=0 THEN CASE e.i WHEN 1 THEN ''.'' ELSE ''0|1'' END
       WHEN s.i=1 THEN ''0|0'' ELSE CASE e.i WHEN 1 THEN ''1|1'' ELSE ''0|0'' END END gt
  FROM hap_route_tx,range(1,3) e(i),range(3) s(i)',
 'hap_routes',input_mode:='source_records',phase_policy:='vep116_compat');

query ITIIIII
SELECT transcript_index,protein,count(*),sum(edit_count),sum(sequence_flags),
 sum(len(protein_differences)),bool_and(sequence_status='conditional') FROM hap_route_result,
 unnest(carriers) c(carrier) WHERE carrier.sample_index=0 GROUP BY transcript_index,protein ORDER BY transcript_index;
----
0	MKP*	2	0	0	0	1
1	MK*P	2	0	0	0	1
2	MKP*	2	0	0	0	1
3	MKP*	2	0	0	0	1
4	MK*P	2	0	0	0	1
5	MKP*	2	0	0	0	1

query II
SELECT count(*),bool_and(c.projection_status='outside_cds' AND c.reference='C'
 AND c.alternate='T' AND c.evidence_flags=1) FROM hap_route_result,unnest(contributors) u(c)
 WHERE c.position=22;
----
6	1

query II
SELECT len(cds_differences),len(contributors) FROM duckvep_haplotypes(
 'SELECT * FROM hap_protein_calls WHERE transcript_index=5','hap_proteins');
----
1	1

# Restored identical CDS needs no trace, while its curated reference protein
# still requires the full 5x5 alignment. Both axes honor the same cell limit.
query I
SELECT loaded FROM duckvep_model_load('hap_protein_alignment','SELECT 0::UINTEGER seq_region',
 'SELECT * FROM hap_tx','SELECT * FROM hap_exons',
 peptide_edit_query := 'SELECT 0::UINTEGER transcript_index,(i+1)::UINTEGER protein_position,
 ''G''::VARCHAR alternate_amino_acid FROM range(4) r(i) ORDER BY protein_position');
----
1

statement ok
CREATE TABLE hap_protein_alignment_calls AS SELECT event_index,0 seq_region,position,reference,alternate,
 1 alt_index,0 transcript_index,0 sample_index,[1] alleles,[true] phase_before,NULL::BIGINT phase_set
 FROM (VALUES (1,101,'A','AA'),(2,108,'AA','A')) v(event_index,position,reference,alternate);

query IITTI
SELECT len(cds_differences),len(protein_differences),protein_differences[1].reference,
 protein_differences[1].alternate,len(contributors) FROM duckvep_haplotypes(
 'SELECT * FROM hap_protein_alignment_calls','hap_protein_alignment',max_alignment_cells := 25);
----
0	1	GGGG	KKKK	2

statement error
SELECT * FROM duckvep_haplotypes('SELECT * FROM hap_protein_alignment_calls','hap_protein_alignment',
 max_alignment_cells := 24);
----
protein difference status 3, max_alignment_cells=24, required=25

# Local substitution spans remain changed when surrounding codon indels
# recreate the complete reference CDS. Genomic input covers both strands.
statement ok
CREATE TABLE hap_restore_tx AS SELECT i::UINTEGER transcript_index,0::UINTEGER seq_region,
 (100+100*i)::UBIGINT transcript_start,(135+100*i)::UBIGINT transcript_end,
 (1-2*i)::TINYINT strand,0::UINTEGER gene_index,3::UBIGINT transcript_flags,
 transcript_start cds_start,transcript_end cds_end,
 'ATGGGTGGTGCTGATGATGCTGATGCTGATGGTTAA'::BLOB cds_sequence,1::UTINYINT codon_table
 FROM range(2) r(i);

query I
SELECT loaded FROM duckvep_model_load('hap_restore','SELECT 0::UINTEGER seq_region',
 'SELECT * FROM hap_restore_tx',
 'SELECT transcript_index,transcript_start exon_start,transcript_end exon_end,
  1::UBIGINT exon_cdna_start,36::UBIGINT exon_cdna_end,
  0::TINYINT phase,0::TINYINT end_phase FROM hap_restore_tx');
----
1

statement ok
CREATE TABLE hap_restore_calls AS SELECT event_index,0 seq_region,position,reference,alternate,
 1 alt_index,transcript_index,0 sample_index,[1] alleles,[true] phase_before,NULL::BIGINT phase_set
 FROM (VALUES (1,0,102,'GGGT','G'),(2,0,109,'GCT','GGT'),(3,0,111,'T','TGCT'),
 (11,1,229,'CACC','C'),(12,1,224,'AGC','ACC'),(13,1,223,'C','CAGC'))
 v(event_index,transcript_index,position,reference,alternate);

statement ok
CREATE TABLE hap_restore_result AS SELECT * FROM duckvep_haplotypes(
 'SELECT * FROM hap_restore_calls ORDER BY position DESC','hap_restore',max_leaf_edits:=3);

query II
SELECT count(*),bool_and(cds='ATGGGTGGTGCTGATGATGCTGATGCTGATGGTTAA'
 AND protein='MGGADDADADG*' AND edit_count=3 AND sequence_flags=1
 AND len(contributors)=3 AND len(cds_differences)=0 AND len(protein_differences)=0
 AND NOT stop_in_displaced_frame) FROM hap_restore_result;
----
2	1

query IITTT
SELECT transcript_index,b.cds_start,b.coding_status,t.consequence,b.event_indices
 FROM hap_restore_result,unnest(coding_blocks) u(b)
 JOIN duckvep_so_terms() t ON (b.local_consequence_mask & t.consequence_mask)<>0
 ORDER BY transcript_index,b.cds_start,t.consequence;
----
0	4	ok	inframe_deletion	[1]
0	11	ok	missense_variant	[2]
0	13	ok	inframe_insertion	[3]
1	4	ok	inframe_deletion	[11]
1	11	ok	missense_variant	[12]
1	13	ok	inframe_insertion	[13]

# Protein HGVS consumes a completed cis path, including repeat interactions
# and separated amino-acid changes within one restored-frame block.
statement ok
CREATE TABLE hap_hgvs_tx AS SELECT i::UINTEGER transcript_index,0::UINTEGER seq_region,
 (100+100*i)::UBIGINT transcript_start,(99+100*i+len(cds))::UBIGINT transcript_end,
 (CASE WHEN i<3 THEN 1 ELSE -1 END)::TINYINT strand,0::UINTEGER gene_index,
 3::UBIGINT transcript_flags,transcript_start cds_start,transcript_end cds_end,
 cds::BLOB cds_sequence,1::UTINYINT codon_table,''::BLOB pre_cds_sequence,''::BLOB post_cds_sequence
 FROM range(6) r(i) JOIN (VALUES (0,'ATGGCTGCTGCTGCTGCTGAATAA'),
 (1,'ATGCGGCATTTCTATGAATAA'),(2,'ATGGGTCCTGCTGAACAATAA')) c(k,cds) ON i%3=k;

query I
SELECT loaded FROM duckvep_model_load('hap_hgvs','SELECT 0::UINTEGER seq_region',
 'SELECT * FROM hap_hgvs_tx ORDER BY transcript_index',
 'SELECT transcript_index,transcript_start exon_start,transcript_end exon_end,
  1::UBIGINT exon_cdna_start,(transcript_end-transcript_start+1)::UBIGINT exon_cdna_end,
  0::TINYINT phase,0::TINYINT end_phase FROM hap_hgvs_tx ORDER BY transcript_index');
----
1

statement ok
CREATE TABLE hap_hgvs_calls AS SELECT 10*transcript_index+j AS event_index,0 seq_region,
 CASE WHEN strand=1 THEN transcript_start+p-1 ELSE transcript_end-p-len(ref)+2 END AS position,
 CASE WHEN strand=1 THEN ref ELSE seq_revcomp(ref) END AS reference,
 CASE WHEN strand=1 THEN alt ELSE seq_revcomp(alt) END AS alternate,1 alt_index,
 transcript_index,0 sample_index,[1] alleles,[true] phase_before,NULL::BIGINT phase_set
 FROM hap_hgvs_tx JOIN (VALUES (0,1,3,'G','GGCT'),(0,2,11,'C','A'),
 (1,1,3,'G','GC'),(1,2,12,'CT','C'),(2,1,3,'GGGT','G'),(2,2,9,'T','TT'))
 v(k,j,p,ref,alt) ON transcript_index%3=k;

query ITTTI
SELECT transcript_index,protein,hgvsp,hgvsp_status,len(contributors) FROM duckvep_haplotypes(
 'SELECT * FROM hap_hgvs_calls ORDER BY position DESC','hap_hgvs',hgvs:=true)
 ORDER BY transcript_index;
----
0	MAAADAAE*	p.(Ala4_Ala5insAsp)	ok	2
1	MPAFHE*	p.[(Arg2_His3delinsProAla;Tyr5His)]	ok	2
2	MPC*	p.[(Gly2del;Ala4CysfsTer2)]	ok	2
3	MAAADAAE*	p.(Ala4_Ala5insAsp)	ok	2
4	MPAFHE*	p.[(Arg2_His3delinsProAla;Tyr5His)]	ok	2
5	MPC*	p.[(Gly2del;Ala4CysfsTer2)]	ok	2


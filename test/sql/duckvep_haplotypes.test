# Raw compatibility omits a non-mappable full source span, retains its
# interpretation as conditional evidence, and replays the separate coding edit.
statement ok
CREATE TABLE hap_unmapped_raw AS SELECT event_index,0 seq_region,position,reference,alternates,
 transcript_index,s.i sample_index,CASE WHEN event_index=2 THEN '1|1'
 ELSE ['1|1','0|1','.','.|1','0|0'][s.i+1] END gt
 FROM (VALUES (1,107,repeat('A',38),['C']),(2,147,'A',['G']))
 v(event_index,position,reference,alternates) CROSS JOIN hap_mixed_tx CROSS JOIN range(5) s(i);

query ITTTIII
SELECT transcript_index,cds,protein,sequence_status,sum(carrier_count),min(edit_count),max(edit_count)
 FROM duckvep_haplotypes('SELECT * FROM hap_unmapped_raw','hap_mixed',
 input_mode:='source_records',phase_policy:='vep116_compat',max_leaf_edits:=1)
 GROUP BY ALL ORDER BY transcript_index,sequence_status;

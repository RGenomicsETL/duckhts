# Interacting indels restore the frame. An earlier in-frame insertion shifts
# later alternate spans; the reverse transcript must expose transcript-oriented
# bases and reverse CDS order, with no source events discarded.
query I
SELECT loaded FROM duckvep_model_load('hap_blocks','SELECT 0::UINTEGER seq_region',
 'SELECT * REPLACE(117::UBIGINT AS transcript_end,117::UBIGINT AS cds_end,''AAAAAAAAAAAAAAAAAA''::BLOB AS cds_sequence) FROM hap_tx UNION ALL SELECT * REPLACE(1::UINTEGER AS transcript_index,-1::TINYINT AS strand,117::UBIGINT AS transcript_end,117::UBIGINT AS cds_end,''TTTTTTTTTTTTTTTTTT''::BLOB AS cds_sequence) FROM hap_tx',
 'SELECT * REPLACE(117::UBIGINT AS exon_end,18::UBIGINT AS exon_cdna_end) FROM hap_exons UNION ALL SELECT * REPLACE(1::UINTEGER AS transcript_index,117::UBIGINT AS exon_end,18::UBIGINT AS exon_cdna_end) FROM hap_exons');
----
1

statement ok
CREATE TABLE hap_block_calls AS SELECT event_index,0 seq_region,position,reference,alternate,
 1 alt_index,t.transcript_index,0 sample_index,[1] alleles,[true] phase_before,NULL::BIGINT phase_set
FROM (VALUES (1,100,'A','AAAA'),(2,103,'A','C'),(3,106,'A','AT'),
 (4,109,'AA','A'),(5,115,'A','G')) e(event_index,position,reference,alternate)
CROSS JOIN (VALUES (0),(1)) t(transcript_index);

query IITTIIII
SELECT transcript_index,b.cds_start,'['||b.reference||']','['||b.alternate||']',
 b.alt_start0,b.length_change,b.sequence_flags,len(b.event_indices) FROM (
 SELECT transcript_index,unnest(coding_blocks) b
 FROM duckvep_haplotypes('SELECT * FROM hap_block_calls','hap_blocks',max_leaf_edits := 5))
ORDER BY transcript_index,b.cds_start;

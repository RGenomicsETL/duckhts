# Exhaust every two/three-base codon replacement on both strands. The fixed
# standard-code table is independent of the effect evaluator. All 6,912 occupied
# paths are required, including stop codons, and cross SQL output vectors.
statement ok
CREATE TABLE hap_codons AS SELECT (16*a.i+4*b.i+c.i)::UINTEGER i,a.b||b.b||c.b codon,
 substring('FFLLSSSSYY**CC*WLLLLPPPPHHQQRRRRIIIMTTTTNNKKSSRRVVVVAAAADDEEGGGG',
 16*a.i+4*b.i+c.i+1,1) aa
FROM (VALUES (0,'T'),(1,'C'),(2,'A'),(3,'G')) a(i,b)
CROSS JOIN (VALUES (0,'T'),(1,'C'),(2,'A'),(3,'G')) b(i,b)
CROSS JOIN (VALUES (0,'T'),(1,'C'),(2,'A'),(3,'G')) c(i,b);

statement ok
CREATE TABLE hap_codon_tx AS SELECT (2*c.i+s.i)::UINTEGER transcript_index,
 (2*c.i+s.i)::UINTEGER seq_region,100::UBIGINT transcript_start,111::UBIGINT transcript_end,
 s.strand::TINYINT strand,0::UINTEGER gene_index,3::UBIGINT transcript_flags,
 100::UBIGINT cds_start,111::UBIGINT cds_end,('ATG'||codon||'GCCTAA')::BLOB cds_sequence,
 1::UTINYINT codon_table FROM hap_codons c CROSS JOIN (VALUES (0,1),(1,-1)) s(i,strand);

query I
SELECT loaded FROM duckvep_model_load('hap_all_codons',
 'SELECT seq_region FROM hap_codon_tx ORDER BY seq_region',
 'SELECT * FROM hap_codon_tx ORDER BY transcript_index','SELECT transcript_index,100::UBIGINT exon_start,
 111::UBIGINT exon_end,1::UBIGINT exon_cdna_start,12::UBIGINT exon_cdna_end,
 0::TINYINT phase,0::TINYINT end_phase FROM hap_codon_tx ORDER BY transcript_index');
----
1

statement ok
CREATE TABLE hap_codon_pairs AS SELECT t.transcript_index,t.seq_region,t.strand,
 a.i sample_index,r.codon reference_codon,a.codon alternate_codon,a.aa alternate_aa,
 CASE WHEN r.aa='*' AND a.aa='*' THEN 'stop_retained_variant'
 WHEN r.aa='*' THEN 'stop_lost' WHEN a.aa='*' THEN 'stop_gained'
 WHEN r.aa=a.aa THEN 'synonymous_variant' ELSE 'missense_variant' END consequence
FROM hap_codon_tx t JOIN hap_codons r ON r.i=t.transcript_index//2 CROSS JOIN hap_codons a
WHERE list_sum(list_transform(range(1,4),p->
 (substring(r.codon,p,1)<>substring(a.codon,p,1))::INTEGER)) >= 2;

statement ok
CREATE TABLE hap_codon_calls AS SELECT (transcript_index*64+sample_index)*3+p event_index,
 seq_region,CASE WHEN strand=1 THEN 102+p ELSE 109-p END::UBIGINT AS position,
 CASE WHEN strand=1 THEN substring(reference_codon,p,1)
 ELSE translate(substring(reference_codon,p,1),'ACGT','TGCA') END reference,
 CASE WHEN strand=1 THEN substring(alternate_codon,p,1)
 ELSE translate(substring(alternate_codon,p,1),'ACGT','TGCA') END alternate,
 1 alt_index,transcript_index,sample_index,[1] alleles,[true] phase_before,NULL::BIGINT phase_set
FROM hap_codon_pairs CROSS JOIN range(1,4) b(p)
WHERE substring(reference_codon,p,1)<>substring(alternate_codon,p,1);

query IIIIII
SELECT count(*),sum(h.carrier_count),bool_and(coalesce(h.cds='ATG'||e.alternate_codon||'GCCTAA',false)),
 bool_and(coalesce(h.protein=CASE WHEN e.alternate_aa='*' THEN 'M*' ELSE 'M'||e.alternate_aa||'A*' END,false)),
 bool_and(coalesce(len(h.coding_blocks)=1 AND h.coding_blocks[1].coding_status='ok'
 AND h.coding_blocks[1].local_consequence_mask=t.consequence_mask
 AND NOT h.coding_blocks[1].after_first_stop,false)),
 bool_and(coalesce(len(h.coding_blocks[1].event_indices)=h.edit_count AND h.carrier_count=1,false))
FROM duckvep_haplotypes('SELECT * FROM hap_codon_calls ORDER BY hash(event_index)',
 'hap_all_codons') h FULL OUTER JOIN hap_codon_pairs e
 ON e.transcript_index=h.transcript_index AND e.sample_index=h.carriers[1].sample_index
LEFT JOIN duckvep_so_terms() t ON t.consequence=e.consequence;
----
6912	6912	1	1	1	1


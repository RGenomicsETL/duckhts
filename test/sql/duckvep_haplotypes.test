# Noncoding contributors preserve a coding transcript's literal CDS; failed
# coding projections still invalidate it. This does not predict altered splicing.
statement ok
CREATE TABLE hap_mixed_tx AS SELECT i::UINTEGER transcript_index,0::UINTEGER seq_region,
 100::UBIGINT transcript_start,151::UBIGINT transcript_end,
 (CASE i WHEN 0 THEN 1 ELSE -1 END)::TINYINT strand,0::UINTEGER gene_index,
 3::UBIGINT transcript_flags,103::UBIGINT cds_start,148::UBIGINT cds_end,
 (CASE i WHEN 0 THEN 'AAAAAAAAAAAA' ELSE 'TTTTTTTTTTTT' END)::BLOB cds_sequence,
 1::UTINYINT codon_table FROM range(2) t(i);

query I
SELECT loaded FROM duckvep_model_load('hap_mixed','SELECT 0::UINTEGER seq_region',
 'SELECT * FROM hap_mixed_tx',
 'SELECT transcript_index,s::UBIGINT exon_start,e::UBIGINT exon_end,
  (CASE WHEN (strand=1 AND s=100) OR (strand=-1 AND s=143) THEN 1 ELSE 10 END)::UBIGINT exon_cdna_start,
  (exon_cdna_start+8)::UBIGINT exon_cdna_end,0::TINYINT phase,0::TINYINT end_phase
  FROM hap_mixed_tx CROSS JOIN (VALUES (100,108),(143,151)) v(s,e)
  ORDER BY transcript_index,exon_cdna_start');
----
1

statement ok
CREATE TABLE hap_mixed_calls AS SELECT event_index,0 seq_region,position,'A' reference,alternate,
 1 alt_index,transcript_index,s.i sample_index,
 [CASE WHEN s.i=1 AND event_index=2 THEN 0 ELSE 1 END,0] alleles,
 [true,true] phase_before,10 phase_set
 FROM (VALUES (1,100,'C'),(2,105,'G'),(3,115,'C'),(4,149,'C')) v(event_index,position,alternate)
 CROSS JOIN hap_mixed_tx CROSS JOIN range(2) s(i);

query ITTTII
SELECT transcript_index,cds,projection_status,sequence_status,edit_count,len(contributors)
 FROM duckvep_haplotypes('SELECT * FROM hap_mixed_calls','hap_mixed')
 ORDER BY transcript_index,cds;

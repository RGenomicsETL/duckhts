SELECT cds,protein,edit_count,len(contributors),stop_in_displaced_frame,
 coding_blocks[1].coding_status,coding_blocks[1].event_indices
FROM duckvep_haplotypes('SELECT * FROM hap_raw_overlap ORDER BY event_index DESC','hap',
 input_mode:='source_records',phase_policy:='vep116_compat') ORDER BY cds;

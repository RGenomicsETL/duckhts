# Full source replacements retain overwritten records and do not use differing
# islands to decide which retained bases survive.
statement ok
CREATE TABLE hap_raw_overlap AS SELECT event_index,0 seq_region,position,reference,
 alternates,0 transcript_index,0 sample_index,gt FROM
 (VALUES (1,100,'AAA',['CAA'],'0|1'),(2,101,'A',['G'],'1|1'))
 v(event_index,position,reference,alternates,gt);


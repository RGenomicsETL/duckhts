 'SELECT * FROM hap_early_stop_tx',
 'SELECT transcript_index,transcript_start exon_start,transcript_end exon_end,
  1::UBIGINT exon_cdna_start,180::UBIGINT exon_cdna_end,0::TINYINT phase,0::TINYINT end_phase
  FROM hap_early_stop_tx');
----
1


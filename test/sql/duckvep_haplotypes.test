statement ok
CREATE VIEW hap_repeat_prepared_events AS SELECT event_index,seq_region,position,reference,
 alternate,NULL::UBIGINT end_position,NULL::VARCHAR structural_type,NULL::VARCHAR copy_change,
 NULL::UINTEGER mate_seq_region,NULL::UBIGINT mate_position FROM hap_repeat_prepared;

query III
WITH expected AS (SELECT * FROM duckvep_annotate('hap_repeat_literal_events','hap_repeat',
 hgvs:=true,upstream_distance:=0,downstream_distance:=0)),
 actual AS (SELECT * FROM duckvep_annotate('hap_repeat_prepared_events','hap_repeat',
 hgvs:=true,upstream_distance:=0,downstream_distance:=0)),
 differences AS ((SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
 UNION ALL (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual))
SELECT (SELECT count(*) FROM actual),(SELECT count(*) FROM differences),
 (SELECT count(*) FROM actual WHERE protein_hgvs IS NOT NULL);
----
2	0	2

query ITTTIII

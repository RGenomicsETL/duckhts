# A restored DNA frame is not a rescued protein: the seed-173 DHT000002
# insertion/deletion pair reaches MGLS* before the restoring deletion. Keep
# both physical contributors and the complete CDS on either strand.
statement ok
CREATE TABLE hap_early_stop_tx AS SELECT i::UINTEGER transcript_index,0::UINTEGER seq_region,
 11::UBIGINT transcript_start,190::UBIGINT transcript_end,s::TINYINT strand,
 0::UINTEGER gene_index,3::UBIGINT transcript_flags,11::UBIGINT cds_start,
 190::UBIGINT cds_end,
 'ATGGGCTTGCCTAGCTTAAAACACTTGGTAAACTTTCTCGTGGTTACAACCTCGTTAGGGCTGCATCTTCTCTACATGGAGAAGTGCGAAGTCCGGGTAAGGACCGGGTGTTATAACCCAGCAGACAAGCTGAAGGGGCGCGTGTACTTAGCTGCCCGCTCGAGGCATTGGTCCCCGTAA'::BLOB cds_sequence,
 1::UTINYINT codon_table FROM (VALUES (0,1),(1,-1)) t(i,s);


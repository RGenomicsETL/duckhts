# The first stop is after the restoring deletion, not inside displaced bases.
# A stop in an unchanged frame is also false; an open frame without a stop is false.
statement ok
CREATE TABLE hap_frame_stop_calls AS SELECT event_index,0 seq_region,position,reference,alternate,
 1 alt_index,0 transcript_index,sample_index,[1] alleles,[true] phase_before,NULL::BIGINT phase_set
 FROM (VALUES (1,0,103,'A','AC'),(2,0,104,'AA','A'),(3,1,103,'A','G'))
 v(event_index,sample_index,position,reference,alternate);


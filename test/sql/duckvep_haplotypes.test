 c.reference=v.reference,c.alternate=v.alternate
 FROM duckvep_haplotypes('SELECT * FROM hap_repeat_calls','hap_repeat',hgvs:=true) h,
 unnest(h.contributors) u(v) JOIN hap_repeat_calls c ON c.event_index=v.event_index
 ORDER BY c.event_index;

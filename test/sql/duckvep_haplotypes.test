 sum(len(contributors)) FROM duckvep_haplotypes(
 'SELECT * REPLACE(CASE WHEN event_index=1 THEN 102 ELSE position END AS position,
  CASE WHEN event_index=1 THEN ''AA'' ELSE reference END AS reference,
  CASE WHEN event_index=1 THEN ''CC'' ELSE alternate END AS alternate) FROM hap_mixed_calls',
 'hap_mixed');
----
4	4	14


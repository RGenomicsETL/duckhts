# A prepared legitimate-start M differs from raw CTG translation even when
# no ALT is carried. The difference has no invented physical coding edit.
query TTII
SELECT hgvsp,hgvsp_status,edit_count,len(coding_blocks) FROM duckvep_haplotypes(
 'SELECT event_index,seq_region,position,reference,[alternate] alternates,
  transcript_index,sample_index,''0|1'' gt FROM hap_protein_calls WHERE transcript_index=0',
 'hap_proteins',input_mode:='source_records',phase_policy:='vep116_compat',hgvs:=true)
 WHERE edit_count=0;

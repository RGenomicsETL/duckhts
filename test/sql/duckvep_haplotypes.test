statement error
SELECT * FROM duckvep_haplotypes('SELECT c.* FROM hap_calls c CROSS JOIN duckvep_model_load(''nested_hap'',''SELECT 0::UINTEGER seq_region'',''SELECT * FROM hap_tx'',''SELECT * FROM hap_exons'') m','hap');
----
preparation is busy

query I
SELECT duckvep_model_drop('nested_hap');
----
0

query I
SELECT loaded FROM duckvep_model_load('hap_noncoding', 'SELECT 0::UINTEGER seq_region',
 'SELECT * REPLACE(0::UBIGINT AS transcript_flags, NULL::UBIGINT AS cds_start, NULL::UBIGINT AS cds_end, NULL::BLOB AS cds_sequence, NULL::UTINYINT AS codon_table) FROM hap_tx',
 'SELECT * FROM hap_exons');
----
1

query TIII
SELECT projection_status,count(*),count(*) FILTER(WHERE cds IS NULL AND protein IS NULL),sum(carrier_count)
FROM duckvep_haplotypes('SELECT * FROM hap_calls','hap_noncoding') GROUP BY projection_status;
----
outside_cds	3	3	4

# Recursive query preparation must error, not deadlock the database connection.
statement error
SELECT * FROM duckvep_haplotypes('SELECT c.* FROM hap_calls c CROSS JOIN duckvep_haplotypes(''SELECT * FROM hap_calls'',''hap'') h','hap');
----
preparation is busy

query I
SELECT count(*) FROM duckvep_haplotypes('SELECT * FROM hap_calls','hap');
----
3

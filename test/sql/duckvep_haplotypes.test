# HGVS consumes a prepared protein operand without changing CDS, local SO,
# carriers, physical blocks or contributing source identities.
statement ok
CREATE TEMP TABLE hap_protein_without_hgvs AS SELECT * EXCLUDE(hgvsp,hgvsp_status)
 FROM duckvep_haplotypes('SELECT * FROM hap_protein_calls','hap_proteins');

query I
SELECT count(*) FROM (
 SELECT * EXCLUDE(hgvsp,hgvsp_status) FROM duckvep_haplotypes(
  'SELECT * FROM hap_protein_calls','hap_proteins',hgvs:=true)
 EXCEPT ALL
 SELECT * FROM hap_protein_without_hgvs);
----
0

statement ok
DROP TABLE hap_protein_without_hgvs;

# Flat event x transcript x sample calls. The early homozygote must reach
# phase set 20, which is first encountered at the third source event.
statement ok
CREATE TABLE hap_calls AS SELECT event_index, 0::UINTEGER seq_region, position,
  'A' reference, alternate, 1::UINTEGER alt_index, 0::UINTEGER transcript_index,
  0::UINTEGER sample_index, alleles, [true,true] phase_before, phase_set
FROM (VALUES (1::UBIGINT,100::UBIGINT,'C',[1,1],NULL::BIGINT),
             (2,101,'G',[1,0],10), (3,102,'C',[0,1],20)) v(event_index,position,alternate,alleles,phase_set);

# BioPerl resolves a codon only when its N expansions agree. GCN is A;
# TGN has multiple amino acids and remains X. Neither policy invents phase.
query I
SELECT loaded FROM duckvep_model_load('hap_n','SELECT 0::UINTEGER seq_region',
 'SELECT * REPLACE(''ATGGCNTGNGCC''::BLOB AS cds_sequence) FROM hap_tx','SELECT * FROM hap_exons');
----
1

statement ok
CREATE TABLE hap_n_calls AS SELECT 1 event_index,0 seq_region,102 AS position,'G' AS reference,
 'A' alternate,1 alt_index,0 transcript_index,0 sample_index,[1] alleles,
 [true] phase_before,NULL::BIGINT phase_set;


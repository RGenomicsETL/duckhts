 'SELECT event_index,seq_region,position,reference,[alternate] alternates,
  transcript_index,sample_index,''1|1'' gt FROM hap_hgvs_calls','hap_hgvs',
 input_mode:='source_records',phase_policy:='vep116_compat',hgvs:=true)
 ORDER BY transcript_index;

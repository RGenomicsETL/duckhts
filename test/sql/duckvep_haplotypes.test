# A coding insertion can recreate the prepared terminal peptide residue.
# Genomic placement needs FASTA; sequence and provenance remain available.
query TTTIII
SELECT protein,hgvsp,hgvsp_status,edit_count,len(coding_blocks),len(contributors)
 FROM duckvep_haplotypes(
 'SELECT * REPLACE (''CTGG'' AS alternate) FROM hap_protein_calls WHERE transcript_index=2',
 'hap_proteins',hgvs:=true);

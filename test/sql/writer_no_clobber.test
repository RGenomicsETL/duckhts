# name: test/sql/writer_no_clobber.test
# description: File writers enforce exclusive creation and retain unrelated outputs
# group: [duckhts]

require duckhts

# Planning does not create output or remove input, even with keep=FALSE.
statement ok
COPY (SELECT 'prepared' AS text) TO '__WORKING_DIRECTORY__/writer_prepared.txt' (FORMAT CSV, HEADER FALSE);

statement ok
EXPLAIN SELECT * FROM bgzip('__WORKING_DIRECTORY__/writer_prepared.txt',
  output_path := '__WORKING_DIRECTORY__/writer_prepared.gz', threads := 1, keep := FALSE);

query II
SELECT (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared.txt')),
       (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared.gz'));
----
1	0

statement ok
PREPARE prepared_bgzip AS SELECT success FROM bgzip('__WORKING_DIRECTORY__/writer_prepared.txt',
  output_path := '__WORKING_DIRECTORY__/writer_prepared.gz', threads := 1, keep := FALSE);

query II
SELECT (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared.txt')),
       (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared.gz'));
----
1	0

query I
EXECUTE prepared_bgzip;
----
1

query II
SELECT (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared.txt')),
       (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared.gz'));
----
0	1

statement error
EXECUTE prepared_bgzip;
----
already exists

statement ok
EXPLAIN SELECT * FROM bgunzip('__WORKING_DIRECTORY__/writer_prepared.gz',
  output_path := '__WORKING_DIRECTORY__/writer_prepared.txt', threads := 1, keep := FALSE);

query II
SELECT (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared.txt')),
       (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared.gz'));
----
0	1

statement ok
PREPARE prepared_bgunzip AS SELECT success FROM bgunzip('__WORKING_DIRECTORY__/writer_prepared.gz',
  output_path := '__WORKING_DIRECTORY__/writer_prepared.txt', threads := 1, keep := FALSE);

query II
SELECT (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared.txt')),
       (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared.gz'));
----
0	1

query I
EXECUTE prepared_bgunzip;
----
1

query II
SELECT (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared.txt')),
       (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared.gz'));
----
1	0

statement error
EXECUTE prepared_bgunzip;
----
already exists

query I
SELECT content = ('prepared' || chr(10)) FROM read_text('__WORKING_DIRECTORY__/writer_prepared.txt');
----
1

# Explicit overwrite permits each execution, with fresh result state.
statement ok
PREPARE repeated_bgzip AS SELECT success FROM bgzip('__WORKING_DIRECTORY__/writer_prepared.txt',
  output_path := '__WORKING_DIRECTORY__/writer_prepared.gz', threads := 1, overwrite := TRUE);

query I
EXECUTE repeated_bgzip;
----
1

query I
EXECUTE repeated_bgzip;
----
1

statement ok
PREPARE repeated_bgunzip AS SELECT success FROM bgunzip('__WORKING_DIRECTORY__/writer_prepared.gz',
  output_path := '__WORKING_DIRECTORY__/writer_prepared.txt', threads := 1, overwrite := TRUE);

query I
EXECUTE repeated_bgunzip;
----
1

query I
EXECUTE repeated_bgunzip;
----
1

query I
SELECT content = ('prepared' || chr(10)) FROM read_text('__WORKING_DIRECTORY__/writer_prepared.txt');
----
1

statement ok
COPY (SELECT 'sentinel' AS text) TO '__WORKING_DIRECTORY__/writer_sentinel.txt' (FORMAT CSV, HEADER FALSE);

statement error
SELECT * FROM bgzip('__WORKING_DIRECTORY__/writer_sentinel.txt',
  output_path := '__WORKING_DIRECTORY__/writer_sentinel.txt', overwrite := FALSE);
----
already exists

query I
SELECT CASE WHEN content LIKE '%sentinel%' THEN 1 ELSE 0 END
FROM read_text('__WORKING_DIRECTORY__/writer_sentinel.txt');
----
1

statement ok
SELECT * FROM bgzip('__WORKING_DIRECTORY__/writer_sentinel.txt',
  output_path := '__WORKING_DIRECTORY__/writer_output.gz', overwrite := FALSE);

statement error
SELECT * FROM bgzip('__WORKING_DIRECTORY__/writer_sentinel.txt',
  output_path := '__WORKING_DIRECTORY__/writer_output.gz', overwrite := FALSE);
----
already exists

statement ok
SELECT * FROM bgzip('__WORKING_DIRECTORY__/writer_sentinel.txt',
  output_path := '__WORKING_DIRECTORY__/writer_output.gz', overwrite := TRUE);

statement ok
SELECT * FROM bgunzip('__WORKING_DIRECTORY__/writer_output.gz',
  output_path := '__WORKING_DIRECTORY__/writer_plain.txt', overwrite := FALSE);

query I
SELECT CASE WHEN content LIKE '%sentinel%' THEN 1 ELSE 0 END
FROM read_text('__WORKING_DIRECTORY__/writer_plain.txt');
----
1

statement error
SELECT * FROM bgunzip('__WORKING_DIRECTORY__/writer_output.gz',
  output_path := '__WORKING_DIRECTORY__/writer_plain.txt', overwrite := FALSE);
----
already exists

statement ok
SELECT * FROM bgunzip('__WORKING_DIRECTORY__/writer_output.gz',
  output_path := '__WORKING_DIRECTORY__/writer_plain.txt', overwrite := TRUE);

statement error
SELECT * FROM duckhts_samtools_idxstats('__WORKING_DIRECTORY__/test/data/range.bam',
  output := '__WORKING_DIRECTORY__/writer_sentinel.txt', overwrite := FALSE);
----
already exists

query I
SELECT CASE WHEN content LIKE '%sentinel%' THEN 1 ELSE 0 END
FROM read_text('__WORKING_DIRECTORY__/writer_sentinel.txt');
----
1

statement ok
SELECT * FROM duckhts_samtools_idxstats('__WORKING_DIRECTORY__/test/data/range.bam',
  output := '__WORKING_DIRECTORY__/writer_sentinel.txt', overwrite := TRUE);

statement ok
SELECT * FROM duckhts_mosdepth('__WORKING_DIRECTORY__/writer_no_clobber',
  '__WORKING_DIRECTORY__/test/data/range.bam', fast_mode := TRUE, overwrite := FALSE);

statement error
SELECT * FROM duckhts_mosdepth('__WORKING_DIRECTORY__/writer_no_clobber',
  '__WORKING_DIRECTORY__/test/data/range.bam', fast_mode := TRUE, overwrite := FALSE);
----
already exists

statement ok
SELECT * FROM duckhts_mosdepth('__WORKING_DIRECTORY__/writer_no_clobber',
  '__WORKING_DIRECTORY__/test/data/range.bam', fast_mode := TRUE, overwrite := TRUE);

# Index builders, idxstats and mosdepth also work in init, not at bind
# (https://github.com/RGenomicsETL/duckhts/issues/358). DuckDB 2.0 binds a
# prepared statement again at every EXECUTE, so a write at bind ran at PREPARE
# and EXPLAIN, and the next bind found its own output.
statement ok
EXPLAIN SELECT * FROM bam_index('__WORKING_DIRECTORY__/test/data/range.bam',
  index_path := '__WORKING_DIRECTORY__/writer_prepared_range.bai', threads := 1);

statement ok
PREPARE prepared_bam_index AS SELECT success FROM bam_index('__WORKING_DIRECTORY__/test/data/range.bam',
  index_path := '__WORKING_DIRECTORY__/writer_prepared_range.bai', threads := 1);

statement ok
EXPLAIN SELECT * FROM bcf_index('__WORKING_DIRECTORY__/test/data/bcf_scan_contigs.bcf',
  index_path := '__WORKING_DIRECTORY__/writer_prepared_contigs.csi', threads := 1);

statement ok
PREPARE prepared_bcf_index AS SELECT success FROM bcf_index('__WORKING_DIRECTORY__/test/data/bcf_scan_contigs.bcf',
  index_path := '__WORKING_DIRECTORY__/writer_prepared_contigs.csi', threads := 1);

statement ok
PREPARE prepared_tabix_index AS SELECT success FROM tabix_index('__WORKING_DIRECTORY__/test/data/bcf_scalar_counts.vcf.gz',
  preset := 'vcf', index_path := '__WORKING_DIRECTORY__/writer_prepared_scalar.tbi', threads := 1);

statement ok
PREPARE prepared_fasta_index AS SELECT success FROM fasta_index('__WORKING_DIRECTORY__/test/data/ce.fa',
  index_path := '__WORKING_DIRECTORY__/writer_prepared_ce.fai');

statement ok
EXPLAIN SELECT * FROM duckhts_samtools_idxstats('__WORKING_DIRECTORY__/test/data/range.bam',
  output := '__WORKING_DIRECTORY__/writer_prepared_idxstats.txt', overwrite := FALSE);

statement ok
PREPARE prepared_idxstats AS SELECT success FROM duckhts_samtools_idxstats('__WORKING_DIRECTORY__/test/data/range.bam',
  output := '__WORKING_DIRECTORY__/writer_prepared_idxstats.txt', overwrite := FALSE);

statement ok
EXPLAIN SELECT * FROM duckhts_mosdepth('__WORKING_DIRECTORY__/writer_prepared_mosdepth',
  '__WORKING_DIRECTORY__/test/data/range.bam', fast_mode := TRUE, no_per_base := TRUE, overwrite := FALSE);

statement ok
PREPARE prepared_mosdepth AS SELECT success FROM duckhts_mosdepth('__WORKING_DIRECTORY__/writer_prepared_mosdepth',
  '__WORKING_DIRECTORY__/test/data/range.bam', fast_mode := TRUE, no_per_base := TRUE, overwrite := FALSE);

query IIIIII
SELECT (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared_range.bai')),
       (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared_contigs.csi')),
       (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared_scalar.tbi')),
       (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared_ce.fai')),
       (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared_idxstats.txt')),
       (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared_mosdepth.mosdepth.summary.txt'));
----
0	0	0	0	0	0

query I
EXECUTE prepared_bam_index;
----
true

query I
EXECUTE prepared_bcf_index;
----
true

query I
EXECUTE prepared_tabix_index;
----
true

query I
EXECUTE prepared_fasta_index;
----
true

query I
EXECUTE prepared_idxstats;
----
true

query I
EXECUTE prepared_mosdepth;
----
true

query IIIIII
SELECT (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared_range.bai')),
       (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared_contigs.csi')),
       (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared_scalar.tbi')),
       (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared_ce.fai')),
       (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared_idxstats.txt')),
       (SELECT count(*) FROM glob('__WORKING_DIRECTORY__/writer_prepared_mosdepth.mosdepth.summary.txt'));
----
1	1	1	1	1	1

# A repeated execution of a non-overwriting writer fails and keeps the first
# output; an index builder rebuilds its index.
statement error
EXECUTE prepared_idxstats;
----
already exists

statement error
EXECUTE prepared_mosdepth;
----
already exists

query I
EXECUTE prepared_bam_index;
----
true

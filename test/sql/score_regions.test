# name: test/sql/score_regions.test
# description: Score BED coordinates and colon-containing contig names
# group: [duckhts]

require duckhts

statement ok
COPY (SELECT '1', 100, 200) TO '__WORKING_DIRECTORY__/test/sql/score_selection.bed' (HEADER false, DELIMITER '\t');

query TT
SELECT SAMPLE, round(score_summary, 3)
FROM bcftools_score('test/data/score_input.vcf', 'test/data/score_summary.tsv',
                   use := 'GT', columns := 'PLINK', regions_file := '__WORKING_DIRECTORY__/test/sql/score_selection.bed')
ORDER BY SAMPLE;
----
S1	-0.2
S2	-0.4

query TT
SELECT SAMPLE, round(score_summary, 3)
FROM bcftools_score('test/data/score_input.vcf', 'test/data/score_summary.tsv',
                   use := 'GT', columns := 'PLINK', targets_file := '__WORKING_DIRECTORY__/test/sql/score_selection.bed')
ORDER BY SAMPLE;
----
S1	-0.2
S2	-0.4

statement ok
COPY (SELECT '1', 100, 200) TO '__WORKING_DIRECTORY__/test/sql/score_selection.bed.gz'
(HEADER false, DELIMITER '\t', COMPRESSION gzip);

query TT
SELECT SAMPLE, round(score_summary, 3)
FROM bcftools_score('test/data/score_input.vcf', 'test/data/score_summary.tsv',
                   use := 'GT', columns := 'PLINK', targets_file := '__WORKING_DIRECTORY__/test/sql/score_selection.bed.gz')
ORDER BY SAMPLE;
----
S1	-0.2
S2	-0.4

# Non-BED region files remain 1-based inclusive.
statement ok
COPY (SELECT '1', 100, 200) TO '__WORKING_DIRECTORY__/test/sql/score_selection.tsv' (HEADER false, DELIMITER '\t');

query TT
SELECT SAMPLE, round(score_summary, 3)
FROM bcftools_score('test/data/score_input.vcf', 'test/data/score_summary.tsv',
                   use := 'GT', columns := 'PLINK', regions_file := '__WORKING_DIRECTORY__/test/sql/score_selection.tsv')
ORDER BY SAMPLE;
----
S1	-0.2
S2	0.1

query TT
SELECT SAMPLE, round(score_hla_summary, 3)
FROM bcftools_score('test/data/score_hla.vcf', 'test/data/score_hla_summary.tsv',
                   use := 'GT', columns := 'PLINK', regions := '{HLA-A*01:01}:100-100')
ORDER BY SAMPLE;
----
S1	0.5

query TT
SELECT SAMPLE, round(score_hla_summary, 3)
FROM bcftools_score('test/data/score_hla.vcf', 'test/data/score_hla_summary.tsv',
                   use := 'GT', columns := 'PLINK', targets := '{HLA-A*01:01}:200-200')
ORDER BY SAMPLE;
----
S1	-0.4

statement ok
COPY (SELECT 'HLA-A*01:01', 100, 200) TO '__WORKING_DIRECTORY__/test/sql/score_hla.bed' (HEADER false, DELIMITER '\t');

query TT
SELECT SAMPLE, round(score_hla_summary, 3)
FROM bcftools_score('test/data/score_hla.vcf', 'test/data/score_hla_summary.tsv',
                   use := 'GT', columns := 'PLINK', regions_file := '__WORKING_DIRECTORY__/test/sql/score_hla.bed')
ORDER BY SAMPLE;
----
S1	-0.4

# A contig absent from the VCF header matches no record instead of failing the query,
# so a genome-wide region list can be applied to a single-contig VCF.
query TT
SELECT SAMPLE, round(score_summary, 3)
FROM bcftools_score('test/data/score_input.vcf', 'test/data/score_summary.tsv',
                   use := 'GT', columns := 'PLINK', regions := '2,1')
ORDER BY SAMPLE;
----
S1	1.8
S2	0.1

query TT
SELECT SAMPLE, round(score_summary, 3)
FROM bcftools_score('test/data/score_input.vcf', 'test/data/score_summary.tsv',
                   use := 'GT', columns := 'PLINK', targets := '1:100-100,chrZ:5-9')
ORDER BY SAMPLE;
----
S1	0.0
S2	0.5

statement ok
COPY (SELECT * FROM (VALUES ('chrZ', 0, 1000), ('1', 0, 1000)) t(c, s, e)) TO '__WORKING_DIRECTORY__/test/sql/score_absent_contig.bed' (HEADER false, DELIMITER '\t');

query TT
SELECT SAMPLE, round(score_summary, 3)
FROM bcftools_score('test/data/score_input.vcf', 'test/data/score_summary.tsv',
                   use := 'GT', columns := 'PLINK', regions_file := '__WORKING_DIRECTORY__/test/sql/score_absent_contig.bed')
ORDER BY SAMPLE;
----
S1	1.8
S2	0.1

# An unterminated brace is still a malformed region.
statement error
SELECT * FROM bcftools_score('test/data/score_input.vcf', 'test/data/score_summary.tsv',
                             use := 'GT', columns := 'PLINK', regions := '{1');
----
invalid region/target expression

invalid filter, search, or resource settings

# A NULL in one row must not abort the vector callback or leave later rows
# uninitialized. The valid rows flank both NULL and invalid settings.
query II rowsort
SELECT case_index,
       __duckhts_somalier_matched_settings_valid(
         min_depth, 1000000, 0.05, 0.001, 0.002, 1e-10, 1e-6,
         0, 1, grid_step, 1e-10, 4096, 2)::INTEGER
FROM (VALUES
  (0, NULL::UBIGINT, 0.01),
  (1, 15::UBIGINT, 0.01),
  (2, 15::UBIGINT, 0.0),
  (3, 15::UBIGINT, 0.01)
) settings(case_index, min_depth, grid_step);
----
0	0
1	1
2	0
3	1


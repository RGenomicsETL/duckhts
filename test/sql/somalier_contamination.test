# A 200,000-site relation exceeds DuckDB's parallel scan threshold. CHARR has
# exactly zero infiltrating reads at every accepted homozygous site; the
# matched receiver has measured zero depth, so both outputs are exactly
# comparable independent of reduction order.
statement ok
CREATE TEMP TABLE contam_large_panel AS
SELECT 'GRCh38' AS assembly, i::UBIGINT AS site_index,
       'chr9' AS region, (1000000 + i)::UBIGINT AS position,
       'A' AS allele_a, 'G' AS allele_b
FROM range(200000) sites(i);

statement ok
CREATE TEMP TABLE contam_large_frequency AS
SELECT p.*, 0.25::DOUBLE AS population_b_af FROM contam_large_panel p;

statement ok
CREATE TEMP TABLE contam_large_charr_evidence AS
SELECT 'LargeC' AS sample_id, p.*,
       200::UBIGINT AS a, 0::UBIGINT AS b, 0::UBIGINT AS other
FROM contam_large_panel p;

statement ok
CREATE TEMP TABLE contam_large_matched_evidence AS
SELECT 'LargeR' AS sample_id, p.*,
       0::UBIGINT AS a, 0::UBIGINT AS b, 0::UBIGINT AS other
FROM contam_large_panel p
UNION ALL
SELECT 'LargeH', p.*, 200::UBIGINT, 0::UBIGINT, 0::UBIGINT
FROM contam_large_panel p;

statement ok
CREATE TEMP TABLE contam_large_pairs AS
SELECT 'LargeR' AS receiver_id, 'LargeH' AS anchor_id;

statement ok
SET threads = 1;

statement ok
CREATE TEMP TABLE contam_large_charr_t1 AS
SELECT * FROM duckhts_somalier_charr(
  'contam_large_charr_evidence', 'contam_large_panel',
  'contam_large_frequency', min_depth := 7, max_sites := 200000);

statement ok
CREATE TEMP TABLE contam_large_matched_t1 AS
SELECT * FROM duckhts_somalier_matched_contamination(
  'contam_large_matched_evidence', 'contam_large_panel',
  'contam_large_frequency', 'contam_large_pairs',
  min_depth := 7, max_sites := 200000);

statement ok
SET threads = 4;

statement ok
CREATE TEMP TABLE contam_large_charr_t4 AS
SELECT * FROM duckhts_somalier_charr(
  'contam_large_charr_evidence', 'contam_large_panel',
  'contam_large_frequency', min_depth := 7, max_sites := 200000);

statement ok
CREATE TEMP TABLE contam_large_matched_t4 AS
SELECT * FROM duckhts_somalier_matched_contamination(
  'contam_large_matched_evidence', 'contam_large_panel',
  'contam_large_frequency', 'contam_large_pairs',
  min_depth := 7, max_sites := 200000);

query IIIIII
SELECT c.contamination.observed_sites, c.contamination.usable_sites,
       c.contamination.estimate = 0,
       m.contamination.observed_sites, m.contamination.usable_sites,
       m.contamination.alpha IS NULL
FROM contam_large_charr_t4 c, contam_large_matched_t4 m;
----
200000	200000	1	200000	0	1

query II
SELECT (SELECT count(*) FROM ((FROM contam_large_charr_t1 EXCEPT ALL
                              FROM contam_large_charr_t4)
         UNION ALL (FROM contam_large_charr_t4 EXCEPT ALL
                    FROM contam_large_charr_t1))),
       (SELECT count(*) FROM ((FROM contam_large_matched_t1 EXCEPT ALL
                              FROM contam_large_matched_t4)
         UNION ALL (FROM contam_large_matched_t4 EXCEPT ALL
                    FROM contam_large_matched_t1)));
----
0	0

# Typed output relations and their identity digests survive Parquet without
# invoking the fit as a surrogate expected-value oracle.
statement ok
CREATE TEMP TABLE contam_charr_result AS
SELECT * FROM duckhts_somalier_charr(
  'contam_charr_evidence', 'contam_panel', 'contam_frequency',
  min_depth := 7, hom_minor_rate := 0.1, hom_tail_alpha := 0.001,
  max_sites := 2);

statement ok
CREATE TEMP TABLE contam_matched_result AS
SELECT * FROM duckhts_somalier_matched_contamination(
  'contam_evidence', 'contam_panel', 'contam_match_frequency', 'contam_pairs',
  max_sites := 2);

statement ok
COPY contam_charr_result TO '__WORKING_DIRECTORY__/test_somalier_charr.parquet'
  (FORMAT PARQUET);

statement ok
COPY contam_matched_result TO '__WORKING_DIRECTORY__/test_somalier_matched.parquet'
  (FORMAT PARQUET);

query II
SELECT (SELECT count(*) FROM ((FROM contam_charr_result EXCEPT ALL
                             FROM read_parquet('__WORKING_DIRECTORY__/test_somalier_charr.parquet'))
        UNION ALL (FROM read_parquet('__WORKING_DIRECTORY__/test_somalier_charr.parquet')
                   EXCEPT ALL FROM contam_charr_result))),
       (SELECT count(*) FROM ((FROM contam_matched_result EXCEPT ALL
                             FROM read_parquet(
                               '__WORKING_DIRECTORY__/test_somalier_matched.parquet'))
        UNION ALL (FROM read_parquet('__WORKING_DIRECTORY__/test_somalier_matched.parquet')
                   EXCEPT ALL FROM contam_matched_result)));
----
0	0

# Macro-internal relation names must not shadow ordinary caller relations.
statement ok
CREATE TEMP VIEW panel AS FROM contam_panel;

statement ok
CREATE TEMP VIEW frequency AS FROM contam_match_frequency;

statement ok
CREATE TEMP VIEW evidence AS
SELECT * FROM contam_evidence WHERE sample_id <> 'One';

statement ok
CREATE TEMP VIEW pairs AS FROM contam_pairs;

query IIIIRR
SELECT length(duckhts_somalier_panel_sha256('panel')),
       length(duckhts_somalier_frequency_sha256('frequency', 'panel')),
       (SELECT count(*) FROM duckhts_somalier_prepare_sketches(
          'evidence', 'panel', 7, 0.3, 0.01, max_sites := 2)),
       (SELECT contamination.usable_sites FROM duckhts_somalier_charr(
          'evidence', 'panel', 'frequency', min_depth := 7,
          hom_minor_rate := 0.1, hom_tail_alpha := 0.001, max_sites := 2)
        WHERE contamination.sample_id = 'D'),
       (SELECT contamination.estimate FROM duckhts_somalier_charr(
          'evidence', 'panel', 'frequency', min_depth := 7,
          hom_minor_rate := 0.1, hom_tail_alpha := 0.001, max_sites := 2)
        WHERE contamination.sample_id = 'D'),
       (SELECT contamination.alpha FROM duckhts_somalier_matched_contamination(
          'evidence', 'panel', 'frequency', 'pairs', max_sites := 2)
        WHERE contamination.receiver_id = 'R' AND contamination.anchor_id = 'H');
----
64	64	7	1	0.01	0.39759034730391873

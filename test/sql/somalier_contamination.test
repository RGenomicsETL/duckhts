statement ok
CREATE TEMP VIEW contam_frequency_nan AS
SELECT assembly, site_index, region, position, allele_a, allele_b,
       CASE WHEN site_index = 0 THEN 'NaN'::DOUBLE ELSE population_b_af END AS population_b_af
FROM contam_frequency;

statement error
SELECT duckhts_somalier_frequency_sha256('contam_frequency_nan', 'contam_panel');
----
population B frequency must be finite in [0, 1]

statement ok
CREATE TEMP VIEW contam_frequency_extreme AS

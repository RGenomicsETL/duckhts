# name: test/sql/somalier_contamination.test
# description: Ordered frequency identity, CHARR, directional matched contamination, and persistence
# group: [duckhts]

require duckhts

statement ok
CREATE TEMP TABLE contam_panel AS
SELECT 'GRCh38' AS assembly, i::UBIGINT AS site_index,
       'chr1' AS region, (100 + i)::UBIGINT AS position,
       'A' AS allele_a, 'G' AS allele_b
FROM range(2) sites(i);

statement ok
CREATE TEMP TABLE contam_frequency AS
SELECT p.*, CASE site_index WHEN 0 THEN 0.25 ELSE 0.80 END::DOUBLE AS population_b_af
FROM contam_panel p;

statement ok
CREATE TEMP TABLE contam_match_frequency AS
SELECT p.*, 0.5::DOUBLE AS population_b_af
FROM contam_panel p;

statement ok
CREATE TEMP VIEW contam_one_panel AS
SELECT * FROM contam_panel WHERE site_index = 0;

statement ok
CREATE TEMP VIEW contam_one_frequency AS
SELECT * FROM contam_frequency WHERE site_index = 0;

# The frequency identity must be insensitive to physical row order, but
# sensitive to a changed B frequency and to ordered-panel identity.
statement ok
CREATE TEMP TABLE contam_frequency_reordered AS
SELECT * FROM contam_frequency ORDER BY site_index DESC;

query III
SELECT duckhts_somalier_frequency_sha256('contam_frequency', 'contam_panel') =
         duckhts_somalier_frequency_sha256('contam_frequency_reordered', 'contam_panel'),
       duckhts_somalier_frequency_sha256('contam_frequency', 'contam_panel') <>
         duckhts_somalier_frequency_sha256('contam_match_frequency', 'contam_panel'),
       length(duckhts_somalier_frequency_sha256('contam_frequency', 'contam_panel'));
----
1	1	64

statement ok
CREATE TEMP TABLE contam_evidence (
  sample_id VARCHAR, assembly VARCHAR, site_index UBIGINT,
  region VARCHAR, position UBIGINT, allele_a VARCHAR, allele_b VARCHAR,
  a UBIGINT, b UBIGINT, other UBIGINT
);

# One is the one-site CHARR witness. R and H are the retained two-site
# matched witness: receiver 160/40 and 40/160, anchor 199/1 and 1/199.
# U is unavailable, E heterozygous, and D contributes one homozygous site.
statement ok
INSERT INTO contam_evidence
SELECT c.sample_id, p.assembly, p.site_index, p.region, p.position,
       p.allele_a, p.allele_b, c.a::UBIGINT, c.b::UBIGINT, c.other::UBIGINT
FROM (VALUES
  ('One', 0, 199, 1, 0), ('R', 0, 160, 40, 0), ('R', 1, 40, 160, 0),
  ('H', 0, 199, 1, 0), ('H', 1, 1, 199, 0),
  ('U', 0, NULL, NULL, NULL), ('U', 1, NULL, NULL, NULL),
  ('E', 0, 100, 100, 0), ('E', 1, 100, 100, 0),
  ('D', 0, 199, 1, 0), ('D', 1, NULL, NULL, NULL),
  ('X', 0, 199, 1, 10), ('X', 1, 1, 199, 10),
  ('L', 0, 6, 0, 0), ('L', 1, 0, 6, 0)
) AS c(sample_id, site_index, a, b, other)
JOIN contam_panel p USING (site_index);

statement ok
CREATE TEMP VIEW contam_one_evidence AS
SELECT * FROM contam_evidence WHERE sample_id = 'One';

# A single infiltrating B read in 200 measured A/B reads, AF(B)=0.25:
# 1 / (0.25 * 200) = 0.02. Explicit binomial settings keep it HOM_A.
query TIIIIIR
SELECT contamination.status, contamination.site_count,
       contamination.observed_sites, contamination.unavailable_sites,
       contamination.usable_sites, contamination.usable_hom_a,
       contamination.estimate
FROM duckhts_somalier_charr(
  'contam_one_evidence', 'contam_one_panel', 'contam_one_frequency',
  min_depth := 7, hom_minor_rate := 0.1, hom_tail_alpha := 0.001,
  max_sites := 1);
----
ok	1	1	0	1	1	0.02

statement ok
CREATE TEMP VIEW contam_charr_evidence AS
SELECT * FROM contam_evidence WHERE sample_id IN ('D', 'E', 'U', 'X', 'L');

# A measured heterozygote, unavailable tuple, high-other tuple, and
# below-minimum-depth tuple are distinct observations but not usable sites.
query TTIIIII
SELECT contamination.sample_id, contamination.status,
       contamination.observed_sites, contamination.unavailable_sites,
       contamination.usable_sites, contamination.usable_hom_a,
       contamination.usable_hom_b
FROM duckhts_somalier_charr(
  'contam_charr_evidence', 'contam_panel', 'contam_frequency',
  min_depth := 7, hom_minor_rate := 0.1, hom_tail_alpha := 0.001,
  max_sites := 2)
ORDER BY contamination.sample_id;
----
D	ok	2	1	1	1	0
E	no_evidence	2	0	0	0	0
L	no_evidence	2	0	0	0	0
U	no_evidence	2	2	0	0	0
X	no_evidence	2	0	0	0	0

query TII
SELECT contamination.sample_id, contamination.estimate IS NULL,
       contamination.site_count
FROM duckhts_somalier_charr(
  'contam_charr_evidence', 'contam_panel', 'contam_frequency',
  min_depth := 7, hom_minor_rate := 0.1, hom_tail_alpha := 0.001,
  max_sites := 2)
WHERE contamination.sample_id IN ('E', 'U')
ORDER BY contamination.sample_id;
----
E	1	2
U	1	2

statement ok
CREATE TEMP TABLE contam_pairs(receiver_id VARCHAR, anchor_id VARCHAR);

statement ok
INSERT INTO contam_pairs VALUES ('R', 'H'), ('H', 'R'), ('U', 'H'), ('R', 'E');

# The two-site fit has an independently calculated optimum near 0.3975904.
# Its retained relative score omits only the alpha-independent binomial
# coefficients. An independent R optimize() evaluation gives
# alpha=0.39759034863198689 and score=-201.54726376072162; at alpha=0.4
# the score is -201.54905839206708.
query TTIIRIRI
SELECT contamination.receiver_id, contamination.anchor_id,
       contamination.site_count, contamination.usable_sites,
       contamination.alpha, contamination.evaluations,
       round(contamination.relative_log_likelihood, 9),
       contamination.relative_log_likelihood > -201.54905839206708
FROM duckhts_somalier_matched_contamination(
  'contam_evidence', 'contam_panel', 'contam_match_frequency', 'contam_pairs',
  max_sites := 2)
WHERE contamination.receiver_id = 'R' AND contamination.anchor_id = 'H';
----
R	H	2	2	0.3975904	143	-201.547263761	1

query TTTIIII
SELECT contamination.receiver_id, contamination.anchor_id,
       contamination.status, contamination.observed_sites,
       contamination.receiver_unavailable_sites,
       contamination.anchor_unavailable_sites, contamination.usable_sites
FROM duckhts_somalier_matched_contamination(
  'contam_evidence', 'contam_panel', 'contam_match_frequency', 'contam_pairs',
  max_sites := 2)
ORDER BY contamination.receiver_id, contamination.anchor_id;
----
H	R	no_evidence	2	0	0	0
R	E	no_evidence	2	0	0	0
R	H	ok	2	0	0	2
U	H	no_evidence	2	2	0	0

query TII
SELECT contamination.receiver_id, contamination.alpha IS NULL,
       contamination.relative_log_likelihood IS NULL
FROM duckhts_somalier_matched_contamination(
  'contam_evidence', 'contam_panel', 'contam_match_frequency', 'contam_pairs',
  max_sites := 2)
WHERE contamination.receiver_id = 'U';
----
U	1	1

statement ok
CREATE TEMP TABLE contam_panel_flipped AS
SELECT assembly, site_index, region, position,
       allele_b AS allele_a, allele_a AS allele_b
FROM contam_panel;

statement ok
CREATE TEMP TABLE contam_frequency_flipped AS
SELECT p.*, (1.0 - f.population_b_af)::DOUBLE AS population_b_af
FROM contam_panel_flipped p JOIN contam_frequency f USING (site_index);

statement ok
CREATE TEMP TABLE contam_frequency_flipped_bad AS
SELECT p.*, f.population_b_af
FROM contam_panel_flipped p JOIN contam_frequency f USING (site_index);

statement ok
CREATE TEMP TABLE contam_evidence_flipped AS
SELECT e.sample_id, p.assembly, p.site_index, p.region, p.position,
       p.allele_a, p.allele_b, e.b AS a, e.a AS b, e.other
FROM contam_evidence e JOIN contam_panel_flipped p USING (site_index);

statement ok
CREATE TEMP VIEW contam_one_evidence_flipped AS
SELECT * FROM contam_evidence_flipped WHERE sample_id = 'One';

statement ok
CREATE TEMP VIEW contam_one_panel_flipped AS
SELECT * FROM contam_panel_flipped WHERE site_index = 0;

statement ok
CREATE TEMP VIEW contam_one_frequency_flipped AS
SELECT * FROM contam_frequency_flipped WHERE site_index = 0;

statement ok
CREATE TEMP VIEW contam_one_frequency_flipped_bad AS
SELECT * FROM contam_frequency_flipped_bad WHERE site_index = 0;

statement ok
CREATE TEMP VIEW contam_flipped_pairs AS
SELECT * FROM contam_pairs WHERE receiver_id = 'R' AND anchor_id = 'H';

# Public panels require canonical lexical A/B order. The kernel's A/B+AF
# symmetry remains a native property; SQL must reject noncanonical panels.
statement error
SELECT duckhts_somalier_panel_sha256('contam_panel_flipped');
----
canonical distinct uppercase biallelic SNP alleles A < B

statement error
SELECT * FROM duckhts_somalier_charr(
  'contam_one_evidence_flipped', 'contam_one_panel_flipped',
  'contam_one_frequency_flipped', min_depth := 7, max_sites := 1);
----
canonical distinct uppercase biallelic SNP alleles A < B

statement error
SELECT * FROM duckhts_somalier_matched_contamination(
  'contam_evidence_flipped', 'contam_panel_flipped',
  'contam_frequency_flipped', 'contam_flipped_pairs', max_sites := 2);
----
canonical distinct uppercase biallelic SNP alleles A < B

statement ok

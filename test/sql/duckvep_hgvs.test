# A CDS-overlapping multi-base feature whose last mapper item is an intronic
# Gap has no HGVSp in VEP. It is non-applicable before sequence reconstruction,
# even though this topology-only test model also lacks prepared CDS sequence.
query TTT
SELECT annotation.transcript_hgvs_status,
       annotation.protein_hgvs_status,
       coalesce(annotation.protein_hgvs_reason, '-')
FROM unnest(_duckvep_annotate_small_hgvs(
  'hgvs-phase', 1::UINTEGER, 109::UBIGINT, 'ACG', 'CCC', 0::UBIGINT
)) AS u(annotation);

# name: test/sql/bcf_filter_list_regression.test
# description: regression for read_bcf FILTER list writes in list columns
# group: [duckhts]

require duckhts

query T
SELECT typeof(FILTER)
FROM read_bcf('__WORKING_DIRECTORY__/test/data/bcf_filter_list_regression.vcf')
LIMIT 1;
----
VARCHAR[]

query T
SELECT FILTER::VARCHAR
FROM read_bcf('__WORKING_DIRECTORY__/test/data/bcf_filter_list_regression.vcf')
WHERE POS = 13
LIMIT 1;
----
[q10, q20]

query TT
SELECT COUNT(*), SUM(length(FILTER))
FROM read_bcf('__WORKING_DIRECTORY__/test/data/bcf_filter_list_regression.vcf');
----
5000	5384

query TT
SELECT list_extract(FILTER, 1) AS f1, list_extract(FILTER, 2) AS f2
FROM read_bcf('__WORKING_DIRECTORY__/test/data/bcf_filter_list_regression.vcf')
WHERE POS = 13
LIMIT 1;
----
q10	q20

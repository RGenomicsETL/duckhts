S2	0.5

# --- q_score_thr with counts ---
# Column naming follows upstream: <prs>_CNT_p<thr> (not <prs>_p<thr>_CNT)
# Boundary precision: strtof→double promotion means exact-boundary P values
# are excluded (upstream parity: float LP < double threshold)
query TTTT
SELECT SAMPLE,
       round("score_summary_p0.01", 3),
       round("score_summary_CNT_p0.01", 0),
       round("score_summary_CNT_p0.2", 0)
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_input.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary.tsv',
  use := 'GT',
  columns := 'PLINK',
  q_score_thr := '0.01,0.2',
  counts := true
)
ORDER BY SAMPLE
----
S1	0.0	0	2
S2	0.0	0	2


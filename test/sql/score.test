# --- FORMAT/AS integer dosage tag ---
# score_as.vcf: S1 GT/AS=(2,1,2), S2 GT/AS=(1,2,1) across rs1/rs2/rs3
# S1: 2*0.5 + 1*(-0.2) + 2*1.0 = 2.8
# S2: 1*0.5 + 2*(-0.2) + 1*1.0 = 1.1
query TT
SELECT SAMPLE, round(score_summary, 3)
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_as.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary.tsv',
  use := 'AS',
  columns := 'PLINK'
)
ORDER BY SAMPLE
----
S1	2.8
S2	1.1

# --- Missing DS value (. treated as missing, variant skipped) ---
# score_missing_ds.vcf: S1 has DS=missing at rs2 → skips rs2 for S1
# S1: 0.1*0.5 + skip + 1.8*1.0 = 1.85; S2: normal DS = 0.32
query TT
SELECT SAMPLE, round(score_summary, 3)
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_missing_ds.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary.tsv',
  use := 'DS',
  columns := 'PLINK'
)
ORDER BY SAMPLE
----
S1	1.85
S2	0.32


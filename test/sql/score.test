# --- Sample subsetting: force_samples ignores missing ---
query TT
SELECT SAMPLE, round(score_summary, 3)
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_input.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary.tsv',
  use := 'GT',
  columns := 'PLINK',
  samples := 'S1,NOSAMPLE',
  force_samples := true
)
ORDER BY SAMPLE
----
S1	1.8


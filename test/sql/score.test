# --- TSV counts without threshold ---
# counts=true adds <col>_CNT column; all 3 variants counted for each sample
query TTT
SELECT SAMPLE, round(score_summary, 3), score_summary_CNT
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_input.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary.tsv',
  use := 'GT',
  columns := 'PLINK',
  counts := true
)
ORDER BY SAMPLE
----
S1	1.8	3
S2	0.1	3

# --- GWAS-VCF + q_score_thr: only variants with LP >= -log10(thr) scored ---
# q_score_thr=0.1 → LP threshold = 1.0; rs1 qualifies (PRS_A lp=2.0, PRS_B lp=1.5)
# GT scores: S1 has 0/0 at rs1 → 0*beta; S2 has 0/1 at rs1 → 1*beta
query TTTTT
SELECT SAMPLE,
       round("PRS_A_p0.1", 3),
       "PRS_A_CNT_p0.1",
       round("PRS_B_p0.1", 3),
       "PRS_B_CNT_p0.1"
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_input.vcf',
  '__WORKING_DIRECTORY__/test/data/score_gwas_summary.vcf',
  use := 'GT',
  q_score_thr := '0.1',
  counts := true
)
ORDER BY SAMPLE
----
S1	0.0	1	0.0	1
S2	0.5	1	0.3	1

# --- Error: include and exclude cannot be used together ---
statement error
SELECT *
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_input.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary.tsv',
  use := 'GT',
  columns := 'PLINK',
  include := 'POS > 100',
  exclude := 'POS > 200'
)
----
only one of include or exclude may be set

# --- Error: regions and regions_file cannot be used together ---
statement error
SELECT *
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_input.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary.tsv',
  use := 'GT',
  columns := 'PLINK',
  regions := '1:100-200',
  regions_file := '__WORKING_DIRECTORY__/test/data/score_regions.txt'
)
----
only one of regions or regions_file may be set


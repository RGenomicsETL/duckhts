# --- GWAS-VCF with counts ---
query TTTTT
SELECT SAMPLE, round(PRS_A, 3), PRS_A_CNT, round(PRS_B, 3), PRS_B_CNT
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_input.vcf',
  '__WORKING_DIRECTORY__/test/data/score_gwas_summary.vcf',
  use := 'GT',
  counts := true
)
ORDER BY SAMPLE
----

# name: test/sql/score.test
# description: Test bcftools_score table function - comprehensive parity tests
# group: [duckhts]

require duckhts

# --- Basic GT scoring (chr:pos matching, PLINK preset) ---
query TT
SELECT SAMPLE, round(score_summary, 3)
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_input.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary.tsv',
  use := 'GT',
  columns := 'PLINK'
)
ORDER BY SAMPLE
----
S1	1.8
S2	0.1

statement error
SELECT *
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_input.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary.tsv',
  use := 'GT',
  columns := 'PLINK',
  include := 'INFO/ZZZ==1'
)
----
failed to evaluate include expression

query TT
SELECT SAMPLE, round(score_summary, 3)
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_input.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary.tsv',
  use := 'GT',
  columns := 'PLINK',
  include := 'FORMAT/GT=="0/0"'
)
ORDER BY SAMPLE
----
S1	0.0
S2	0.5

# --- q_score_thr with counts ---
# Column naming follows upstream: <prs>_CNT_p<thr> (not <prs>_p<thr>_CNT)
# Boundary precision: strtof→double promotion means exact-boundary P values
# are excluded (upstream parity: float LP < double threshold)
query TTTT
SELECT SAMPLE,
       round("score_summary_p0.01", 3),
       round("score_summary_CNT_p0.01", 0),
       round("score_summary_CNT_p0.2", 0)
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_input.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary.tsv',
  use := 'GT',
  columns := 'PLINK',
  q_score_thr := '0.01,0.2',
  counts := true
)
ORDER BY SAMPLE
----
S1	0.0	0	2
S2	0.0	0	2

# --- rsID matching (use_variant_id) ---
query TT
SELECT SAMPLE, round(score_summary_rsid, 3)
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_input.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary_rsid.tsv',
  use := 'GT',
  columns := 'PLINK',
  use_variant_id := true
)
ORDER BY SAMPLE
----
S1	1.8
S2	0.1

# --- rsID summary without use_variant_id (falls back to chr:pos, no match) ---
query TT
SELECT SAMPLE, round(score_summary_rsid, 3)
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_input.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary_rsid.tsv',
  use := 'GT',
  columns := 'PLINK'
)
ORDER BY SAMPLE
----
S1	0.0
S2	0.0

# --- Error: use_variant_id with no SNP column ---
statement error
SELECT *
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_input.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary_no_snp.tsv',
  use := 'GT',
  columns := 'PLINK',
  use_variant_id := true
)
----
Invalid Input Error: bcftools_score: summary must include marker name column when use_variant_id=true

# --- Flexible chromosome name matching (chr prefix) ---
# VCF has chr1, summary has bare "1" — should match via flexible resolution
query TT
SELECT SAMPLE, round(score_summary, 3)
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_chrprefix.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary.tsv',
  use := 'GT',
  columns := 'PLINK'
)
ORDER BY SAMPLE
----
S1	1.8
S2	0.1

# --- OR-to-beta conversion ---
query TT
SELECT SAMPLE, round(score_summary_or, 3)
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_input.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary_or.tsv',
  use := 'GT',
  columns := 'PLINK'
)
ORDER BY SAMPLE
----
S1	1.8

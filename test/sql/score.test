# --- DS auto-detection on dosage VCF (DS highest priority among available) ---
query TT
SELECT SAMPLE, round(score_summary, 3)
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_dosage.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary.tsv',
  columns := 'PLINK'
)
ORDER BY SAMPLE
----
S1	1.69
S2	0.32

# --- Small p-value precision (stable -log10 parsing) ---
# With improved parsing: -log10(5e-300)=299.301, -log10(1e-100)=100
# q_score_thr 1e-200 => lp threshold = 200. Only rs1 (lp=299.3) passes.
# S1: 0*0.5 = 0.0; S2: 1*0.5 = 0.5
query TT
SELECT SAMPLE, round("score_summary_smallp_p1e-200", 3)
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_input.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary_smallp.tsv',
  use := 'GT',
  columns := 'PLINK',
  q_score_thr := '1e-200'
)
ORDER BY SAMPLE
----
S1	0.0
S2	0.5

query TT

# --- PLINK2 preset with LOG10_P ---
query TT
SELECT SAMPLE, round(score_summary_plink2, 3)
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_input.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary_plink2.tsv',
  use := 'GT',
  columns := 'PLINK2'
)
ORDER BY SAMPLE
----
S1	1.8
S2	0.1

# --- NA/missing value handling (rs2 BETA=NA, should be skipped) ---
# Only rs1 (beta=0.5) and rs3 (beta=1.0) contribute
# S1: 0*0.5 + 2*1.0 = 2.0; S2: 1*0.5 + 0*1.0 = 0.5
query TT
SELECT SAMPLE, round(score_summary_na, 3)
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_input.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary_na.tsv',
  use := 'GT',
  columns := 'PLINK'
)
ORDER BY SAMPLE
----
S1	2.0
S2	0.5

# --- Missing genotype (S1 has ./. at rs1) ---
# S1: skip rs1, 1*(-0.2) + 2*1.0 = 1.8; S2: 1*0.5 + 2*(-0.2) + 0 = 0.1
query TT
SELECT SAMPLE, round(score_summary, 3)
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_missing_gt.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary.tsv',
  use := 'GT',
  columns := 'PLINK'
)
ORDER BY SAMPLE
----
S1	1.8
S2	0.1

# --- Allele mismatch (A1 not in VCF alleles — all markers skipped) ---
query TT
SELECT SAMPLE, round(score_summary_mismatch, 3)
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_input.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary_mismatch.tsv',
  use := 'GT',
  columns := 'PLINK'
)
ORDER BY SAMPLE
----
S1	0.0
S2	0.0

# --- Custom columns_file mapping ---
query TT
SELECT SAMPLE, round(score_summary_custom, 3)
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_input.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary_custom.tsv',
  use := 'GT',
  columns_file := '__WORKING_DIRECTORY__/test/data/score_columns.tsv'
)
ORDER BY SAMPLE
----
S1	1.8
S2	0.1

# --- DS dosage mode ---
# S1: 0.1*0.5 + 0.8*(-0.2) + 1.8*1.0 = 1.69
# S2: 1.0*0.5 + 1.9*(-0.2) + 0.2*1.0 = 0.32
query TT
SELECT SAMPLE, round(score_summary, 3)
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_dosage.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary.tsv',
  use := 'DS',
  columns := 'PLINK'
)
ORDER BY SAMPLE
----
S1	1.69
S2	0.32

# --- HDS dosage mode ---
query TT

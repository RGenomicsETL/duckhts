)
ORDER BY SAMPLE
----
S1	1.69
S2	0.32

# --- GP dosage mode ---
# S1: (0.1+0)*0.5 + (0.6+0.4)*(-0.2) + (0.2+1.6)*1.0 = 0.05-0.2+1.8 = 1.65
# S2: (1.0+0)*0.5 + (0.1+1.8)*(-0.2) + (0.2+0)*1.0 = 0.5-0.38+0.2 = 0.32
query TT
SELECT SAMPLE, round(score_summary, 3)
FROM bcftools_score(
  '__WORKING_DIRECTORY__/test/data/score_dosage.vcf',
  '__WORKING_DIRECTORY__/test/data/score_summary.tsv',
  use := 'GP',
  columns := 'PLINK'
)
ORDER BY SAMPLE
----
S1	1.65
S2	0.32


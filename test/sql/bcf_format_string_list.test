# name: test/sql/bcf_format_string_list.test
# description: read_bcf handle string FORMAT lists and variable Number fields
# group: [duckhts]

require duckhts

query T
SELECT typeof(FORMAT_LAA_SAMPLE1)
FROM read_bcf('__WORKING_DIRECTORY__/test/data/format_string_list.vcf')
LIMIT 1;
----
VARCHAR[]

query TT
SELECT list_extract(FORMAT_LAA_SAMPLE1, 1), list_extract(FORMAT_LAA_SAMPLE1, 2)
FROM read_bcf('__WORKING_DIRECTORY__/test/data/format_string_list.vcf')
WHERE POS = 73;
----
1	2

query TI
SELECT FORMAT_LAA_SAMPLE1::VARCHAR, FORMAT_LAA_SAMPLE1 IS NULL
FROM read_bcf('__WORKING_DIRECTORY__/test/data/format_string_list.vcf')
WHERE POS = 263;
----
NULL	1

query T
SELECT typeof(INFO_SB)
FROM read_bcf('__WORKING_DIRECTORY__/test/data/fixed_count_arrays.vcf')
LIMIT 1;
----
INTEGER[]

query T
SELECT INFO_SB::VARCHAR
FROM read_bcf('__WORKING_DIRECTORY__/test/data/fixed_count_arrays.vcf')
WHERE POS = 100;
----
[10, 20, 30, 40]

query T
SELECT typeof(FORMAT_HQ_S1)
FROM read_bcf('__WORKING_DIRECTORY__/test/data/fixed_count_arrays.vcf')
LIMIT 1;
----
INTEGER[]

query T
SELECT FORMAT_HQ_S1::VARCHAR
FROM read_bcf('__WORKING_DIRECTORY__/test/data/fixed_count_arrays.vcf')
WHERE POS = 100;
----
[5, 9]

# INFO and FORMAT Number=. fields remain list-typed and value-preserving.
query TTTT
SELECT typeof(INFO_VSTR), INFO_VSTR::VARCHAR, typeof(INFO_VINT), INFO_VINT::VARCHAR
FROM read_bcf('__WORKING_DIRECTORY__/test/data/mapping_number_families.vcf')
WHERE POS = 200;
----
VARCHAR[]	[red, blue, green]	INTEGER[]	[1, 2, 3]

query TTTT
SELECT typeof(FORMAT_LAA_S1), FORMAT_LAA_S1::VARCHAR, typeof(FORMAT_PL_S1), FORMAT_PL_S1::VARCHAR
FROM read_bcf('__WORKING_DIRECTORY__/test/data/mapping_number_families.vcf')
WHERE POS = 200;
----
VARCHAR[]	[1, 2]	INTEGER[]	[0, 10, 20, 30, 40, 50]

# name: test/sql/macro_definitions.test
# description: Ordered native macro definitions and in-memory LOAD behavior.
# group: [duckhts]

require duckhts

# The inventory includes the separate fitted-count ROH macro and the private
# duckhts_htslib_is_indel classifier of duckhts_roh_af_table_bcftools, and that macro.
query IIIII
SELECT count(*)::INTEGER, count(DISTINCT install_order)::INTEGER,
       count(DISTINCT definitions_sha256)::INTEGER,
       count(*) FILTER (WHERE sql LIKE 'CREATE OR REPLACE TEMP MACRO %')::INTEGER,
       count(*) FILTER (WHERE length(definitions_sha256) = 64)::INTEGER
FROM duckhts_macro_definitions();
----
45	45	1	45	45

query II
SELECT count(DISTINCT d.name)::INTEGER,
       count(DISTINCT d.name) FILTER (WHERE f.database_name = current_database())::INTEGER
FROM duckhts_macro_definitions() d
JOIN duckdb_functions() f ON f.function_name = d.name AND f.function_type IN ('macro', 'table_macro');
----
45	45

query I
SELECT duckhts_quote_ident('a"b');
----
"a""b"

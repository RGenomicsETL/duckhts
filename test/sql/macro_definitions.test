# name: test/sql/macro_definitions.test
# description: Ordered native macro definitions and in-memory LOAD behavior.
# group: [duckhts]

require duckhts

# Public and private macro definitions have one ordered inventory.
query IIIII
SELECT count(*)::INTEGER, count(DISTINCT install_order)::INTEGER,
       count(DISTINCT definitions_sha256)::INTEGER,
       count(*) FILTER (WHERE sql LIKE 'CREATE OR REPLACE TEMP MACRO %')::INTEGER,
       count(*) FILTER (WHERE length(definitions_sha256) = 64)::INTEGER
FROM duckhts_macro_definitions();
----
56	56	1	56	56

query II
SELECT count(DISTINCT d.name)::INTEGER,
       count(DISTINCT d.name) FILTER (WHERE f.database_name = current_database())::INTEGER
FROM duckhts_macro_definitions() d
JOIN duckdb_functions() f ON f.function_name = d.name AND f.function_type IN ('macro', 'table_macro');
----
56	56

# Each DuckHTS macro name has exactly one overload.
query I
SELECT count(*) FROM (
  SELECT function_name, count(*) FROM duckdb_functions()
  WHERE function_type IN ('macro', 'table_macro')
    AND starts_with(function_name, 'duckhts_')
  GROUP BY function_name HAVING count(*) > 1
);
----
0

query I
SELECT count(*) FROM duckhts_macro_definitions() WHERE public;
----
45

# DuckHTS contributes no public function or macro in DuckDB's namespace.
query I
SELECT count(*) FROM duckhts_macro_definitions()
WHERE public AND starts_with(name, 'duckdb_');
----
0

# Depth and interval base signatures reject extra positional table inputs.
statement error
SELECT * FROM duckhts_depth_region_fraction('bins', 'regions', 'reference');
----
Binder Error

statement error
SELECT * FROM duckhts_depth_sex_fraction('bins', 'reference');
----
Binder Error

statement error
SELECT * FROM duckhts_cgranges_from_table('idx', 'table', 'chrom', 'start', 'end', 'label');
----
Binder Error

query I
SELECT duckhts__quote_ident('a"b');
----
"a""b"

# name: test/sql/cgranges_api.test
# description: Test native DuckHTS cgranges registry and overlap queries
# group: [duckhts]

require duckhts

# Mutators must receive constant NULLs rather than be folded to SQL NULL.
statement error
SELECT duckhts_cgranges_create(NULL);
----
duckhts_cgranges_create: name must be non-null

statement error
SELECT duckhts_cgranges_index(NULL);
----
duckhts_cgranges_index: name must be non-null

statement error
SELECT duckhts_cgranges_destroy(NULL);
----
duckhts_cgranges_destroy: name must be non-null

query I
SELECT duckhts_cgranges_create('x');
----
1

statement error
SELECT duckhts_cgranges_add(NULL, 'chr1', 10, 20);
----
duckhts_cgranges_add: name, chrom, start, and end must be non-null

statement error
SELECT duckhts_cgranges_add('x', NULL, 10, 20);
----
duckhts_cgranges_add: name, chrom, start, and end must be non-null

statement error
SELECT duckhts_cgranges_add('x', 'chr1', NULL, 20);
----
duckhts_cgranges_add: name, chrom, start, and end must be non-null

statement error
SELECT duckhts_cgranges_add('x', 'chr1', 10, NULL, 'label');
----
duckhts_cgranges_add: name, chrom, start, and end must be non-null

# A non-NULL label establishes the registry payload type. Subsequent NULL
# labels remain stored intervals for every label overload.
foreach type VARCHAR BIGINT DOUBLE BOOLEAN

query I
SELECT duckhts_cgranges_create('null_labels');
----
1

query I
SELECT duckhts_cgranges_add('null_labels', 'chr1', 10, 20, '1'::${type});
----
1

query I
SELECT duckhts_cgranges_add('null_labels', 'chr1', 10, 20, NULL::${type});
----
1

query I
SELECT duckhts_cgranges_index('null_labels');
----
1

query II
SELECT interval_ordinal, label IS NULL
FROM duckhts_cgranges_overlaps('null_labels', 'chr1', 10, 20)
ORDER BY interval_ordinal;
----
0	false
1	true

query I
SELECT duckhts_cgranges_destroy('null_labels');
----
1

endloop

query I
SELECT duckhts_cgranges_add('x', 'chr1', 10, 20);
----
1

query I
SELECT duckhts_cgranges_add('x', 'chr1', 30, 40);
----
1

statement error
SELECT * FROM duckhts_cgranges_overlaps('x', 'chr1', 15, 18);
----
duckhts_cgranges_overlaps: index is not finalized; call duckhts_cgranges_index first

query I
SELECT duckhts_cgranges_index('x');
----
1

query IIIII
SELECT
  interval_ordinal,
  label,
  interval_chrom,
  interval_start,
  interval_end
FROM duckhts_cgranges_overlaps('x', 'chr1', 15, 18);
----
0	0	chr1	10	20

query IIIIII
SELECT
  query_row_id,
  interval_ordinal,
  label,
  interval_chrom,
  interval_start,
  interval_end
FROM duckhts_cgranges_overlaps('x', 'chr1', 35, 36, query_row_id := 7);
----
7	1	1	chr1	30	40

statement ok
CREATE TABLE cgr_src AS
SELECT * FROM (VALUES
  ('chr2', 100, 110, 'alpha'),
  ('chr2', 150, 170, 'beta')
) AS t(chrom, start, "end", label);

query I
SELECT * FROM duckhts_cgranges_from_table_labelled('tbl_idx', 'cgr_src', 'chrom', 'start', 'end', 'label');
----
1

query IIIII
SELECT interval_ordinal, label, interval_chrom, interval_start, interval_end
FROM duckhts_cgranges_overlaps('tbl_idx', 'chr2', 105, 106);
----
0	alpha	chr2	100	110

statement error
SELECT * FROM duckhts_cgranges_from_table_labelled('tbl_idx', 'cgr_src', 'chrom', 'start', 'end', 'label');
----
duckhts_cgranges_create: index already exists in this session

statement ok
CREATE TEMP VIEW cgr_beta AS SELECT chrom, start, "end", label FROM cgr_src WHERE label = 'beta';

query I
SELECT * FROM duckhts_cgranges_from_table_labelled('qry_idx', 'cgr_beta', 'chrom', 'start', 'end', 'label');
----
1

query I
SELECT duckhts_cgranges_index('qry_idx');
----
1

query IIIII
SELECT
  interval_ordinal,
  label,
  interval_chrom,
  interval_start,
  interval_end
FROM duckhts_cgranges_overlaps('qry_idx', 'chr2', 160, 161);
----
0	beta	chr2	150	170

query IIIII
SELECT
  interval_ordinal,
  label,
  interval_chrom,
  interval_start,
  interval_end
FROM duckhts_cgranges_overlaps('qry_idx', 'chr2', 150, 170, mode := 'contain');
----
0	beta	chr2	150	170

statement ok
CREATE TABLE cgr_probe_src AS
SELECT * FROM (VALUES
  (10::BIGINT, 'chr2', 100, 105),
  (20::BIGINT, 'chr2', 160, 161),
  (30::BIGINT, 'chr2', 500, 510),
  (40::BIGINT, 'chr2', 150, 170)
) AS t(qid, chrom, start, "end");

query ITI
SELECT
  qid,
  CAST(duckhts_cgranges_has_overlap('qry_idx', chrom, start, "end") AS VARCHAR) AS has_overlap,
  duckhts_cgranges_count_overlaps('qry_idx', chrom, start, "end") AS n_overlap
FROM cgr_probe_src
ORDER BY qid;
----
10	false	0
20	true	1
30	false	0
40	true	1

query ITI
SELECT
  qid,
  CAST(duckhts_cgranges_has_overlap('qry_idx', chrom, start, "end", 'contain') AS VARCHAR) AS has_contained,
  duckhts_cgranges_count_overlaps('qry_idx', chrom, start, "end", 'contain') AS n_contained
FROM cgr_probe_src
ORDER BY qid;
----
10	false	0
20	false	0
30	false	0
40	true	1

query T
SELECT COALESCE(CAST(duckhts_cgranges_has_overlap('qry_idx', NULL::VARCHAR, 1, 2) AS VARCHAR), 'NULL');
----
NULL

query IITTTII
SELECT
  p.qid,
  hit.interval_ordinal,
  hit.label,
  hit.label_type,
  hit.interval_chrom,
  hit.interval_start,
  hit.interval_end
FROM cgr_probe_src AS p
CROSS JOIN UNNEST(duckhts_cgranges_overlaps_list('qry_idx', p.chrom, p.start, p."end")) AS u(hit)
ORDER BY p.qid, hit.interval_ordinal;
----
20	0	beta	VARCHAR	chr2	150	170
40	0	beta	VARCHAR	chr2	150	170

query IITTTII
SELECT
  p.qid,
  hit.interval_ordinal,
  hit.label,
  hit.label_type,
  hit.interval_chrom,
  hit.interval_start,
  hit.interval_end
FROM cgr_probe_src AS p
CROSS JOIN UNNEST(duckhts_cgranges_overlaps_list('qry_idx', p.chrom, p.start, p."end", 'contain')) AS u(hit)
ORDER BY p.qid, hit.interval_ordinal;
----
40	0	beta	VARCHAR	chr2	150	170

query I
SELECT duckhts_cgranges_overlaps_list('qry_idx', NULL::VARCHAR, 1, 2) IS NULL;
----
1

statement ok
CREATE TEMP VIEW cgr_bed_targets AS
SELECT chrom, start, "end" FROM read_bed('__WORKING_DIRECTORY__/test/data/targets.bed');

query I
SELECT * FROM duckhts_cgranges_from_table('bed_from_table_idx', 'cgr_bed_targets', 'chrom', 'start', 'end');
----
1

query IIIII
SELECT interval_ordinal, label, interval_chrom, interval_start, interval_end
FROM duckhts_cgranges_overlaps('bed_from_table_idx', 'CHROMOSOME_I', 5, 15)
ORDER BY interval_ordinal;
----
0	0	CHROMOSOME_I	0	10
1	1	CHROMOSOME_I	10	20

query I
SELECT duckhts_cgranges_create('bed_provider_idx');
----
1

query I
SELECT duckhts_cgranges_add('bed_provider_idx', 'CHROMOSOME_I', 5, 15);
----
1

query I
SELECT duckhts_cgranges_index('bed_provider_idx');
----
1

query II
SELECT
  count(*) AS overlapping_rows,
  sum(duckhts_cgranges_count_overlaps('bed_provider_idx', chrom, start, "end"))::BIGINT AS total_hits
FROM read_bed('__WORKING_DIRECTORY__/test/data/targets.bed')
WHERE duckhts_cgranges_has_overlap('bed_provider_idx', chrom, start, "end");
----
2	2

query TIIITTII
SELECT
  q.chrom,
  q.start,
  q."end",
  hit.interval_ordinal,
  hit.label,
  hit.label_type,
  hit.interval_start,
  hit.interval_end
FROM read_bed('__WORKING_DIRECTORY__/test/data/targets.bed') AS q
CROSS JOIN UNNEST(duckhts_cgranges_overlaps_list('bed_provider_idx', q.chrom, q.start, q."end")) AS u(hit)
ORDER BY q.chrom, q.start, hit.interval_ordinal;
----
CHROMOSOME_I	0	10	0	0	ORDINAL	5	15
CHROMOSOME_I	10	20	0	0	ORDINAL	5	15

query IIIIII
SELECT
  query_row_id,
  hit.interval_ordinal,
  hit.label,
  hit.interval_chrom,
  hit.interval_start,
  hit.interval_end
FROM (
  SELECT p.qid AS query_row_id,
         unnest(duckhts_cgranges_overlaps_list('qry_idx', p.chrom, p.start, p."end")) AS hit
  FROM cgr_probe_src AS p
) AS o
ORDER BY query_row_id, hit.interval_ordinal;
----
20	0	beta	chr2	150	170
40	0	beta	chr2	150	170

query IIIIII
SELECT
  query_row_id,
  hit.interval_ordinal,
  hit.label,
  hit.interval_chrom,
  hit.interval_start,
  hit.interval_end
FROM (
  SELECT p.query_row_id,
         unnest(duckhts_cgranges_overlaps_list('qry_idx', p.chrom, p.start, p."end")) AS hit
  FROM (
    SELECT row_number() OVER () AS query_row_id, chrom, start, "end"
    FROM cgr_probe_src
  ) AS p
) AS o
ORDER BY query_row_id, hit.interval_ordinal;
----
2	0	beta	chr2	150	170
4	0	beta	chr2	150	170

query IIIIII
SELECT
  query_row_id,
  hit.interval_ordinal,
  hit.label,
  hit.interval_chrom,
  hit.interval_start,
  hit.interval_end
FROM (
  SELECT p.qid AS query_row_id,
         unnest(duckhts_cgranges_overlaps_list('qry_idx', p.chrom, p.start, p."end", 'contain')) AS hit
  FROM cgr_probe_src AS p
) AS o
ORDER BY query_row_id, hit.interval_ordinal;
----
40	0	beta	chr2	150	170


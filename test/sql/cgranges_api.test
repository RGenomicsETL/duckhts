query I
SELECT * FROM duckhts_cgranges_from_table('txn_idx', 'cgr_txn_src', 'chrom', 'start', 'end');
----
1

statement ok
ROLLBACK;

query I
SELECT duckhts_cgranges_count_overlaps('txn_idx', 'chr9', 150, 151);
----
1

statement error

query I
SELECT duckhts_cgranges_destroy('x');
----
1

# A NULL label first leaves the index without label storage; a later typed label
# must allocate it, and the earlier intervals keep their NULL label.
statement ok
SELECT duckhts_cgranges_create('null_first_varchar');

statement ok
SELECT duckhts_cgranges_add('null_first_varchar', 'chr1', 0, 10, NULL::VARCHAR);

statement ok
SELECT duckhts_cgranges_add('null_first_varchar', 'chr1', 10, 20, 'a');

statement ok
SELECT duckhts_cgranges_add('null_first_varchar', 'chr1', 20, 30, NULL::VARCHAR);

statement ok
SELECT duckhts_cgranges_index('null_first_varchar');

query IIT
SELECT hit.interval_ordinal, hit.interval_start, hit.label
FROM (SELECT unnest(duckhts_cgranges_overlaps_list('null_first_varchar', 'chr1', 0, 30)) AS hit)
ORDER BY hit.interval_ordinal;
----
0	0	NULL
1	10	a
2	20	NULL

statement ok
SELECT duckhts_cgranges_create('null_first_bigint');

statement ok
SELECT duckhts_cgranges_add('null_first_bigint', 'chr1', 0, 10, NULL::BIGINT);

statement ok
SELECT duckhts_cgranges_add('null_first_bigint', 'chr1', 10, 20, 42::BIGINT);

statement ok
SELECT duckhts_cgranges_index('null_first_bigint');

query IIT
SELECT hit.interval_ordinal, hit.interval_start, hit.label
FROM (SELECT unnest(duckhts_cgranges_overlaps_list('null_first_bigint', 'chr1', 0, 20)) AS hit)
ORDER BY hit.interval_ordinal;
----
0	0	NULL
1	10	42

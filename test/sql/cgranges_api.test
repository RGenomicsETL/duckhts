  ('chr3', 5, 15, 11::BIGINT, 1.5::DOUBLE, TRUE),
  ('chr3', 20, 35, NULL::BIGINT, NULL::DOUBLE, NULL::BOOLEAN),
  ('chr3', 40, 50, 42::BIGINT, 3.25::DOUBLE, FALSE)
) AS t(chrom, start, "end", label_i64, label_f64, label_bool);


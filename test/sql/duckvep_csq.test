# name: test/sql/duckvep_csq.test
# description: DuckVEP/bcftools csq fixture plumbing over DuckDB-native BCSQ, exact, and region annotations
# group: [duckhts]

require duckhts

# --- Ensembl variation releases use Format= rather than VEP's usual Format: ---
query IT
SELECT count(*), string_agg(column_name, ',' ORDER BY column_name)
FROM (DESCRIBE SELECT * FROM read_bcf_v2(
  '__WORKING_DIRECTORY__/test/data/duckvep/ensembl_release_consequences.vcf',
  include_info := false,
  include_format := false,
  vep_fields := 'Allele,Consequence,Feature_type,Feature,Amino_acids,SIFT'
));
----
13	ALT,CHROM,FILTER,ID,POS,QUAL,REF,VEP_Allele,VEP_Amino_acids,VEP_Consequence,VEP_Feature,VEP_Feature_type,VEP_SIFT

# --- official release rows retain parallel CSQ fields and indexed VE entries ---
query II
SELECT list_count(VEP_Consequence), list_count(INFO_VE)
FROM read_bcf_v2(
  '__WORKING_DIRECTORY__/test/data/duckvep/ensembl_release_consequences.vcf',
  info_fields := 'VE',
  include_format := false,
  vep_fields := 'Allele,Consequence,Feature_type,Feature,Amino_acids,SIFT'
)
WHERE POS = 15528198;
----
4	6

query T
SELECT string_agg(
  list_extract(VEP_Allele, ordinal) || ':' ||
    list_extract(VEP_Consequence, ordinal) || ':' ||
    list_extract(VEP_Feature, ordinal),
  ',' ORDER BY ordinal
)
FROM read_bcf_v2(
  '__WORKING_DIRECTORY__/test/data/duckvep/ensembl_release_consequences.vcf',
  include_info := false,
  include_format := false,
  vep_fields := 'Allele,Consequence,Feature'
), UNNEST(range(1, list_count(VEP_Allele) + 1)) AS u(ordinal)
WHERE POS = 15528198;
----
A:missense_variant:ENST00000643195,A:intron_variant:ENST00000775238,T:intron_variant:ENST00000775238,T:missense_variant:ENST00000643195

# --- bcftools csq BCSQ header schema is parsed into VEP_* list columns ---
query TTTTT
SELECT
  list_extract(VEP_Consequence, 1),
  list_extract(VEP_gene, 1),
  list_extract(VEP_transcript, 1),
  list_extract(VEP_strand, 1),
  list_extract(VEP_dna_change, 1)
FROM read_bcf('__WORKING_DIRECTORY__/test/data/duckvep/minimal_bcsq.vcf')
WHERE POS = 124;
----
missense_variant	DUCK1	DUCK1-201	+	124T>C

# --- BCSQ fields keep the same typed list surface used for CSQ/ANN parsing ---
query TT
SELECT typeof(VEP_Consequence), typeof(VEP_dna_change)
FROM read_bcf('__WORKING_DIRECTORY__/test/data/duckvep/minimal_bcsq.vcf')
LIMIT 1;
----
VARCHAR[]	VARCHAR[]

# --- exact annotations can use ordinary DuckDB joins on VCF keys ---
query TT
WITH variants AS (
  SELECT CHROM, POS, REF, list_extract(ALT, 1) AS ALT, ID
  FROM read_bcf('__WORKING_DIRECTORY__/test/data/duckvep/minimal_bcsq.vcf')
), exact_annotations(chrom, pos, ref, alt, label) AS (
  VALUES ('chrDuck', 124::BIGINT, 'T', 'C', 'pinned_exact_missense')
)
SELECT v.ID, a.label
FROM variants v
JOIN exact_annotations a
  ON v.CHROM = a.chrom
 AND v.POS = a.pos
 AND v.REF = a.ref
 AND v.ALT = a.alt;
----
duck_missense	pinned_exact_missense

# --- region candidate annotations can use DuckDB range joins over GFF3 rows ---
query T
WITH variants AS (
  SELECT CHROM, POS, ID
  FROM read_bcf('__WORKING_DIRECTORY__/test/data/duckvep/minimal_bcsq.vcf')
), genes AS (
  SELECT seqname, start, "end", map_extract_value(attributes_map, 'ID') AS gene_id
  FROM read_gff('__WORKING_DIRECTORY__/test/data/duckvep/minimal.gff3', attributes_map := true)
  WHERE feature = 'gene'
)
SELECT string_agg(v.ID || ':' || coalesce(g.gene_id, 'NA'), ',' ORDER BY v.CHROM, v.POS)
FROM variants v
LEFT JOIN genes g
  ON v.CHROM = g.seqname
 AND v.POS BETWEEN g.start AND g."end";
----
duck_missense:gene:DUCK1,duck_intron:gene:DUCK1,duck_intergenic:NA

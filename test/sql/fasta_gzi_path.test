# name: test/sql/fasta_gzi_path.test
# description: Explicit FASTA indexes, failed retrieval and connection recovery
# group: [duckhts]

require duckhts

statement ok
SELECT *
FROM bgzip(
  '__WORKING_DIRECTORY__/test/data/ce.fa',
  output_path := '__WORKING_DIRECTORY__/test/tmp_ce.fa.gz',
  keep := TRUE,
  overwrite := TRUE
);

statement ok
SELECT *
FROM fasta_index(
  '__WORKING_DIRECTORY__/test/tmp_ce.fa.gz',
  index_path := '__WORKING_DIRECTORY__/test/tmp_ce.fa.gz.fai'
);

query II
SELECT NAME, length(SEQUENCE)
FROM read_fasta(
  '__WORKING_DIRECTORY__/test/tmp_ce.fa.gz',
  region := 'CHROMOSOME_I:1-10',
  index_path := '__WORKING_DIRECTORY__/test/tmp_ce.fa.gz.fai',
  gzi_path := '__WORKING_DIRECTORY__/test/tmp_ce.fa.gz.gzi'
);
----
CHROMOSOME_I	10

query I
SELECT sum(seq_len)
FROM fasta_nuc(
  '__WORKING_DIRECTORY__/test/tmp_ce.fa.gz',
  bin_width := 10,
  region := 'CHROMOSOME_I:1-20',
  index_path := '__WORKING_DIRECTORY__/test/tmp_ce.fa.gz.fai',
  gzi_path := '__WORKING_DIRECTORY__/test/tmp_ce.fa.gz.gzi'
);
----
20

# These deliberately malformed FAI entries either overrun the tiny FASTA or
# wrap a physical file offset. Neither failure may omit the requested interval.
statement error
SELECT * FROM fasta_nuc('__WORKING_DIRECTORY__/test/data/faidx_invalid.fa',
  bin_width := 1, region := 'offset_wrap:5-5', include_seq := true);
----
fasta_nuc: failed to fetch

statement error
SELECT * FROM fasta_nuc('__WORKING_DIRECTORY__/test/data/faidx_invalid.fa',
  bin_width := 20, region := 'truncated:1-20');
----
fasta_nuc: failed to fetch

# A failure after a valid BED row fails the complete query.
statement error
SELECT * FROM fasta_nuc('__WORKING_DIRECTORY__/test/data/faidx_invalid.fa',
  bed_path := '__WORKING_DIRECTORY__/test/data/faidx_invalid.bed', include_seq := true);
----
fasta_nuc: failed to fetch

query TI
SELECT seq, seq_len FROM fasta_nuc('__WORKING_DIRECTORY__/test/data/faidx_invalid.fa',
  bin_width := 4, region := 'ok:1-4', include_seq := true);
----
AcGT	4

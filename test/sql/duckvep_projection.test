# NMD's <=101 rule uses VEP feature CDS coordinates, not the physical
# phase-padded edit fact cached by the ordinary indel path.
query I
SELECT * FROM duckvep_model_load('later-nmd', 'SELECT * FROM projection_regions',
  'SELECT 0::UINTEGER transcript_index, 1::UINTEGER seq_region,
    90::UBIGINT transcript_start, 1119::UBIGINT transcript_end,
    1::TINYINT strand, 0::UINTEGER gene_index, 3::UBIGINT transcript_flags,
    1000::UBIGINT cds_start, 1119::UBIGINT cds_end,
    (''NN'' || repeat(''A'',120))::BLOB cds_sequence, 1::UTINYINT codon_table',
  'SELECT * FROM (VALUES
    (0::UINTEGER,90::UBIGINT,99::UBIGINT,1::UBIGINT,10::UBIGINT,-1::TINYINT,-1::TINYINT),
    (0::UINTEGER,1000::UBIGINT,1119::UBIGINT,11::UBIGINT,130::UBIGINT,2::TINYINT,2::TINYINT))
    e(transcript_index,exon_start,exon_end,exon_cdna_start,exon_cdna_end,phase,end_phase)');
----
true

query TII
SELECT a.nmd_prediction, a.nmd_escape_early_cds, a.status_code=0
FROM unnest(_duckvep_annotate_small_rich('later-nmd', 1::UINTEGER,
  1099::UBIGINT, 'AA', 'A', 0::UBIGINT)) u(a);
----
escaping	true	true

query I
SELECT duckvep_model_drop('later-nmd');
----
true

statement ok
CREATE TABLE projection_gap_event AS SELECT * REPLACE(18::UBIGINT AS position,
  'CAA' AS reference, 'GTT' AS alternate) FROM projection_events WHERE event_index=1;

query IIIIIITT
SELECT cdna_start, cdna_end, cds_start, cds_end, protein_start, protein_end,
  reference_amino_acids, reference_codons FROM duckvep_transcript_projection(
    'projection_gap_event', 'projection_one_annotation', 'projection_transcripts');
----
9	NULL	9	NULL	3	NULL	NULL	NULL

statement ok
CREATE TABLE projection_three AS SELECT * REPLACE(
  [exons[1], struct_pack(exon_start := 20::UBIGINT, exon_end := 21::UBIGINT,
    exon_cdna_start := 10::UBIGINT, exon_cdna_end := 11::UBIGINT,
    phase := -1::TINYINT, end_phase := -1::TINYINT),
   struct_pack(exon_start := 25::UBIGINT, exon_end := 30::UBIGINT,
    exon_cdna_start := 12::UBIGINT, exon_cdna_end := 17::UBIGINT,
    phase := -1::TINYINT, end_phase := -1::TINYINT)] AS exons) FROM projection_noncoding;

statement ok
CREATE TABLE projection_long_event AS SELECT * REPLACE(17::UBIGINT AS position,
  'CCAAAAAAGGG' AS reference, 'A' AS alternate) FROM projection_events WHERE event_index=1;

query IIIIIIII
SELECT cdna_start, cdna_end, exon_first, exon_last, exon_total,
  intron_first, intron_last, intron_total FROM duckvep_transcript_projection(
    'projection_long_event', 'projection_one_annotation', 'projection_three');
----
8	14	1	3	3	1	2	2

# An insertion directly after the CDS is wholly outside its coordinate map.
statement ok
CREATE TABLE projection_partial AS SELECT * REPLACE(29::UBIGINT AS cds_end,
  substring(decode(cds_sequence),1,14)::BLOB AS cds_sequence,
  35::UBIGINT AS transcript_flags) FROM projection_transcripts;

statement ok
CREATE TABLE projection_cds_end_event AS SELECT * REPLACE(29::UBIGINT AS position,
  'A' AS reference, 'AT' AS alternate) FROM projection_events WHERE event_index=1;

query IIIIIIT
SELECT cdna_start, cdna_end, cds_start, cds_end, protein_start, cds_end_nf::INTEGER,
  reference_codons FROM duckvep_transcript_projection(
    'projection_cds_end_event', 'projection_one_annotation', 'projection_partial');
----
14	15	NULL	NULL	NULL	1	NULL

# Pinned VEP 116, CDS ATGAAACCCGGGTT with no UTR: the first partial-codon
# insertion site has empty reference codons, while the internal site retains
# tt. The same transcript-oriented cases must agree on both strands.
statement ok
CREATE TABLE projection_partial_insertions AS SELECT
  (seq_region-1)::UINTEGER transcript_index, seq_region::UINTEGER seq_region,
  100::UBIGINT transcript_start, 113::UBIGINT transcript_end,
  strand::TINYINT strand, 0::UINTEGER gene_index, 35::UBIGINT transcript_flags,
  100::UBIGINT cds_start, 113::UBIGINT cds_end,
  'ATGAAACCCGGGTT'::BLOB cds_sequence, 1::UTINYINT codon_table,
  ''::BLOB pre_cds_sequence, ''::BLOB post_cds_sequence
FROM (VALUES (1,1), (2,-1)) t(seq_region,strand);

query I
SELECT loaded FROM duckvep_model_load('partial-insertions',
  'SELECT seq_region FROM projection_partial_insertions ORDER BY seq_region',
  'SELECT * FROM projection_partial_insertions ORDER BY seq_region',
  'SELECT transcript_index, 100::UBIGINT exon_start, 113::UBIGINT exon_end,
     1::UBIGINT exon_cdna_start, 14::UBIGINT exon_cdna_end,
     0::TINYINT phase, 2::TINYINT end_phase
   FROM projection_partial_insertions ORDER BY transcript_index');
----
true

query III
WITH cases(site,payload,terms) AS (VALUES
  (0,'TAG','incomplete_terminal_codon_variant&inframe_insertion&stop_gained'),
  (0,'TAGA','incomplete_terminal_codon_variant&inframe_insertion&stop_gained'),
  (1,'TAG','coding_sequence_variant&incomplete_terminal_codon_variant&inframe_insertion'),
  (1,'TAGA','incomplete_terminal_codon_variant&protein_altering_variant'),
  (1,'AGT','coding_sequence_variant&incomplete_terminal_codon_variant&stop_gained'),
  (1,'ATG','coding_sequence_variant&incomplete_terminal_codon_variant&inframe_insertion'),
  (1,'A','coding_sequence_variant&incomplete_terminal_codon_variant'),
  (1,'AC','coding_sequence_variant&incomplete_terminal_codon_variant&inframe_insertion')
), observed AS (
  SELECT terms, a.* FROM cases, projection_partial_insertions m,
  unnest(_duckvep_annotate_small_rich('partial-insertions', m.seq_region,
    (CASE WHEN strand=1 THEN 111+site ELSE 101-site END)::UBIGINT,
    CASE WHEN strand=1 THEN CASE WHEN site=0 THEN 'G' ELSE 'T' END ELSE 'A' END,
    CASE WHEN strand=1 THEN (CASE WHEN site=0 THEN 'G' ELSE 'T' END)||payload
      ELSE 'A'||seq_revcomp(payload) END, 0::UBIGINT)) u(a)
)
SELECT count(*), count(*) FILTER (WHERE status_code=0),
  count(*) FILTER (WHERE terms=(SELECT string_agg(s.consequence,'&' ORDER BY s.consequence)
    FROM duckvep_so_terms() s WHERE (observed.consequence_mask & s.consequence_mask)!=0))
FROM observed;
----
16	16	16

# One UTR base extends the requested ALT codon without extending the REF.
statement ok
UPDATE projection_partial_insertions SET transcript_end=114, post_cds_sequence='A'::BLOB
WHERE seq_region=1;

query I
SELECT loaded FROM duckvep_model_load('partial-insertions-utr',
  'SELECT seq_region FROM projection_partial_insertions WHERE seq_region=1',
  'SELECT * FROM projection_partial_insertions WHERE seq_region=1',
  'SELECT 0::UINTEGER transcript_index, 100::UBIGINT exon_start, 114::UBIGINT exon_end,
     1::UBIGINT exon_cdna_start, 15::UBIGINT exon_cdna_end,
     0::TINYINT phase, 2::TINYINT end_phase');
----
true

query TT
SELECT a.consequence, a.status
FROM unnest(_duckvep_annotate_small_rich('partial-insertions-utr',1::UINTEGER,
  112::UBIGINT,'T','TA',0::UBIGINT)) u(a);
----
inframe_insertion&incomplete_terminal_codon_variant&coding_sequence_variant	supported

statement ok
CREATE TABLE projection_invalid_code AS SELECT * REPLACE(255::UTINYINT AS codon_table)
FROM projection_transcripts;

statement error
SELECT * FROM duckvep_transcript_projection('projection_events', 'projection_annotations', 'projection_invalid_code');
----
unsupported genetic code

# Cold metadata joins must not multiply transcript rows or redefine VEP FLAGS.
statement ok
CREATE TABLE projection_cold AS SELECT 0::UINTEGER transcript_index,
  10 source_transcript_id, 20 source_gene_id, 'protein_coding' transcript_biotype,
  'NM_TEST.1' mane_select_refseq, 4096::UBIGINT transcript_flags;

statement ok
CREATE TABLE projection_gene AS SELECT 20 gene_id, 10 canonical_transcript_id;

statement ok
CREATE TABLE projection_attributes AS SELECT * FROM (VALUES
  (10,'CCDS1'),(10,'CCDS2'),(10,'CCDS1')) a(transcript_id,value);

query IIIIITT
WITH ccds AS (SELECT transcript_id, list(DISTINCT value ORDER BY value) ccds_ids
  FROM projection_attributes GROUP BY transcript_id)
SELECT p.event_index, (g.canonical_transcript_id=t.source_transcript_id)::INTEGER,
  p.cds_start_nf::INTEGER, p.cds_end_nf::INTEGER,
  ((t.transcript_flags & 4096)<>0)::INTEGER, t.mane_select_refseq,
  array_to_string(c.ccds_ids, ',')
FROM projection_result p LEFT JOIN projection_cold t USING(transcript_index)
LEFT JOIN projection_gene g ON g.gene_id=t.source_gene_id
LEFT JOIN ccds c ON c.transcript_id=t.source_transcript_id WHERE p.event_index=1;
----
1	1	0	0	1	NM_TEST.1	CCDS1,CCDS2

statement ok
CREATE TABLE projection_bad_events AS SELECT * FROM projection_events UNION ALL SELECT * FROM projection_events;

statement error
SELECT * FROM duckvep_transcript_projection('projection_bad_events', 'projection_annotations', 'projection_transcripts');
----
event_index must be unique

statement ok
CREATE OR REPLACE TABLE projection_bad_events AS SELECT * FROM projection_events WHERE event_index != 1;

statement error
SELECT * FROM duckvep_transcript_projection('projection_bad_events', 'projection_annotations', 'projection_transcripts');
----
annotation needs a source event

statement ok
CREATE OR REPLACE TABLE projection_bad_events AS SELECT * REPLACE(2::UINTEGER AS seq_region) FROM projection_events;

statement error
SELECT * FROM duckvep_transcript_projection('projection_bad_events', 'projection_annotations', 'projection_transcripts');
----
source region must match the model

statement ok
CREATE TABLE projection_bad_model AS SELECT * REPLACE(1::UINTEGER AS transcript_index) FROM projection_transcripts;

statement error
SELECT * FROM duckvep_transcript_projection('projection_events', 'projection_annotations', 'projection_bad_model');
----
annotation transcript and source region must match the model

statement ok
CREATE OR REPLACE TABLE projection_bad_model AS SELECT * FROM projection_transcripts UNION ALL SELECT * FROM projection_transcripts;

statement error
SELECT * FROM duckvep_transcript_projection('projection_events', 'projection_annotations', 'projection_bad_model');
----
transcript_index must be non-null and unique

# Multiple DuckDB vectors and workers must preserve the complete typed multiset.
statement ok
CREATE TABLE projection_many_events AS SELECT e.* REPLACE((event_index + 8*i)::UBIGINT AS event_index)
FROM projection_events e, range(600) r(i);

statement ok
CREATE TABLE projection_many_annotations AS SELECT a.* REPLACE((event_index + 8*i)::UBIGINT AS event_index)
FROM projection_annotations a, range(600) r(i);

statement ok
SET threads=1;

statement ok
CREATE TABLE projection_one_thread AS SELECT * FROM duckvep_transcript_projection(
  'projection_many_events', 'projection_many_annotations', 'projection_transcripts');

statement ok
SET threads=4;

query III
WITH expected AS (SELECT p.* REPLACE((event_index+8*i)::UBIGINT AS event_index)
  FROM projection_result p, range(600) r(i)), actual AS (
  SELECT * FROM duckvep_transcript_projection('projection_many_events', 'projection_many_annotations', 'projection_transcripts'))
SELECT (SELECT count(*) FROM actual),
  (SELECT count(*) FROM ((SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
    UNION ALL (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual))),
  (SELECT count(*) FROM ((SELECT * FROM actual EXCEPT ALL SELECT * FROM projection_one_thread)
    UNION ALL (SELECT * FROM projection_one_thread EXCEPT ALL SELECT * FROM actual)));
----
4800	0	0

statement ok
SET threads=1;

query I
SELECT duckvep_model_drop('projection');
----
true

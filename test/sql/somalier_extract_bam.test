# The panel is read from Parquet on a private in-memory instance, so the
# caller's relations are not a panel transport: panel_table is rejected.
statement error
SELECT * FROM duckhts_somalier_bam_counts(
  '__WORKING_DIRECTORY__/test/data/range.bam',
  'somalier_bam_panel', 'sample-1',
  '__WORKING_DIRECTORY__/test/data/ce.fa'
);
----
panel_table is no longer supported

statement error
SELECT * FROM duckhts_somalier_bam_counts(
  '__WORKING_DIRECTORY__/test/data/range.bam',
  NULL, 'sample-1',
  '__WORKING_DIRECTORY__/test/data/ce.fa'
);
----
panel_parquet is required

statement error
SELECT * FROM duckhts_somalier_bam_counts(
  '__WORKING_DIRECTORY__/test/data/range.bam',
  NULL, 'sample-1',
  '__WORKING_DIRECTORY__/test/data/ce.fa',
  panel_parquet := '__WORKING_DIRECTORY__/test_somalier_missing_panel.parquet'
);

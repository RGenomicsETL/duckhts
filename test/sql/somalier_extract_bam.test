test_somalier_missing_panel.parquet

# A panel that fails validation is reported by the private reader.
statement ok
COPY (SELECT * FROM somalier_bam_panel WHERE site_index > 0)
TO '__WORKING_DIRECTORY__/test_somalier_gap_panel.parquet' (FORMAT parquet);

statement error
SELECT * FROM duckhts_somalier_bam_counts(
  '__WORKING_DIRECTORY__/test/data/range.bam',
  NULL, 'sample-1',
  '__WORKING_DIRECTORY__/test/data/ce.fa',
  panel_parquet := '__WORKING_DIRECTORY__/test_somalier_gap_panel.parquet'
);
----
site_index must be unique and dense from zero

# A valid FAI does not turn a truncated reference read into biological
# unavailability: transport/read failure aborts extraction.
statement ok
COPY (VALUES ('>CHROMOSOME_I'), ('AAAAAAAAAA'))
TO '__WORKING_DIRECTORY__/test_somalier_truncated.fa'
  (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

statement ok
COPY (VALUES (E'CHROMOSOME_I\t1000\t14\t10\t11'))
TO '__WORKING_DIRECTORY__/test_somalier_truncated.fa.fai'
  (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

statement error
SELECT * FROM duckhts_somalier_bam_counts(
  '__WORKING_DIRECTORY__/test/data/range.bam',
  NULL, 'sample-1',
  '__WORKING_DIRECTORY__/test_somalier_truncated.fa',
  panel_parquet := '__WORKING_DIRECTORY__/test_somalier_bam_panel.parquet',
  index_path := '__WORKING_DIRECTORY__/test/data/range.bam.bai',
  reference_index_path := '__WORKING_DIRECTORY__/test_somalier_truncated.fa.fai'
);

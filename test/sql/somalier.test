# Retained aggregate identities have a fixed byte bound independent of the
# number of samples. The largest accepted identity and first rejected byte are
# checked directly on the production aggregate.
query I
SELECT length((__duckhts_somalier_sketch(
  repeat('s', 1024), repeat('a', 1024), repeat('b', 64),
  0::UBIGINT, 1::UBIGINT, 20::UBIGINT, 0::UBIGINT, 0::UBIGINT,
  7::UBIGINT, 0.3::DOUBLE, 0.01::DOUBLE, 1::UBIGINT)).sample_id);
----
1024

statement error
SELECT __duckhts_somalier_sketch(
  repeat('s', 1025), 'GRCh38', repeat('b', 64),
  0::UBIGINT, 1::UBIGINT, 20::UBIGINT, 0::UBIGINT, 0::UBIGINT,
  7::UBIGINT, 0.3::DOUBLE, 0.01::DOUBLE, 1::UBIGINT);
----
sample_id and assembly must be at most 1024 bytes

# Final mask word counts at the 64-bit transition, with a called last site.
statement ok
CREATE TEMP TABLE somalier_word_panel_all AS
SELECT n, 'GRCh38' AS assembly, i::UBIGINT AS site_index,
       'chr2' AS region, (1000 + i)::UBIGINT AS position,
       'A' AS allele_a, 'G' AS allele_b
FROM (VALUES (63::UBIGINT), (64::UBIGINT), (65::UBIGINT)) sizes(n),
     LATERAL range(n::BIGINT) sites(i);

statement ok
CREATE TEMP TABLE somalier_word_evidence_all AS
SELECT 'W' || n::VARCHAR AS sample_id, assembly, site_index,
       region, position, allele_a, allele_b,
       CASE WHEN site_index = n - 1 THEN 20 ELSE 0 END::UBIGINT AS a,
       0::UBIGINT AS b, 0::UBIGINT AS other, n
FROM somalier_word_panel_all;

statement ok
CREATE TEMP VIEW somalier_word_panel_63 AS
SELECT assembly, site_index, region, position, allele_a, allele_b
FROM somalier_word_panel_all WHERE n = 63;


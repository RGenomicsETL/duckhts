# A noncanonical panel is rejected; callers must transform count channels and
# population-B frequencies together before presenting a canonical panel.
statement ok
CREATE TEMP TABLE somalier_flipped_evidence AS
SELECT e.sample_id || '_F' AS sample_id, p.assembly, p.site_index,
       p.region, p.position, p.allele_a, p.allele_b,
       CASE WHEN e.site_index = 0 THEN e.b ELSE e.a END AS a,
       CASE WHEN e.site_index = 0 THEN e.a ELSE e.b END AS b,
       e.other
FROM somalier_evidence e
JOIN somalier_panel_flipped p USING (site_index)
WHERE e.sample_id IN ('A', 'B');

statement error
SELECT * FROM duckhts_somalier_prepare_sketches(
  'somalier_flipped_evidence', 'somalier_panel_flipped',
  7, 0.3, 0.01, max_sites := 8);

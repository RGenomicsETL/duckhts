statement ok
CREATE TEMP TABLE somalier_word_sizes AS
SELECT 63 AS n, sketch FROM duckhts_somalier_prepare_sketches(
  'somalier_word_evidence_63', 'somalier_word_panel_63',
  7, 0.3, 0.01, max_sites := 63)
UNION ALL
SELECT 64, sketch FROM duckhts_somalier_prepare_sketches(
  'somalier_word_evidence_64', 'somalier_word_panel_64',
  7, 0.3, 0.01, max_sites := 64)
UNION ALL
SELECT 65, sketch FROM duckhts_somalier_prepare_sketches(
  'somalier_word_evidence_65', 'somalier_word_panel_65',
  7, 0.3, 0.01, max_sites := 65);

query IIII
SELECT n, len(sketch.hom_a), len(sketch.het), len(sketch.hom_b)
FROM somalier_word_sizes ORDER BY n;
----
63	1	1	1
64	1	1	1
65	2	2	2

query III
SELECT n, sketch.hom_a[1], coalesce(sketch.hom_a[2], 0)
FROM somalier_word_sizes ORDER BY n;
----
63	4611686018427387904	0
64	9223372036854775808	0
65	0	1


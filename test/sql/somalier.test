query III
SELECT duckhts_somalier_verify_sketches(
         'somalier_word_evidence_63', 'somalier_word_panel_63',
         'somalier_word_sketch_63', 63),
       duckhts_somalier_verify_sketches(
         'somalier_word_evidence_64', 'somalier_word_panel_64',
         'somalier_word_sketch_64', 64),
       duckhts_somalier_verify_sketches(
         'somalier_word_evidence_65', 'somalier_word_panel_65',
         'somalier_word_sketch_65', 65);
----
1	1	1

# Parquet preserves typed sketch identity, word arrays, and pair output.
statement ok
COPY somalier_sketches TO '__WORKING_DIRECTORY__/test_somalier_sketches.parquet'
  (FORMAT PARQUET);

statement ok
CREATE TEMP VIEW somalier_persisted AS
SELECT * FROM read_parquet('__WORKING_DIRECTORY__/test_somalier_sketches.parquet');

query I
SELECT duckhts_somalier_verify_sketches(
  'somalier_evidence', 'somalier_panel_base', 'somalier_persisted', 8);
----
1

query I
WITH original AS (
  SELECT duckhts_somalier_relatedness(a.sketch, b.sketch, 8) AS pair
  FROM somalier_sketches a, somalier_sketches b
  WHERE a.sketch.sample_id = 'A' AND b.sketch.sample_id = 'B'
), persisted AS (
  SELECT duckhts_somalier_relatedness(a.sketch, b.sketch, 8) AS pair
  FROM somalier_persisted a, somalier_persisted b
  WHERE a.sketch.sample_id = 'A' AND b.sketch.sample_id = 'B'
)
SELECT count(*) FROM ((FROM original EXCEPT ALL FROM persisted)
 UNION ALL (FROM persisted EXCEPT ALL FROM original));
----
0

query I
SELECT count(*) FROM ((FROM somalier_sketches EXCEPT ALL FROM somalier_persisted)
 UNION ALL (FROM somalier_persisted EXCEPT ALL FROM somalier_sketches));
----
0

statement ok
CREATE TEMP TABLE somalier_pair_rows AS
SELECT pair FROM somalier_ab UNION ALL SELECT pair FROM somalier_zu;

statement ok
COPY somalier_pair_rows TO '__WORKING_DIRECTORY__/test_somalier_pairs.parquet'
  (FORMAT PARQUET);

query II
SELECT count(*) AS rows,
       count(*) FILTER (WHERE duckhts_somalier_verify_relatedness(
         r.pair, a.sketch, b.sketch, 8)) AS verified
FROM read_parquet('__WORKING_DIRECTORY__/test_somalier_pairs.parquet') r
JOIN somalier_persisted a ON a.sketch.sample_id = r.pair.sample_a
JOIN somalier_persisted b ON b.sketch.sample_id = r.pair.sample_b;
----
2	2

duplicate physical region and position

statement ok
CREATE TEMP TABLE somalier_evidence (
  sample_id VARCHAR, assembly VARCHAR, site_index UBIGINT,
  region VARCHAR, position UBIGINT, allele_a VARCHAR, allele_b VARCHAR,
  a UBIGINT, b UBIGINT, other UBIGINT
);

# Independently specified eight-site calls:
# site   0  1   2    3    4   5       6   7
# A      AA AA  AB   AB   BB  absent  BB  measured zero
# B      AA BB  AB   BB   BB  AA      AA  absent
# Z has eight measured zero-depth observations; U has eight unavailable ones.
statement ok
INSERT INTO somalier_evidence
SELECT sample_id, p.assembly, p.site_index, p.region, p.position,
       p.allele_a, p.allele_b, c.a, c.b, c.other
FROM (VALUES
  ('A', 0, 20, 0, 0), ('A', 1, 20, 0, 0),
  ('A', 2, 10, 10, 0), ('A', 3, 10, 10, 0),
  ('A', 4, 0, 20, 0), ('A', 5, NULL, NULL, NULL),
  ('A', 6, 0, 20, 0), ('A', 7, 0, 0, 0),
  ('B', 0, 20, 0, 0), ('B', 1, 0, 20, 0),
  ('B', 2, 10, 10, 0), ('B', 3, 0, 20, 0),
  ('B', 4, 0, 20, 0), ('B', 5, 20, 0, 0),
  ('B', 6, 20, 0, 0), ('B', 7, NULL, NULL, NULL)
) AS c(sample_id, site_index, a, b, other)
JOIN somalier_panel_base p USING (site_index);

statement ok
INSERT INTO somalier_evidence
SELECT 'Z', assembly, site_index, region, position, allele_a, allele_b,
       0::UBIGINT, 0::UBIGINT, 0::UBIGINT
FROM somalier_panel_base;

statement ok
INSERT INTO somalier_evidence
SELECT 'U', assembly, site_index, region, position, allele_a, allele_b,
       NULL::UBIGINT, NULL::UBIGINT, NULL::UBIGINT
FROM somalier_panel_base;

statement ok
CREATE TEMP TABLE somalier_sketches AS
SELECT * FROM duckhts_somalier_prepare_sketches(
  'somalier_evidence', 'somalier_panel_base',
  7, 0.3, 0.01, max_sites := 8);

# Persist the normalized settings used by the sealed identity. IEEE negative
# zero must not make a freshly constructed sketch fail its own digest check.
statement ok
CREATE TEMP TABLE somalier_negative_zero_sketches AS
SELECT * FROM duckhts_somalier_prepare_sketches(
  'somalier_evidence', 'somalier_panel_base',
  7, 0.3, -0.0::DOUBLE, max_sites := 8);

query III
SELECT duckhts_somalier_verify_sketches(
         'somalier_evidence', 'somalier_panel_base',
         'somalier_negative_zero_sketches', 8),
       count(*),
       sum(signbit(a.sketch.hom_balance_cutoff)::INTEGER)
FROM somalier_negative_zero_sketches a, somalier_negative_zero_sketches b
WHERE a.sketch.sample_id < b.sketch.sample_id
  AND duckhts_somalier_relatedness(a.sketch, b.sketch, 8).status IS NOT NULL;
----
1	6	0

query I
SELECT duckhts_somalier_verify_sketches(
  'somalier_evidence', 'somalier_panel_base', 'somalier_sketches', 8);
----
1

# Invalid persisted settings are corruption, not aggregate settings.
statement ok
CREATE TEMP VIEW somalier_invalid_settings AS
SELECT struct_update(sketch, min_depth := 0::UBIGINT) AS sketch
FROM somalier_sketches;

query I
SELECT duckhts_somalier_verify_sketches(
  'somalier_evidence', 'somalier_panel_base', 'somalier_invalid_settings', 8);
----
0

# The count receipt binds raw evidence even when the genotype mask is unchanged.
statement ok
CREATE TEMP VIEW somalier_changed_count AS
SELECT * REPLACE(CASE WHEN sample_id = 'A' AND site_index = 0
                      THEN 19::UBIGINT ELSE a END AS a)
FROM somalier_evidence;

query I
SELECT duckhts_somalier_verify_sketches(
  'somalier_changed_count', 'somalier_panel_base', 'somalier_sketches', 8);
----
0

statement ok
CREATE TEMP VIEW somalier_changed_availability AS
SELECT * REPLACE(CASE WHEN sample_id = 'Z' AND site_index = 0
                      THEN NULL::UBIGINT ELSE a END AS a,
                 CASE WHEN sample_id = 'Z' AND site_index = 0
                      THEN NULL::UBIGINT ELSE b END AS b,
                 CASE WHEN sample_id = 'Z' AND site_index = 0
                      THEN NULL::UBIGINT ELSE other END AS other)
FROM somalier_evidence;

query I
SELECT duckhts_somalier_verify_sketches(
  'somalier_changed_availability', 'somalier_panel_base', 'somalier_sketches', 8);
----
0


# Bit positions use zero-based site_index. The expected words are calculated
# directly from the truth table, not from another sketch implementation.
query TIIII
SELECT sketch.sample_id, sketch.hom_a[1], sketch.het[1],
       sketch.hom_b[1], sketch.unavailable_count
FROM somalier_sketches ORDER BY sketch.sample_id;
----
A	3	12	80	1
B	97	4	26	1
U	0	0	0	8
Z	0	0	0	0

statement ok
CREATE TEMP VIEW somalier_ab AS
SELECT duckhts_somalier_relatedness(a.sketch, b.sketch, 8) AS pair
FROM somalier_sketches a, somalier_sketches b
WHERE a.sketch.sample_id = 'A' AND b.sketch.sample_id = 'B';

# Jointly called sites are 0,1,2,3,4,6. IBS0 is 1 and 6; IBS2 is
# 0,2,4. The het denominator counts A's 2 and 3 plus B's 2.
query TTIIII
SELECT pair.sample_a, pair.sample_b, pair.jointly_called,
       pair.ibs0, pair.ibs2, pair.shared_hets
FROM somalier_ab;
----
A	B	6	2	3	1

query IIIIIIIIII
SELECT pair.het_ab, pair.shared_hom_b,
       pair.het_count_a, pair.het_count_b,
       pair.hom_b_count_a, pair.hom_b_count_b,
       pair.callable_hom_count_a, pair.callable_hom_count_b,
       pair.matching_hom_count, pair.site_count
FROM somalier_ab;
----
3	1	2	1	2	3	4	5	2	8

query TRRR
SELECT pair.status, pair.relatedness,
       pair.inferred_hom_concordance, pair.raw_hom_b_concordance
FROM somalier_ab;
----
ok	-2.0	0.5	-1.5

query TII
SELECT pair.status, pair.jointly_called,
       pair.unavailable_count_a + pair.unavailable_count_b
FROM (
  SELECT duckhts_somalier_relatedness(z.sketch, u.sketch, 8) AS pair
  FROM somalier_sketches z, somalier_sketches u
  WHERE z.sketch.sample_id = 'Z' AND u.sketch.sample_id = 'U'
);
----
no_evidence	0	8

query II
SELECT pair.relatedness IS NULL, pair.adjusted_concordance IS NULL
FROM (
  SELECT duckhts_somalier_relatedness(z.sketch, u.sketch, 8) AS pair
  FROM somalier_sketches z, somalier_sketches u
  WHERE z.sketch.sample_id = 'Z' AND u.sketch.sample_id = 'U'
);
----
1	1

statement ok
CREATE TEMP VIEW somalier_zu AS
SELECT duckhts_somalier_relatedness(z.sketch, u.sketch, 8) AS pair
FROM somalier_sketches z, somalier_sketches u
WHERE z.sketch.sample_id = 'Z' AND u.sketch.sample_id = 'U';

# The typed verifier checks pair identity, all counters and denominators,
# nullable status-dependent metrics, and the sealed sketch content.
query IIIIIIIII
SELECT duckhts_somalier_verify_relatedness(ab.pair, a.sketch, b.sketch, 8),
       duckhts_somalier_verify_relatedness(
         struct_update(ab.pair, ibs0 := 3::UBIGINT), a.sketch, b.sketch, 8),
       duckhts_somalier_verify_relatedness(
         struct_update(ab.pair, site_count := 7::UBIGINT), a.sketch, b.sketch, 8),
       duckhts_somalier_verify_relatedness(
         struct_update(ab.pair, relatedness := -1.5::DOUBLE), a.sketch, b.sketch, 8),
       duckhts_somalier_verify_relatedness(
         struct_update(ab.pair, relatedness := NULL::DOUBLE), a.sketch, b.sketch, 8),
       duckhts_somalier_verify_relatedness(
         struct_update(ab.pair, sample_a := 'B'), a.sketch, b.sketch, 8),
       duckhts_somalier_verify_relatedness(
         struct_update(ab.pair, method_version := 'wrong'), a.sketch, b.sketch, 8),
       duckhts_somalier_verify_relatedness(
         struct_update(ab.pair, status := 'no_evidence'), a.sketch, b.sketch, 8),
       duckhts_somalier_verify_relatedness(
         ab.pair, a.sketch,
         struct_update(b.sketch, content_digest_0 := 0::UBIGINT), 8)
FROM somalier_ab ab, somalier_sketches a, somalier_sketches b
WHERE a.sketch.sample_id = 'A' AND b.sketch.sample_id = 'B';
----
1	0	0	0	0	0	0	0	0

query IIIII
SELECT duckhts_somalier_verify_relatedness(
         struct_update(ab.pair, sample_b := 'A'), a.sketch, b.sketch, 8),
       duckhts_somalier_verify_relatedness(
         struct_update(ab.pair, assembly := 'GRCh37'), a.sketch, b.sketch, 8),
       duckhts_somalier_verify_relatedness(
         struct_update(ab.pair, panel_sha256 := repeat('b', 64)),
         a.sketch, b.sketch, 8),
       duckhts_somalier_verify_relatedness(
         struct_update(ab.pair, middling_balance_count_a :=
           ab.pair.middling_balance_count_a + 1::UBIGINT), a.sketch, b.sketch, 8),
       duckhts_somalier_verify_relatedness(
         struct_update(ab.pair, unavailable_count_b :=
           ab.pair.unavailable_count_b + 1::UBIGINT), a.sketch, b.sketch, 8)
FROM somalier_ab ab, somalier_sketches a, somalier_sketches b
WHERE a.sketch.sample_id = 'A' AND b.sketch.sample_id = 'B';
----
0	0	0	0	0

query IIIII
SELECT duckhts_somalier_verify_relatedness(zu.pair, z.sketch, u.sketch, 8),
       duckhts_somalier_verify_relatedness(
         struct_update(zu.pair, jointly_called := 1::UBIGINT), z.sketch, u.sketch, 8),
       duckhts_somalier_verify_relatedness(
         struct_update(zu.pair, relatedness := 0.0::DOUBLE), z.sketch, u.sketch, 8),
       duckhts_somalier_verify_relatedness(
         struct_update(zu.pair, status := 'ok'), z.sketch, u.sketch, 8),
       duckhts_somalier_verify_relatedness(
         zu.pair, z.sketch, u.sketch, 7)
FROM somalier_zu zu, somalier_sketches z, somalier_sketches u
WHERE z.sketch.sample_id = 'Z' AND u.sketch.sample_id = 'U';
----
1	0	0	0	0

# A selected-pair relation avoids asking the adapter to construct all pairs.
statement ok
CREATE TEMP TABLE somalier_selected_pairs(sample_a VARCHAR, sample_b VARCHAR);

statement ok
INSERT INTO somalier_selected_pairs VALUES ('A', 'B'), ('Z', 'U');

query TTI
SELECT p.sample_a, p.sample_b, r.jointly_called
FROM somalier_selected_pairs p
JOIN somalier_sketches a ON a.sketch.sample_id = p.sample_a
JOIN somalier_sketches b ON b.sketch.sample_id = p.sample_b,
LATERAL (SELECT duckhts_somalier_relatedness(a.sketch, b.sketch, 8) AS r)
ORDER BY p.sample_a;
----
A	B	6
Z	U	0


# name: test/sql/bcftools_norm.test
# description: Test bcftools-style allele normalization macro and scalar
# group: [duckhts]

require duckhts

statement ok
CREATE OR REPLACE TEMP TABLE norm_seq AS
SELECT *
FROM (VALUES
  ('chrS', 2, 'T', 'TT,TTT'),
  ('chrS', 2, 'TT', 'T,TTT'),
  ('chrMissing', 2, 'T', 'TT')
) AS t(chrom, pos, ref, alt);

statement ok
CREATE OR REPLACE TEMP TABLE norm_list AS
SELECT *
FROM (VALUES
  ('chrS', 2, 'T', ['TT', 'TTT'])
) AS t(chrom, pos, ref, alt);

statement ok
CREATE OR REPLACE TEMP TABLE norm_sv AS
SELECT *
FROM (VALUES
  ('chrS', 2, 'T', '<DEL>', 3, NULL),
  ('chrS', 3, 'T', '<DUP>', NULL, 2)
) AS t(chrom, pos, ref, alt, end_pos, svlen);

statement ok
CREATE OR REPLACE TEMP TABLE norm_spanning AS
SELECT *
FROM (VALUES
  ('chrS', 2, 'T', '*,TT')
) AS t(chrom, pos, ref, alt);

statement ok
CREATE OR REPLACE TEMP TABLE norm_gvcf AS
SELECT *
FROM (VALUES
  ('band_non_ref', 'chrS', 2, 'T', '<NON_REF>', 6::BIGINT),
  ('mixed_non_ref', 'chrS', 2, 'T', 'TT,<NON_REF>', NULL::BIGINT),
  ('mixed_non_ref_band', 'chrS', 2, 'T', 'TT,<NON_REF>', 6::BIGINT),
  ('mixed_symbolic_star', 'chrS', 2, 'T', 'TT,<*>', NULL::BIGINT),
  ('star_only', 'chrS', 2, 'T', '*', NULL::BIGINT)
) AS t(case_id, chrom, pos, ref, alt, end_pos);

statement ok
CREATE OR REPLACE TEMP TABLE norm_fast_path AS
SELECT *
FROM (VALUES
  ('plain_mnv_left_trim', 'chrS', 2, 'TT', 'TC', 6::BIGINT),
  ('plain_mnv_no_common_head', 'chrS', 2, 'TT', 'CC', 6::BIGINT),
  ('plain_snv_explicit_end', 'chrS', 2, 'T', 'C', 6::BIGINT)
) AS t(case_id, chrom, pos, ref, alt, end_pos);

statement ok
CREATE OR REPLACE TEMP TABLE norm_empty_seq AS
SELECT *
FROM (VALUES
  ('dot', 'chrS', 2, 'T', '.'),
  ('empty_text', 'chrS', 2, 'T', ''),
  ('null_text', 'chrS', 2, 'T', NULL)
) AS t(case_id, chrom, pos, ref, alt);

statement ok
CREATE OR REPLACE TEMP TABLE norm_empty_list AS
SELECT *
FROM (VALUES
  ('empty_list', 'chrS', 2, 'T', []::VARCHAR[]),
  ('null_item', 'chrS', 2, 'T', [NULL]::VARCHAR[]),
  ('null_list', 'chrS', 2, 'T', NULL::VARCHAR[])
) AS t(case_id, chrom, pos, ref, alt);

query T
SELECT typeof(alt_normed)
FROM duckhts_bcftools_norm('norm_seq', '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa')
LIMIT 1;
----
VARCHAR[]

query T
SELECT typeof(alt_normed)
FROM duckhts_bcftools_norm(
  'norm_seq',
  '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa',
  split_multiallelic := true
)
LIMIT 1;
----
VARCHAR

query IITTIT
SELECT pos_normed,
       end_pos_normed,
       ref_normed,
       alt_normed::VARCHAR,
       CASE WHEN normed THEN 1 WHEN normed IS NULL THEN NULL ELSE 0 END,
       norm_status
FROM duckhts_bcftools_norm('norm_seq', '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa')
WHERE ref = 'T' AND alt = 'TT,TTT';
----
1	1	G	[GT, GTT]	1	Normalized

query IITTITR
SELECT pos_normed,
       end_pos_normed,
       ref_normed,
       alt_normed,
       CASE WHEN normed THEN 1 WHEN normed IS NULL THEN NULL ELSE 0 END,
       norm_status,
       alt_index
FROM duckhts_bcftools_norm(
  'norm_seq',
  '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa',
  split_multiallelic := true
)
WHERE ref = 'T' AND alt = 'TT,TTT'
ORDER BY alt_index;
----
1	1	G	GT	1	Normalized	1
1	1	G	GTT	1	Normalized	2

query IITTITR
SELECT pos_normed,
       end_pos_normed,
       ref_normed,
       alt_normed,
       CASE WHEN normed THEN 1 WHEN normed IS NULL THEN NULL ELSE 0 END,
       norm_status,
       alt_index
FROM duckhts_bcftools_norm(
  'norm_seq',
  '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa',
  split_multiallelic := true
)
WHERE ref = 'TT' AND alt = 'T,TTT'
ORDER BY alt_index;
----
1	2	GT	G	1	Normalized	1
1	1	G	GT	1	Normalized	2

query ITTIT
SELECT pos_normed,
       ref_normed,
       alt_normed::VARCHAR,
       CASE WHEN normed THEN 1 WHEN normed IS NULL THEN NULL ELSE 0 END,
       norm_status
FROM duckhts_bcftools_norm('norm_list', '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa');
----
1	G	[GT, GTT]	1	Normalized

query IITTIT
SELECT pos_normed,
       end_pos_normed,
       ref_normed,
       alt_normed::VARCHAR,
       CASE WHEN normed THEN 1 WHEN normed IS NULL THEN NULL ELSE 0 END,
       norm_status
FROM duckhts_bcftools_norm(
  'norm_sv',
  '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa',
  end_pos_col := 'end_pos',
  svlen_col := 'svlen'
)
WHERE alt = '<DEL>';
----
1	2	G	[<DEL>]	1	Normalized

query IITTIT
SELECT pos_normed,
       end_pos_normed,
       ref_normed,
       alt_normed::VARCHAR,
       CASE WHEN normed THEN 1 WHEN normed IS NULL THEN NULL ELSE 0 END,
       norm_status
FROM duckhts_bcftools_norm(
  'norm_sv',
  '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa',
  end_pos_col := 'end_pos',
  svlen_col := 'svlen'
)
WHERE alt = '<DUP>';
----
1	1	G	[<DUP>]	1	Normalized

query IITTIT
SELECT pos_normed,
       end_pos_normed,
       ref_normed,
       alt_normed::VARCHAR,
       CASE WHEN normed THEN 1 WHEN normed IS NULL THEN NULL ELSE 0 END,
       norm_status
FROM duckhts_bcftools_norm('norm_seq', '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa')
WHERE chrom = 'chrMissing';
----
2	2	T	[TT]	NULL	MissingContig

query IITTIT
SELECT pos_normed,
       end_pos_normed,
       ref_normed,
       alt_normed::VARCHAR,
       CASE WHEN normed THEN 1 WHEN normed IS NULL THEN NULL ELSE 0 END,
       norm_status
FROM duckhts_bcftools_norm('norm_spanning', '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa');
----
1	1	G	[*, GT]	1	Normalized

query TIITTIT
SELECT case_id,
       pos_normed,
       end_pos_normed,
       ref_normed,
       alt_normed::VARCHAR,
       CASE WHEN normed THEN 1 WHEN normed IS NULL THEN NULL ELSE 0 END,
       norm_status
FROM duckhts_bcftools_norm(
  'norm_gvcf',
  '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa',
  end_pos_col := 'end_pos'
)
ORDER BY case_id;
----
band_non_ref	2	6	T	[<NON_REF>]	0	GVCFReferenceBlock
mixed_non_ref	1	1	G	[GT, <NON_REF>]	1	Normalized
mixed_non_ref_band	1	6	G	[GT, <NON_REF>]	1	Normalized
mixed_symbolic_star	1	1	G	[GT, <*>]	1	Normalized
star_only	2	2	T	[*]	NULL	SpanningDeletion

query TIITTIT
SELECT case_id,
       pos_normed,
       end_pos_normed,
       ref_normed,
       alt_normed::VARCHAR,
       CASE WHEN normed THEN 1 WHEN normed IS NULL THEN NULL ELSE 0 END,
       norm_status
FROM duckhts_bcftools_norm(
  'norm_fast_path',
  '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa',
  end_pos_col := 'end_pos'
)
ORDER BY case_id;
----
plain_mnv_left_trim	3	3	T	[C]	1	Normalized
plain_mnv_no_common_head	2	3	TT	[CC]	0	Unchanged
plain_snv_explicit_end	2	2	T	[C]	0	Unchanged

query TIITTITR
SELECT case_id,
       pos_normed,
       end_pos_normed,
       ref_normed,
       alt_normed,
       CASE WHEN normed THEN 1 WHEN normed IS NULL THEN NULL ELSE 0 END,
       norm_status,
       alt_index
FROM duckhts_bcftools_norm(
  'norm_gvcf',
  '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa',
  split_multiallelic := true,
  end_pos_col := 'end_pos'
)
WHERE case_id IN ('mixed_non_ref', 'mixed_non_ref_band', 'mixed_symbolic_star')
ORDER BY case_id, alt_index;
----
mixed_non_ref	1	1	G	GT	1	Normalized	1
mixed_non_ref	2	2	T	<NON_REF>	0	GVCFReferenceBlock	2
mixed_non_ref_band	1	1	G	GT	1	Normalized	1
mixed_non_ref_band	2	6	T	<NON_REF>	0	GVCFReferenceBlock	2
mixed_symbolic_star	1	1	G	GT	1	Normalized	1
mixed_symbolic_star	2	2	T	<*>	0	GVCFReferenceBlock	2

query IITTITR
SELECT pos_normed,
       end_pos_normed,
       ref_normed,
       alt_normed,
       CASE WHEN normed THEN 1 WHEN normed IS NULL THEN NULL ELSE 0 END,
       norm_status,
       alt_index
FROM duckhts_bcftools_norm(
  'norm_spanning',
  '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa',
  split_multiallelic := true
)
ORDER BY alt_index;
----
2	2	T	*	NULL	SpanningDeletion	1
1	1	G	GT	1	Normalized	2

query I
SELECT count(*)
FROM duckhts_bcftools_norm(
  'norm_empty_seq',
  '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa',
  split_multiallelic := true
);
----
3

query I
SELECT count(*)
FROM duckhts_bcftools_norm(
  'norm_empty_list',
  '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa',
  split_multiallelic := true
);
----
3

query TIIIT
SELECT case_id,
       CASE WHEN alt_normed IS NULL THEN 'NULL' ELSE cast(length(alt_normed) AS VARCHAR) END,
       CASE WHEN normed THEN 1 WHEN normed IS NULL THEN NULL ELSE 0 END,
       coalesce(alt_index, -1),
       norm_status
FROM duckhts_bcftools_norm(
  'norm_empty_seq',
  '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa',
  split_multiallelic := true
)
ORDER BY case_id;
----
dot	NULL	0	-1	RefOnly
empty_text	0	NULL	1	NullInput
null_text	NULL	0	-1	RefOnly

query TIIIT
SELECT case_id,
       CASE WHEN alt_normed IS NULL THEN 'NULL' ELSE cast(length(alt_normed) AS VARCHAR) END,
       CASE WHEN normed THEN 1 WHEN normed IS NULL THEN NULL ELSE 0 END,
       coalesce(alt_index, -1),
       norm_status
FROM duckhts_bcftools_norm(
  'norm_empty_list',
  '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa',
  split_multiallelic := true
)
ORDER BY case_id;
----
empty_list	NULL	0	-1	RefOnly
null_item	NULL	NULL	1	NullInput
null_list	NULL	0	-1	RefOnly

statement ok
CREATE OR REPLACE TEMP TABLE norm_shadow_text AS
SELECT *
FROM (VALUES
  ('keep_text', 'chrS', 2, 'T', 'TT', 'user_norm', 'user_item', 99)
) AS t(case_id, chrom, pos, ref, alt, __duckhts_norm, __duckhts_alt_item, __duckhts_alt_index);

query TITT
SELECT __duckhts_norm,
       pos_normed,
       ref_normed,
       alt_normed::VARCHAR
FROM duckhts_bcftools_norm('norm_shadow_text', '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa')
ORDER BY case_id;
----
user_norm	1	G	[GT]

query TIITTR
SELECT __duckhts_alt_item,
       __duckhts_alt_index,
       pos_normed,
       ref_normed,
       alt_normed,
       alt_index
FROM duckhts_bcftools_norm(
  'norm_shadow_text',
  '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa',
  split_multiallelic := true
)
ORDER BY case_id;
----
user_item	99	1	G	GT	1

statement ok
CREATE OR REPLACE TEMP TABLE norm_shadow_helpers AS
SELECT *
FROM (VALUES
  ('chrS', 2, 'T', 'TT', 'bad_contig', 999, 'BADREF', 'BADALT', 123, 456)
) AS t(chrom, pos, ref, alt, __duckhts_chrom, __duckhts_pos, __duckhts_ref, __duckhts_alt, __duckhts_end_pos, __duckhts_svlen);

query TITTIIITTT
SELECT __duckhts_chrom,
       __duckhts_pos,
       __duckhts_ref,
       __duckhts_alt,
       __duckhts_end_pos,
       __duckhts_svlen,
       pos_normed,
       ref_normed,
       alt_normed::VARCHAR,
       norm_status
FROM duckhts_bcftools_norm('norm_shadow_helpers', '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa');
----
bad_contig	999	BADREF	BADALT	123	456	1	G	[GT]	Normalized

query TIITTR
SELECT __duckhts_chrom,
       __duckhts_pos,
       pos_normed,
       ref_normed,
       alt_normed,
       alt_index
FROM duckhts_bcftools_norm(
  'norm_shadow_helpers',
  '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa',
  split_multiallelic := true
);
----
bad_contig	999	1	G	GT	1

statement ok
CREATE OR REPLACE TEMP TABLE norm_shadow_struct AS
SELECT *
FROM (VALUES
  ('chrS', 2, 'T', 'TT', struct_pack(pos_normed := 999::BIGINT, end_pos_normed := 999::BIGINT, ref_normed := 'BAD', alt_normed := ['BAD'], normed := false, norm_status := 'BAD'))
) AS t(chrom, pos, ref, alt, __duckhts_norm);

query IITT
SELECT __duckhts_norm.pos_normed,
       pos_normed,
       ref_normed,
       alt_normed::VARCHAR
FROM duckhts_bcftools_norm('norm_shadow_struct', '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa');
----
999	1	G	[GT]

statement ok
CREATE OR REPLACE TEMP TABLE norm_shadow_outputs AS
SELECT *
FROM (VALUES
  ('chrS', 2, 'T', 'TT', 900::BIGINT, 901::BIGINT, 'USER_REF', ['USER_ALT']::VARCHAR[], false, 'USER_STATUS', 99::BIGINT)
) AS t(chrom, pos, ref, alt, pos_normed, end_pos_normed, ref_normed, alt_normed, normed, norm_status, alt_index);

query IIIIIITTTTTT
SELECT pos_normed,
       pos_normed_1,
       end_pos_normed,
       end_pos_normed_1,
       CASE WHEN normed THEN 1 WHEN normed IS NULL THEN NULL ELSE 0 END,
       CASE WHEN normed_1 THEN 1 WHEN normed_1 IS NULL THEN NULL ELSE 0 END,
       ref_normed,
       ref_normed_1,
       alt_normed::VARCHAR,
       alt_normed_1::VARCHAR,
       norm_status,
       norm_status_1
FROM duckhts_bcftools_norm('norm_shadow_outputs', '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa');
----
900	1	901	1	0	1	USER_REF	G	[USER_ALT]	[GT]	USER_STATUS	Normalized

query IIIIIIIITTTT
SELECT alt_index,
       alt_index_1,
       pos_normed,
       pos_normed_1,
       end_pos_normed,
       end_pos_normed_1,
       CASE WHEN normed THEN 1 WHEN normed IS NULL THEN NULL ELSE 0 END,
       CASE WHEN normed_1 THEN 1 WHEN normed_1 IS NULL THEN NULL ELSE 0 END,
       alt_normed::VARCHAR,
       alt_normed_1,
       norm_status,
       norm_status_1
FROM duckhts_bcftools_norm(
  'norm_shadow_outputs',
  '__WORKING_DIRECTORY__/test/data/liftover_repeat_src.fa',
  split_multiallelic := true
);
----
99	1	900	1	901	1	0	1	[USER_ALT]	GT	USER_STATUS	Normalized

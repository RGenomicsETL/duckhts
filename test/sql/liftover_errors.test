# name: test/sql/liftover_errors.test
# description: Test liftover error propagation and validation
# group: [duckhts]

require duckhts

statement error
SELECT bcftools_liftover(
  'chrF', 2, 'C', 'T',
  '__WORKING_DIRECTORY__/test/data/does_not_exist.chain',
  '__WORKING_DIRECTORY__/test/data/liftover_dst.fa',
  '__WORKING_DIRECTORY__/test/data/liftover_src.fa',
   1, 250, false, NULL::BIGINT, false
);
----
Invalid Input Error: bcftools_liftover: failed to load chain or FASTA context

statement error
SELECT (bcftools_liftover(
  NULL, 2, 'C', 'T',
  '__WORKING_DIRECTORY__/test/data/liftover.chain',
  '__WORKING_DIRECTORY__/test/data/liftover_dst.fa',
  '__WORKING_DIRECTORY__/test/data/liftover_src.fa',
  1, 250, false, NULL::BIGINT, false
)).src_pos;
----
Invalid Input Error: bcftools_liftover: chrom must be non-null


# name: test/sql/count_mixture_lowpass.test
# description: Low-pass moment QC, admission, exact matching and deterministic block fits.

require duckhts

statement ok
CREATE TABLE lowpass(sample_id VARCHAR, candidate VARCHAR, chrom VARCHAR, pos BIGINT,
                     ref_count BIGINT, alt_count BIGINT, other_count BIGINT,
                     sample_af DOUBLE, candidate_af DOUBLE);

statement ok
INSERT INTO lowpass VALUES
('s','other','20',1,2,1,1,.25,.75),
('s','other','20',2,0,2,2,.5,.25),
('s','other','20',3,1,0,3,0,1),
('s','other','20',4,0,0,4,1,0),
('s','other','20',5,10,0,5,.5,.25),
('s','other','20',6,NULL,NULL,6,.5,.5);

statement ok
INSERT INTO lowpass SELECT sample_id,'matched',chrom,pos,ref_count,alt_count,other_count,sample_af,sample_af FROM lowpass;

query TTTIIIIIIIIIIII
SELECT candidate,relationship_model,status,sites,usable_sites,zero_depth_sites,singleton_sites,
reads,other_reads,positive_pair_sites,excluded_sites,unavailable_sites,
concordant_ref_pairs,discordant_pairs,concordant_alt_pairs FROM
 duckhts_count_mixture_lowpass('lowpass',0,0,0,block_bases:=2)
ORDER BY candidate,relationship_model;
----
matched	ibd1	insufficient_blocks	6	4	1	1	6	21	2	1	1	1	2	1
matched	unrelated	insufficient_blocks	6	4	1	1	6	21	2	1	1	1	2	1
other	unrelated	insufficient_blocks	6	4	1	1	6	21	2	1	1	1	2	1

query I
SELECT bool_and(pair_denominator=.8125 AND abs(discordance_ratio-32.0/13)<1e-12
 AND share IS NOT NULL AND share_lower IS NULL AND share_upper IS NULL)
FROM duckhts_count_mixture_lowpass('lowpass',0,0,0,block_bases:=2);
----
true

# Blocks use 1-based positions, restart per contig, and are shared by candidates.
statement ok
CREATE TABLE block_edges AS
SELECT 'blocks' AS sample_id, candidate, chrom, pos, 1 AS ref_count, 1 AS alt_count,
0 AS other_count, 0.2 AS sample_af, 0.2 AS candidate_af
FROM (VALUES ('1', 1), ('1', 16), ('1', 17), ('1', 32), ('1', 33),
             ('2', 1), ('2', 17)) s(chrom, pos)
CROSS JOIN (VALUES ('one'), ('two')) c(candidate);

query III
SELECT min(blocks), max(blocks), count(*)
FROM duckhts_count_mixture_lowpass('block_edges', seq_error := 0.01,
  artefact_weight := 0.02, homozygosity_excess := 0, block_bases := 16, min_blocks := 2);
----
5	5	4

# A one-ulp-scale difference is not a matched frequency, including a zero-read site.
statement ok
CREATE TABLE almost AS SELECT * REPLACE ('almost' AS candidate,
CASE WHEN pos=4 THEN sample_af-1e-15 ELSE sample_af END AS candidate_af) FROM lowpass WHERE candidate='matched';

query I
SELECT count(*) FROM duckhts_count_mixture_lowpass('almost',0,0,0);
----
1

statement ok
SET threads=1;

statement ok
CREATE TABLE lowpass_one AS SELECT * FROM duckhts_count_mixture_lowpass('lowpass',.01,.02,.1,block_bases:=2,min_blocks:=2);

statement ok
SET threads=4;

query I
SELECT count(*) FROM ((SELECT * FROM lowpass_one EXCEPT ALL SELECT * FROM duckhts_count_mixture_lowpass('lowpass',.01,.02,.1,block_bases:=2,min_blocks:=2)) UNION ALL
(SELECT * FROM duckhts_count_mixture_lowpass('lowpass',.01,.02,.1,block_bases:=2,min_blocks:=2) EXCEPT ALL SELECT * FROM lowpass_one));
----
0

statement ok
CREATE TABLE empty_sample AS SELECT * REPLACE (0::BIGINT AS ref_count,0::BIGINT AS alt_count) FROM lowpass WHERE candidate='matched';

query TTII
SELECT relationship_model,status,reads,share IS NULL FROM duckhts_count_mixture_lowpass('empty_sample',0,0,0) ORDER BY relationship_model;
----
ibd1	no_sites	0	true
unrelated	no_sites	0	true

statement ok
CREATE TABLE no_rows AS SELECT * FROM lowpass WHERE false;

query I
SELECT count(*) FROM duckhts_count_mixture_lowpass('no_rows',0,0,0);
----
0


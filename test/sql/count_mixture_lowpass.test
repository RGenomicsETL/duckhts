statement ok
CREATE TABLE duplicate AS SELECT * FROM lowpass UNION ALL SELECT * FROM lowpass WHERE pos=1;

statement error
SELECT * FROM duckhts_count_mixture_lowpass('duplicate',0,0,0);
----
duplicate site keys

statement ok
CREATE TABLE negative AS SELECT * REPLACE (-1::BIGINT AS other_count) FROM lowpass;

statement error
SELECT * FROM duckhts_count_mixture_lowpass('negative',0,0,0);
----
read counts must not be negative

statement ok
CREATE TABLE inconsistent AS SELECT * REPLACE (CASE WHEN candidate='other' THEN .4 ELSE sample_af END AS sample_af) FROM lowpass;

statement error
SELECT * FROM duckhts_count_mixture_lowpass('inconsistent',0,0,0);
----
must agree

statement ok
CREATE TABLE invalid_af AS SELECT * REPLACE (2::DOUBLE AS candidate_af) FROM lowpass;

statement error
SELECT * FROM duckhts_count_mixture_lowpass('invalid_af',0,0,0);
----
frequencies must be finite

statement ok
CREATE TABLE missing_candidate AS SELECT * FROM lowpass WHERE NOT (candidate='other' AND pos=1);

query III
SELECT count(*),min(usable_sites),max(usable_sites) FROM duckhts_count_mixture_lowpass('missing_candidate',0,0,0);
----
3	3	3

# Vector-sized input exercises exact block sums across worker counts and
# reversed site storage. The entire conditional result is reproducible.
statement ok
CREATE TABLE parallel_lowpass AS SELECT 'parallel' AS sample_id,cand AS candidate,'20' AS chrom,
i AS pos, (1+(i%3=0)::BIGINT) AS ref_count, (i%7=0)::BIGINT AS alt_count,
0::BIGINT AS other_count, (1+i%37)/39.0 AS sample_af,
CASE WHEN cand='matched' THEN (1+i%37)/39.0 ELSE (1+(i*13)%37)/39.0 END AS candidate_af
FROM range(1,32769) t(i) CROSS JOIN (VALUES ('matched'),('other')) c(cand) ORDER BY i DESC,cand;

statement ok
SET threads=1;

statement ok
CREATE TABLE parallel_one AS SELECT * FROM duckhts_count_mixture_lowpass('parallel_lowpass',.01,.02,0,block_bases:=1024);

statement ok
SET threads=4;

query I
SELECT count(*) FROM ((SELECT * FROM parallel_one EXCEPT ALL SELECT * FROM duckhts_count_mixture_lowpass('parallel_lowpass',.01,.02,0,block_bases:=1024)) UNION ALL
(SELECT * FROM duckhts_count_mixture_lowpass('parallel_lowpass',.01,.02,0,block_bases:=1024) EXCEPT ALL SELECT * FROM parallel_one));
----
0

statement ok
DROP TABLE parallel_one;

statement ok
DROP TABLE parallel_lowpass;

statement ok

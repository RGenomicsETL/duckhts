statement ok
COPY (SELECT '@HD' || chr(9) || 'VN:1.6' || chr(10) || repeat('a', 240) || 'FIRST' || chr(9) || '4' || chr(9) || '*' || chr(9) || '0' || chr(9) || '0' || chr(9) || '*' || chr(9) || '*' || chr(9) || '0' || chr(9) || '0' || chr(9) || 'A' || chr(9) || 'I') TO '__WORKING_DIRECTORY__/test/sql/diagnostic_first.sam' (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

statement ok
COPY (SELECT '@HD' || chr(9) || 'VN:1.6' || chr(10) || repeat('b', 240) || 'SECOND' || chr(9) || '4' || chr(9) || '*' || chr(9) || '0' || chr(9) || '0' || chr(9) || '*' || chr(9) || '*' || chr(9) || '0' || chr(9) || '0' || chr(9) || 'A' || chr(9) || 'I') TO '__WORKING_DIRECTORY__/test/sql/diagnostic_second.sam' (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

statement error
SELECT * FROM read_fastq('__WORKING_DIRECTORY__/test/sql/diagnostic_first.sam', mate_path := '__WORKING_DIRECTORY__/test/sql/diagnostic_second.sam');
----
<REGEX>:.*read_fastq: mate files out of sync.*QNAME mismatch: 'a{240}FIRST' vs 'b{240}SECOND'.*diagnostic_first.sam.*diagnostic_second.sam.*


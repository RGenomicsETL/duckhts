# name: test/sql/munge_errors.test
# description: Test munge error propagation and validation
# group: [duckhts]

require duckhts

statement error
SELECT (bcftools_munge_row(
  NULL, 2, 'A', 'C', 'rs1',
  NULL, NULL, NULL, NULL,
  NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
  '__WORKING_DIRECTORY__/test/data/liftover_src.fa', 'IFFY', 'REF_MISMATCH', NULL, NULL, NULL
)).chrom;
----
Invalid Input Error: bcftools_munge_row: chrom must be non-null

statement error
SELECT (bcftools_munge_row(
  '', 2, 'A', 'C', 'rs1',
  NULL, NULL, NULL, NULL,
  NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
  '__WORKING_DIRECTORY__/test/data/liftover_src.fa', 'IFFY', 'REF_MISMATCH', NULL, NULL, NULL
)).chrom;
----
Invalid Input Error: bcftools_munge_row: chrom must be non-empty

statement error

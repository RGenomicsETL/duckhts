# name: test/sql/munge_errors.test
# description: Test munge error propagation and validation
# group: [duckhts]

require duckhts

statement error
SELECT (bcftools_munge_row(
  NULL, 2, 'A', 'C', 'rs1',
  NULL, NULL, NULL, NULL,
  NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
  '__WORKING_DIRECTORY__/test/data/liftover_src.fa', 'IFFY', 'REF_MISMATCH', NULL, NULL, NULL
)).chrom;
----
Invalid Input Error: bcftools_munge_row: chrom must be non-null

statement error
SELECT (bcftools_munge_row(
  '', 2, 'A', 'C', 'rs1',
  NULL, NULL, NULL, NULL,
  NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
  '__WORKING_DIRECTORY__/test/data/liftover_src.fa', 'IFFY', 'REF_MISMATCH', NULL, NULL, NULL
)).chrom;
----
Invalid Input Error: bcftools_munge_row: chrom must be non-empty

statement error
SELECT (bcftools_munge_row(
  'chrF', 0, 'A', 'C', 'rs1',
  NULL, NULL, NULL, NULL,
  NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
  '__WORKING_DIRECTORY__/test/data/liftover_src.fa', 'IFFY', 'REF_MISMATCH', NULL, NULL, NULL
)).pos;
----
Invalid Input Error: bcftools_munge_row: pos must be >= 1

statement error
SELECT (bcftools_munge_row(
  'chrF', 2, NULL, 'C', 'rs1',
  NULL, NULL, NULL, NULL,
  NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
  '__WORKING_DIRECTORY__/test/data/liftover_src.fa', 'IFFY', 'REF_MISMATCH', NULL, NULL, NULL
)).chrom;
----
Invalid Input Error: bcftools_munge_row: a1 and a2 must be non-null

statement error
SELECT (bcftools_munge_row(
  'chrF', 2, 'A', 'C', 'rs1',
  NULL, NULL, NULL, NULL,
  NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
  '__WORKING_DIRECTORY__/test/data/does_not_exist.fa', 'IFFY', 'REF_MISMATCH', NULL, NULL, NULL
)).chrom;
----
Invalid Input Error: bcftools_munge_row: failed to load FASTA index:

# Missing contig now emits a row with filter=MissingContig instead of erroring
query TT
SELECT (bcftools_munge_row(
  'chrMissing', 2, 'A', 'C', 'rs1',
  NULL, NULL, NULL, NULL,
  NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
  '__WORKING_DIRECTORY__/test/data/liftover_src.fa', 'IFFY', 'REF_MISMATCH', NULL, NULL, NULL
)).chrom,
(bcftools_munge_row(
  'chrMissing', 2, 'A', 'C', 'rs1',
  NULL, NULL, NULL, NULL,
  NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
  '__WORKING_DIRECTORY__/test/data/liftover_src.fa', 'IFFY', 'REF_MISMATCH', NULL, NULL, NULL
)).filter;
----
chrMissing	MissingContig

# SET duckhts_file_system = 'duckdb' reads the FASTA through the connection.
# The route builds no index: a FASTA that is not there is DuckDB's error.
statement ok
SET duckhts_file_system = 'duckdb';

statement error
SELECT (bcftools_munge_row(
  'chrF', 2, 'A', 'C', 'rs1',
  NULL, NULL, NULL, NULL,
  NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
  '__WORKING_DIRECTORY__/test/data/does_not_exist.fa', 'IFFY', 'REF_MISMATCH', NULL, NULL, NULL
)).chrom;
----
No such file or directory

# The missing-contig row above is the same through the connection.
query TT
SELECT m.chrom, m.filter
FROM (
  SELECT bcftools_munge_row(
    'chrMissing', 2, 'A', 'C', 'rs1',
    NULL, NULL, NULL, NULL,
    NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
    '__WORKING_DIRECTORY__/test/data/liftover_src.fa', 'IFFY', 'REF_MISMATCH', NULL, NULL, NULL
  ) AS m
) s;
----
chrMissing	MissingContig

statement ok
SET duckhts_file_system = 'tabix';

statement error
SELECT (bcftools_munge_row(
  'chrF', 2, 'A', 'C', 'rs1',
  NULL, NULL, NULL, NULL,
  NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
  '__WORKING_DIRECTORY__/test/data/liftover_src.fa', 'IFFY', 'REF_MISMATCH', NULL, NULL, NULL
)).chrom;
----
bcftools_munge_row: duckhts_file_system must be 'htslib' or 'duckdb'

statement ok
RESET duckhts_file_system;

statement ok
SET duckhts_remote_block_size = 1;

statement error
SELECT (bcftools_munge_row(
  'chrF', 2, 'A', 'C', 'rs1',
  NULL, NULL, NULL, NULL,
  NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
  '__WORKING_DIRECTORY__/test/data/liftover_src.fa', 'IFFY', 'REF_MISMATCH', NULL, NULL, NULL
)).chrom;
----
bcftools_munge_row: duckhts_remote_block_size must be 0 or between 131072 and 268435456 bytes

statement ok
RESET duckhts_remote_block_size;

# name: test/sql/somalier_find_sites.test
# description: Greedy ordered position selection for Somalier find-sites recipes
# group: [duckhts]

require duckhts

query I
SELECT duckhts_somalier_spacing([100, 109, 110, 95, 120]::UBIGINT[], 10) =
       [true, false, true, false, true];
----
1

query I
SELECT duckhts_somalier_spacing([100, 100, 101]::UBIGINT[], 1) =
       [true, false, true];
----
1

query I
SELECT duckhts_somalier_spacing([]::UBIGINT[], 10000) = []::BOOLEAN[];
----
1

statement error
SELECT duckhts_somalier_spacing([100, NULL]::UBIGINT[], 10);
----
positions must be positive and non-NULL

statement error
SELECT duckhts_somalier_spacing([100]::UBIGINT[], 0);
----
positive distance

statement ok
CREATE TEMP TABLE find_sites_candidates AS SELECT * FROM (VALUES
    ('chr2', 105::UBIGINT, 0.02::FLOAT),
    ('chr1', 120::UBIGINT, 0.04::FLOAT),
    ('chr1', 110::UBIGINT, 0.00::FLOAT),
    ('chr1', 100::UBIGINT, 0.00::FLOAT)
) AS candidates(region, position, score);

query TII
WITH ranked AS (
    SELECT region, position,
        row_number() OVER (PARTITION BY region ORDER BY score, position) AS rank
    FROM find_sites_candidates
), masks AS (
    SELECT region,
        duckhts_somalier_spacing(list(position ORDER BY rank), 20::UBIGINT) AS mask
    FROM ranked GROUP BY region
), expanded AS (
    SELECT region, generate_subscripts(mask, 1) AS rank,
        unnest(mask) AS selected FROM masks
), selected AS (
    SELECT r.region, r.position FROM ranked r JOIN expanded e USING (region, rank)
    WHERE e.selected
)
SELECT region, position, row_number() OVER (ORDER BY region, position) - 1 AS site_index
FROM selected ORDER BY region, position;
----
chr1	100	0
chr1	120	1
chr2	105	2

# The candidate cap applies per chromosome list. Lists stored in a table reach the
# scalar in one chunk: four 300,000-position lists exceed 1,000,000 together, but
# each is within the cap (a per-chunk total rejected this).
statement ok
CREATE TABLE spacing_lists AS
SELECT g, list(CAST(i + 1 AS UBIGINT) ORDER BY i) AS positions
FROM range(4) t(g), range(300000) r(i) GROUP BY g;

query II
SELECT count(*), sum(len(duckhts_somalier_spacing(positions, 1::UBIGINT))) FROM spacing_lists;
----
4	1200000

statement error
SELECT duckhts_somalier_spacing(
    list_transform(range(1000001), lambda i: CAST(i + 1 AS UBIGINT)), 1::UBIGINT);
----
at most 1000000 candidates per list

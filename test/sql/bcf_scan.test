# Five physical records; equal-position distinct alleles and exact duplicates
# must survive both scan modes. These literal rows are independent of the reader.
statement ok
CREATE TABLE bcf_scan_expected(CHROM VARCHAR, POS BIGINT, ID VARCHAR, REF VARCHAR,
  ALT VARCHAR[], QUAL DOUBLE, FILTER VARCHAR[], INFO_DP INTEGER,
  FORMAT_GT_S1 VARCHAR, FORMAT_GT_S2 VARCHAR);

statement ok
INSERT INTO bcf_scan_expected VALUES
  ('chr1',10,'known','A',['C'],60,['PASS'],7,'0/1','1/1'),
  ('chr3',20,'duplicate','G',['T'],50,['PASS'],8,'./1','0/0'),
  ('chr3',20,'duplicate','G',['T'],50,['PASS'],8,'./1','0/0'),
  ('chr3',20,'allele','G',['A'],30,['PASS'],9,'1/1','./.'),
  ('chr3',40,'last','T',['G'],NULL,['PASS'],NULL,'1','0|1');

statement ok
CREATE MACRO bcf_scan_difference(header_kind, index_kind, mode) AS TABLE
WITH observed AS MATERIALIZED (
  SELECT * FROM read_bcf('__WORKING_DIRECTORY__/test/data/bcf_scan_contigs.' || header_kind || '.vcf.gz',
    index_path := '__WORKING_DIRECTORY__/test/data/bcf_scan_contigs.' || header_kind || '.vcf.gz.index.' || index_kind,
    scan_mode := mode, decompression_threads := 0)
)
(SELECT * FROM observed EXCEPT ALL SELECT * FROM bcf_scan_expected)
UNION ALL
(SELECT * FROM bcf_scan_expected EXCEPT ALL SELECT * FROM observed);

statement ok
SET threads=1;

query I
SELECT count(*) FROM (
  SELECT * FROM bcf_scan_difference('partial','tbi','auto') UNION ALL
  SELECT * FROM bcf_scan_difference('none','tbi','auto') UNION ALL
  SELECT * FROM bcf_scan_difference('full','tbi','auto') UNION ALL
  SELECT * FROM bcf_scan_difference('partial','csi','auto') UNION ALL
  SELECT * FROM bcf_scan_difference('none','csi','auto') UNION ALL
  SELECT * FROM bcf_scan_difference('full','csi','auto')
);
----
0


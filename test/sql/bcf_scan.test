query I
SELECT count(POS) FROM read_bcf('__WORKING_DIRECTORY__/test/data/bcf_scan_contigs.full.vcf.gz',
  index_path := '__WORKING_DIRECTORY__/test/data/bcf_scan_contigs.full.vcf.gz.index.tbi', region := 'empty');
----
0

# A header-only VCF has an empty Tabix dictionary, not an allocation failure.
query II
SELECT
  (SELECT count(POS) FROM read_bcf('__WORKING_DIRECTORY__/test/data/bcf_scan_contigs.empty.vcf.gz',
    index_path := '__WORKING_DIRECTORY__/test/data/bcf_scan_contigs.empty.vcf.gz.index.tbi')),
  (SELECT count(POS) FROM read_bcf('__WORKING_DIRECTORY__/test/data/bcf_scan_contigs.empty.vcf.gz',
    index_path := '__WORKING_DIRECTORY__/test/data/bcf_scan_contigs.empty.vcf.gz.index.csi'));
----
0	0

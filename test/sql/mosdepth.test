query TT
SELECT
  CASE WHEN per_base_path IS NULL THEN 'NULL' ELSE 'SET' END,
  CASE WHEN regions_path LIKE '%/mosdepth_noper_sqltest.regions.bed.gz' THEN 'OK' ELSE 'BAD' END
FROM duckhts_mosdepth(
  '__WORKING_DIRECTORY__/mosdepth_noper_sqltest',
  '__WORKING_DIRECTORY__/test/data/range.bam',
  by := '1000',
  no_per_base := TRUE,
  overwrite := TRUE
);
----
NULL	OK

statement error
SELECT * FROM duckhts_mosdepth(
  '__WORKING_DIRECTORY__/mosdepth_default_sqltest',
  '__WORKING_DIRECTORY__/test/data/range.bam',
  fast_mode := FALSE,
  overwrite := TRUE
);
----
duckhts_mosdepth currently implements only fast_mode := TRUE

statement error
SELECT * FROM duckhts_mosdepth(
  '__WORKING_DIRECTORY__/mosdepth_badprec_sqltest',
  '__WORKING_DIRECTORY__/test/data/range.bam',
  precision_digits := -1,
  overwrite := TRUE
);
----
duckhts_mosdepth: precision_digits must be between 0 and 18

statement error
SELECT * FROM duckhts_mosdepth(
  '__WORKING_DIRECTORY__/mosdepth_badthr_sqltest',
  '__WORKING_DIRECTORY__/test/data/range.bam',
  thresholds := '1,2',
  overwrite := TRUE
);
----
duckhts_mosdepth: thresholds requires by := '<window|bed>'

statement error
SELECT * FROM duckhts_mosdepth(
  '__WORKING_DIRECTORY__/mosdepth_badthrspec_sqltest',
  '__WORKING_DIRECTORY__/test/data/range.bam',
  by := '1000',
  thresholds := '1,nope',
  overwrite := TRUE
);
----
duckhts_mosdepth: invalid thresholds string

statement error
SELECT * FROM duckhts_mosdepth(
  '__WORKING_DIRECTORY__/mosdepth_badquant_sqltest',
  '__WORKING_DIRECTORY__/test/data/range.bam',
  quantize := '1::4',

# name: test/sql/mosdepth.test
# description: Test native duckhts_mosdepth BAM/CRAM fast-mode outputs
# group: [duckhts]

require duckhts

statement ok
SELECT * FROM duckhts_mosdepth(
  '__WORKING_DIRECTORY__/mosdepth_fast_sqltest',
  '__WORKING_DIRECTORY__/test/data/range.bam',
  overwrite := TRUE
);

query TIITII
SELECT chrom, length, bases, printf('%.2f', mean), min, max
FROM read_csv(
  '__WORKING_DIRECTORY__/mosdepth_fast_sqltest.mosdepth.summary.txt',
  delim = '\t',
  header = true
)
WHERE chrom IN ('CHROMOSOME_II', 'total')
ORDER BY chrom;
----
CHROMOSOME_II	5000	3400	0.68	0	5
total	1024800	11129	0.01	0	6

statement ok
SELECT * FROM duckhts_mosdepth(
  '__WORKING_DIRECTORY__/mosdepth_prec_sqltest',
  '__WORKING_DIRECTORY__/test/data/range.bam',
  precision_digits := 4,
  overwrite := TRUE
);

query TTI
SELECT chrom, printf('%.4f', mean), max
FROM read_csv(
  '__WORKING_DIRECTORY__/mosdepth_prec_sqltest.mosdepth.summary.txt',
  delim = '\t',
  header = true
)
WHERE chrom IN ('CHROMOSOME_I', 'total')
ORDER BY chrom;
----
CHROMOSOME_I	0.0017	4
total	0.0109	6

statement ok
SELECT * FROM duckhts_mosdepth(
  '__WORKING_DIRECTORY__/mosdepth_cram_sqltest',
  '__WORKING_DIRECTORY__/test/data/range.cram',
  fasta := '__WORKING_DIRECTORY__/test/data/ce.fa',
  index_path := '__WORKING_DIRECTORY__/test/data/range.cram.crai',
  overwrite := TRUE
);

query TIITII
SELECT chrom, length, bases, printf('%.2f', mean), min, max
FROM read_csv(
  '__WORKING_DIRECTORY__/mosdepth_cram_sqltest.mosdepth.summary.txt',
  delim = '\t',
  header = true
)
WHERE chrom IN ('CHROMOSOME_II', 'total')
ORDER BY chrom;
----
CHROMOSOME_II	5000	3400	0.68	0	5
total	1024800	11129	0.01	0	6

query TIII
SELECT chrom, start_pos, end_pos, depth
FROM read_csv(
  '__WORKING_DIRECTORY__/mosdepth_fast_sqltest.per-base.bed.gz',
  columns = {'chrom':'VARCHAR', 'start_pos':'BIGINT', 'end_pos':'BIGINT', 'depth':'INTEGER'},
  delim = '\t',
  header = false
)
LIMIT 5;
----
CHROMOSOME_I	0	913	0
CHROMOSOME_I	913	933	1
CHROMOSOME_I	933	1014	2
CHROMOSOME_I	1014	1019	1
CHROMOSOME_I	1019	1034	2

query I
SELECT count(*)
FROM read_bed(
  '__WORKING_DIRECTORY__/mosdepth_fast_sqltest.per-base.bed.gz',
  region := 'CHROMOSOME_II',
  index_path := '__WORKING_DIRECTORY__/mosdepth_fast_sqltest.per-base.bed.gz.csi'
);
----
67

statement ok
SELECT * FROM duckhts_mosdepth(
  '__WORKING_DIRECTORY__/mosdepth_win_sqltest',
  '__WORKING_DIRECTORY__/test/data/range.bam',
  by := '1000',
  overwrite := TRUE
);

query TIIT
SELECT chrom, start_pos, end_pos, printf('%.2f', mean_depth)
FROM read_csv(
  '__WORKING_DIRECTORY__/mosdepth_win_sqltest.regions.bed.gz',
  columns = {'chrom':'VARCHAR', 'start_pos':'BIGINT', 'end_pos':'BIGINT', 'mean_depth':'DOUBLE'},
  delim = '\t',
  header = false
)
WHERE chrom = 'CHROMOSOME_II'
ORDER BY start_pos
LIMIT 5;
----
CHROMOSOME_II	0	1000	0.00
CHROMOSOME_II	1000	2000	1.90
CHROMOSOME_II	2000	3000	1.34
CHROMOSOME_II	3000	4000	0.16
CHROMOSOME_II	4000	5000	0.00

query TIR
SELECT chrom, depth, proportion
FROM read_csv(
  '__WORKING_DIRECTORY__/mosdepth_win_sqltest.mosdepth.region.dist.txt',
  columns = {'chrom':'VARCHAR', 'depth':'INTEGER', 'proportion':'DOUBLE'},
  delim = '\t',
  header = false
)
WHERE chrom = 'CHROMOSOME_II'
ORDER BY depth DESC;
----
CHROMOSOME_II	2	0.2
CHROMOSOME_II	1	0.4
CHROMOSOME_II	0	1.0

statement ok
SELECT * FROM duckhts_mosdepth(
  '__WORKING_DIRECTORY__/mosdepth_thr_sqltest',
  '__WORKING_DIRECTORY__/test/data/range.bam',
  by := '1000',
  thresholds := '1,2',
  overwrite := TRUE
);

query TTII
SELECT chrom, region, ge1, ge2
FROM read_csv(
  '__WORKING_DIRECTORY__/mosdepth_thr_sqltest.thresholds.bed.gz',
  columns = {'chrom':'VARCHAR', 'start_pos':'BIGINT', 'end_pos':'BIGINT', 'region':'VARCHAR', 'ge1':'BIGINT', 'ge2':'BIGINT'},
  delim = '\t',
  header = false,
  skip = 1
)
WHERE chrom = 'CHROMOSOME_II'
ORDER BY start_pos
LIMIT 5;
----
CHROMOSOME_II	unknown	0	0
CHROMOSOME_II	unknown	840	555
CHROMOSOME_II	unknown	737	368
CHROMOSOME_II	unknown	82	75
CHROMOSOME_II	unknown	0	0


query IIII
SELECT
 (SELECT count(*) FROM read_bcf('__WORKING_DIRECTORY__/test/data/vcf_file.bcf', region := '')),
 (SELECT count(*) FROM read_bam('__WORKING_DIRECTORY__/test/data/range.bam', region := '')),
 (SELECT count(*) FROM read_tabix('__WORKING_DIRECTORY__/test/data/gff_file.gff.gz', region := '')),
 (SELECT count(*) FROM read_fasta('__WORKING_DIRECTORY__/test/data/ce.fa', region := ''));
----
15	112	62	7

# FASTA intentionally preserves repeated requests as repeated sequence rows.
query II
SELECT count(*), min(length(SEQUENCE)) FROM read_fasta('__WORKING_DIRECTORY__/test/data/ce.fa', region := 'CHROMOSOME_I:1-10,CHROMOSOME_I:1-10');
----
2	10

statement ok
CREATE TABLE region_oracle AS SELECT * FROM read_bcf('__WORKING_DIRECTORY__/test/data/region_union.bcf', scan_mode := 'sequential', tidy_format := false);

statement ok
CREATE TABLE region_actual AS SELECT * FROM read_bcf('__WORKING_DIRECTORY__/test/data/region_union.bcf', region := 'chr1:18-18,chr1:10-20,chr1:11-11,chr1:12-14,chr1:18-18', tidy_format := false);

query II
SELECT (SELECT count(*) FROM region_actual), (SELECT count(*) FROM (
 (SELECT * FROM region_actual EXCEPT ALL SELECT * FROM region_oracle WHERE ID IN ('long_ref','long_end','same_c','same_g','duplicate'))
 UNION ALL
 (SELECT * FROM region_oracle WHERE ID IN ('long_ref','long_end','same_c','same_g','duplicate') EXCEPT ALL SELECT * FROM region_actual)));
----
6	0

statement ok
DROP TABLE region_actual;


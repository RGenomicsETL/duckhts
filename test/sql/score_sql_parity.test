# name: test/sql/score_sql_parity.test
# description: Relational GT/DS score reference and float32 forward error bounds
# group: [duckhts]

require duckhts

statement ok
SET VARIABLE score_sql = (SELECT content FROM read_text('test/sql/score_reference.sql'));

statement ok
SET VARIABLE score_compare = $compare$
WITH native_cells AS (
    SELECT n.SAMPLE, j.key, j.value FROM native_score n, json_each(to_json(n)) j
    WHERE j.key <> 'SAMPLE'
), reference_cells AS (
    SELECT r.SAMPLE, j.key, j.value, to_json(r) AS row FROM sql_score r, json_each(to_json(r)) j
    WHERE j.key <> 'SAMPLE' AND NOT ends_with(j.key, '_BOUND')
)
SELECT count(*) FROM native_cells n FULL JOIN reference_cells r USING (SAMPLE, key)
WHERE n.SAMPLE IS NULL OR r.SAMPLE IS NULL OR n.value IS NULL OR r.value IS NULL
   OR json_type(n.value) = 'NULL' OR json_type(r.value) = 'NULL'
   OR NOT isfinite(n.value::DOUBLE) OR NOT isfinite(r.value::DOUBLE)
   OR CASE WHEN regexp_matches(coalesce(n.key, r.key), '_CNT(_p|$)')
           THEN n.value::BIGINT <> r.value::BIGINT
           ELSE json_extract(r.row, '/' || r.key || '_BOUND') IS NULL
                OR json_type(json_extract(r.row, '/' || r.key || '_BOUND')) = 'NULL'
                OR NOT isfinite(json_extract(r.row, '/' || r.key || '_BOUND')::DOUBLE)
                OR abs(n.value::DOUBLE - r.value::DOUBLE) >
                   json_extract(r.row, '/' || r.key || '_BOUND')::DOUBLE END
$compare$;

statement ok
SET VARIABLE score_path = 'test/data/score_input.vcf';

statement ok

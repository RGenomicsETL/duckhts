statement ok
CREATE OR REPLACE TABLE native_score AS SELECT * FROM bcftools_score(getvariable('score_path'), getvariable('score_summaries'), use := 'GT', columns := '${preset}', counts := true);

statement ok
CREATE OR REPLACE TABLE sql_score AS FROM query(getvariable('score_sql'));

query I
FROM query(getvariable('score_compare'));
----
0

query I
SELECT count(*) FROM ((SELECT name, type FROM pragma_table_info('native_score') EXCEPT ALL SELECT name, type FROM pragma_table_info('sql_score') WHERE NOT ends_with(name, '_BOUND')) UNION ALL (SELECT name, type FROM pragma_table_info('sql_score') WHERE NOT ends_with(name, '_BOUND') EXCEPT ALL SELECT name, type FROM pragma_table_info('native_score')));

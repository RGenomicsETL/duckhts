# Native computes -log10(p) with float32 log10f, whose last bit depends on the platform
# libm. rs1 (P = 0.00000000095) lies within that rounding of the 9.5e-10 threshold, so the
# reference rejects it; at 1e-9 the selection is decided and matches native.
statement ok
SET VARIABLE score_summaries = ['test/data/score_sql_lp_adjacent.tsv'];

statement ok
SET VARIABLE score_q_score_thr = [9.5e-10, 1e-9];

statement error
CREATE OR REPLACE TABLE sql_score AS FROM query(getvariable('score_sql'));
----
within float32 log10 rounding of a q_score_thr threshold

statement ok

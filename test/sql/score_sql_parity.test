statement ok
CREATE OR REPLACE TABLE native_score AS SELECT * FROM bcftools_score(getvariable('score_path'), getvariable('score_summaries'), use := 'GT', columns := '${preset}', counts := true);

statement ok
CREATE OR REPLACE TABLE sql_score AS FROM query(getvariable('score_sql'));

query I
FROM query(getvariable('score_compare'));

query I
SELECT count(*) FROM (
 (SELECT * FROM duckhts_bam_insert_size_counts('test/data/insert_size/unindexed.bam')
 EXCEPT ALL SELECT * FROM duckhts_bam_insert_size_counts('test/data/insert_size/edges.bam'))
 UNION ALL
 (SELECT * FROM duckhts_bam_insert_size_counts('test/data/insert_size/edges.bam')
 EXCEPT ALL SELECT * FROM duckhts_bam_insert_size_counts('test/data/insert_size/unindexed.bam')));

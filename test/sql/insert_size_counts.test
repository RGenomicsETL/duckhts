foreach threads 0 9

statement error
SELECT * FROM duckhts_bam_insert_size_counts('test/data/insert_size/edges.bam', threads := ${threads});
----
threads

endloop

statement error
SELECT * FROM duckhts_bam_insert_size_counts('test/data/insert_size/unindexed.bam', scan_mode := 'indexed');
----
cannot load required index

statement error
SELECT * FROM duckhts_insert_size_metrics('counts', deviations := -1);
----
nonnegative

statement ok
CREATE OR REPLACE TEMP TABLE invalid_counts AS SELECT 'FR' AS pair_orientation, 0 AS insert_size, 1 AS read_pairs;

statement error
SELECT * FROM duckhts_insert_size_metrics('invalid_counts');
----
counts require

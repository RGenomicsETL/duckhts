# name: test/sql/insert_size_counts.test
# description: SQL/native counts and riker 0.4.1 exact integers and rounded metrics.
# group: [duckhts]

require duckhts

statement ok
SET VARIABLE insert_reference = 'test/data/insert_size/reference.fa.gz';

statement ok
SET VARIABLE reference_sql = (SELECT content FROM read_text('test/sql/insert_size_reference.sql'));

statement ok
CREATE TEMP VIEW oracle_histograms AS SELECT * FROM read_csv('test/data/insert_size/histograms.tsv', delim='\t', header=true);

statement ok
CREATE TEMP VIEW oracle_metrics AS SELECT * FROM read_csv('test/data/insert_size/metrics.tsv', delim='\t', header=true, all_varchar=true);

foreach format bam cram

foreach fixture edges empty singleton task_overlap long_cigar even mad_zero minority

foreach arm duckhts_bam_insert_size_counts duckhts_bam_insert_size_counts_sql

foreach duplicates false true

statement ok
SET VARIABLE insert_path = 'test/data/insert_size/${fixture}.${format}';

statement ok
SET VARIABLE insert_duplicates = ${duplicates};

statement ok
SET threads = 1;

statement ok
CREATE OR REPLACE TEMP TABLE counts AS
SELECT * FROM ${arm}('test/data/insert_size/${fixture}.${format}',
 reference := 'test/data/insert_size/reference.fa.gz', include_duplicates := ${duplicates});

query I
SELECT count(*) FROM (
 (SELECT * FROM counts EXCEPT ALL SELECT * FROM query(getvariable('reference_sql')))
 UNION ALL
 (SELECT * FROM query(getvariable('reference_sql')) EXCEPT ALL SELECT * FROM counts)
);
----
0

statement ok
CREATE OR REPLACE TEMP TABLE raw AS
SELECT pair_orientation, insert_size::BIGINT AS insert_size, read_pairs::UBIGINT AS read_pairs
FROM (UNPIVOT (SELECT insert_size,fr_count,rf_count,tandem_count FROM oracle_histograms
 WHERE fixture='${fixture}' AND format='${format}' AND case_name=
 CASE WHEN ${duplicates} THEN 'raw_duplicates' ELSE 'raw' END)
 ON fr_count AS 'FR', rf_count AS 'RF', tandem_count AS 'TANDEM'
 INTO NAME pair_orientation VALUE read_pairs) WHERE read_pairs > 0;

query I
SELECT count(*) FROM (
 (SELECT * FROM counts EXCEPT ALL SELECT * FROM raw)
 UNION ALL (SELECT * FROM raw EXCEPT ALL SELECT * FROM counts)
);
----
0

foreach threads 1 2 4 8

statement ok
SET threads = ${threads};

foreach mode auto sequential

query I
SELECT count(*) FROM (
 (SELECT * FROM counts EXCEPT ALL SELECT * FROM duckhts_bam_insert_size_counts_sql(
  'test/data/insert_size/${fixture}.${format}', reference := 'test/data/insert_size/reference.fa.gz',
  scan_mode := '${mode}', include_duplicates := ${duplicates}))
 UNION ALL
 (SELECT * FROM duckhts_bam_insert_size_counts_sql(
  'test/data/insert_size/${fixture}.${format}', reference := 'test/data/insert_size/reference.fa.gz',
  scan_mode := '${mode}', include_duplicates := ${duplicates}) EXCEPT ALL SELECT * FROM counts)
);
----
0

endloop

foreach mode auto indexed sequential

query I
SELECT count(*) FROM (
 (SELECT * FROM counts EXCEPT ALL SELECT * FROM duckhts_bam_insert_size_counts(
  'test/data/insert_size/${fixture}.${format}', reference := 'test/data/insert_size/reference.fa.gz',
  threads := ${threads}, scan_mode := '${mode}', include_duplicates := ${duplicates}))
 UNION ALL
 (SELECT * FROM duckhts_bam_insert_size_counts(
  'test/data/insert_size/${fixture}.${format}', reference := 'test/data/insert_size/reference.fa.gz',
  threads := ${threads}, scan_mode := '${mode}', include_duplicates := ${duplicates})
  EXCEPT ALL SELECT * FROM counts)
);
----
0

endloop

endloop

foreach case default duplicates all_orientations median_only filtered raw raw_duplicates

statement ok
SET VARIABLE deviations = (SELECT deviations FROM read_csv('test/data/insert_size/cases.tsv', delim='\t', header=true) WHERE name='${case}');

statement ok
SET VARIABLE min_frac = (SELECT min_frac FROM read_csv('test/data/insert_size/cases.tsv', delim='\t', header=true) WHERE name='${case}');

# Each counts relation is checked against only cases with its duplicate policy.
statement ok
CREATE OR REPLACE TEMP TABLE metrics AS
SELECT * FROM duckhts_insert_size_metrics('counts', deviations := getvariable('deviations'),
 min_frac := getvariable('min_frac'), sample_name := 'edges')
WHERE ${duplicates} = (SELECT duplicates FROM read_csv('test/data/insert_size/cases.tsv', delim='\t', header=true) WHERE name='${case}');

query I
WITH actual AS (
 SELECT sample,pair_orientation,read_pairs,
 printf('%.2f',mean_insert_size) AS mean_insert_size,
 printf('%.2f',standard_deviation) AS standard_deviation,
 printf('%.2f',median_insert_size) AS median_insert_size,
 printf('%.2f',median_absolute_deviation) AS median_absolute_deviation,
 mode_insert_size,min_insert_size,max_insert_size FROM metrics
), expected AS (
 SELECT sample,pair_orientation,read_pairs::HUGEINT AS read_pairs,mean_insert_size,
 standard_deviation,median_insert_size,median_absolute_deviation,
 mode_insert_size::BIGINT AS mode_insert_size,min_insert_size::BIGINT AS min_insert_size,
 max_insert_size::BIGINT AS max_insert_size FROM oracle_metrics
 WHERE fixture='${fixture}' AND format='${format}' AND case_name='${case}'
 AND ${duplicates} = (SELECT duplicates FROM read_csv('test/data/insert_size/cases.tsv', delim='\t', header=true) WHERE name='${case}')
)
SELECT count(*) FROM ((SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
 UNION ALL (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual));
----
0

query I
WITH actual AS (
 SELECT insert_size,
 coalesce(sum(read_pairs) FILTER (WHERE pair_orientation='FR'),0) AS fr_count,
 coalesce(sum(read_pairs) FILTER (WHERE pair_orientation='RF'),0) AS rf_count,
 coalesce(sum(read_pairs) FILTER (WHERE pair_orientation='TANDEM'),0) AS tandem_count
 FROM counts WHERE insert_size <= coalesce((SELECT max(histogram_cutoff) FROM metrics),4294967295)
 AND ${duplicates} = (SELECT duplicates FROM read_csv('test/data/insert_size/cases.tsv', delim='\t', header=true) WHERE name='${case}')
 GROUP BY insert_size
), expected AS (
 SELECT insert_size,fr_count,rf_count,tandem_count FROM oracle_histograms
 WHERE fixture='${fixture}' AND format='${format}' AND case_name='${case}'
 AND ${duplicates} = (SELECT duplicates FROM read_csv('test/data/insert_size/cases.tsv', delim='\t', header=true) WHERE name='${case}')
)
SELECT count(*) FROM ((SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
 UNION ALL (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual));
----
0

endloop

endloop

endloop

endloop

endloop

foreach arm duckhts_bam_insert_size_counts duckhts_bam_insert_size_counts_sql

query TTTTTT
DESCRIBE SELECT * FROM ${arm}('test/data/insert_size/empty.bam');

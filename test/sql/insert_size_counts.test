pair_orientation	VARCHAR	YES	NULL	NULL	NULL
insert_size	BIGINT	YES	NULL	NULL	NULL
read_pairs	UBIGINT	YES	NULL	NULL	NULL

statement error
SELECT * FROM ${arm}('test/data/insert_size/edges.bam', scan_mode := 'other');
----
scan_mode

statement error
SELECT * FROM ${arm}('missing.bam');
----
open

query I
SELECT count(*) FROM (
 (SELECT * FROM ${arm}('test/data/insert_size/unindexed.bam')
 EXCEPT ALL SELECT * FROM ${arm}('test/data/insert_size/edges.bam'))
 UNION ALL
 (SELECT * FROM ${arm}('test/data/insert_size/edges.bam')
 EXCEPT ALL SELECT * FROM ${arm}('test/data/insert_size/unindexed.bam')));
----

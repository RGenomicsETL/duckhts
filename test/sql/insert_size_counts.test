statement ok
CREATE OR REPLACE TEMP TABLE invalid_counts AS SELECT 'FR' AS pair_orientation, 0 AS insert_size, 1 AS read_pairs;

statement error
SELECT * FROM duckhts_insert_size_metrics('invalid_counts');

# name: test/sql/parallel_empty_contigs.test
# description: Regression tests for indexed parallel scans with leading empty contigs
# group: [duckhts]

require duckhts

statement ok
PRAGMA threads=4

query IT
SELECT count(*), min(RNAME)
FROM read_bam(
  '__WORKING_DIRECTORY__/test/data/parallel_empty_contigs.bam',
  index_path := '__WORKING_DIRECTORY__/test/data/parallel_empty_contigs.bam.bai'
);
----
2	chr1

query IT
SELECT count(*), min(CHROM)
FROM read_bcf(
  '__WORKING_DIRECTORY__/test/data/parallel_empty_contigs.vcf.gz',
  index_path := '__WORKING_DIRECTORY__/test/data/parallel_empty_contigs.vcf.gz.tbi'
);
----
2	chr1

# The appender's parallel region scheduler must also advance iteratively past
# empty indexed contigs.  It must not create one worker or open handle per
# header contig, and it must retain the serial native-iterator row multiset.
query I
SELECT rows_written
FROM read_bcf_appender(
  '__WORKING_DIRECTORY__/test/data/parallel_empty_contigs.bcf',
  'parallel_empty_contigs_appender_serial',
  region := 'empty1,empty2,empty3,empty4,empty5,empty6,empty7,empty8,chr1',
  tidy_format := true,
  overwrite := true,
  include_file_offset := true,
  region_threads := 1
);
----
2

query I
SELECT rows_written
FROM read_bcf_appender(
  '__WORKING_DIRECTORY__/test/data/parallel_empty_contigs.bcf',
  'parallel_empty_contigs_appender_parallel',
  region := 'empty1,empty2,empty3,empty4,empty5,empty6,empty7,empty8,chr1',
  tidy_format := true,
  overwrite := true,
  include_file_offset := true,
  region_threads := 4
);
----
2

query II
SELECT count(*), count(DISTINCT FILE_OFFSET)
FROM parallel_empty_contigs_appender_parallel;
----
2	2

query I
SELECT count(*)
FROM (
  (SELECT * FROM parallel_empty_contigs_appender_serial
   EXCEPT ALL
   SELECT * FROM parallel_empty_contigs_appender_parallel)
  UNION ALL
  (SELECT * FROM parallel_empty_contigs_appender_parallel
   EXCEPT ALL
   SELECT * FROM parallel_empty_contigs_appender_serial)
);
----
0

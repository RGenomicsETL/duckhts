# name: test/sql/parallel_empty_contigs.test
# description: Regression tests for indexed parallel scans with leading empty contigs
# group: [duckhts]

require duckhts

statement ok
PRAGMA threads=4

query IT
SELECT count(*), min(RNAME)
FROM read_bam(
  '__WORKING_DIRECTORY__/test/data/parallel_empty_contigs.bam',
  index_path := '__WORKING_DIRECTORY__/test/data/parallel_empty_contigs.bam.bai'
);
----
2	chr1

query IT
SELECT count(*), min(CHROM)
FROM read_bcf(
  '__WORKING_DIRECTORY__/test/data/parallel_empty_contigs.vcf.gz',
  index_path := '__WORKING_DIRECTORY__/test/data/parallel_empty_contigs.vcf.gz.tbi'
);
----
2	chr1

# Leading empty targets must not terminate a native multi-region request.
query I
SELECT count(*) FROM (
 (SELECT * FROM read_bcf('__WORKING_DIRECTORY__/test/data/parallel_empty_contigs.bcf', region := 'empty1,empty2,empty3,empty4,empty5,empty6,empty7,empty8,chr1', tidy_format := true)
  EXCEPT ALL SELECT * FROM read_bcf('__WORKING_DIRECTORY__/test/data/parallel_empty_contigs.bcf', scan_mode := 'sequential', tidy_format := true))
 UNION ALL
 (SELECT * FROM read_bcf('__WORKING_DIRECTORY__/test/data/parallel_empty_contigs.bcf', scan_mode := 'sequential', tidy_format := true)
  EXCEPT ALL SELECT * FROM read_bcf('__WORKING_DIRECTORY__/test/data/parallel_empty_contigs.bcf', region := 'empty1,empty2,empty3,empty4,empty5,empty6,empty7,empty8,chr1', tidy_format := true))
);
----
0

query IT
SELECT count(*), min(CHROM) FROM read_bcf('__WORKING_DIRECTORY__/test/data/parallel_empty_contigs.vcf.gz', region := 'empty1,empty2,empty3,empty4,empty5,empty6,empty7,empty8,chr1');
----
2	chr1

# name: test/sql/bcf_csq_limit.test
# description: Oversized annotation schemas fail explicitly rather than losing columns
# group: [duckhts]

require duckhts

statement ok
COPY (
    SELECT line FROM (
        SELECT 1 AS ordinal, '##fileformat=VCFv4.2' AS line
        UNION ALL SELECT 2, '##contig=<ID=chr1,length=100>'
        UNION ALL SELECT 3, '##INFO=<ID=CSQ,Number=.,Type=String,Description="Format: ' ||
            (SELECT string_agg('Field' || i::VARCHAR, '|' ORDER BY i) FROM range(1, 258) AS fields(i)) || '">'
        UNION ALL SELECT 4, '#CHROM' || chr(9) || 'POS' || chr(9) || 'ID' || chr(9) || 'REF' || chr(9) ||
            'ALT' || chr(9) || 'QUAL' || chr(9) || 'FILTER' || chr(9) || 'INFO'
        UNION ALL SELECT 5, 'chr1' || chr(9) || '1' || chr(9) || '.' || chr(9) || 'A' || chr(9) ||
            'G' || chr(9) || '.' || chr(9) || 'PASS' || chr(9) || '.'
    ) ORDER BY ordinal
) TO '__TEST_DIR__/csq_257_fields.vcf' (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

statement error
SELECT count(*) FROM read_bcf('__TEST_DIR__/csq_257_fields.vcf');
----
exceeds the supported annotation field count

statement ok
COPY (
    SELECT replace(line, '|Field257', '') AS line
    FROM read_csv('__TEST_DIR__/csq_257_fields.vcf', header := false, columns := {'line': 'VARCHAR'},
                  delim := chr(1), quote := '', escape := '')
) TO '__TEST_DIR__/csq_256_fields.vcf' (FORMAT CSV, HEADER FALSE, QUOTE '', ESCAPE '');

query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_bcf('__TEST_DIR__/csq_256_fields.vcf'))
WHERE starts_with(column_name, 'VEP_');
----
256

# --- tabix multi-region query (comma-separated) ---
query I
WITH r1 AS (
  SELECT count(*) AS c FROM read_tabix('__WORKING_DIRECTORY__/test/data/gff_file.gff.gz', region := 'X:2934816-2935190')
),
r2 AS (
  SELECT count(*) AS c FROM read_tabix('__WORKING_DIRECTORY__/test/data/gff_file.gff.gz', region := 'X:2937010-2937500')
),
mr AS (
  SELECT count(*) AS c FROM read_tabix('__WORKING_DIRECTORY__/test/data/gff_file.gff.gz', region := 'X:2934816-2935190,X:2937010-2937500')
)
SELECT CASE WHEN (SELECT c FROM mr) = (SELECT c FROM r1) + (SELECT c FROM r2) THEN 1 ELSE 0 END;
----
1

# ==============================================================
# read_hts_header & read_hts_index
# ==============================================================

# --- header map extraction (VCF) ---
query T
SELECT map_extract(key_values, 'Description')
FROM read_hts_header('__WORKING_DIRECTORY__/test/data/formatcols.vcf.gz')
WHERE record_type = 'FORMAT'
LIMIT 1;
----
['"Text"']

# --- raw header mode ---
query I
SELECT count(*)
FROM read_hts_header('__WORKING_DIRECTORY__/test/data/formatcols.vcf.gz', mode := 'raw')
WHERE raw LIKE '##%';
----
6

# --- raw header mode schema ---
query T
SELECT string_agg(column_name, '|')
FROM (DESCRIBE SELECT * FROM read_hts_header('__WORKING_DIRECTORY__/test/data/formatcols.vcf.gz', mode := 'raw'));
----
idx|raw

# --- parsed header mode schema ---
query T
SELECT string_agg(column_name, '|')
FROM (DESCRIBE SELECT * FROM read_hts_header('__WORKING_DIRECTORY__/test/data/formatcols.vcf.gz', mode := 'parsed'));
----
file_format|compression|record_type|id|number|value_type|length|description|idx|key_values

# --- raw header mode preserves distinct line content ---
query T
SELECT string_agg(raw, '|')
FROM (
  SELECT idx, raw
  FROM read_hts_header('__WORKING_DIRECTORY__/test/data/formatcols.vcf.gz', mode := 'raw')
  ORDER BY idx
  LIMIT 3
) t;
----
##fileformat=VCFv4.3|##FILTER=<ID=PASS,Description="All filters passed">|##contig=<ID=1>

# --- tabix auto-detect (no explicit format) ---
query I
SELECT count(*)
FROM read_hts_header('__WORKING_DIRECTORY__/test/data/meta_tabix.tsv.gz', mode := 'raw')
WHERE raw LIKE '#%';
----
2

# --- index type extracted from VCF/BCF ---
query I
SELECT index_type
FROM read_hts_index('__WORKING_DIRECTORY__/test/data/formatcols.vcf.gz')
LIMIT 1;
----
CSI

# --- index spans return real chunk offsets ---
query I
SELECT CASE
         WHEN seqname = '1'
          AND tid = 0
          AND bin = 2396745
          AND chunk_beg_vo = 20381696
          AND chunk_end_vo = 23789568
          AND seq_start = 1
          AND seq_end = 16384
         THEN 1 ELSE 0
       END
FROM read_hts_index_spans('__WORKING_DIRECTORY__/test/data/formatcols.vcf.gz');
----
1

# --- index raw macro available ---
query I
SELECT CASE WHEN octet_length(raw) > 0 THEN 1 ELSE 0 END
FROM read_hts_index_raw('__WORKING_DIRECTORY__/test/data/formatcols.vcf.gz');
----
1

# --- explicit index_path for read_bcf ---
query I
SELECT count(*)
FROM read_bcf(
  '__WORKING_DIRECTORY__/test/data/vcf_file.bcf',
  region := '1:3000150-3000151',
  index_path := '__WORKING_DIRECTORY__/test/data/vcf_file.bcf.csi'
);
----
2

# --- explicit index_path for read_bam ---
query I
SELECT count(*)
FROM read_bam(
  '__WORKING_DIRECTORY__/test/data/range.bam',
  region := 'CHROMOSOME_I:1-1000',
  index_path := '__WORKING_DIRECTORY__/test/data/range.bam.bai'
);
----
2

# ==============================================================
# Sequence UDFs (k-mer utilities)
# ==============================================================

# --- reverse complement ---
query T
SELECT seq_revcomp('ACGTN');
----
NACGT

# --- canonical sequence representation ---
query T
SELECT seq_canonical('TTA');
----
TAA

# --- 2-bit hash encoding (A=0,C=1,G=2,T=3) ---
query I
SELECT seq_hash_2bit('ACGT');
----
27

# --- invalid base yields NULL in 2-bit hash ---
query I
SELECT seq_hash_2bit('ACNT') IS NULL;
----
1

# --- 4-bit encoding supports IUPAC DNA codes including N ---
query T
SELECT string_agg(CAST(code AS VARCHAR), ',' ORDER BY ord)
FROM UNNEST(seq_encode_4bit('ACGTRYSWKMBDHVN')) WITH ORDINALITY AS t(code, ord);
----
1,2,4,8,5,10,6,9,12,3,14,13,11,7,15

# --- 4-bit decoding round-trips canonical IUPAC codes ---
query T
SELECT seq_decode_4bit(seq_encode_4bit('ACGTRYSWKMBDHVN'));
----
ACGTRYSWKMBDHVN

# --- U (RNA) normalizes to T (code 8) in nt16 encoding ---
query T
SELECT seq_encode_4bit('ACGU')::VARCHAR;
----
[1, 2, 4, 8]

# --- code 0 ('=') is valid nt16; decodes to '=' ---
query T
SELECT seq_decode_4bit([1::UTINYINT, 0::UTINYINT]);
----
A=

# --- unknown chars map to N (15) in 4-bit encoding (htslib-compatible) ---
query T
SELECT seq_encode_4bit('ACG!')::VARCHAR;
----
[1, 2, 4, 15]

# --- out-of-range 4-bit code (>15) yields NULL on decode ---
query I
SELECT seq_decode_4bit([1::UTINYINT, 16::UTINYINT]) IS NULL;
----
1

# --- empty 4-bit list decodes to empty string ---
query I
SELECT length(seq_decode_4bit([]::UTINYINT[]));
----
0

# --- GC content ignores N and returns fraction over called bases ---
query TT
SELECT printf('%.3f', seq_gc_content('ACGTNN')), seq_gc_content('NNNN') IS NULL;
----
0.500	true

# --- SIMD backend diagnostics are backend-agnostic and GC accepts lower-case bases ---
query T
SELECT duckhts_simd_set_backend('scalar');
----
scalar

query TTT
SELECT
  length(duckhts_simd_backend()) > 0,
  duckhts_simd_backend_available('scalar'),
  printf('%.3f', seq_gc_content('acgtnn'));
----
true	true	0.500

query T
SELECT duckhts_simd_set_backend('auto') IS NOT NULL;
----
true

query T
SELECT duckhts_simd_backend_available('neon');
----
false

query TT
SELECT
  duckhts_simd_requested_backend(),
  printf('%.3f', seq_gc_content('acgtnn'));
----
auto	0.500

statement error
SELECT duckhts_simd_set_backend('not-a-backend');
----
unknown SIMD backend

# --- k-mer emission ---
query T
SELECT string_agg(kmer, ',' ORDER BY pos)
FROM seq_kmers('ACGTA', 3);
----
ACG,CGT,GTA

# --- canonical k-mer emission ---
query T
SELECT string_agg(kmer, ',' ORDER BY pos)
FROM seq_kmers('ACGTA', 3, canonical := true);
----
ACG,ACG,GTA

# --- no rows when k > sequence length ---
query I
SELECT count(*) FROM seq_kmers('AC', 3);
----
0

# --- SAM flag predicates on BAM FLAG column ---
query TTTTT
SELECT
  CAST(is_paired(FLAG) AS VARCHAR),
  CAST(is_unmapped(FLAG) AS VARCHAR),
  CAST(is_next_segment_unmapped(FLAG) AS VARCHAR),
  CAST(is_reverse_complemented(FLAG) AS VARCHAR),
  CAST(is_last_segment(FLAG) AS VARCHAR)
FROM read_bam('__WORKING_DIRECTORY__/test/data/range.bam')
LIMIT 1;
----
true	false	false	true	true

# --- proper-pair SAM flag helper ---
query T
SELECT CAST(is_proper_pair(FLAG) AS VARCHAR)
FROM read_bam('__WORKING_DIRECTORY__/test/data/range.bam')
LIMIT 1;
----
false

# --- forward alignment helper ---
query TTT
SELECT
  CAST(is_forward_aligned(0) AS VARCHAR),
  CAST(is_forward_aligned(16) AS VARCHAR),
  COALESCE(CAST(is_forward_aligned(4) AS VARCHAR), 'NULL');
----
true	false	NULL

# --- CIGAR utility helpers on literal examples ---
query TTTIIIIIT
SELECT
  CAST(cigar_has_soft_clip('5S90M5S') AS VARCHAR),
  CAST(cigar_has_hard_clip('5H95M') AS VARCHAR),
  CAST(cigar_has_op('5S90M5S', 'S') AS VARCHAR),
  cigar_left_soft_clip('5S90M5S'),
  cigar_right_soft_clip('5S90M5S'),
  cigar_query_length('5S90M5I'),
  cigar_aligned_query_length('5S90M5I'),
  cigar_reference_length('90M5D'),
  CAST(cigar_has_op('90M5D', 'I') AS VARCHAR);
----
true	true	true	5	5	100	90	95	false

# --- CIGAR utility helpers on BAM CIGAR values ---
query TTT
SELECT
  CAST(cigar_has_op(CIGAR, 'M') AS VARCHAR),
  CAST(cigar_has_soft_clip(CIGAR) AS VARCHAR),
  CAST(cigar_reference_length(CIGAR) > 0 AS VARCHAR)
FROM read_bam('__WORKING_DIRECTORY__/test/data/range.bam')
LIMIT 1;
----
true	false	true

# --- bulk SAM flag decoder ---
query TTTT
SELECT
  CAST(struct_extract(sam_flag_bits(FLAG), 'is_paired') AS VARCHAR),
  CAST(struct_extract(sam_flag_bits(FLAG), 'is_reverse_complemented') AS VARCHAR),
  CAST(struct_extract(sam_flag_bits(FLAG), 'is_last_segment') AS VARCHAR),
  CAST(struct_extract(sam_flag_bits(FLAG), 'is_duplicate') AS VARCHAR)
FROM read_bam('__WORKING_DIRECTORY__/test/data/range.bam')
LIMIT 1;
----
true	true	true	false

# --- generic SAM flag mask helper ---
query TTT
SELECT
  CAST(sam_flag_has(FLAG, 1) AS VARCHAR),
  CAST(sam_flag_has(FLAG, 16) AS VARCHAR),
  CAST(sam_flag_has(FLAG, 1024) AS VARCHAR)
FROM read_bam('__WORKING_DIRECTORY__/test/data/range.bam')
LIMIT 1;
----
true	true	false

# =============================================================================
# sequence_encoding parameter tests
# =============================================================================

# --- read_bam: nt16 returns UTINYINT list ---
query T
SELECT typeof(SEQ)
FROM read_bam('__WORKING_DIRECTORY__/test/data/range.bam', sequence_encoding := 'nt16')
LIMIT 1;
----
UTINYINT[]

# --- read_bam: nt16 values match expected codes ---
query T
SELECT SEQ[1:5]::VARCHAR
FROM read_bam('__WORKING_DIRECTORY__/test/data/range.bam', sequence_encoding := 'nt16')
LIMIT 1;
----
[1, 4, 2, 8, 1]

# --- read_bam: nt16 round-trips back to string ---
query I
SELECT seq_decode_4bit(e.SEQ) = s.SEQ
FROM (SELECT SEQ FROM read_bam('__WORKING_DIRECTORY__/test/data/range.bam', sequence_encoding := 'nt16') LIMIT 1) e,
     (SELECT SEQ FROM read_bam('__WORKING_DIRECTORY__/test/data/range.bam') LIMIT 1) s;
----
1

# --- read_bam: default encoding is 'string' (VARCHAR) ---
query T
SELECT typeof(SEQ)
FROM read_bam('__WORKING_DIRECTORY__/test/data/range.bam')
LIMIT 1;
----
VARCHAR

# --- read_bam: explicit 'string' encoding matches default ---
query T
SELECT typeof(SEQ)
FROM read_bam('__WORKING_DIRECTORY__/test/data/range.bam', sequence_encoding := 'string')
LIMIT 1;
----
VARCHAR

# --- read_bam: invalid encoding value raises error ---
statement error
SELECT * FROM read_bam('__WORKING_DIRECTORY__/test/data/range.bam', sequence_encoding := 'invalid') LIMIT 1;
----
sequence_encoding must be 'string' or 'nt16'

statement error
SELECT * FROM read_bam('__WORKING_DIRECTORY__/test/data/range.bam', decompression_threads := -1) LIMIT 1;
----
decompression_threads must be between 0 and INT_MAX

# --- read_fasta: nt16 returns UTINYINT list ---
query T
SELECT typeof(SEQUENCE)
FROM read_fasta('__WORKING_DIRECTORY__/test/data/ce.fa', region := 'CHROMOSOME_I:1-10', sequence_encoding := 'nt16');
----
UTINYINT[]

# --- read_fasta: nt16 values match expected codes (GCCTA → 4,2,2,8,1) ---
query T
SELECT SEQUENCE[1:5]::VARCHAR
FROM read_fasta('__WORKING_DIRECTORY__/test/data/ce.fa', region := 'CHROMOSOME_I:1-10', sequence_encoding := 'nt16');
----
[4, 2, 2, 8, 1]

# --- read_fasta: nt16 round-trips back to string ---
query I
SELECT seq_decode_4bit(e.SEQUENCE) = s.SEQUENCE
FROM read_fasta('__WORKING_DIRECTORY__/test/data/ce.fa', region := 'CHROMOSOME_I:1-100', sequence_encoding := 'nt16') e,
     read_fasta('__WORKING_DIRECTORY__/test/data/ce.fa', region := 'CHROMOSOME_I:1-100') s;
----
1

# --- read_fasta: invalid encoding raises error ---
statement error
SELECT * FROM read_fasta('__WORKING_DIRECTORY__/test/data/ce.fa', sequence_encoding := 'bad');
----
sequence_encoding must be 'string' or 'nt16'

# --- read_fastq: nt16 returns UTINYINT list ---
query T
SELECT typeof(SEQUENCE)
FROM read_fastq('__WORKING_DIRECTORY__/test/data/r1.fq', sequence_encoding := 'nt16')
LIMIT 1;
----
UTINYINT[]

# --- read_fastq: nt16 values match expected codes (CCGTT → 2,2,4,8,8) ---
query T
SELECT SEQUENCE[1:5]::VARCHAR
FROM read_fastq('__WORKING_DIRECTORY__/test/data/r1.fq', sequence_encoding := 'nt16')
LIMIT 1;
----
[2, 2, 4, 8, 8]

# --- read_fastq: nt16 round-trips back to string ---
query I
SELECT seq_decode_4bit(e.SEQUENCE) = s.SEQUENCE
FROM (SELECT SEQUENCE FROM read_fastq('__WORKING_DIRECTORY__/test/data/r1.fq', sequence_encoding := 'nt16') LIMIT 1) e,
     (SELECT SEQUENCE FROM read_fastq('__WORKING_DIRECTORY__/test/data/r1.fq') LIMIT 1) s;
----
1

# --- read_fastq: invalid encoding raises error ---
statement error
SELECT * FROM read_fastq('__WORKING_DIRECTORY__/test/data/r1.fq', sequence_encoding := 'xyz');
----
sequence_encoding must be 'string' or 'nt16'

# ==============================================================
# hts_union_query – multi-file UNION ALL BY NAME macro
# ==============================================================

# --- hts_union_query: generates valid SQL for a single BAM file ---
statement ok
SET VARIABLE hts_q = hts_union_query('read_bam', '__WORKING_DIRECTORY__/test/data/range.bam');

query I
SELECT count(*) FROM query(getvariable('hts_q'));
----
112

# --- hts_union_query: result includes filename column ---
query I
SELECT count(DISTINCT filename) FROM query(getvariable('hts_q'));
----
1

# --- hts_union_query: with params passthrough ---
statement ok
SET VARIABLE hts_q = hts_union_query('read_bam', '__WORKING_DIRECTORY__/test/data/range.bam', 'region := ''CHROMOSOME_I:1-1000''');

query I
SELECT count(*) FROM query(getvariable('hts_q'));
----
2

# --- hts_union_query: BCF reader ---
statement ok
SET VARIABLE hts_q = hts_union_query('read_bcf', '__WORKING_DIRECTORY__/test/data/vcf_file.bcf');

query I
SELECT count(*) > 0 FROM query(getvariable('hts_q'));
----
1

# --- hts_union_query: FASTQ reader ---
statement ok
SET VARIABLE hts_q = hts_union_query('read_fastq', '__WORKING_DIRECTORY__/test/data/r1.fq');

query I
SELECT count(*) > 0 FROM query(getvariable('hts_q'));
----
1

# --- FILE_OFFSET: present in schema as UBIGINT after SAMPLE_ID ---
query TT
SELECT column_name, column_type
FROM (DESCRIBE SELECT * FROM read_bam('__WORKING_DIRECTORY__/test/data/range.bam'))
WHERE column_name IN ('SAMPLE_ID', 'FILE_OFFSET')
ORDER BY column_name;
----
FILE_OFFSET	UBIGINT
SAMPLE_ID	VARCHAR

# --- FILE_OFFSET: positive, unique, strictly increasing across all records ---
query I
WITH offsets AS (
    SELECT FILE_OFFSET FROM read_bam('__WORKING_DIRECTORY__/test/data/range.bam')
),
checks AS (
    SELECT
        COUNT(*) FILTER (WHERE FILE_OFFSET <= 0)        AS non_positive,
        COUNT(*) - COUNT(DISTINCT FILE_OFFSET)           AS duplicates
    FROM offsets
)
SELECT CASE WHEN non_positive = 0 AND duplicates = 0 THEN 1 ELSE 0 END FROM checks;
----
1

# --- FILE_OFFSET: ORDER BY FILE_OFFSET in LAG() has no inversions (CTE pattern) ---
query I
WITH windowed AS (
    SELECT FILE_OFFSET,
           LAG(FILE_OFFSET) OVER (ORDER BY FILE_OFFSET) AS prev_offset
    FROM read_bam('__WORKING_DIRECTORY__/test/data/range.bam')
)
SELECT COUNT(*) FILTER (WHERE prev_offset >= FILE_OFFSET) AS order_violations
FROM windowed;
----
0


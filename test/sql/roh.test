genetic map positions must be strictly ascending

# Map with a NULL cM.
statement error
SELECT duckhts_roh_segments([1000], [0.3], [[0, 30, 60]], [1000, 2000]::BIGINT[], [0.0, NULL]::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9);
----
genetic map entry 2 has a NULL position or cM value

# Map with a non-finite cM.
statement error
SELECT duckhts_roh_segments([1000], [0.3], [[0, 30, 60]], [1000, 2000]::BIGINT[], [0.0, 'NaN'::DOUBLE]::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9);
----
genetic map cM values must be finite


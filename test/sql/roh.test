# Kernel: a run of 60 sites at 0.3 frequency with hom-ref PL is one segment (start 1000, end 60000,
# quality 64.956...). Each kind of site bcftools skips must leave the result unchanged, to the bit.
query IIII
WITH s(pos) AS (SELECT i * 1000 FROM range(1, 61) AS t(i))
SELECT r.start, r."end", r.n_markers, round(r.quality, 3) FROM (
  SELECT unnest(duckhts_roh_segments(list(pos ORDER BY pos), list(0.3::DOUBLE ORDER BY pos),
    list([0, 30, 60] ORDER BY pos), NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9)) AS r FROM s);
----
1000	60000	60	64.956

# Skipped: missing (NULL) frequency.
query I
WITH base_sites(pos, seq, af, pl) AS (SELECT i * 1000 AS pos, 1 AS seq, 0.3::DOUBLE AS af, [0, 30, 60] AS pl FROM range(1, 61) AS t(i)),
all_sites(pos, seq, af, pl) AS (
  SELECT * FROM base_sites UNION ALL SELECT 30500, 1, NULL::DOUBLE, [60, 30, 0]
), decoded AS (
  SELECT
    (SELECT duckhts_roh_segments(list(pos ORDER BY pos, seq), list(af ORDER BY pos, seq), list(pl ORDER BY pos, seq), NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9) FROM base_sites) AS expected,
    (SELECT duckhts_roh_segments(list(pos ORDER BY pos, seq), list(af ORDER BY pos, seq), list(pl ORDER BY pos, seq), NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9) FROM all_sites) AS observed
)
SELECT expected = observed AND len(expected) = 1 AND expected[1].n_markers = 60 FROM decoded;
----
true

# Skipped: frequency exactly 0, and NaN.
query I
WITH base_sites(pos, seq, af, pl) AS (SELECT i * 1000 AS pos, 1 AS seq, 0.3::DOUBLE AS af, [0, 30, 60] AS pl FROM range(1, 61) AS t(i)),
all_sites(pos, seq, af, pl) AS (
  SELECT * FROM base_sites UNION ALL SELECT 30500, 1, 0.0::DOUBLE, [60, 30, 0] UNION ALL SELECT 30600, 1, 'NaN'::DOUBLE, [60, 30, 0]
), decoded AS (
  SELECT
    (SELECT duckhts_roh_segments(list(pos ORDER BY pos, seq), list(af ORDER BY pos, seq), list(pl ORDER BY pos, seq), NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9) FROM base_sites) AS expected,
    (SELECT duckhts_roh_segments(list(pos ORDER BY pos, seq), list(af ORDER BY pos, seq), list(pl ORDER BY pos, seq), NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9) FROM all_sites) AS observed
)
SELECT expected = observed AND len(expected) = 1 AND expected[1].n_markers = 60 FROM decoded;
----
true

# Skipped: PL values all equal, NULL PL, NULL element, wrong length, negative.
query I
WITH base_sites(pos, seq, af, pl) AS (SELECT i * 1000 AS pos, 1 AS seq, 0.3::DOUBLE AS af, [0, 30, 60] AS pl FROM range(1, 61) AS t(i)),
all_sites(pos, seq, af, pl) AS (
  SELECT * FROM base_sites UNION ALL SELECT 30100, 1, 0.3::DOUBLE, [0, 0, 0] UNION ALL SELECT 30200, 1, 0.3::DOUBLE, [7, 7, 7] UNION ALL SELECT 30300, 1, 0.3::DOUBLE, NULL UNION ALL SELECT 30400, 1, 0.3::DOUBLE, [60, NULL, 0] UNION ALL SELECT 30500, 1, 0.3::DOUBLE, [60, 0] UNION ALL SELECT 30600, 1, 0.3::DOUBLE, [60, 30, 0, 90] UNION ALL SELECT 30700, 1, 0.3::DOUBLE, [60, -1, 0]
), decoded AS (
  SELECT
    (SELECT duckhts_roh_segments(list(pos ORDER BY pos, seq), list(af ORDER BY pos, seq), list(pl ORDER BY pos, seq), NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9) FROM base_sites) AS expected,
    (SELECT duckhts_roh_segments(list(pos ORDER BY pos, seq), list(af ORDER BY pos, seq), list(pl ORDER BY pos, seq), NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9) FROM all_sites) AS observed
)
SELECT expected = observed AND len(expected) = 1 AND expected[1].n_markers = 60 FROM decoded;
----
true

# Skipped: a repeated position keeps its first entry, as bcftools skips duplicate positions.
query I
WITH base_sites(pos, seq, af, pl) AS (SELECT i * 1000 AS pos, 1 AS seq, 0.3::DOUBLE AS af, [0, 30, 60] AS pl FROM range(1, 61) AS t(i)),
all_sites(pos, seq, af, pl) AS (
  SELECT * FROM base_sites UNION ALL SELECT 30000, 2, 0.3::DOUBLE, [60, 30, 0] UNION ALL SELECT 1000, 2, 0.3::DOUBLE, [60, 30, 0]
), decoded AS (
  SELECT
    (SELECT duckhts_roh_segments(list(pos ORDER BY pos, seq), list(af ORDER BY pos, seq), list(pl ORDER BY pos, seq), NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9) FROM base_sites) AS expected,
    (SELECT duckhts_roh_segments(list(pos ORDER BY pos, seq), list(af ORDER BY pos, seq), list(pl ORDER BY pos, seq), NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9) FROM all_sites) AS observed
)
SELECT expected = observed AND len(expected) = 1 AND expected[1].n_markers = 60 FROM decoded;
----
true

# PL values above 255 count as 255.
query I
SELECT duckhts_roh_segments([1000, 2000, 3000], [0.3, 0.3, 0.3], [[0, 300, 400], [0, 255, 255], [0, 900, 255]], NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9)
     = duckhts_roh_segments([1000, 2000, 3000], [0.3, 0.3, 0.3], [[0, 255, 255], [0, 255, 255], [0, 255, 255]], NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9);
----
true

# GT dosage mode skips NULL dosages.
query I
SELECT duckhts_roh_segments([1000, 2000, 3000, 4000], [0.3, 0.3, 0.3, 0.3], [0, NULL, 0, 0], 30.0, NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9)
     = duckhts_roh_segments([1000, 3000, 4000], [0.3, 0.3, 0.3], [0, 0, 0], 30.0, NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9);
----
true

# NULL lists and NULL transition parameters give NULL; NULL map and rate mean no map and no rate.
query III
SELECT duckhts_roh_segments(NULL::BIGINT[], [0.3], [[0, 30, 60]], NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9) IS NULL,
       duckhts_roh_segments([1000], NULL::DOUBLE[], [[0, 30, 60]], NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9) IS NULL,
       duckhts_roh_segments([1000], [0.3], NULL::INTEGER[][], NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9) IS NULL;
----
true	true	true

query I
SELECT duckhts_roh_segments([1000], [0.3], [[0, 30, 60]], NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, NULL::DOUBLE, 5e-9) IS NULL;
----
true


# Input validation: each error names the problem.

# Lists of unequal length: positions and af.
statement error
SELECT duckhts_roh_segments([1000, 2000], [0.3], [[0, 30, 60], [0, 30, 60]], NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9);
----
positions and af lists differ in length (2 vs 1)

# Lists of unequal length: positions and PL.
statement error
SELECT duckhts_roh_segments([1000, 2000], [0.3, 0.3], [[0, 30, 60]], NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9);
----
positions and PL lists differ in length (2 vs 1)

# Lists of unequal length: positions and dosage.
statement error
SELECT duckhts_roh_segments([1000, 2000], [0.3, 0.3], [0], 30.0, NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9);
----
positions and genotype lists differ in length (2 vs 1)

# Unsorted positions.
statement error
SELECT duckhts_roh_segments([2000, 1000], [0.3, 0.3], [[0, 30, 60], [0, 30, 60]], NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9);
----
positions must be sorted ascending (entry 2 is 1000 after 2000)

# NULL position.
statement error
SELECT duckhts_roh_segments([1000, NULL], [0.3, 0.3], [[0, 30, 60], [0, 30, 60]], NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9);
----
positions cannot contain NULL (entry 2)

# Position below 1.
statement error
SELECT duckhts_roh_segments([0], [0.3], [[0, 30, 60]], NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9);
----
position 0 is outside 1..2147483647

# Position above int32.
statement error
SELECT duckhts_roh_segments([2147483648], [0.3], [[0, 30, 60]], NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9);
----
position 2147483648 is outside 1..2147483647

# Frequency above 1.
statement error
SELECT duckhts_roh_segments([1000], [1.5], [[0, 30, 60]], NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9);
----
af must be in [0, 1] (entry 1 is 1.5)

# Negative frequency.
statement error
SELECT duckhts_roh_segments([1000], [-0.1], [[0, 30, 60]], NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9);
----
af must be in [0, 1]

# Dosage outside 0..2.
statement error
SELECT duckhts_roh_segments([1000], [0.3], [3], 30.0, NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9);
----
genotype dosage must be 0, 1 or 2 (entry 1 is 3)

# Negative gt_error.
statement error
SELECT duckhts_roh_segments([1000], [0.3], [0], -1.0, NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9);
----
gt_error must be a finite phred value of at least 0

# hw_to_az above 1.
statement error
SELECT duckhts_roh_segments([1000], [0.3], [[0, 30, 60]], NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 2.0, 5e-9);
----
hw_to_az must be in [0, 1]

# az_to_hw below 0.
statement error
SELECT duckhts_roh_segments([1000], [0.3], [[0, 30, 60]], NULL::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, -1.0);
----
az_to_hw must be in [0, 1]

# Negative rec_rate.
statement error
SELECT duckhts_roh_segments([1000], [0.3], [[0, 30, 60]], NULL::BIGINT[], NULL::DOUBLE[], -1.0, 6.7e-8, 5e-9);
----
rec_rate must be finite and at least 0

# Map positions without cM.
statement error
SELECT duckhts_roh_segments([1000], [0.3], [[0, 30, 60]], [1000]::BIGINT[], NULL::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9);
----
genetic map positions and cM values must both be given or both NULL

# Map lists of unequal length.
statement error
SELECT duckhts_roh_segments([1000], [0.3], [[0, 30, 60]], [1000, 2000]::BIGINT[], [0.0]::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9);

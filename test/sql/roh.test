# name: test/sql/roh.test
# description: Runs of homozygosity: kernel contract and bcftools roh parity
# group: [duckhts]

require duckhts

# Parity with `bcftools roh` (1.23.1-70-g6dbd8fef) on test/data/roh_fixture.vcf.gz: four samples,
# two contigs, planted homozygous stretches over heterozygous background, records with missing
# AF, AF = 0, missing and uninformative genotypes, PL above 255, an indel, a multiallelic record
# and a record without ALT. The expected rows are the RG lines printed by
# test/scripts/roh_bcftools_expected.sh. Start, end, length and marker counts must be equal;
# quality is compared at the one decimal that bcftools prints (%.1f), which is the only
# tolerance and arises from the output format, not from the arithmetic.

statement ok
CREATE TEMP TABLE roh_af AS SELECT chrom, pos, split_part(alleles, ',', 1) AS ref,
  split_part(alleles, ',', 2) AS alt, af
FROM read_csv('__WORKING_DIRECTORY__/test/data/roh_af.tsv.gz', delim = '\t', header = false,
  columns = {'chrom': 'VARCHAR', 'pos': 'BIGINT', 'alleles': 'VARCHAR', 'af': 'DOUBLE'});

statement ok
CREATE TEMP TABLE roh_map AS
  SELECT 'chr1' AS chrom, position AS pos, "Genetic_Map(cM)" AS cm FROM read_csv('__WORKING_DIRECTORY__/test/data/roh_map_chr1.txt', delim = ' ')
  UNION ALL
  SELECT 'chr2', position, "Genetic_Map(cM)" FROM read_csv('__WORKING_DIRECTORY__/test/data/roh_map_chr2.txt', delim = ' ');

statement ok
CREATE TEMP TABLE roh_map_chr1 AS SELECT * FROM roh_map WHERE chrom = 'chr1';

# PL emissions, frequencies from INFO/AF.
# bcftools: bcftools roh --AF-tag AF
query I
WITH expected(sample, chrom, start, "end", length, n_markers, quality) AS (VALUES
('S1', 'chr1', 1042655, 2396807, 1354153, 113, 32.0),
 ('S4', 'chr1', 1876100, 3319712, 1443613, 131, 44.8),
 ('S2', 'chr2', 693881, 1722963, 1029083, 114, 32.9),
 ('S4', 'chr2', 23420, 2400223, 2376804, 239, 46.6)
), observed AS (
  SELECT sample, chrom, start, "end", length, n_markers, quality FROM duckhts_roh('__WORKING_DIRECTORY__/test/data/roh_fixture.vcf.gz', 'AF')
)
SELECT count(*) FROM (
  (SELECT sample, chrom, start, "end", length, n_markers, CAST(quality AS DECIMAL(6, 1)) FROM observed
   EXCEPT ALL SELECT sample, chrom, start, "end", length, n_markers, CAST(quality AS DECIMAL(6, 1)) FROM expected)
  UNION ALL
  (SELECT sample, chrom, start, "end", length, n_markers, CAST(quality AS DECIMAL(6, 1)) FROM expected
   EXCEPT ALL SELECT sample, chrom, start, "end", length, n_markers, CAST(quality AS DECIMAL(6, 1)) FROM observed));
----
0

query I
SELECT count(*) FROM duckhts_roh('__WORKING_DIRECTORY__/test/data/roh_fixture.vcf.gz', 'AF');
----
4


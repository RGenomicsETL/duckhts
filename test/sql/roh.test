# Relation frequencies, GT emissions and a map together.
# bcftools: bcftools roh -G30 --AF-file test/data/roh_af.tsv.gz -m test/data/roh_map_{CHROM}.txt
query I
WITH expected(sample, chrom, start, "end", length, n_markers, quality) AS (VALUES
('S1', 'chr1', 1432927, 2396807, 963881, 94, 61.7),
 ('S4', 'chr1', 1876100, 3319712, 1443613, 131, 82.8),
 ('S2', 'chr2', 693881, 1722963, 1029083, 114, 37.2),
 ('S4', 'chr2', 23420, 2400223, 2376804, 238, 96.6)
), observed AS (
  SELECT sample, chrom, start, "end", length, n_markers, quality FROM duckhts_roh_af_table('__WORKING_DIRECTORY__/test/data/roh_fixture.vcf.gz', 'roh_af', 'roh_map', gt_error := 30)
)
SELECT count(*) FROM (
  (SELECT sample, chrom, start, "end", length, n_markers, CAST(quality AS DECIMAL(6, 1)) FROM observed
   EXCEPT ALL SELECT sample, chrom, start, "end", length, n_markers, CAST(quality AS DECIMAL(6, 1)) FROM expected)
  UNION ALL
  (SELECT sample, chrom, start, "end", length, n_markers, CAST(quality AS DECIMAL(6, 1)) FROM expected
   EXCEPT ALL SELECT sample, chrom, start, "end", length, n_markers, CAST(quality AS DECIMAL(6, 1)) FROM observed));

hw_to_az must be in [0, 1]

# Macro: a map with a repeated position.
statement ok
CREATE TEMP TABLE roh_bad_map AS SELECT 'chr1' AS chrom, 1000 AS pos, 0.0 AS cm UNION ALL SELECT 'chr1', 1000, 0.1;

statement error
SELECT * FROM duckhts_roh('__WORKING_DIRECTORY__/test/data/roh_fixture.vcf.gz', 'AF', 'roh_bad_map');
----
genetic map positions must be strictly ascending

# Overloads: a string third argument is the genetic map, a number is hw_to_az.
query I
SELECT count(*) FROM duckhts_roh('__WORKING_DIRECTORY__/test/data/roh_fixture.vcf.gz', 'AF', 'roh_map', az_to_hw := 5e-9);

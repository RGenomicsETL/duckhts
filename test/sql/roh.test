genetic map is empty

# Unsorted map.
statement error
SELECT duckhts_roh_segments([1000], [0.3], [[0, 30, 60]], [2000, 1000]::BIGINT[], [0.1, 0.0]::DOUBLE[], NULL::DOUBLE, 6.7e-8, 5e-9);

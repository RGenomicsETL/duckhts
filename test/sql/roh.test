# Per-sample AF equals the equivalent per-site table, with and without a map.
query I
WITH tuned AS (SELECT * FROM duckhts_roh_ancestry('__WORKING_DIRECTORY__/test/data/roh_fixture.vcf.gz',
  'roh_ancestry_reference', 'roh_ancestry_proportions', gt_error := 30, samples := 'S1')),
pooled AS (SELECT * FROM duckhts_roh_af_table('__WORKING_DIRECTORY__/test/data/roh_fixture.vcf.gz',
  'roh_ancestry_af', gt_error := 30, samples := 'S1'))
SELECT count(*) FROM ((SELECT * FROM tuned EXCEPT ALL SELECT * FROM pooled)
UNION ALL (SELECT * FROM pooled EXCEPT ALL SELECT * FROM tuned));
----
0

query I
WITH tuned AS (SELECT * FROM duckhts_roh_ancestry('__WORKING_DIRECTORY__/test/data/roh_fixture.vcf.gz',
  'roh_ancestry_reference', 'roh_ancestry_proportions', 'roh_map', gt_error := 30, samples := 'S1')),
pooled AS (SELECT * FROM duckhts_roh_af_table('__WORKING_DIRECTORY__/test/data/roh_fixture.vcf.gz',
  'roh_ancestry_af', 'roh_map', gt_error := 30, samples := 'S1'))
SELECT count(*) FROM ((SELECT * FROM tuned EXCEPT ALL SELECT * FROM pooled)
UNION ALL (SELECT * FROM pooled EXCEPT ALL SELECT * FROM tuned));
----
0

statement ok
CREATE TEMP TABLE roh_ancestry_missing AS
SELECT * FROM roh_ancestry_proportions WHERE sample_id <> 'S1';

statement ok
CREATE TEMP TABLE roh_ancestry_mismatch AS
SELECT sample_id, CASE WHEN group_id = 'B' THEN 'C' ELSE group_id END AS group_id,
       proportion FROM roh_ancestry_proportions;

statement error
SELECT count(*) FROM duckhts_roh_ancestry('__WORKING_DIRECTORY__/test/data/roh_fixture.vcf.gz',
  'roh_ancestry_reference', 'roh_ancestry_missing', gt_error := 30, samples := 'S1');
----
every VCF sample requires ancestry proportions

statement error
SELECT count(*) FROM duckhts_roh_ancestry('__WORKING_DIRECTORY__/test/data/roh_fixture.vcf.gz',
  'roh_ancestry_reference', 'roh_ancestry_mismatch', gt_error := 30, samples := 'S1');
----
reference and proportions group sets must match exactly

# Constant recombination rate (-M).
# bcftools: bcftools roh --AF-tag AF -M 1e-6
query I
WITH expected(sample, chrom, start, "end", length, n_markers, quality) AS (VALUES
('S1', 'chr1', 1432927, 2396807, 963881, 95, 49.7),
 ('S4', 'chr1', 1876100, 3319712, 1443613, 131, 66.6),
 ('S2', 'chr2', 693881, 1722963, 1029083, 114, 40.7),
 ('S4', 'chr2', 23420, 2400223, 2376804, 239, 79.2)
), observed AS (
  SELECT sample, chrom, start, "end", length, n_markers, quality FROM duckhts_roh('__WORKING_DIRECTORY__/test/data/roh_fixture.vcf.gz', 'AF', rec_rate := 1e-6)
)
SELECT count(*) FROM (
  (SELECT sample, chrom, start, "end", length, n_markers, CAST(quality AS DECIMAL(6, 1)) FROM observed
   EXCEPT ALL SELECT sample, chrom, start, "end", length, n_markers, CAST(quality AS DECIMAL(6, 1)) FROM expected)
  UNION ALL
  (SELECT sample, chrom, start, "end", length, n_markers, CAST(quality AS DECIMAL(6, 1)) FROM expected
   EXCEPT ALL SELECT sample, chrom, start, "end", length, n_markers, CAST(quality AS DECIMAL(6, 1)) FROM observed));
----
0

query I
SELECT count(*) FROM duckhts_roh('__WORKING_DIRECTORY__/test/data/roh_fixture.vcf.gz', 'AF', rec_rate := 1e-6);
----
4


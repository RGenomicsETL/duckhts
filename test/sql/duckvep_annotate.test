# name: test/sql/duckvep_annotate.test
# description: Stable-API DuckVEP model registry and vector annotation vertical
# group: [duckhts]

require duckhts

statement ok
CREATE TABLE duckvep_test_regions AS
SELECT * FROM (VALUES (0::UINTEGER), (1::UINTEGER)) t(seq_region);

statement ok
CREATE TABLE duckvep_test_transcripts AS
SELECT
  0::UINTEGER transcript_index,
  1::UINTEGER seq_region,
  100::UBIGINT transcript_start,
  250::UBIGINT transcript_end,
  1::TINYINT strand,
  0::UINTEGER gene_index,
  3::UBIGINT transcript_flags,
  120::UBIGINT cds_start,
  240::UBIGINT cds_end,
  'ATGGTACGTACGTACGTACGTACGTACGTACTACGTACGTACGTACGTACGTACGTACGTACGTACTGGTAA'::BLOB cds_sequence,
  1::UTINYINT codon_table,
  'TACGTACGTACGTACGTACG'::BLOB pre_cds_sequence,
  'ACGTACGTAC'::BLOB post_cds_sequence;

statement ok
CREATE TABLE duckvep_test_exons AS
SELECT * FROM (VALUES
  (0::UINTEGER, 100::UBIGINT, 150::UBIGINT, 1::UBIGINT, 51::UBIGINT, 0::TINYINT, 0::TINYINT),
  (0::UINTEGER, 200::UBIGINT, 250::UBIGINT, 52::UBIGINT, 102::UBIGINT, 0::TINYINT, 0::TINYINT)
) t(transcript_index, exon_start, exon_end, exon_cdna_start, exon_cdna_end, phase, end_phase);

# Binding a setup call must not mutate the registry. Loading happens at execution.
statement ok
EXPLAIN SELECT * FROM duckvep_model_load(
  'explain_only',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_start'
);

query I
SELECT duckvep_model_drop('explain_only');
----
0

query I
SELECT loaded FROM duckvep_model_load(
  'fixture',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_start'
);
----
1

# The pure-C model validator is also the final authority for SQL-loaded models.
# A transcript span wider than its outer exon envelope must fail at load time.
statement error
SELECT * FROM duckvep_model_load(
  'invalid-envelope',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * REPLACE (99::UBIGINT AS transcript_start) FROM duckvep_test_transcripts ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_start'
);
----
transcript span is not the outer exon envelope

# Pinned VEP-116 coding predicates plus structural rows through the public vector.
query TTTTTTTTTT
WITH variants(ord, id, seq_region, position, reference, alternate) AS (
  VALUES
    (1, 'start_lost', 1::UINTEGER, 120::UBIGINT, 'A', 'T'),
    (2, 'missense', 1::UINTEGER, 124::UBIGINT, 'T', 'C'),
    (3, 'synonymous', 1::UINTEGER, 125::UBIGINT, 'A', 'C'),
    (4, 'intron', 1::UINTEGER, 160::UBIGINT, 'T', 'C'),
    (5, 'stop_gained', 1::UINTEGER, 236::UBIGINT, 'G', 'A'),
    (6, 'stop_lost', 1::UINTEGER, 238::UBIGINT, 'T', 'C'),
    (7, 'stop_retained', 1::UINTEGER, 239::UBIGINT, 'A', 'G'),
    (8, 'intergenic', 0::UINTEGER, 100::UBIGINT, 'A', 'C')
)
SELECT
  id,
  coalesce(annotation.transcript_index::VARCHAR, '-'),
  annotation.consequence,
  annotation.impact,
  annotation.region,
  annotation.status,
  coalesce(annotation.reason, '-'),
  coalesce(annotation.cdna_position::VARCHAR, '-'),
  coalesce(annotation.cds_position::VARCHAR, '-'),
  coalesce(annotation.protein_position::VARCHAR, '-')
FROM variants,
LATERAL unnest(duckvep_annotate(
  'fixture', seq_region, position, reference, alternate, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord, annotation.transcript_index NULLS FIRST;
----
start_lost	0	start_lost	HIGH	CDS	supported	-	21	1	1
missense	0	missense_variant	MODERATE	CDS	supported	-	25	5	2
synonymous	0	synonymous_variant	LOW	CDS	supported	-	26	6	2
intron	0	intron_variant	MODIFIER	intron	supported	-	-	-	-
stop_gained	0	stop_gained	HIGH	CDS	supported	-	88	68	23
stop_lost	0	stop_lost	HIGH	CDS	supported	-	90	70	24
stop_retained	0	stop_retained_variant	LOW	CDS	supported	-	91	71	24
intergenic	-	sequence_variant	MODIFIER	NULL	unresolved	no_feature_in_loaded_model	-	-	-

# The compact surface runs the same kernel but preserves masks and enum bytes.
query TTIIIIITTTTTII
WITH variants(ord, id, seq_region, position, reference, alternate) AS (
  VALUES
    (1, 'missense', 1::UINTEGER, 124::UBIGINT, 'T', 'C'),
    (2, 'intron', 1::UINTEGER, 160::UBIGINT, 'T', 'C'),
    (3, 'reference_mismatch', 1::UINTEGER, 124::UBIGINT, 'A', 'C'),
    (4, 'partial_no_feature', 0::UINTEGER, 100::UBIGINT, 'A', 'C')
)
SELECT
  id,
  coalesce(annotation.transcript_index::VARCHAR, '-'),
  annotation.consequence_mask,
  annotation.region_mask,
  annotation.impact_code,
  annotation.status_code,
  annotation.reason_code,
  coalesce(annotation.cdna_position::VARCHAR, '-'),
  coalesce(annotation.cds_position::VARCHAR, '-'),
  coalesce(annotation.protein_position::VARCHAR, '-'),
  coalesce(annotation.reference_amino_acid_code::VARCHAR, '-'),
  coalesce(annotation.alternate_amino_acid_code::VARCHAR, '-'),
  annotation.nmd_prediction_code,
  annotation.nmd_escape_reasons
FROM variants,
LATERAL unnest(duckvep_annotate_compact(
  'fixture', seq_region, position, reference, alternate, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord, annotation.transcript_index NULLS FIRST;
----
missense	0	8192	16	2	0	0	25	5	2	86	65	0	0
intron	0	4	4	0	0	0	-	-	-	-	-	0	0
reference_mismatch	0	2048	16	0	1	4	-	-	-	-	-	0	0
partial_no_feature	-	0	0	0	1	1	-	-	-	-	-	0	0

# VEP 116 keeps an equal-length uploaded feature as the peptide-predicate
# window even when prefix/suffix trimming leaves the same one-base CDS edit as
# a paired SNV. The retained start/stop codon changes the predicate state.
query ITTT
WITH variants(ord, position, reference, alternate) AS (
  VALUES
    (1, 122::UBIGINT, 'GG', 'GA'),
    (2, 123::UBIGINT, 'G', 'A'),
    (3, 237::UBIGINT, 'GT', 'TT'),
    (4, 237::UBIGINT, 'G', 'T'),
    (5, 237::UBIGINT, 'GT', 'AT'),
    (6, 237::UBIGINT, 'G', 'A'),
    (7, 122::UBIGINT, 'AG', 'AA'),
    (8, 122::UBIGINT, 'NG', 'NA')
)
SELECT ord, annotation.consequence, annotation.status,
       coalesce(annotation.reason, '-')
FROM variants,
LATERAL unnest(duckvep_annotate(
  'fixture', 1::UINTEGER, position, reference, alternate, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	start_lost&start_retained_variant	supported	-
2	missense_variant	supported	-
3	stop_retained_variant	supported	-
4	missense_variant	supported	-
5	missense_variant	supported	-
6	stop_gained	supported	-
7	coding_sequence_variant	unresolved	reference_mismatch
8	coding_sequence_variant	unresolved	ambiguous_sequence

# VEP maps an equal-length feature crossing 5' UTR into CDS through the start
# codon only. Preserving ATG suppresses later coding changes in the same feature.
query ITT
WITH variants(ord, position, reference, alternate) AS (
  VALUES
    (1, 119::UBIGINT, 'GA', 'AC'),
    (2, 118::UBIGINT, 'CGA', 'GAA'),
    (3, 119::UBIGINT, 'GATGGT', 'TATGAT'),
    (4, 119::UBIGINT, 'GATG', 'GTAA')
)
SELECT ord, annotation.consequence, annotation.status
FROM variants,
LATERAL unnest(duckvep_annotate(
  'fixture', 1::UINTEGER, position, reference, alternate, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	start_lost&5_prime_UTR_variant	supported
2	start_retained_variant&5_prime_UTR_variant	supported
3	start_retained_variant&5_prime_UTR_variant	supported
4	start_lost&5_prime_UTR_variant	supported

# VEP's length-changing start/stop predicates rebuild UTR+CDS strings. These
# are real VEP-116 witnesses, including its odd lost+retained start state.
query ITTT
WITH variants(ord, position, reference, alternate) AS (
  VALUES
    (1, 117::UBIGINT, 'ACGA', 'A'),
    (2, 118::UBIGINT, 'CGA', 'C'),
    (3, 118::UBIGINT, 'CGA', 'CACAC'),
    (4, 239::UBIGINT, 'AAA', 'A'),
    (5, 239::UBIGINT, 'AAAC', 'A'),
    (6, 240::UBIGINT, 'AA', 'C')
)
SELECT ord, annotation.consequence, annotation.status,
       coalesce(annotation.reason, '-')
FROM variants,
LATERAL unnest(duckvep_annotate(
  'fixture', 1::UINTEGER, position, reference, alternate, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	start_lost&start_retained_variant&5_prime_UTR_variant	supported	-
2	start_lost&5_prime_UTR_variant	supported	-
3	start_lost&5_prime_UTR_variant	supported	-
4	stop_lost&3_prime_UTR_variant	supported	-
5	stop_retained_variant&3_prime_UTR_variant	supported	-
6	stop_lost&3_prime_UTR_variant	supported	-

# The stronger overload requires contig lengths before a caller may declare
# complete transcript coverage and receive supported intergenic assertions.
statement error
SELECT * FROM duckvep_model_load(
  'invalid-complete',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_start',
  transcript_coverage_complete := TRUE
);
----
complete transcript coverage requires sequence_length

query I
SELECT loaded FROM duckvep_model_load(
  'fixture-complete',
  'SELECT seq_region, 1000::UBIGINT AS sequence_length FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_start',
  transcript_coverage_complete := TRUE
);
----
1

query TTTT
SELECT annotation.consequence, annotation.status,
       coalesce(annotation.reason, '-'), annotation.region
FROM unnest(duckvep_annotate(
  'fixture-complete', 0::UINTEGER, 100::UBIGINT, 'A', 'C', 0::UBIGINT
)) AS u(annotation);
----
intergenic_variant	supported	-	intergenic

query IIII
SELECT annotation.consequence_mask, annotation.region_mask,
       annotation.status_code, annotation.reason_code
FROM unnest(duckvep_annotate_compact(
  'fixture-complete', 0::UINTEGER, 100::UBIGINT, 'A', 'C'
)) AS u(annotation);
----
8589934592	0	0	0

statement error
SELECT duckvep_annotate(
  'fixture-complete', 1::UINTEGER, 1001::UBIGINT, 'A', 'C', 0::UBIGINT
);
----
variant span exceeds sequence-region length

# Several named models may coexist and may occur in the same DuckDB vector.
statement ok
CREATE TABLE duckvep_test_transcripts_2 AS
SELECT * REPLACE (7::UINTEGER AS gene_index)
FROM duckvep_test_transcripts;

query I
SELECT loaded FROM duckvep_model_load(
  'fixture2',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts_2 ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_start'
);
----
1

query IIT
WITH variants(ord, model_name, position, reference, alternate) AS (
  VALUES
    (1, 'fixture', 124::UBIGINT, 'T', 'C'),
    (2, 'fixture2', 124::UBIGINT, 'T', 'C'),
    (3, 'fixture', 125::UBIGINT, 'A', 'C')
)
SELECT ord, annotation.gene_index, annotation.consequence
FROM variants,
LATERAL unnest(duckvep_annotate(
  model_name, 1::UINTEGER, position, reference, alternate, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	0	missense_variant
2	7	missense_variant
3	0	synonymous_variant

# A coding span may be loaded before its sequence is prepared. Structural
# coding classification remains available and the unresolved sequence predicate
# is explicit.
statement ok
CREATE TABLE duckvep_test_transcripts_structural AS
SELECT * REPLACE (
  NULL::BLOB AS cds_sequence,
  NULL::UTINYINT AS codon_table,
  NULL::BLOB AS pre_cds_sequence,
  NULL::BLOB AS post_cds_sequence
)
FROM duckvep_test_transcripts;

query I
SELECT loaded FROM duckvep_model_load(
  'structural',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts_structural ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_cdna_start'
);
----
1

query TTT
SELECT annotation.consequence, annotation.status, annotation.reason
FROM unnest(duckvep_annotate(
  'structural', 1::UINTEGER, 124::UBIGINT, 'T', 'C', 0::UBIGINT
)) AS u(annotation);
----
coding_sequence_variant	unresolved	missing_sequence

# A REF disagreement with the prepared CDS is auditable and does not become a
# generic unsupported-sequence result.
query TTT
SELECT annotation.consequence, annotation.status, annotation.reason
FROM unnest(duckvep_annotate(
  'fixture', 1::UINTEGER, 124::UBIGINT, 'A', 'C', 0::UBIGINT
)) AS u(annotation);
----
coding_sequence_variant	unresolved	reference_mismatch

# A protein coordinate is useful for a frameshift, but the compact row has no
# scalar one-letter amino-acid pair. Absence is NULL, not an empty string.
query TTIIII
SELECT annotation.consequence, annotation.nmd_prediction,
       annotation.nmd_escape_early_cds::INTEGER,
       (annotation.protein_position IS NOT NULL)::INTEGER,
       (annotation.reference_amino_acid IS NULL)::INTEGER,
       (annotation.alternate_amino_acid IS NULL)::INTEGER
FROM unnest(duckvep_annotate(
  'fixture', 1::UINTEGER, 124::UBIGINT, 'T', 'TC', 0::UBIGINT
)) AS u(annotation);
----
frameshift_variant	escaping	1	1	1	1

# VEP 116 places an insertion on the exon/CDS side of a boundary while its
# splice predicates retain the interbase interval. These are fixed witnesses
# from the real VEP differential, not hand-assigned consequence examples.
query ITTT
WITH variants(ord, position, reference, alternate) AS (
  VALUES
    (1, 199::UBIGINT, 'G', 'GT'),
    (2, 199::UBIGINT, 'G', 'GATG'),
    (3, 240::UBIGINT, 'A', 'AATG'),
    (4, 250::UBIGINT, 'C', 'CT')
)
SELECT ord, annotation.consequence, annotation.status,
       coalesce(annotation.reason, '-')
FROM variants,
LATERAL unnest(duckvep_annotate(
  'fixture', 1::UINTEGER, position, reference, alternate, 1::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	frameshift_variant&splice_region_variant	supported	-
2	protein_altering_variant&splice_region_variant	supported	-
3	3_prime_UTR_variant	supported	-
4	downstream_gene_variant	supported	-

# VEP handles a frame-changing edit that begins in the terminal stop through
# stop_lost/stop_retained, not frameshift_variant. Deletions may need the first
# post-CDS reference base to reconstruct the codon at the original endpoint.
query ITTT
WITH variants(ord, position, reference, alternate) AS (
  VALUES
    (1, 238::UBIGINT, 'T', 'AC'),
    (2, 238::UBIGINT, 'TA', 'T'),
    (3, 239::UBIGINT, 'AA', 'A'),
    (4, 240::UBIGINT, 'A', 'CG'),
    (5, 239::UBIGINT, 'AA', 'CA'),
    (6, 240::UBIGINT, 'AA', 'TA')
)
SELECT ord, annotation.consequence, annotation.status,
       coalesce(annotation.reason, '-')
FROM variants,
LATERAL unnest(duckvep_annotate(
  'fixture', 1::UINTEGER, position, reference, alternate, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	stop_lost	supported	-
2	stop_retained_variant	supported	-
3	stop_retained_variant	supported	-
4	stop_lost	supported	-
5	stop_lost	supported	-
6	coding_sequence_variant&3_prime_UTR_variant	supported	-

# The original eleven-column model remains valid. A terminal deletion that needs
# post-CDS bases fails closed rather than becoming a false frameshift.
statement ok
CREATE TABLE duckvep_test_transcripts_no_tail AS
SELECT * EXCLUDE (pre_cds_sequence, post_cds_sequence)
FROM duckvep_test_transcripts;

query I
SELECT loaded FROM duckvep_model_load(
  'fixture-no-tail',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts_no_tail ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_start'
);
----
1

query TTT
SELECT annotation.consequence, annotation.status, annotation.reason
FROM unnest(duckvep_annotate(
  'fixture-no-tail', 1::UINTEGER, 238::UBIGINT, 'TA', 'T', 0::UBIGINT
)) AS u(annotation);
----
coding_sequence_variant	unresolved	missing_transcript_tail

# The legacy twelfth column carries only a short post-CDS prefix. It still
# resolves terminal codons, but it cannot pretend to contain a complete UTR.
statement ok
CREATE TABLE duckvep_test_transcripts_legacy_tail AS
SELECT * EXCLUDE (pre_cds_sequence, post_cds_sequence),
       'ACG'::BLOB AS post_cds_bases
FROM duckvep_test_transcripts;

query I
SELECT loaded FROM duckvep_model_load(
  'fixture-legacy-tail',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts_legacy_tail ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_start'
);
----
1

query TTT
SELECT annotation.consequence, annotation.status,
       coalesce(annotation.reason, '-')
FROM unnest(duckvep_annotate(
  'fixture-legacy-tail', 1::UINTEGER, 238::UBIGINT, 'TA', 'T', 0::UBIGINT
)) AS u(annotation);
----
stop_retained_variant	supported	-

query TTT
SELECT annotation.consequence, annotation.status, annotation.reason
FROM unnest(duckvep_annotate(
  'fixture-legacy-tail', 1::UINTEGER, 117::UBIGINT, 'ACGA', 'A', 0::UBIGINT
)) AS u(annotation);
----
coding_sequence_variant&5_prime_UTR_variant	unresolved	missing_transcript_flank

# NMD_transcript_variant is the VEP biotype predicate: it co-emits for a
# variant inside a transcript already curated as nonsense_mediated_decay.
statement ok
CREATE TABLE duckvep_test_transcripts_nmd AS
SELECT * REPLACE (7::UBIGINT AS transcript_flags)
FROM duckvep_test_transcripts;

query I
SELECT loaded FROM duckvep_model_load(
  'nmd',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts_nmd ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_cdna_start'
);
----
1

query T
SELECT annotation.consequence
FROM unnest(duckvep_annotate(
  'nmd', 1::UINTEGER, 160::UBIGINT, 'T', 'C', 0::UBIGINT
)) AS u(annotation);
----
intron_variant&NMD_transcript_variant

# Variant-induced NMD is a separate VEP-116-plugin-compatible prediction. The
# four booleans expose every escape rule instead of hiding the decision in text.
statement ok
CREATE TABLE duckvep_nmd_prediction_transcripts AS
SELECT
  0::UINTEGER transcript_index,
  1::UINTEGER seq_region,
  100::UBIGINT transcript_start,
  498::UBIGINT transcript_end,
  1::TINYINT strand,
  0::UINTEGER gene_index,
  3::UBIGINT transcript_flags,
  100::UBIGINT cds_start,
  498::UBIGINT cds_end,
  ('ATG' || repeat('CAA', 81) || 'TAA')::BLOB cds_sequence,
  1::UTINYINT codon_table;

statement ok
CREATE TABLE duckvep_nmd_prediction_exons AS
SELECT * FROM (VALUES
  (0::UINTEGER, 100::UBIGINT, 199::UBIGINT, 1::UBIGINT, 100::UBIGINT,
   0::TINYINT, 1::TINYINT),
  (0::UINTEGER, 300::UBIGINT, 399::UBIGINT, 101::UBIGINT, 200::UBIGINT,
   1::TINYINT, 2::TINYINT),
  (0::UINTEGER, 450::UBIGINT, 498::UBIGINT, 201::UBIGINT, 249::UBIGINT,
   2::TINYINT, 0::TINYINT)
) t(transcript_index, exon_start, exon_end, exon_cdna_start, exon_cdna_end,
    phase, end_phase);

query I
SELECT loaded FROM duckvep_model_load(
  'nmd-prediction',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_nmd_prediction_transcripts ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_nmd_prediction_exons ORDER BY transcript_index, exon_cdna_start'
);
----
1

query ITTIIII
WITH variants(ord, position) AS (
  VALUES
    (1, 193::UBIGINT),
    (2, 305::UBIGINT),
    (3, 350::UBIGINT),
    (4, 454::UBIGINT)
)
SELECT ord, annotation.consequence, annotation.nmd_prediction,
       annotation.nmd_escape_intronless::INTEGER,
       annotation.nmd_escape_early_cds::INTEGER,
       annotation.nmd_escape_last_exon::INTEGER,
       annotation.nmd_escape_penultimate_exon_end::INTEGER
FROM variants,
LATERAL unnest(duckvep_annotate(
  'nmd-prediction', 1::UINTEGER, position, 'C', 'T', 0::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	stop_gained	escaping	0	1	0	0
2	stop_gained	triggering	0	0	0	0
3	stop_gained	escaping	0	0	0	1
4	stop_gained	escaping	0	0	1	0

# Decreasing positions remain correct by starting another sweep run.
query IT
WITH variants(ord, position, reference, alternate) AS (
  VALUES
    (1, 125::UBIGINT, 'A', 'C'),
    (2, 124::UBIGINT, 'T', 'C')
)
SELECT ord, annotation.consequence
FROM variants,
LATERAL unnest(duckvep_annotate(
  'fixture', 1::UINTEGER, position, reference, alternate, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	synonymous_variant
2	missense_variant

# The interval index seeds only the first row of a sorted run. A transcript that
# starts after that first window must still enter the continuing forward sweep.
query IT
WITH variants(ord, position) AS (
  VALUES (1, 80::UBIGINT), (2, 105::UBIGINT)
)
SELECT ord, annotation.consequence
FROM variants,
LATERAL unnest(duckvep_annotate(
  'fixture', 1::UINTEGER, position, 'A', 'C', 10::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	sequence_variant
2	5_prime_UTR_variant

# Essential splice positions use the VEP-116 splice predicate port.
query TTTT
SELECT annotation.consequence, annotation.status,
       coalesce(annotation.reason, '-'), annotation.nmd_prediction
FROM unnest(duckvep_annotate(
  'fixture', 1::UINTEGER, 151::UBIGINT, 'G', 'A', 0::UBIGINT
)) AS u(annotation);
----
splice_donor_variant	supported	-	unresolved

# More than one DuckDB vector reuses adapter and model workspace storage. The
# exact-distance path must retain its cgranges seed instead of rescanning the
# sequence region from its first transcript for every vector.
query I
SELECT count(*)
FROM (
  SELECT unnest(duckvep_annotate(
    'fixture', 1::UINTEGER, 124::UBIGINT, 'T', 'C', 0::UBIGINT
  )) AS annotation
  FROM range(5000)
)
WHERE annotation.consequence = 'missense_variant';
----
5000

# VCF permits the padding base to follow an indel at the first contig base.
# Both transcript strands must see the prepared event; the adapter must not
# reject it for lacking a common left prefix.
statement ok
CREATE TABLE duckvep_pos1_regions AS
SELECT 1::UINTEGER AS seq_region;

statement ok
CREATE TABLE duckvep_pos1_transcripts AS
SELECT * FROM (VALUES
  (0::UINTEGER, 1::UINTEGER, 1::UBIGINT, 20::UBIGINT, 1::TINYINT,
   0::UINTEGER, 0::UBIGINT, NULL::UBIGINT, NULL::UBIGINT, NULL::BLOB, NULL::UTINYINT),
  (1::UINTEGER, 1::UINTEGER, 1::UBIGINT, 20::UBIGINT, -1::TINYINT,
   1::UINTEGER, 0::UBIGINT, NULL::UBIGINT, NULL::UBIGINT, NULL::BLOB, NULL::UTINYINT)
) t(transcript_index, seq_region, transcript_start, transcript_end, strand,
    gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table);

statement ok
CREATE TABLE duckvep_pos1_exons AS
SELECT * FROM (VALUES
  (0::UINTEGER, 1::UBIGINT, 20::UBIGINT, 1::UBIGINT, 20::UBIGINT,
   -1::TINYINT, -1::TINYINT),
  (1::UINTEGER, 1::UBIGINT, 20::UBIGINT, 1::UBIGINT, 20::UBIGINT,
   -1::TINYINT, -1::TINYINT)
) t(transcript_index, exon_start, exon_end, exon_cdna_start, exon_cdna_end,
    phase, end_phase);

query I
SELECT loaded FROM duckvep_model_load(
  'position-one',
  'SELECT * FROM duckvep_pos1_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_pos1_transcripts ORDER BY seq_region, transcript_start, transcript_index',
  'SELECT * FROM duckvep_pos1_exons ORDER BY transcript_index, exon_cdna_start'
);
----
1

query IIT
WITH variants(ord, reference, alternate) AS (
  VALUES (1, 'AC', 'C'), (2, 'C', 'AC')
)
SELECT ord, count(*), min(annotation.consequence)
FROM variants,
LATERAL unnest(duckvep_annotate(
  'position-one', 1::UINTEGER, 1::UBIGINT, reference, alternate, 0::UBIGINT
)) AS u(annotation)
GROUP BY ord
ORDER BY ord;
----
1	2	non_coding_transcript_exon_variant
2	2	non_coding_transcript_exon_variant


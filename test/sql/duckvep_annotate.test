# Variant-induced NMD is a separate VEP-116-plugin-compatible prediction. The
# four booleans expose every escape rule instead of hiding the decision in text.
statement ok
CREATE TABLE duckvep_nmd_prediction_transcripts AS
SELECT
  0::UINTEGER transcript_index,
  1::UINTEGER seq_region,

# Several named models may coexist and may occur in the same DuckDB vector.
statement ok
CREATE TABLE duckvep_test_transcripts_2 AS
SELECT * REPLACE (7::UINTEGER AS gene_index)
FROM duckvep_test_transcripts;

query I
SELECT loaded FROM duckvep_model_load(
  'fixture2',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts_2 ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_start'
);
----
1

query IIT
WITH variants(ord, model_name, position, reference, alternate) AS (
  VALUES
    (1, 'fixture', 124::UBIGINT, 'T', 'C'),
    (2, 'fixture2', 124::UBIGINT, 'T', 'C'),
    (3, 'fixture', 125::UBIGINT, 'A', 'C')
)
SELECT ord, annotation.gene_index, annotation.consequence
FROM variants,
LATERAL unnest(_duckvep_annotate_small_rich(
  model_name, 1::UINTEGER, position, reference, alternate, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	0	missense_variant
2	7	missense_variant
3	0	synonymous_variant

# A coding span may be loaded before its sequence is prepared. Structural
# coding classification remains available and the unresolved sequence predicate
# is explicit.
statement ok
CREATE TABLE duckvep_test_transcripts_structural AS
SELECT * REPLACE (
  NULL::BLOB AS cds_sequence,
  NULL::UTINYINT AS codon_table,
  NULL::BLOB AS pre_cds_sequence,
  NULL::BLOB AS post_cds_sequence
)
FROM duckvep_test_transcripts;

query I
SELECT loaded FROM duckvep_model_load(
  'structural',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts_structural ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_cdna_start'
);
----
1

query TTT
SELECT annotation.consequence, annotation.status, annotation.reason
FROM unnest(_duckvep_annotate_small_rich(
  'structural', 1::UINTEGER, 124::UBIGINT, 'T', 'C', 0::UBIGINT
)) AS u(annotation);
----
coding_sequence_variant	unresolved	missing_sequence

# Exact structural spans use typed operation and copy-direction fields. They do
# not pass symbolic alleles through the small-variant adapter.
query TTTT
WITH events(ord, start1, end1, structural_type, copy_change) AS (
  VALUES
    (1, 90::UBIGINT, 260::UBIGINT, 'DEL', 'LOSS'),
    (2, 90::UBIGINT, 260::UBIGINT, 'DUP', 'GAIN'),
    (3, 110::UBIGINT, 230::UBIGINT, 'CNV', 'LOSS'),
    (4, 110::UBIGINT, 230::UBIGINT, 'CNV', 'GAIN'),
    (5, 90::UBIGINT, 260::UBIGINT, 'STR', 'UNKNOWN')
)
SELECT structural_type, copy_change, annotation.consequence, annotation.status
FROM events,
LATERAL unnest(_duckvep_annotate_structural_rich(
  'structural', 1::UINTEGER, start1, end1, structural_type, copy_change,
  0::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
DEL	LOSS	transcript_ablation	supported
DUP	GAIN	transcript_amplification	supported
CNV	LOSS	start_lost&feature_truncation&start_retained_variant&coding_sequence_variant&5_prime_UTR_variant&intron_variant	supported
CNV	GAIN	start_lost&feature_elongation&start_retained_variant&coding_sequence_variant&5_prime_UTR_variant&intron_variant	supported
STR	UNKNOWN	transcript_amplification	supported

query IIIII
SELECT annotation.consequence_mask, annotation.region_mask,
       annotation.impact_code, annotation.status_code, annotation.reason_code
FROM unnest(_duckvep_annotate_structural_compact(
  'structural', 1::UINTEGER, 90::UBIGINT, 260::UBIGINT,
  'DUP', 'GAIN', 0::UBIGINT
)) AS u(annotation);
----
67108864	116	3	0	0

statement error
SELECT _duckvep_annotate_structural_rich(
  'structural', 1::UINTEGER, 100::UBIGINT, 200::UBIGINT,
  'DEL', 'GAIN'
);
----
structural type contradicts copy change

# One BND input carries both raw VCF endpoints. VEP shifts the local POS by one
# for ordinary transcript topology, retains the mate coordinate verbatim, and
# may create two internal overlap alleles. DuckVEP returns their transcript-level
# consequence-set union once.
query TTTT
WITH bnd_event(event_id, local_region, local_position, mate_region, mate_position) AS (
  VALUES ('bnd-1', 1::UINTEGER, 159::UBIGINT, 1::UINTEGER, 170::UBIGINT)
)
SELECT event_id, annotation.consequence,
       coalesce(annotation.region, '-'), annotation.status
FROM bnd_event,
LATERAL unnest(_duckvep_annotate_breakend_rich(
  'structural', local_region, local_position, mate_region, mate_position,
  0::UBIGINT
)) AS u(annotation);
----
bnd-1	feature_truncation&intron_variant	intron	supported

query IIIII
SELECT annotation.consequence_mask, annotation.region_mask,
       annotation.impact_code, annotation.status_code, annotation.reason_code
FROM unnest(_duckvep_annotate_breakend_compact(
  'structural', 1::UINTEGER, 159::UBIGINT,
  1::UINTEGER, 170::UBIGINT, 0::UBIGINT
)) AS u(annotation);
----
268435460	4	3	0	0

# The public relation surface derives all three event families from one narrow,
# globally coordinate-ordered event relation. It carries only event_index into
# transcript expansion and leaves HGVS columns NULL when hgvs is disabled.
statement ok
CREATE TABLE duckvep_mixed_events AS
SELECT * FROM (VALUES
  (1::UBIGINT, 1::UINTEGER, 90::UBIGINT, NULL::VARCHAR, '<DUP>'::VARCHAR,
   260::UBIGINT, NULL::VARCHAR, NULL::VARCHAR, NULL::UINTEGER, NULL::UBIGINT),
  (2::UBIGINT, 1::UINTEGER, 124::UBIGINT, 'T'::VARCHAR, 'C'::VARCHAR,
   NULL::UBIGINT, NULL::VARCHAR, NULL::VARCHAR, NULL::UINTEGER, NULL::UBIGINT),
  (3::UBIGINT, 1::UINTEGER, 159::UBIGINT, NULL::VARCHAR, 'N]1:170]'::VARCHAR,
   NULL::UBIGINT, NULL::VARCHAR, NULL::VARCHAR, 1::UINTEGER, 170::UBIGINT)
) t(event_index, seq_region, position, reference, alternate, end_position,
    structural_type, copy_change, mate_seq_region, mate_position);

query ITII
SELECT event_index, duckvep_event_kind, consequence_mask,
       transcript_hgvs IS NULL
FROM duckvep_annotate(
  'duckvep_mixed_events', 'structural',
  upstream_distance := 0, downstream_distance := 0
)
ORDER BY event_index;
----
1	structural_variant	67108864	1
2	small_variant	2048	1
3	breakend	268435460	1

# An explicit NULL HGVS selector follows the documented FALSE default instead
# of filtering small variants out of both native lanes.
query ITII
SELECT event_index, duckvep_event_kind, consequence_mask,
       transcript_hgvs IS NULL
FROM duckvep_annotate(
  'duckvep_mixed_events', 'structural', hgvs := NULL,
  upstream_distance := 0, downstream_distance := 0
)
ORDER BY event_index;
----
1	structural_variant	67108864	1
2	small_variant	2048	1
3	breakend	268435460	1

# Rich projection is opt-in and remains one native pass. It preserves every
# compact code while exposing VEP-facing consequence/IMPACT text and explicitly
# named DuckHTS audit state for small, structural, and breakend rows.
query ITTTTII
SELECT event_index, consequence, impact, duckvep_status,
       coalesce(duckvep_reason, '-'), protein_position IS NULL,
       nmd_prediction IS NULL
FROM duckvep_annotate(
  'duckvep_mixed_events', 'structural',
  upstream_distance := 0, downstream_distance := 0, rich := TRUE
)
ORDER BY event_index;
----
1	transcript_amplification	HIGH	supported	-	1	1
2	coding_sequence_variant	MODIFIER	unresolved	missing_sequence	1	1
3	feature_truncation&intron_variant	HIGH	supported	-	1	1

# Opting into text must not change the compact consequence authority.
query I
WITH compact AS (
  SELECT event_index, consequence_mask, region_mask, impact_code,
         status_code, reason_code, overlap_object_code
  FROM duckvep_annotate(
    'duckvep_mixed_events', 'structural',
    upstream_distance := 0, downstream_distance := 0
  )
), rich AS (
  SELECT event_index, consequence_mask, region_mask, impact_code,
         status_code, reason_code, overlap_object_code
  FROM duckvep_annotate(
    'duckvep_mixed_events', 'structural',
    upstream_distance := 0, downstream_distance := 0, rich := TRUE
  )
)
SELECT count(*) = 3 AND bool_and(
  compact.consequence_mask = rich.consequence_mask AND
  compact.region_mask = rich.region_mask AND
  compact.impact_code = rich.impact_code AND
  compact.status_code = rich.status_code AND
  compact.reason_code = rich.reason_code AND
  compact.overlap_object_code = rich.overlap_object_code
)
FROM compact JOIN rich USING (event_index);
----
1

# NULL follows the compact default just as the HGVS selector does.
query III
SELECT event_index, consequence IS NULL, duckvep_status IS NULL
FROM duckvep_annotate(
  'duckvep_mixed_events', 'structural',
  upstream_distance := 0, downstream_distance := 0, rich := NULL
)
ORDER BY event_index;
----
1	1	1
2	1	1
3	1	1

# When both canonical type channels carry a supported structural vocabulary,
# they must agree. A typed DUP cannot silently reinterpret a symbolic DEL.
statement ok
CREATE TABLE duckvep_contradictory_event AS
SELECT * FROM (VALUES
  (1::UBIGINT, 1::UINTEGER, 90::UBIGINT, NULL::VARCHAR, '<DEL>'::VARCHAR,
   260::UBIGINT, 'DUP'::VARCHAR, NULL::VARCHAR, NULL::UINTEGER, NULL::UBIGINT)
) t(event_index, seq_region, position, reference, alternate, end_position,
    structural_type, copy_change, mate_seq_region, mate_position);

statement error
SELECT * FROM duckvep_annotate('duckvep_contradictory_event', 'structural');
----
symbolic alternate and structural_type disagree

# Unsupported raw symbolic vocabulary and incomplete BND coordinates fail at
# the relation adapter instead of falling through the literal small-event lane.
statement ok
CREATE TABLE duckvep_invalid_event AS
SELECT * FROM (VALUES
  (1::UBIGINT, 1::UINTEGER, 100::UBIGINT, 'N'::VARCHAR, '<CPX>'::VARCHAR,
   NULL::UBIGINT, NULL::VARCHAR, NULL::VARCHAR, NULL::UINTEGER, NULL::UBIGINT)
) t(event_index, seq_region, position, reference, alternate, end_position,
    structural_type, copy_change, mate_seq_region, mate_position);

statement error
SELECT * FROM duckvep_annotate('duckvep_invalid_event', 'structural');
----
a structural event requires end_position and a supported structural_type

query ITTI
SELECT bit_index, consequence, impact, severity_rank
FROM duckvep_so_terms()
WHERE consequence_mask = 2048;
----
11	coding_sequence_variant	MODIFIER	23

# A transcript admitted only by the mate has no local topology. The rich region
# is NULL and the compact region mask is zero; feature_truncation still survives.
query TTI
SELECT annotation.consequence, coalesce(annotation.region, '-'),
       compact.region_mask
FROM unnest(_duckvep_annotate_breakend_rich(
  'structural', 1::UINTEGER, 5250::UBIGINT,
  1::UINTEGER, 170::UBIGINT, 0::UBIGINT
)) AS u(annotation),
unnest(_duckvep_annotate_breakend_compact(
  'structural', 1::UINTEGER, 5250::UBIGINT,
  1::UINTEGER, 170::UBIGINT, 0::UBIGINT
)) AS c(compact);
----
feature_truncation	-	0

# RegulatoryFeature and MotifFeature candidates are collected at both BND
# endpoints. The local coordinate follows VEP's anchor removal (POS + 1), the
# mate coordinate remains verbatim, and a feature hit by both endpoints emits
# once. A local hit keeps the ordinary object term; a mate-only hit takes VEP's
# generic feature_truncation chromosome-breakpoint branch. For a mate-only hit,
# VEP also retains intergenic_variant when the local point is outside but within
# its fixed 5000-base structural-feature admission distance. When both endpoints
# hit one object, the local term wins.
query IIII
WITH events(ord, local_position, mate_position) AS (
  VALUES
    (1, 999::UBIGINT, 300::UBIGINT),
    (2, 300::UBIGINT, 1010::UBIGINT),
    (3, 999::UBIGINT, 1010::UBIGINT)
)
SELECT ord, annotation.regulation_feature_index,
       annotation.consequence_mask, annotation.overlap_object_code
FROM events,
LATERAL unnest(_duckvep_annotate_breakend_compact(
  'fixture', 1::UINTEGER, local_position,
  1::UINTEGER, mate_position, 0::UBIGINT
)) AS u(annotation)
WHERE annotation.regulation_feature_index IS NOT NULL
ORDER BY ord, annotation.regulation_feature_index;
----
1	0	549755813888	1
1	1	68719476736	2
2	0	8858370048	1
2	1	8858370048	2
3	0	549755813888	1
3	1	68719476736	2

# Transcript and regulation-feature pair evaluators produce separate sorted
# streams. A vector containing several BNDs must still materialize one complete
# result list per input event rather than concatenating those streams globally.
query IIII
WITH events(ord, local_position, mate_position) AS (
  VALUES
    (1, 159::UBIGINT, 1010::UBIGINT),
    (2, 124::UBIGINT, 1011::UBIGINT)
)
SELECT ord, count(*)::INTEGER,
       count(*) FILTER (WHERE annotation.transcript_index IS NOT NULL)::INTEGER,
       count(*) FILTER (WHERE annotation.regulation_feature_index IS NOT NULL)::INTEGER
FROM events,
LATERAL unnest(_duckvep_annotate_breakend_compact(
  'fixture', 1::UINTEGER, local_position,
  1::UINTEGER, mate_position, 0::UBIGINT
)) AS u(annotation)
GROUP BY ord
ORDER BY ord;
----
1	3	1	2
2	3	1	2

# The public adapter keeps VEP's two equal-looking 5000-base rules separate.
# A caller-selected 10000-base transcript window allows ordinary predicates on
# a mate-created overlap allele to inspect the local BND feature even past
# StructuralVariationOverlap's fixed 5000-base allele cap. The cap still decides
# which endpoint alleles exist; it does not clamp the separate directional
# predicate. Regulatory/motif endpoint admission remains independently fixed.
query ITT
WITH events(ord, local_position) AS (
  VALUES
    (1, 5249::UBIGINT), -- shifted point is 5000 after transcript end 250
    (2, 5250::UBIGINT)  -- shifted point is 5001 after transcript end 250
)
SELECT ord, annotation.consequence, coalesce(annotation.region, '-')
FROM events,
LATERAL unnest(_duckvep_annotate_breakend_rich(
  'structural', 1::UINTEGER, local_position,
  1::UINTEGER, 124::UBIGINT, 10000::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	feature_truncation&downstream_gene_variant	downstream
2	feature_truncation&downstream_gene_variant	downstream

# The fixed structural-overlap endpoint rule also survives a caller distance
# of zero. At exactly 5000 bases the local overlap allele loses its disabled
# downstream predicate and falls back to intergenic_variant, while the mate
# allele contributes feature_truncation. At 5001 bases no local allele exists.
query ITT
WITH events(ord, local_position) AS (
  VALUES
    (1, 5249::UBIGINT),
    (2, 5250::UBIGINT)
)
SELECT ord, annotation.consequence, coalesce(annotation.region, '-')
FROM events,
LATERAL unnest(_duckvep_annotate_breakend_rich(
  'structural', 1::UINTEGER, local_position,
  1::UINTEGER, 124::UBIGINT, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	feature_truncation&intergenic_variant	-
2	feature_truncation	-

# The fixed 5000-base StructuralVariationOverlap test does not independently
# discover a transcript that the caller's directional source window excluded.
# Executable indexed-cache VEP 116 returns only intergenic alleles when both BND
# points are outside an isolated transcript under --distance 0, then two
# duplicate downstream transcript alleles at --distance 5000 and 10000. The
# public DuckVEP row union therefore has no transcript at zero and one stable
# downstream row at either wider setting.
query IITTTT
WITH distances(distance) AS (
  VALUES (0::UBIGINT), (5000::UBIGINT), (10000::UBIGINT)
)
SELECT distance,
       coalesce(annotation.transcript_index::BIGINT, -1),
       annotation.consequence, annotation.status,
       coalesce(annotation.reason, '-'), coalesce(annotation.region, '-')
FROM distances,
LATERAL unnest(_duckvep_annotate_breakend_rich(
  'structural', 1::UINTEGER, 5249::UBIGINT,
  1::UINTEGER, 5250::UBIGINT, distance
)) AS u(annotation)
ORDER BY distance;
----
0	-1	sequence_variant	unresolved	no_feature_in_loaded_model	-
5000	0	downstream_gene_variant	supported	-	downstream
10000	0	downstream_gene_variant	supported	-	downstream

query IT
WITH events(ord, local_position) AS (
  VALUES
    (1, 6019::UBIGINT), -- shifted point is 5000 after feature end 1020
    (2, 6020::UBIGINT)  -- shifted point is 5001 after feature end 1020
)
SELECT ord, annotation.consequence
FROM events,
LATERAL unnest(_duckvep_annotate_breakend_rich(
  'fixture', 1::UINTEGER, local_position,
  1::UINTEGER, 1010::UBIGINT, 10000::UBIGINT
)) AS u(annotation)
WHERE annotation.regulation_feature_index = 0
ORDER BY ord;
----
1	feature_truncation&intergenic_variant
2	feature_truncation

statement error
SELECT _duckvep_annotate_structural_rich(
  'structural', 1::UINTEGER, 100::UBIGINT, 100::UBIGINT,
  'BND', 'UNKNOWN'
);

# The interval index seeds only the first row of a sorted run. A transcript that
# starts after that first window must still enter the continuing forward sweep.
query IT
WITH variants(ord, position) AS (
  VALUES (1, 80::UBIGINT), (2, 105::UBIGINT)
)
SELECT ord, annotation.consequence
FROM variants,
LATERAL unnest(_duckvep_annotate_small_rich(
  'fixture', 1::UINTEGER, position, 'A', 'C', 10::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	sequence_variant
2	5_prime_UTR_variant

# Essential splice positions use the VEP-116 splice predicate port.
query TTTT
SELECT annotation.consequence, annotation.status,
       coalesce(annotation.reason, '-'), annotation.nmd_prediction
FROM unnest(_duckvep_annotate_small_rich(
  'fixture', 1::UINTEGER, 151::UBIGINT, 'G', 'A', 0::UBIGINT
)) AS u(annotation);
----
splice_donor_variant	supported	-	unresolved

# More than one DuckDB vector reuses adapter and model workspace storage. The
# exact-distance path must retain its cgranges seed instead of rescanning the
# sequence region from its first transcript for every vector.
query I
SELECT count(*)
FROM (
  SELECT unnest(_duckvep_annotate_small_rich(
    'fixture', 1::UINTEGER, 124::UBIGINT, 'T', 'C', 0::UBIGINT
  )) AS annotation
  FROM range(5000)
)
WHERE annotation.consequence = 'missense_variant';
----
5000

# VCF permits the padding base to follow an indel at the first contig base.
# Both transcript strands must see the prepared event; the adapter must not
# reject it for lacking a common left prefix.
statement ok
CREATE TABLE duckvep_pos1_regions AS
SELECT 1::UINTEGER AS seq_region;

statement ok
CREATE TABLE duckvep_pos1_transcripts AS
SELECT * FROM (VALUES
  (0::UINTEGER, 1::UINTEGER, 1::UBIGINT, 20::UBIGINT, 1::TINYINT,
   0::UINTEGER, 0::UBIGINT, NULL::UBIGINT, NULL::UBIGINT, NULL::BLOB, NULL::UTINYINT),
  (1::UINTEGER, 1::UINTEGER, 1::UBIGINT, 20::UBIGINT, -1::TINYINT,
   1::UINTEGER, 0::UBIGINT, NULL::UBIGINT, NULL::UBIGINT, NULL::BLOB, NULL::UTINYINT)
) t(transcript_index, seq_region, transcript_start, transcript_end, strand,
    gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table);

statement ok
CREATE TABLE duckvep_pos1_exons AS
SELECT * FROM (VALUES
  (0::UINTEGER, 1::UBIGINT, 20::UBIGINT, 1::UBIGINT, 20::UBIGINT,
   -1::TINYINT, -1::TINYINT),
  (1::UINTEGER, 1::UBIGINT, 20::UBIGINT, 1::UBIGINT, 20::UBIGINT,
   -1::TINYINT, -1::TINYINT)
) t(transcript_index, exon_start, exon_end, exon_cdna_start, exon_cdna_end,
    phase, end_phase);

query I
SELECT loaded FROM duckvep_model_load(
  'position-one',
  'SELECT * FROM duckvep_pos1_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_pos1_transcripts ORDER BY seq_region, transcript_start, transcript_index',
  'SELECT * FROM duckvep_pos1_exons ORDER BY transcript_index, exon_cdna_start'
);
----
1

# Upstream and downstream are transcript-relative. At the same genomic point,
# the negative-strand transcript is upstream while the positive-strand one is
# downstream.
query ITT
SELECT annotation.transcript_index, annotation.consequence, annotation.region
FROM unnest(_duckvep_annotate_small_rich(
  'position-one', 1::UINTEGER, 25::UBIGINT, 'A', 'C',
  10::UBIGINT, 0::UBIGINT
)) AS u(annotation);
----
1	upstream_gene_variant	upstream

query ITT
SELECT annotation.transcript_index, annotation.consequence, annotation.region
FROM unnest(_duckvep_annotate_small_rich(
  'position-one', 1::UINTEGER, 25::UBIGINT, 'A', 'C',
  0::UBIGINT, 10::UBIGINT
)) AS u(annotation);
----
0	downstream_gene_variant	downstream

query IIT
WITH variants(ord, reference, alternate) AS (
  VALUES (1, 'AC', 'C'), (2, 'C', 'AC')
)
SELECT ord, count(*), min(annotation.consequence)
FROM variants,
LATERAL unnest(_duckvep_annotate_small_rich(
  'position-one', 1::UINTEGER, 1::UBIGINT, reference, alternate, 0::UBIGINT
)) AS u(annotation)
GROUP BY ord
ORDER BY ord;
----
1	2	non_coding_transcript_exon_variant
2	2	non_coding_transcript_exon_variant

# Core regulation features are resident SoA rows in the named model. The same
# C cursor emits transcript, RegulatoryFeature, and MotifFeature consequences.
# A reversed insertion interval immediately after the feature emits no
# regulation row; it does not inherit the uploaded VCF anchor overlap.
query IIIT
WITH small_events(ord, position, reference, alternate) AS (
  VALUES
    (1, 1010::UBIGINT, 'A', 'T'),
    (2, 999::UBIGINT, 'AAAAAAAAAAAAAAAAAAAAAA', 'A'),
    (5, 1020::UBIGINT, 'A', 'AT')
), observed AS (
  SELECT ord, annotation.*
  FROM small_events,
  LATERAL unnest(_duckvep_annotate_small_compact(
    'fixture', 1::UINTEGER, position, reference, alternate, 0::UBIGINT
  )) AS u(annotation)
  WHERE annotation.regulation_feature_index IS NOT NULL
  UNION ALL
  SELECT ord, annotation.*
  FROM (VALUES
    (3, 990::UBIGINT, 1030::UBIGINT, 'DEL', 'LOSS'),
    (4, 990::UBIGINT, 1030::UBIGINT, 'DUP', 'GAIN')
  ) events(ord, event_start, event_end, structural_type, copy_change),
  LATERAL unnest(_duckvep_annotate_structural_compact(
    'fixture', 1::UINTEGER, event_start, event_end,
    structural_type, copy_change, 0::UBIGINT
  )) AS u(annotation)
  WHERE annotation.regulation_feature_index IS NOT NULL
)
SELECT ord, regulation_feature_index, consequence_mask,
       overlap_object_code
FROM observed
ORDER BY ord, regulation_feature_index;
----
1	0	549755813888	1
1	1	68719476736	2
2	0	687194767360	1
2	1	85899345920	2
3	0	687194767360	1
3	1	85899345920	2
4	0	824633720832	1
4	1	103079215104	2

query IITT
SELECT annotation.regulation_feature_index,
       annotation.transcript_index IS NULL,
       annotation.consequence, annotation.overlap_object
FROM unnest(_duckvep_annotate_small_rich(
  'fixture', 1::UINTEGER, 1010::UBIGINT, 'A', 'T', 0::UBIGINT
)) AS u(annotation)
WHERE annotation.regulation_feature_index IS NOT NULL
ORDER BY annotation.regulation_feature_index;
----
0	1	regulatory_region_variant	regulatory_region
1	1	TF_binding_site_variant	transcription_factor_binding_site


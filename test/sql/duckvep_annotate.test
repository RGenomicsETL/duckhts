# Like VEP --distance U,D, the seven-argument overload controls the two
# transcript-relative directions independently. A zero disables that direction.
query TT
SELECT annotation.consequence, annotation.region
FROM unnest(_duckvep_annotate_small_rich(
  'fixture-complete', 1::UINTEGER, 90::UBIGINT, 'A', 'C',
  10::UBIGINT, 0::UBIGINT
)) AS u(annotation);
----
upstream_gene_variant	upstream

query TT
SELECT annotation.consequence, annotation.region

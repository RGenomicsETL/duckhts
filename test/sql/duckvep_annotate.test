# name: test/sql/duckvep_annotate.test
# description: Stable-API DuckVEP model registry and vector annotation vertical
# group: [duckhts]

require duckhts

statement ok
CREATE TABLE duckvep_test_regions AS
SELECT * FROM (VALUES (0::UINTEGER), (1::UINTEGER)) t(seq_region);

statement ok
CREATE TABLE duckvep_test_transcripts AS
SELECT
  0::UINTEGER transcript_index,
  1::UINTEGER seq_region,
  100::UBIGINT transcript_start,
  250::UBIGINT transcript_end,
  1::TINYINT strand,
  0::UINTEGER gene_index,
  3::UBIGINT transcript_flags,
  120::UBIGINT cds_start,
  240::UBIGINT cds_end,
  'ATGGTACGTACGTACGTACGTACGTACGTACTACGTACGTACGTACGTACGTACGTACGTACGTACTGGTAA'::BLOB cds_sequence,
  1::UTINYINT codon_table;

statement ok
CREATE TABLE duckvep_test_exons AS
SELECT * FROM (VALUES
  (0::UINTEGER, 100::UBIGINT, 150::UBIGINT, 1::UBIGINT, 51::UBIGINT, 0::TINYINT, 0::TINYINT),
  (0::UINTEGER, 200::UBIGINT, 250::UBIGINT, 52::UBIGINT, 102::UBIGINT, 0::TINYINT, 0::TINYINT)
) t(transcript_index, exon_start, exon_end, exon_cdna_start, exon_cdna_end, phase, end_phase);

# Binding a setup call must not mutate the registry. Loading happens at execution.
statement ok
EXPLAIN SELECT * FROM duckvep_model_load(
  'explain_only',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_start'
);

query I
SELECT duckvep_model_drop('explain_only');
----
0

query I
SELECT loaded FROM duckvep_model_load(
  'fixture',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_start'
);
----
1

# Pinned VEP-116 coding predicates plus structural rows through the public vector.
query TTTTTTTTTT
WITH variants(ord, id, seq_region, position, reference, alternate) AS (
  VALUES
    (1, 'start_lost', 1::UINTEGER, 120::UBIGINT, 'A', 'T'),
    (2, 'missense', 1::UINTEGER, 124::UBIGINT, 'T', 'C'),
    (3, 'synonymous', 1::UINTEGER, 125::UBIGINT, 'A', 'C'),
    (4, 'intron', 1::UINTEGER, 160::UBIGINT, 'T', 'C'),
    (5, 'stop_gained', 1::UINTEGER, 236::UBIGINT, 'G', 'A'),
    (6, 'stop_lost', 1::UINTEGER, 238::UBIGINT, 'T', 'C'),
    (7, 'stop_retained', 1::UINTEGER, 239::UBIGINT, 'A', 'G'),
    (8, 'intergenic', 0::UINTEGER, 100::UBIGINT, 'A', 'C')
)
SELECT
  id,
  coalesce(annotation.transcript_index::VARCHAR, '-'),
  annotation.consequence,
  annotation.impact,
  annotation.region,
  annotation.status,
  coalesce(annotation.reason, '-'),
  coalesce(annotation.cdna_position::VARCHAR, '-'),
  coalesce(annotation.cds_position::VARCHAR, '-'),
  coalesce(annotation.protein_position::VARCHAR, '-')
FROM variants,
LATERAL unnest(duckvep_annotate(
  'fixture', seq_region, position, reference, alternate, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord, annotation.transcript_index NULLS FIRST;
----
start_lost	0	start_lost	HIGH	CDS	supported	-	21	1	1
missense	0	missense_variant	MODERATE	CDS	supported	-	25	5	2
synonymous	0	synonymous_variant	LOW	CDS	supported	-	26	6	2
intron	0	intron_variant	MODIFIER	intron	supported	-	-	-	-
stop_gained	0	stop_gained	HIGH	CDS	supported	-	88	68	23
stop_lost	0	stop_lost	HIGH	CDS	supported	-	90	70	24
stop_retained	0	stop_retained_variant	LOW	CDS	supported	-	91	71	24
intergenic	-	intergenic_variant	MODIFIER	intergenic	supported	-	-	-	-

# Several named models may coexist and may occur in the same DuckDB vector.
statement ok
CREATE TABLE duckvep_test_transcripts_2 AS
SELECT * REPLACE (7::UINTEGER AS gene_index)
FROM duckvep_test_transcripts;

query I
SELECT loaded FROM duckvep_model_load(
  'fixture2',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts_2 ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_start'
);
----
1

query IIT
WITH variants(ord, model_name, position, reference, alternate) AS (
  VALUES
    (1, 'fixture', 124::UBIGINT, 'T', 'C'),
    (2, 'fixture2', 124::UBIGINT, 'T', 'C'),
    (3, 'fixture', 125::UBIGINT, 'A', 'C')
)
SELECT ord, annotation.gene_index, annotation.consequence
FROM variants,
LATERAL unnest(duckvep_annotate(
  model_name, 1::UINTEGER, position, reference, alternate, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	0	missense_variant
2	7	missense_variant
3	0	synonymous_variant

# A coding span may be loaded before its sequence is prepared. Structural
# coding classification remains available and the unresolved sequence predicate
# is explicit.
statement ok
CREATE TABLE duckvep_test_transcripts_structural AS
SELECT * REPLACE (
  NULL::BLOB AS cds_sequence,
  NULL::UTINYINT AS codon_table
)
FROM duckvep_test_transcripts;

query I
SELECT loaded FROM duckvep_model_load(
  'structural',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts_structural ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_cdna_start'
);
----
1

query TT
SELECT annotation.consequence, annotation.status
FROM unnest(duckvep_annotate(
  'structural', 1::UINTEGER, 124::UBIGINT, 'T', 'C', 0::UBIGINT
)) AS u(annotation);
----
coding_sequence_variant	unresolved

# NMD_transcript_variant is the VEP biotype predicate: it co-emits for a
# variant inside a transcript already curated as nonsense_mediated_decay.
statement ok
CREATE TABLE duckvep_test_transcripts_nmd AS
SELECT * REPLACE (7::UBIGINT AS transcript_flags)
FROM duckvep_test_transcripts;

query I
SELECT loaded FROM duckvep_model_load(
  'nmd',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts_nmd ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_cdna_start'
);
----
1

query T
SELECT annotation.consequence
FROM unnest(duckvep_annotate(
  'nmd', 1::UINTEGER, 160::UBIGINT, 'T', 'C', 0::UBIGINT
)) AS u(annotation);
----
intron_variant&NMD_transcript_variant

# Decreasing positions remain correct by starting another sweep run.
query IT
WITH variants(ord, position, reference, alternate) AS (
  VALUES
    (1, 125::UBIGINT, 'A', 'C'),
    (2, 124::UBIGINT, 'T', 'C')
)
SELECT ord, annotation.consequence
FROM variants,
LATERAL unnest(duckvep_annotate(
  'fixture', 1::UINTEGER, position, reference, alternate, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	synonymous_variant
2	missense_variant

# The interval index seeds only the first row of a sorted run. A transcript that
# starts after that first window must still enter the continuing forward sweep.
query IT
WITH variants(ord, position) AS (
  VALUES (1, 80::UBIGINT), (2, 105::UBIGINT)
)
SELECT ord, annotation.consequence
FROM variants,
LATERAL unnest(duckvep_annotate(
  'fixture', 1::UINTEGER, position, 'A', 'C', 10::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	intergenic_variant
2	5_prime_UTR_variant

# Essential splice positions use the VEP-116 splice predicate port.
query TTT
SELECT annotation.consequence, annotation.status,
       coalesce(annotation.reason, '-')
FROM unnest(duckvep_annotate(
  'fixture', 1::UINTEGER, 151::UBIGINT, 'G', 'A', 0::UBIGINT
)) AS u(annotation);
----
splice_donor_variant	supported	-

# More than one DuckDB vector reuses adapter and model workspace storage. The
# exact-distance path must retain its cgranges seed instead of rescanning the
# sequence region from its first transcript for every vector.
query I
SELECT count(*)
FROM (
  SELECT unnest(duckvep_annotate(
    'fixture', 1::UINTEGER, 124::UBIGINT, 'T', 'C', 0::UBIGINT
  )) AS annotation
  FROM range(5000)
)
WHERE annotation.consequence = 'missense_variant';
----
5000

# VCF permits the padding base to follow an indel at the first contig base.
# Both transcript strands must see the prepared event; the adapter must not
# reject it for lacking a common left prefix.
statement ok
CREATE TABLE duckvep_pos1_regions AS
SELECT 1::UINTEGER AS seq_region;

statement ok
CREATE TABLE duckvep_pos1_transcripts AS
SELECT * FROM (VALUES
  (0::UINTEGER, 1::UINTEGER, 1::UBIGINT, 20::UBIGINT, 1::TINYINT,
   0::UINTEGER, 0::UBIGINT, NULL::UBIGINT, NULL::UBIGINT, NULL::BLOB, NULL::UTINYINT),
  (1::UINTEGER, 1::UINTEGER, 1::UBIGINT, 20::UBIGINT, -1::TINYINT,
   1::UINTEGER, 0::UBIGINT, NULL::UBIGINT, NULL::UBIGINT, NULL::BLOB, NULL::UTINYINT)
) t(transcript_index, seq_region, transcript_start, transcript_end, strand,
    gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table);

statement ok
CREATE TABLE duckvep_pos1_exons AS
SELECT * FROM (VALUES
  (0::UINTEGER, 1::UBIGINT, 20::UBIGINT, 1::UBIGINT, 20::UBIGINT,
   -1::TINYINT, -1::TINYINT),
  (1::UINTEGER, 1::UBIGINT, 20::UBIGINT, 1::UBIGINT, 20::UBIGINT,
   -1::TINYINT, -1::TINYINT)
) t(transcript_index, exon_start, exon_end, exon_cdna_start, exon_cdna_end,
    phase, end_phase);

query I
SELECT loaded FROM duckvep_model_load(
  'position-one',
  'SELECT * FROM duckvep_pos1_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_pos1_transcripts ORDER BY seq_region, transcript_start, transcript_index',
  'SELECT * FROM duckvep_pos1_exons ORDER BY transcript_index, exon_cdna_start'
);
----
1

query IIT
WITH variants(ord, reference, alternate) AS (
  VALUES (1, 'AC', 'C'), (2, 'C', 'AC')
)
SELECT ord, count(*), min(annotation.consequence)
FROM variants,
LATERAL unnest(duckvep_annotate(
  'position-one', 1::UINTEGER, 1::UBIGINT, reference, alternate, 0::UBIGINT
)) AS u(annotation)
GROUP BY ord
ORDER BY ord;
----
1	2	non_coding_transcript_exon_variant
2	2	non_coding_transcript_exon_variant

statement error
SELECT duckvep_annotate(
  'missing', 1::UINTEGER, 124::UBIGINT, 'T', 'C', 0::UBIGINT
);
----
duckvep_annotate: unknown model name

statement error
SELECT * FROM duckvep_model_load(
  'fixture',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_start'
);
----
duckvep_model_load: model name already exists

query IIIII
SELECT duckvep_model_drop('fixture'), duckvep_model_drop('fixture2'),
       duckvep_model_drop('structural'), duckvep_model_drop('nmd'),
       duckvep_model_drop('position-one');
----
1	1	1	1	1

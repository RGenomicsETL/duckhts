# A REF disagreement with the prepared CDS is auditable and does not become a
# generic unsupported-sequence result.
query TTT
SELECT annotation.consequence, annotation.status, annotation.reason
FROM unnest(_duckvep_annotate_small_rich(
  'fixture', 1::UINTEGER, 124::UBIGINT, 'A', 'C', 0::UBIGINT
)) AS u(annotation);
----
coding_sequence_variant	unresolved	reference_mismatch

# A protein coordinate is useful for a frameshift, but the compact row has no
# scalar one-letter amino-acid pair. Absence is NULL, not an empty string.
query TTIIII
SELECT annotation.consequence, annotation.nmd_prediction,
       annotation.nmd_escape_early_cds::INTEGER,
       (annotation.protein_position IS NOT NULL)::INTEGER,
       (annotation.reference_amino_acid IS NULL)::INTEGER,
       (annotation.alternate_amino_acid IS NULL)::INTEGER
FROM unnest(_duckvep_annotate_small_rich(
  'fixture', 1::UINTEGER, 124::UBIGINT, 'T', 'TC', 0::UBIGINT
)) AS u(annotation);
----
frameshift_variant	escaping	1	1	1	1

# VEP 116 places an insertion on the exon/CDS side of a boundary while its
# splice predicates retain the interbase interval. These are fixed witnesses
# from the real VEP differential, not hand-assigned consequence examples.
query ITTT
WITH variants(ord, position, reference, alternate) AS (
  VALUES
    (1, 199::UBIGINT, 'G', 'GT'),
    (2, 199::UBIGINT, 'G', 'GATG'),
    (3, 240::UBIGINT, 'A', 'AATG'),
    (4, 250::UBIGINT, 'C', 'CT')
)
SELECT ord, annotation.consequence, annotation.status,
       coalesce(annotation.reason, '-')
FROM variants,
LATERAL unnest(_duckvep_annotate_small_rich(
  'fixture', 1::UINTEGER, position, reference, alternate, 1::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	frameshift_variant&splice_region_variant	supported	-
2	protein_altering_variant&splice_region_variant	supported	-
3	3_prime_UTR_variant	supported	-
4	downstream_gene_variant	supported	-

# Generic exon overlap, UTR mapping, and splice overlap use different VEP
# insertion geometries. At an internal exon boundary, a non-coding insertion is
# not an exon variant; an insertion whose other flank maps into UTR keeps the
# UTR term. Splice predicates continue to use the reversed P+1,P interval.
statement ok
CREATE TABLE duckvep_insertion_boundary_transcripts AS
SELECT
  0::UINTEGER transcript_index, 1::UINTEGER seq_region,
  300::UBIGINT transcript_start, 450::UBIGINT transcript_end,
  1::TINYINT strand, 0::UINTEGER gene_index, 0::UBIGINT transcript_flags,
  NULL::UBIGINT cds_start, NULL::UBIGINT cds_end, NULL::BLOB cds_sequence,
  NULL::UTINYINT codon_table, NULL::BLOB pre_cds_sequence,
  NULL::BLOB post_cds_sequence
UNION ALL
SELECT
  1::UINTEGER, 1::UINTEGER, 1000::UBIGINT, 1150::UBIGINT,
  1::TINYINT, 1::UINTEGER, 5::UBIGINT,
  1021::UBIGINT, 1050::UBIGINT, repeat('A', 30)::BLOB,
  1::UTINYINT, repeat('A', 21)::BLOB, repeat('A', 51)::BLOB;

statement ok
CREATE TABLE duckvep_insertion_boundary_exons AS
SELECT * FROM (VALUES
  (0::UINTEGER, 300::UBIGINT, 350::UBIGINT, 1::UBIGINT, 51::UBIGINT, -1::TINYINT, -1::TINYINT),
  (0::UINTEGER, 400::UBIGINT, 450::UBIGINT, 52::UBIGINT, 102::UBIGINT, -1::TINYINT, -1::TINYINT),
  (1::UINTEGER, 1000::UBIGINT, 1050::UBIGINT, 1::UBIGINT, 51::UBIGINT, 0::TINYINT, 0::TINYINT),
  (1::UINTEGER, 1100::UBIGINT, 1150::UBIGINT, 52::UBIGINT, 102::UBIGINT, -1::TINYINT, -1::TINYINT)
) t(transcript_index, exon_start, exon_end, exon_cdna_start, exon_cdna_end, phase, end_phase);

query I
SELECT loaded FROM duckvep_model_load(
  'insertion-boundaries',
  'SELECT seq_region FROM duckvep_test_regions WHERE seq_region = 1',
  'SELECT * FROM duckvep_insertion_boundary_transcripts ORDER BY transcript_index',
  'SELECT * FROM duckvep_insertion_boundary_exons ORDER BY transcript_index, exon_cdna_start'
);
----
1

query IT
WITH variants(ord, position, reference, alternate) AS (VALUES
  (1, 350::UBIGINT, 'A', 'AT'),
  (2, 1099::UBIGINT, 'A', 'AT')
)
SELECT ord,
       list_aggregate(list_sort(string_split(annotation.consequence, '&')),
                      'string_agg', '&')
FROM variants,
LATERAL unnest(_duckvep_annotate_small_rich(
  'insertion-boundaries', 1::UINTEGER, position, reference, alternate, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	non_coding_transcript_variant&splice_region_variant
2	3_prime_UTR_variant&NMD_transcript_variant&splice_region_variant

# VEP handles a frame-changing edit that begins in the terminal stop through
# stop_lost/stop_retained, not frameshift_variant. Deletions may need the first
# post-CDS reference base to reconstruct the codon at the original endpoint.
query ITTT
WITH variants(ord, position, reference, alternate) AS (
  VALUES
    (1, 238::UBIGINT, 'T', 'AC'),
    (2, 238::UBIGINT, 'TA', 'T'),
    (3, 239::UBIGINT, 'AA', 'A'),
    (4, 240::UBIGINT, 'A', 'CG'),
    (5, 239::UBIGINT, 'AA', 'CA'),
    (6, 240::UBIGINT, 'AA', 'TA')
)
SELECT ord, annotation.consequence, annotation.status,
       coalesce(annotation.reason, '-')
FROM variants,
LATERAL unnest(_duckvep_annotate_small_rich(
  'fixture', 1::UINTEGER, position, reference, alternate, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	stop_lost	supported	-
2	stop_retained_variant	supported	-
3	stop_retained_variant	supported	-
4	stop_lost	supported	-
5	stop_lost	supported	-
6	coding_sequence_variant&3_prime_UTR_variant	supported	-

# The original eleven-column model remains valid. A terminal deletion that needs
# post-CDS bases fails closed rather than becoming a false frameshift.
statement ok
CREATE TABLE duckvep_test_transcripts_no_tail AS

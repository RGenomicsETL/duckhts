  3::UBIGINT transcript_flags,
  100::UBIGINT cds_start,
  498::UBIGINT cds_end,
  ('ATG' || repeat('CAA', 81) || 'TAA')::BLOB cds_sequence,
  1::UTINYINT codon_table;

statement ok

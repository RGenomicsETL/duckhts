# name: test/sql/duckvep_annotate.test
# description: Stable-API DuckVEP model registry and vector annotation vertical
# group: [duckhts]

require duckhts

statement ok
CREATE TABLE duckvep_test_regions AS
SELECT * FROM (VALUES (0::UINTEGER), (1::UINTEGER)) t(seq_region);

statement ok
CREATE TABLE duckvep_test_transcripts AS
SELECT
  0::UINTEGER transcript_index,
  1::UINTEGER seq_region,
  100::UBIGINT transcript_start,
  250::UBIGINT transcript_end,
  1::TINYINT strand,
  0::UINTEGER gene_index,
  3::UBIGINT transcript_flags,
  120::UBIGINT cds_start,
  240::UBIGINT cds_end,
  'ATGGTACGTACGTACGTACGTACGTACGTACTACGTACGTACGTACGTACGTACGTACGTACGTACTGGTAA'::BLOB cds_sequence,
  1::UTINYINT codon_table,
  'TACGTACGTACGTACGTACG'::BLOB pre_cds_sequence,
  'ACGTACGTAC'::BLOB post_cds_sequence;

statement ok
CREATE TABLE duckvep_test_exons AS
SELECT * FROM (VALUES
  (0::UINTEGER, 100::UBIGINT, 150::UBIGINT, 1::UBIGINT, 51::UBIGINT, 0::TINYINT, 0::TINYINT),
  (0::UINTEGER, 200::UBIGINT, 250::UBIGINT, 52::UBIGINT, 102::UBIGINT, 0::TINYINT, 0::TINYINT)
) t(transcript_index, exon_start, exon_end, exon_cdna_start, exon_cdna_end, phase, end_phase);

statement ok
CREATE TABLE duckvep_test_regulation AS
SELECT * FROM (VALUES
  (0::UINTEGER, 1::UINTEGER, 1000::UINTEGER, 1020::UINTEGER, 1::UTINYINT),
  (1::UINTEGER, 1::UINTEGER, 1000::UINTEGER, 1020::UINTEGER, 2::UTINYINT)
) t(regulation_feature_index, seq_region, feature_start, feature_end, feature_kind);

# Binding a setup call must not mutate the registry. Loading happens at execution.
statement ok
EXPLAIN SELECT * FROM duckvep_model_load(
  'explain_only',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_start'
);

query I
SELECT duckvep_model_drop('explain_only');
----
0

query I
SELECT loaded FROM duckvep_model_load(
  'fixture',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_start',
  interval_feature_query := 'SELECT * FROM duckvep_test_regulation ORDER BY seq_region, feature_start, regulation_feature_index'
);
----
1

# CDS_END_NF may leave one or two CDS bases beyond the last complete codon.
# VEP evaluates ordinary length changes against its synthetic trailing X;
# the incomplete tail does not make a body edit a compound event.
statement ok
CREATE TABLE duckvep_partial_cds_transcripts AS
SELECT
  0::UINTEGER transcript_index,
  1::UINTEGER seq_region,
  100::UBIGINT transcript_start,
  113::UBIGINT transcript_end,
  1::TINYINT strand,
  0::UINTEGER gene_index,
  35::UBIGINT transcript_flags,
  100::UBIGINT cds_start,
  113::UBIGINT cds_end,
  'ATGAAACCCGGGTT'::BLOB cds_sequence,
  1::UTINYINT codon_table,
  ''::BLOB pre_cds_sequence,
  ''::BLOB post_cds_sequence;

statement ok
CREATE TABLE duckvep_partial_cds_exons AS
SELECT
  0::UINTEGER transcript_index,
  100::UBIGINT exon_start,
  113::UBIGINT exon_end,
  1::UBIGINT exon_cdna_start,
  14::UBIGINT exon_cdna_end,
  0::TINYINT phase,
  2::TINYINT end_phase;

query I
SELECT loaded FROM duckvep_model_load(
  'partial-cds-end',
  'SELECT seq_region FROM duckvep_test_regions WHERE seq_region = 1',
  'SELECT * FROM duckvep_partial_cds_transcripts',
  'SELECT * FROM duckvep_partial_cds_exons'
);
----
1

query TTT
SELECT annotation.consequence, annotation.status,
       coalesce(annotation.reason, '-')
FROM unnest(_duckvep_annotate_small_rich(
  'partial-cds-end', 1::UINTEGER, 106::UBIGINT, 'C', 'CA', 0::UBIGINT
)) AS u(annotation);
----
frameshift_variant	supported	-

query TTT
SELECT annotation.consequence, annotation.status,
       coalesce(annotation.reason, '-')
FROM unnest(_duckvep_annotate_small_rich(
  'partial-cds-end', 1::UINTEGER, 109::UBIGINT, 'GGGT', 'G', 0::UBIGINT
)) AS u(annotation);
----
inframe_deletion	supported	-

# VEP's incomplete-terminal-codon predicate is separate from CDS_END_NF: it
# becomes true only when the edit begins in the final one- or two-base codon.
query TTT
SELECT annotation.consequence, annotation.status,
       coalesce(annotation.reason, '-')
FROM unnest(_duckvep_annotate_small_rich(
  'partial-cds-end', 1::UINTEGER, 112::UBIGINT, 'T', 'A', 0::UBIGINT
)) AS u(annotation);
----
incomplete_terminal_codon_variant&coding_sequence_variant	supported	-

query TTT
SELECT annotation.consequence, annotation.status,
       coalesce(annotation.reason, '-')
FROM unnest(_duckvep_annotate_small_rich(
  'partial-cds-end', 1::UINTEGER, 111::UBIGINT, 'GTT', 'G', 0::UBIGINT
)) AS u(annotation);
----
protein_altering_variant&incomplete_terminal_codon_variant	supported	-

# A long literal allele remains an ordinary VariationFeature in VEP. Complete
# transcript overlap plus its normalized deletion fact still has tier-1
# feature_ablation semantics. Equal-length containing spans keep VEP's empty
# endpoint-UTR predicates and suppress coding_unknown.
statement ok
CREATE TABLE duckvep_complete_span_transcripts AS
SELECT
  0::UINTEGER transcript_index,
  1::UINTEGER seq_region,
  100::UBIGINT transcript_start,
  108::UBIGINT transcript_end,
  1::TINYINT strand,
  0::UINTEGER gene_index,
  3::UBIGINT transcript_flags,
  100::UBIGINT cds_start,
  108::UBIGINT cds_end,
  'ATGAAATAA'::BLOB cds_sequence,
  1::UTINYINT codon_table,
  ''::BLOB pre_cds_sequence,
  ''::BLOB post_cds_sequence;

statement ok
CREATE TABLE duckvep_complete_span_exons AS
SELECT
  0::UINTEGER transcript_index,
  100::UBIGINT exon_start,
  108::UBIGINT exon_end,
  1::UBIGINT exon_cdna_start,
  9::UBIGINT exon_cdna_end,
  0::TINYINT phase,
  0::TINYINT end_phase;

query I
SELECT loaded FROM duckvep_model_load(
  'complete-span',
  'SELECT seq_region FROM duckvep_test_regions WHERE seq_region = 1',
  'SELECT * FROM duckvep_complete_span_transcripts',
  'SELECT * FROM duckvep_complete_span_exons'
);
----
1

query ITT
WITH variants(ord, reference, alternate) AS (
  VALUES
    (1, repeat('A', 11), repeat('A', 5) || 'C' || repeat('A', 5)),
    (2, repeat('A', 11), 'A')
)
SELECT ord, annotation.consequence, annotation.status
FROM variants,
LATERAL unnest(_duckvep_annotate_small_rich(
  'complete-span', 1::UINTEGER, 99::UBIGINT,
  reference, alternate, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	5_prime_UTR_variant&3_prime_UTR_variant&coding_transcript_variant	supported
2	transcript_ablation	supported

# VEP does not suppress inframe_insertion when partial_codon is true, and its
# X-bearing peptide also keeps coding_sequence_variant.
query TTT
SELECT annotation.consequence, annotation.status,
       coalesce(annotation.reason, '-')
FROM unnest(_duckvep_annotate_small_rich(
  'partial-cds-end', 1::UINTEGER, 111::UBIGINT, 'G', 'GGCCA', 0::UBIGINT
)) AS u(annotation);
----
inframe_insertion&incomplete_terminal_codon_variant&coding_sequence_variant	supported	-

# The pure-C model validator is also the final authority for SQL-loaded models.
# A transcript span wider than its outer exon envelope must fail at load time.
statement error
SELECT * FROM duckvep_model_load(
  'invalid-envelope',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * REPLACE (99::UBIGINT AS transcript_start) FROM duckvep_test_transcripts ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_start'
);
----
transcript span is not the outer exon envelope

# Pinned VEP-116 coding predicates plus structural rows through the public vector.
query TTTTTTTTTT
WITH variants(ord, id, seq_region, position, reference, alternate) AS (
  VALUES
    (1, 'start_lost', 1::UINTEGER, 120::UBIGINT, 'A', 'T'),
    (2, 'missense', 1::UINTEGER, 124::UBIGINT, 'T', 'C'),
    (3, 'synonymous', 1::UINTEGER, 125::UBIGINT, 'A', 'C'),
    (4, 'intron', 1::UINTEGER, 160::UBIGINT, 'T', 'C'),
    (5, 'stop_gained', 1::UINTEGER, 236::UBIGINT, 'G', 'A'),
    (6, 'stop_lost', 1::UINTEGER, 238::UBIGINT, 'T', 'C'),
    (7, 'stop_retained', 1::UINTEGER, 239::UBIGINT, 'A', 'G'),
    (8, 'intergenic', 0::UINTEGER, 100::UBIGINT, 'A', 'C')
)
SELECT
  id,
  coalesce(annotation.transcript_index::VARCHAR, '-'),
  annotation.consequence,
  annotation.impact,
  annotation.region,
  annotation.status,
  coalesce(annotation.reason, '-'),
  coalesce(annotation.cdna_position::VARCHAR, '-'),
  coalesce(annotation.cds_position::VARCHAR, '-'),
  coalesce(annotation.protein_position::VARCHAR, '-')
FROM variants,
LATERAL unnest(_duckvep_annotate_small_rich(
  'fixture', seq_region, position, reference, alternate, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord, annotation.transcript_index NULLS FIRST;
----
start_lost	0	start_lost	HIGH	CDS	supported	-	21	1	1
missense	0	missense_variant	MODERATE	CDS	supported	-	25	5	2
synonymous	0	synonymous_variant	LOW	CDS	supported	-	26	6	2
intron	0	intron_variant	MODIFIER	intron	supported	-	-	-	-
stop_gained	0	stop_gained	HIGH	CDS	supported	-	88	68	23
stop_lost	0	stop_lost	HIGH	CDS	supported	-	90	70	24
stop_retained	0	stop_retained_variant	LOW	CDS	supported	-	91	71	24
intergenic	-	sequence_variant	MODIFIER	NULL	unresolved	no_feature_in_loaded_model	-	-	-

# The compact surface runs the same kernel but preserves masks and enum bytes.
query TTIIIIITTTTTII
WITH variants(ord, id, seq_region, position, reference, alternate) AS (
  VALUES
    (1, 'missense', 1::UINTEGER, 124::UBIGINT, 'T', 'C'),
    (2, 'intron', 1::UINTEGER, 160::UBIGINT, 'T', 'C'),
    (3, 'reference_mismatch', 1::UINTEGER, 124::UBIGINT, 'A', 'C'),
    (4, 'partial_no_feature', 0::UINTEGER, 100::UBIGINT, 'A', 'C')
)
SELECT
  id,
  coalesce(annotation.transcript_index::VARCHAR, '-'),
  annotation.consequence_mask,
  annotation.region_mask,
  annotation.impact_code,
  annotation.status_code,
  annotation.reason_code,
  coalesce(annotation.cdna_position::VARCHAR, '-'),
  coalesce(annotation.cds_position::VARCHAR, '-'),
  coalesce(annotation.protein_position::VARCHAR, '-'),
  coalesce(annotation.reference_amino_acid_code::VARCHAR, '-'),
  coalesce(annotation.alternate_amino_acid_code::VARCHAR, '-'),
  annotation.nmd_prediction_code,
  annotation.nmd_escape_reasons
FROM variants,
LATERAL unnest(_duckvep_annotate_small_compact(
  'fixture', seq_region, position, reference, alternate, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord, annotation.transcript_index NULLS FIRST;
----
missense	0	8192	16	2	0	0	25	5	2	86	65	0	0
intron	0	4	4	0	0	0	-	-	-	-	-	0	0
reference_mismatch	0	2048	16	0	1	4	-	-	-	-	-	0	0
partial_no_feature	-	0	0	0	1	1	-	-	-	-	-	0	0

# VEP 116 keeps an equal-length uploaded feature as the peptide-predicate
# window even when prefix/suffix trimming leaves the same one-base CDS edit as
# a paired SNV. The retained start/stop codon changes the predicate state.
query ITTT
WITH variants(ord, position, reference, alternate) AS (
  VALUES
    (1, 122::UBIGINT, 'GG', 'GA'),
    (2, 123::UBIGINT, 'G', 'A'),
    (3, 237::UBIGINT, 'GT', 'TT'),
    (4, 237::UBIGINT, 'G', 'T'),
    (5, 237::UBIGINT, 'GT', 'AT'),
    (6, 237::UBIGINT, 'G', 'A'),
    (7, 122::UBIGINT, 'AG', 'AA'),
    (8, 122::UBIGINT, 'NG', 'NA')
)
SELECT ord, annotation.consequence, annotation.status,
       coalesce(annotation.reason, '-')
FROM variants,
LATERAL unnest(_duckvep_annotate_small_rich(
  'fixture', 1::UINTEGER, position, reference, alternate, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	start_lost&start_retained_variant	supported	-
2	missense_variant	supported	-
3	stop_retained_variant	supported	-
4	missense_variant	supported	-
5	missense_variant	supported	-
6	stop_gained	supported	-
7	coding_sequence_variant	unresolved	reference_mismatch
8	coding_sequence_variant	unresolved	ambiguous_sequence

# VEP maps an equal-length feature crossing 5' UTR into CDS through the start
# codon only. Preserving ATG suppresses later coding changes in the same feature.
query ITT
WITH variants(ord, position, reference, alternate) AS (
  VALUES
    (1, 119::UBIGINT, 'GA', 'AC'),
    (2, 118::UBIGINT, 'CGA', 'GAA'),
    (3, 119::UBIGINT, 'GATGGT', 'TATGAT'),
    (4, 119::UBIGINT, 'GATG', 'GTAA')
)
SELECT ord, annotation.consequence, annotation.status
FROM variants,
LATERAL unnest(_duckvep_annotate_small_rich(
  'fixture', 1::UINTEGER, position, reference, alternate, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	start_lost&5_prime_UTR_variant	supported
2	start_retained_variant&5_prime_UTR_variant	supported
3	start_retained_variant&5_prime_UTR_variant	supported
4	start_lost&5_prime_UTR_variant	supported

# VEP's length-changing start/stop predicates rebuild UTR+CDS strings. These
# are real VEP-116 witnesses, including its odd lost+retained start state.
query ITTT
WITH variants(ord, position, reference, alternate) AS (
  VALUES
    (1, 117::UBIGINT, 'ACGA', 'A'),
    (2, 118::UBIGINT, 'CGA', 'C'),
    (3, 118::UBIGINT, 'CGA', 'CACAC'),
    (4, 239::UBIGINT, 'AAA', 'A'),
    (5, 239::UBIGINT, 'AAAC', 'A'),
    (6, 240::UBIGINT, 'AA', 'C')
)
SELECT ord, annotation.consequence, annotation.status,
       coalesce(annotation.reason, '-')
FROM variants,
LATERAL unnest(_duckvep_annotate_small_rich(
  'fixture', 1::UINTEGER, position, reference, alternate, 0::UBIGINT
)) AS u(annotation)
ORDER BY ord;
----
1	start_lost&start_retained_variant&5_prime_UTR_variant	supported	-
2	start_lost&5_prime_UTR_variant	supported	-
3	start_lost&5_prime_UTR_variant	supported	-
4	stop_lost&3_prime_UTR_variant	supported	-
5	stop_retained_variant&3_prime_UTR_variant	supported	-
6	stop_lost&3_prime_UTR_variant	supported	-

# The stronger overload requires contig lengths before a caller may declare
# complete transcript coverage and receive supported intergenic assertions.
statement error
SELECT * FROM duckvep_model_load(
  'invalid-complete',
  'SELECT * FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_start',
  transcript_coverage_complete := TRUE
);
----
complete transcript coverage requires sequence_length

query I
SELECT loaded FROM duckvep_model_load(
  'fixture-complete',
  'SELECT seq_region, 1000::UBIGINT AS sequence_length FROM duckvep_test_regions ORDER BY seq_region',
  'SELECT * FROM duckvep_test_transcripts ORDER BY seq_region, transcript_start',
  'SELECT * FROM duckvep_test_exons ORDER BY transcript_index, exon_start',
  transcript_coverage_complete := TRUE
);
----
1


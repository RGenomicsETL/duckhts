# Text locations identify the 1-based start byte of the failing operation,
# including arithmetic failures after an earlier aligned block.
statement error
SELECT cigar_query_length('10M2Q', TRUE);
----
operation-start byte offset 4

statement error
SELECT cigar_query_length('9223372036854775807I1I', TRUE);
----
operation-start byte offset 21

statement error
SELECT cigar_aligned_blocks('10M2M', 9223372036854775796, TRUE);
----
operation-start byte offset 4

# Packed operation indices are 1-based and relative to this CIGAR, including
# NULL children in a list that starts after another row's children.
statement error
SELECT cigar_query_length([16, 0]::UINTEGER[], TRUE);
----
op index 2

statement error
SELECT cigar_has_op([16, 25]::UINTEGER[], 'M', TRUE);
----
op index 2

statement error
SELECT cigar_aligned_blocks([16, 16, NULL]::UINTEGER[], 1, TRUE);
----
op index 3

statement ok
CREATE TEMP TABLE strict_cigar_child_offsets AS
SELECT * FROM (VALUES (0, [32, 48]::UINTEGER[]), (1, [16, NULL]::UINTEGER[])) t(i,c);

statement error
SELECT cigar_reference_length(c, TRUE) FROM strict_cigar_child_offsets ORDER BY i;
----
op index 2

# Policy and NULL flags vary per row across multiple DuckDB vectors.
query IIII
WITH inputs AS (
    SELECT i,
        CASE WHEN i % 4 = 0 THEN [16, 0]::UINTEGER[]
             WHEN i % 4 = 2 THEN [NULL, 16]::UINTEGER[]
             ELSE [80, 34, 80]::UINTEGER[] END AS c,
        CASE WHEN i % 4 = 2 THEN NULL ELSE i % 4 = 1 END AS strict
    FROM range(5000) t(i)
), results AS (SELECT i, checked_cigar_profile(c, strict) AS p FROM inputs)
SELECT count(*),
    count(*) FILTER (WHERE i % 4 = 0 AND p IS NOT DISTINCT FROM {
        'q':NULL, 'r':NULL, 'aligned':NULL, 'left_clip':NULL, 'right_clip':NULL,
        'soft':NULL, 'hard':NULL, 'has_d':NULL, 'blocks':NULL}),
    count(*) FILTER (WHERE i % 4 = 2 AND p IS NOT DISTINCT FROM {
        'q':NULL, 'r':NULL, 'aligned':NULL, 'left_clip':NULL, 'right_clip':NULL,
        'soft':NULL, 'hard':NULL, 'has_d':NULL, 'blocks':NULL}),
    count(*) FILTER (WHERE i % 2 = 1 AND p IS NOT DISTINCT FROM {
        'q':10, 'r':12, 'aligned':10, 'left_clip':0, 'right_clip':0,
        'soft':FALSE, 'hard':FALSE, 'has_d':TRUE,
        'blocks':{'ref_start':[-5,2], 'query_start':[0,5], 'width':[5,5]}})
FROM results;
----
5000	1250	1250	2500

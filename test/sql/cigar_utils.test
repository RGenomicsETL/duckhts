# CIGAR metrics and presence validate the complete text or packed input.
require duckhts

query III
WITH invalid(id, cigar) AS (VALUES
    (1, '10M0'),
    (2, '10M00'),
    (3, '18446744073709551617M'),
    (4, '9223372036854775807M1M'),
    (5, '9223372036854775807I1I'),
    (6, '9223372036854775807D1D'),
    (7, '9223372036854775807S1S'),
    (8, '1M0Q'),
    (9, '1M1Q'),
    (10, '1M1B'),
    (11, '0M'),
    (12, 'M'),
    (13, '1M1'),
    (14, '-1M'),
    (15, '1M 1I'),
    (16, '1M1m'),
    (17, '1S0M'),
    (18, '1M' || chr(0) || '1M')
)
SELECT id,
       (cigar_query_length(cigar) IS NULL AND
        cigar_reference_length(cigar) IS NULL AND
        cigar_aligned_query_length(cigar) IS NULL AND
        cigar_left_soft_clip(cigar) IS NULL AND
        cigar_right_soft_clip(cigar) IS NULL AND
        cigar_has_soft_clip(cigar) IS NULL AND
        cigar_has_hard_clip(cigar) IS NULL)::INTEGER,
       (cigar_has_op(cigar, 'M') IS NULL AND
        cigar_has_op(cigar, 'S') IS NULL)::INTEGER
FROM invalid ORDER BY id;
----
1	1	1
2	1	1
3	1	1
4	1	1
5	1	1
6	1	1
7	1	1
8	1	1
9	1	1
10	1	1
11	1	1
12	1	1
13	1	1
14	1	1
15	1	1
16	1	1
17	1	1
18	1	1

query III
WITH invalid(id, cigar) AS (VALUES
    (1, [16, 0]::UINTEGER[]),
    (2, [16, 25]::UINTEGER[]),
    (3, [16, 31]::UINTEGER[]),
    (4, [16, NULL]::UINTEGER[]),
    (5, [0]::UINTEGER[]),
    (6, [4294967295]::UINTEGER[])
)
SELECT id,
       (cigar_query_length(cigar) IS NULL AND
        cigar_reference_length(cigar) IS NULL AND
        cigar_aligned_query_length(cigar) IS NULL AND
        cigar_left_soft_clip(cigar) IS NULL AND
        cigar_right_soft_clip(cigar) IS NULL AND
        cigar_has_soft_clip(cigar) IS NULL AND
        cigar_has_hard_clip(cigar) IS NULL)::INTEGER,
       (cigar_has_op(cigar, 'M') IS NULL)::INTEGER
FROM invalid ORDER BY id;
----
1	1	1
2	1	1
3	1	1
4	1	1
5	1	1
6	1	1

# Numeric limits apply to each op length and the consumed spans, not to the
# sum of non-consuming H/P lengths. Leading zeroes do not change the length.
query TTTIIII
SELECT cigar_query_length('9223372036854775807M')::VARCHAR,
       cigar_aligned_query_length('9223372036854775807M')::VARCHAR,
       cigar_reference_length('9223372036854775807M')::VARCHAR,
       cigar_reference_length('9223372036854775807I'),
       cigar_query_length('9223372036854775807D'),
       cigar_query_length('9223372036854775807H9223372036854775807P'),
       cigar_query_length('000000000000000000000000000000000000000001M');
----
9223372036854775807	9223372036854775807	9223372036854775807	0	0	0	1

query III
SELECT cigar_query_length([4294967280]::UINTEGER[]),
       cigar_aligned_query_length([4294967280]::UINTEGER[]),
       cigar_reference_length([4294967280]::UINTEGER[]);
----
268435455	268435455	268435455

# Soft-clip endpoints refer to the literal first and last ops.
query IIIIIII
SELECT cigar_left_soft_clip('5H7S3M2S4H'),
       cigar_right_soft_clip('5H7S3M2S4H'),
       cigar_query_length('5H7S3M2S4H'),
       cigar_left_soft_clip('5S7S3M2S4S'),
       cigar_right_soft_clip('5S7S3M2S4S'),
       cigar_query_length('5S7S3M2S4S'),
       cigar_aligned_query_length('5S7S3M2S4S');
----
0	0	12	5	4	21	3

query IIIIIIII
SELECT (cigar_query_length('') IS NULL)::INTEGER,
       (cigar_query_length('*') IS NULL)::INTEGER,
       (cigar_query_length([]::UINTEGER[]) IS NULL)::INTEGER,
       cigar_has_op('', 'M')::INTEGER,
       cigar_has_op('*', 'M')::INTEGER,
       cigar_has_op([]::UINTEGER[], 'M')::INTEGER,
       (cigar_has_op(NULL::VARCHAR, 'M') IS NULL)::INTEGER,
       (cigar_has_op(NULL::UINTEGER[], 'M') IS NULL)::INTEGER;
----
1	1	1	0	0	0	1	1

query IIIIII
SELECT cigar_has_op('5M2D5M', 'd')::INTEGER,
       cigar_has_op([80, 34, 80]::UINTEGER[], 'd')::INTEGER,
       (cigar_has_op('1M', 'Q') IS NULL)::INTEGER,
       (cigar_has_op([16]::UINTEGER[], 'Q') IS NULL)::INTEGER,
       (cigar_has_op('1M', '') IS NULL)::INTEGER,
       (cigar_has_op([16]::UINTEGER[], '') IS NULL)::INTEGER;
----
1	1	1	1	1	1

# Position may be negative; its sum with the reference span must fit BIGINT.
query TTTI
SELECT (cigar_aligned_blocks('1M', '-9223372036854775808'::BIGINT)).ref_start::VARCHAR,
       (cigar_aligned_blocks('9223372036854775807M', '-9223372036854775808'::BIGINT)).width::VARCHAR,
       (cigar_aligned_blocks('1M', 9223372036854775806)).ref_start::VARCHAR,
       (cigar_aligned_blocks('1M', 9223372036854775807) IS NULL)::INTEGER;
----
[-9223372036854775808]	[9223372036854775807]	[9223372036854775806]	1

# Invalid packed rows and following valid rows cross DuckDB vector edges.
query III
WITH inputs AS (
    SELECT i, CASE WHEN i % 3 = 0 THEN [16, 0]::UINTEGER[]
                   ELSE [80, 34, 80]::UINTEGER[] END AS cigar
    FROM range(5000) t(i)
), results AS (
    SELECT i, cigar_query_length(cigar) AS q, cigar_has_op(cigar, 'M') AS has_m,
           cigar_aligned_blocks(cigar, 1) AS blocks
    FROM inputs
)
SELECT count(*),
       count(*) FILTER (WHERE i % 3 = 0 AND q IS NULL AND has_m IS NULL AND blocks IS NULL),
       count(*) FILTER (WHERE i % 3 != 0 AND q = 10 AND has_m AND
           blocks.ref_start = [1, 8] AND blocks.query_start = [0, 5] AND blocks.width = [5, 5])
FROM results;
----
5000	1667	3333

# Requested operators use ASCII case folding for both representations.
query II
WITH requested(op) AS (VALUES ('m'), ('i'), ('d'), ('n'), ('s'), ('h'), ('p'), ('='), ('x'))
SELECT count(*), count(*) FILTER (WHERE
    cigar_has_op('1M1I1D1N1S1H1P1=1X', op)
    AND cigar_has_op('1M1I1D1N1S1H1P1=1X', op, TRUE)
    AND cigar_has_op([16,17,18,19,20,21,22,23,24]::UINTEGER[], op)
    AND cigar_has_op([16,17,18,19,20,21,22,23,24]::UINTEGER[], op, TRUE))
FROM requested;
----
9	9

# One grammar and numeric contract for both failure policies and encodings.
statement ok
CREATE TEMP MACRO checked_cigar_profile(c, strict) AS struct_pack(
    q := cigar_query_length(c, strict),
    r := cigar_reference_length(c, strict),
    aligned := cigar_aligned_query_length(c, strict),
    left_clip := cigar_left_soft_clip(c, strict),
    right_clip := cigar_right_soft_clip(c, strict),
    soft := cigar_has_soft_clip(c, strict),
    hard := cigar_has_hard_clip(c, strict),
    has_d := cigar_has_op(c, 'd', strict),
    blocks := cigar_aligned_blocks(c, -5, strict));

query II
WITH inputs(c, strict) AS (VALUES
    ('2H3S5M2I1P4=1X2D3N7M4S1H', FALSE),
    ('2H3S5M2I1P4=1X2D3N7M4S1H', TRUE)
), results AS (SELECT checked_cigar_profile(c, strict) AS p FROM inputs)
SELECT count(*), count(*) FILTER (WHERE p IS NOT DISTINCT FROM {
    'q':26, 'r':22, 'aligned':17, 'left_clip':0, 'right_clip':0,
    'soft':TRUE, 'hard':TRUE, 'has_d':TRUE,
    'blocks':{'ref_start':[-5,0,4,10], 'query_start':[3,10,14,15], 'width':[5,4,1,7]}})
FROM results;
----
2	2

query II
WITH inputs(strict) AS (VALUES (FALSE), (TRUE)), results AS (
    SELECT checked_cigar_profile(
        [37,52,80,33,22,71,24,34,51,112,68,21]::UINTEGER[], strict) AS p FROM inputs
)
SELECT count(*), count(*) FILTER (WHERE p IS NOT DISTINCT FROM {
    'q':26, 'r':22, 'aligned':17, 'left_clip':0, 'right_clip':0,
    'soft':TRUE, 'hard':TRUE, 'has_d':TRUE,
    'blocks':{'ref_start':[-5,0,4,10], 'query_start':[3,10,14,15], 'width':[5,4,1,7]}})
FROM results;
----
2	2

# Missing CIGAR is distinct from an invalid operation in either policy.
query IIIIIIII
SELECT (cigar_query_length('*', TRUE) IS NULL)::INTEGER,
       (cigar_has_soft_clip('', TRUE) IS NULL)::INTEGER,
       (cigar_reference_length([]::UINTEGER[], TRUE) IS NULL)::INTEGER,
       cigar_has_op('*', 'M', TRUE)::INTEGER,
       cigar_has_op('', 'M', TRUE)::INTEGER,
       cigar_has_op([]::UINTEGER[], 'M', TRUE)::INTEGER,
       (cigar_aligned_blocks('*', 1, TRUE) IS NULL)::INTEGER,
       (cigar_aligned_blocks([]::UINTEGER[], 1, TRUE) IS NULL)::INTEGER;
----
1	1	1	0	0	0	1	1

query IIIIIII
SELECT (cigar_query_length(NULL::VARCHAR, TRUE) IS NULL)::INTEGER,
       (cigar_query_length(NULL::UINTEGER[], TRUE) IS NULL)::INTEGER,
       (cigar_has_op(NULL::VARCHAR, 'Q', TRUE) IS NULL)::INTEGER,
       (cigar_has_op('0M', NULL::VARCHAR, TRUE) IS NULL)::INTEGER,
       (cigar_has_op([0]::UINTEGER[], NULL::VARCHAR, TRUE) IS NULL)::INTEGER,
       (cigar_aligned_blocks('0M', NULL::BIGINT, TRUE) IS NULL)::INTEGER,
       (cigar_aligned_blocks([0]::UINTEGER[], NULL::BIGINT, TRUE) IS NULL)::INTEGER;
----
1	1	1	1	1	1	1

query II
WITH inputs(c) AS (VALUES ('0M'), ('1M')), results AS (
    SELECT checked_cigar_profile(c, NULL::BOOLEAN) AS p FROM inputs
)
SELECT count(*), count(*) FILTER (WHERE p IS NOT DISTINCT FROM {
    'q':NULL, 'r':NULL, 'aligned':NULL, 'left_clip':NULL, 'right_clip':NULL,
    'soft':NULL, 'hard':NULL, 'has_d':NULL, 'blocks':NULL})
FROM results;
----
2	2

query TTTTI
SELECT (cigar_aligned_blocks('3S', 1, TRUE)).ref_start::VARCHAR,
       (cigar_aligned_blocks([52]::UINTEGER[], 1, TRUE)).query_start::VARCHAR,
       (cigar_aligned_blocks('1H1P', 1, TRUE)).width::VARCHAR,
       cigar_query_length('9223372036854775807M', TRUE)::VARCHAR,
       cigar_query_length('9223372036854775807H9223372036854775807P', TRUE);
----
[]	[]	[]	9223372036854775807	0


# name: test/sql/variantkey_regionkey.test
# description: Test duckhts extension – VariantKey and RegionKey scalar UDFs
# group: [duckhts]

require duckhts

query TTTTTTTTTTTTT
SELECT duckhts_contig_key('chr1'),
       duckhts_contig_key('1'),
       duckhts_contig_key('chrM'),
       duckhts_contig_key('CHRMT'),
       duckhts_contig_key('M'),
       duckhts_contig_key('mt'),
       duckhts_contig_key('chrX'),
       duckhts_contig_key('chry'),
       duckhts_contig_key('chrGL000220.1'),
       duckhts_contig_key('NC_000001.11'),
       duckhts_contig_key('23'),
       duckhts_contig_key('chrchr1'),
       duckhts_contig_key('chr');
----
1	1	MT	MT	MT	MT	X	Y	GL000220.1	NC_000001.11	23	chr1	chr

query II
SELECT CASE WHEN duckhts_contig_key(NULL) IS NULL THEN 1 ELSE 0 END,
       CASE WHEN duckhts_contig_key('') = '' THEN 1 ELSE 0 END;
----
1	1

query T
SELECT variantkey_hex(variantkey('chr1', 268435456, 'C', 'T'));
----
0fffffff88b80000

query T
SELECT variantkey_hex(encode_variantkey(1, 324683, 145752064));
----
08027a2588b00000

query III
SELECT extract_variantkey_chrom(parse_variantkey_hex('08027a2588b00000')),
       extract_variantkey_pos(parse_variantkey_hex('08027a2588b00000')),
       extract_variantkey_refalt(parse_variantkey_hex('08027a2588b00000'));
----
1	324683	145752064

query III
SELECT dv.chrom_code, dv.pos0, dv.refalt_code
FROM (SELECT decode_variantkey(parse_variantkey_hex('08027a2588b00000')) AS dv);
----
1	324683	145752064

query T
SELECT variantkey_hex(variantkey('1', 324696, 'ATGCTTCTTTGCAGCCTCTCCAGGCCCAGCTCC', 'A'));
----
08027a2bed669117

query T
SELECT variantkey_hex(variantkey('1', 324693, 'N', 'A'));
----
08027a2a13ace339

query T
SELECT variantkey_hex(variantkey('1', 101, 'A', '<DEL>'));
----
080000320d008101

query IIII
SELECT rv.chrom_code,
       rv.pos,
       rv.pos0,
       CASE WHEN rv.reversible THEN 1 ELSE 0 END
FROM (SELECT reverse_variantkey(parse_variantkey_hex('08027a2588b00000')) AS rv);
----
1	324684	324683	1

query TT
SELECT rv.ref, rv.alt
FROM (SELECT reverse_variantkey(parse_variantkey_hex('08027a2588b00000')) AS rv);
----
C	G

query III
SELECT rv.pos,
       CASE WHEN rv.ref IS NULL THEN 1 ELSE 0 END,
       CASE WHEN rv.reversible THEN 1 ELSE 0 END
FROM (SELECT reverse_variantkey(variantkey('1', 101, 'A', '<DEL>')) AS rv);
----
101	1	0

query TT
SELECT variantkey_hex(vkr.min), variantkey_hex(vkr.max)
FROM (SELECT variantkey_range('1', 100, 100) AS vkr);
----
0800003180000000	08000031ffffffff

query II
SELECT CASE WHEN variantkey('GL000220.1', 1, 'A', 'C') IS NULL THEN 1 ELSE 0 END,
       CASE WHEN variantkey('1', 0, 'A', 'C') IS NULL THEN 1 ELSE 0 END;
----
1	1

query T
SELECT regionkey_hex(regionkey('X', 1007, 1807, 1));
----
b80001f78000387a

query T
SELECT regionkey_hex(encode_regionkey(23, 1007, 1807, 1));
----
b80001f78000387a

query IIII
SELECT extract_regionkey_chrom(parse_regionkey_hex('b80001f78000387a')),
       extract_regionkey_startpos(parse_regionkey_hex('b80001f78000387a')),
       extract_regionkey_endpos(parse_regionkey_hex('b80001f78000387a')),
       extract_regionkey_strand(parse_regionkey_hex('b80001f78000387a'));
----
23	1007	1807	1

query IIII
SELECT dr.chrom_code, dr.start, dr."end", dr.strand_code
FROM (SELECT decode_regionkey(parse_regionkey_hex('b80001f78000387a')) AS dr);
----
23	1007	1807	1

query T
SELECT regionkey_hex(regionkey('X', 1007, 1807));
----
b80001f780003878

query IIIIII
SELECT rr.chrom_code,
       rr.start,
       rr."end",
       rr.strand,
       rr.strand_code,
       CASE WHEN rr.chrom = 'X' THEN 1 ELSE 0 END
FROM (SELECT reverse_regionkey(parse_regionkey_hex('b80001f78000387a')) AS rr);
----
23	1007	1807	1	1	1

query IIII
SELECT rr.start,
       rr."end",
       rr.strand,
       rr.strand_code
FROM (SELECT reverse_regionkey(extend_regionkey(regionkey('X', 10000, 20000, -1), 1000)) AS rr);
----
9000	21000	-1	2

query IIII
SELECT rr.start,
       rr."end",
       rr.strand,
       rr.strand_code
FROM (SELECT reverse_regionkey(extend_regionkey(regionkey('X', 10000, 20000, -1), 300000000)) AS rr);
----
0	268435455	-1	2

query IIIII
SELECT CASE WHEN are_overlapping_regions('1', 2, 4, '1', 3, 7) THEN 1 ELSE 0 END,
       CASE WHEN are_overlapping_regions('1', 0, 2, '1', 3, 7) THEN 1 ELSE 0 END,
       CASE WHEN are_overlapping_regionkeys(regionkey('X', 1007, 1807, 1), parse_regionkey_hex('b80001f78000387a')) THEN 1 ELSE 0 END,
       CASE WHEN are_overlapping_region_regionkey('X', 1008, 1800, parse_regionkey_hex('b80001f78000387a')) THEN 1 ELSE 0 END,
       CASE WHEN are_overlapping_region_regionkey('X', 2000, 2100, parse_regionkey_hex('b80001f78000387a')) THEN 1 ELSE 0 END;
----
1	0	1	1	0

query II
SELECT CASE WHEN regionkey('GL000220.1', 0, 10) IS NULL THEN 1 ELSE 0 END,
       CASE WHEN regionkey('1', 10, 0) IS NULL THEN 1 ELSE 0 END;
----
1	1

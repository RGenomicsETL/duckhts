# Named columns are raw scalar MAP lookups, including first-occurrence semantics.
require duckhts

statement ok
CREATE TABLE gff_named AS SELECT * FROM read_gff('__WORKING_DIRECTORY__/test/data/gff_named_attributes.gff3', attributes := ['Parent','ID','encoded','spaced','empty','missing','odd-key','quote''key'], attributes_map := true, attributes_list := true, attributes_pairs := true);

query I
SELECT count(*) FROM gff_named WHERE Parent IS DISTINCT FROM attributes_map['Parent'] OR ID IS DISTINCT FROM attributes_map['ID'] OR encoded IS DISTINCT FROM attributes_map['encoded'] OR spaced IS DISTINCT FROM attributes_map['spaced'] OR empty IS DISTINCT FROM attributes_map['empty'] OR missing IS DISTINCT FROM attributes_map['missing'] OR "odd-key" IS DISTINCT FROM attributes_map['odd-key'] OR "quote'key" IS DISTINCT FROM attributes_map['quote''key'];
----
0

query TTTTT
SELECT ID, coalesce('[' || Parent || ']', 'NULL'), encoded, spaced, coalesce('[' || empty || ']', 'NULL') FROM gff_named ORDER BY seqname, start;
----
first	[p1,p2]	a%3Bb%20c	value	[]
third	[p3]	%25	other	[]
NULL	NULL	NULL	NULL	NULL
fourth	[]	a=b	NULL	NULL
last	NULL	NULL	NULL	NULL

query T
SELECT typeof(ID) FROM gff_named LIMIT 1;
----
VARCHAR

statement ok
CREATE TABLE gtf_named AS SELECT * FROM read_gtf('__WORKING_DIRECTORY__/test/data/gtf_named_attributes.gtf', attributes := ['transcript_id','gene_id','encoded','spaced','empty','missing','odd-key','quote''key'], attributes_map := true, attributes_list := true, attributes_pairs := true);

query I
SELECT count(*) FROM gtf_named WHERE transcript_id IS DISTINCT FROM attributes_map['transcript_id'] OR gene_id IS DISTINCT FROM attributes_map['gene_id'] OR encoded IS DISTINCT FROM attributes_map['encoded'] OR spaced IS DISTINCT FROM attributes_map['spaced'] OR empty IS DISTINCT FROM attributes_map['empty'] OR missing IS DISTINCT FROM attributes_map['missing'] OR "odd-key" IS DISTINCT FROM attributes_map['odd-key'] OR "quote'key" IS DISTINCT FROM attributes_map['quote''key'];
----
0

query TTTTT
SELECT gene_id, transcript_id, encoded, spaced, coalesce('[' || empty || ']', 'NULL') FROM gtf_named ORDER BY seqname, start;
----
first	p1,p2	a%3Bb%20c	value	[]
third	p3	%25	other	[]
NULL	NULL	NULL	NULL	NULL
fourth	a;b	a=b	NULL	NULL
last	NULL	NULL	NULL	NULL

# Project only a subset, reordered, without materializing raw or derived containers.
query TT
SELECT "odd-key", ID FROM read_gff('__WORKING_DIRECTORY__/test/data/gff_named_attributes.gff3', attributes := ['missing','ID','Parent','odd-key'], attributes_map := true, attributes_list := true, attributes_pairs := true) ORDER BY seqname, start;
----
x	first
y	third
NULL	NULL
NULL	fourth
NULL	last

query TT
SELECT ID AS first_copy, ID AS second_copy FROM read_gff('__WORKING_DIRECTORY__/test/data/gff_named_attributes.gff3', attributes := ['ID']) WHERE ID IS NOT NULL ORDER BY seqname, start;
----
first	first
third	third
fourth	fourth
last	last

query I
SELECT sum(start) FROM read_gff('__WORKING_DIRECTORY__/test/data/gff_named_attributes.gff3', attributes := ['ID','Parent','missing']);
----
45

query I
SELECT count(*) FROM read_gtf('__WORKING_DIRECTORY__/test/data/gtf_named_attributes.gtf', attributes := []::VARCHAR[]);
----
5

query T
SELECT id FROM read_gff('__WORKING_DIRECTORY__/test/data/gff_named_attributes.gff3', attributes := ['id']) WHERE start = 11 AND seqname = 'chr2';
----
lower

# Identifier collisions use DuckDB's ASCII case folding, not Unicode case folding.
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM read_gff('__WORKING_DIRECTORY__/test/data/gff_named_attributes.gff3', attributes := ['Ä','ä'])) WHERE column_name IN ('Ä','ä') ORDER BY column_name;
----
Ä	VARCHAR
ä	VARCHAR


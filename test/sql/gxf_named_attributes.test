# Maximum admitted key count with reordered projections.
query I
SELECT count(key0) + count(key255) FROM read_gff('__WORKING_DIRECTORY__/test/data/gff_named_attributes.gff3', attributes := list_transform(range(256), x -> 'key' || x));
----
0

statement error
SELECT ID FROM read_gff('__WORKING_DIRECTORY__/test/data/gff_named_attributes.gff3', attributes := ['ID'], strict := true);
----
InvalidAttribute

query II
SELECT count(*), count(missing) FROM read_gff('__WORKING_DIRECTORY__/test/data/gff_many_contigs.gff.gz', attributes := ['missing','ID','Parent']);
----
20000	0

statement ok
CREATE TABLE many_seq AS SELECT seqname, start, "end", ID, Parent, transcript_type, gene_type FROM read_gff('__WORKING_DIRECTORY__/test/data/gff_many_contigs.gff.gz', scan_mode := 'sequential', attributes := ['Parent','ID','transcript_type','gene_type']);

statement ok
CREATE TABLE many_idx AS SELECT seqname, start, "end", ID, Parent, transcript_type, gene_type FROM read_gff('__WORKING_DIRECTORY__/test/data/gff_many_contigs.gff.gz', attributes := ['Parent','ID','transcript_type','gene_type']);

query II
SELECT count(*), count(DISTINCT seqname) FROM many_seq;
----
20000	10000

query I
SELECT count(*) FROM ((SELECT * FROM many_seq EXCEPT ALL SELECT * FROM many_idx) UNION ALL (SELECT * FROM many_idx EXCEPT ALL SELECT * FROM many_seq));
----
0

query I
SELECT count(*) FROM read_gff('__WORKING_DIRECTORY__/test/data/gff_many_contigs.gff.gz', attributes := ['Parent','ID','transcript_type','gene_type'], attributes_map := true) WHERE Parent IS DISTINCT FROM attributes_map['Parent'] OR ID IS DISTINCT FROM attributes_map['ID'] OR transcript_type IS DISTINCT FROM attributes_map['transcript_type'] OR gene_type IS DISTINCT FROM attributes_map['gene_type'];
----
0

statement ok
CREATE TABLE many_regions AS SELECT seqname, start, "end", ID, Parent, transcript_type, gene_type FROM read_gff('__WORKING_DIRECTORY__/test/data/gff_many_contigs.gff.gz', region := array_to_string(list_transform(range(1, 10001), x -> 'contig' || lpad(x::VARCHAR, 5, '0') || ':1-100'), ','), attributes := ['Parent','ID','transcript_type','gene_type']);

query I
SELECT count(*) FROM many_regions;
----
20000

query I
SELECT count(*) FROM ((SELECT * FROM many_seq EXCEPT ALL SELECT * FROM many_regions) UNION ALL (SELECT * FROM many_regions EXCEPT ALL SELECT * FROM many_seq));
----
0

# Indexed overlapping regions must equal the corresponding sequential row filter.
statement ok
CREATE TABLE region_seq AS SELECT seqname, start, "end", ID, Parent FROM read_gff('__WORKING_DIRECTORY__/test/data/gff_named_attributes.gff3.gz', scan_mode := 'sequential', attributes := ['Parent','ID']) WHERE seqname = 'chr1' AND start <= 20 AND "end" >= 5;

statement ok
CREATE TABLE region_idx AS SELECT seqname, start, "end", ID, Parent FROM read_gff('__WORKING_DIRECTORY__/test/data/gff_named_attributes.gff3.gz', region := 'chr1:5-15,chr1:14-20', attributes := ['Parent','ID']);

query I
SELECT count(*) FROM region_seq;
----
2

query I
SELECT count(*) FROM ((SELECT * FROM region_seq EXCEPT ALL SELECT * FROM region_idx) UNION ALL (SELECT * FROM region_idx EXCEPT ALL SELECT * FROM region_seq));
----
0

statement ok
CREATE TABLE gtf_region_seq AS SELECT seqname, start, gene_id, transcript_id FROM read_gtf('__WORKING_DIRECTORY__/test/data/gtf_named_attributes.gtf.gz', scan_mode := 'sequential', attributes := ['gene_id','transcript_id']) WHERE seqname = 'chr1' AND start <= 20 AND "end" >= 5;

statement ok
CREATE TABLE gtf_region_idx AS SELECT seqname, start, gene_id, transcript_id FROM read_gtf('__WORKING_DIRECTORY__/test/data/gtf_named_attributes.gtf.gz', region := 'chr1:5-15,chr1:14-20', attributes := ['gene_id','transcript_id']);

query I
SELECT count(*) FROM gtf_region_idx;
----
2

query I
SELECT count(*) FROM ((SELECT * FROM gtf_region_seq EXCEPT ALL SELECT * FROM gtf_region_idx) UNION ALL (SELECT * FROM gtf_region_idx EXCEPT ALL SELECT * FROM gtf_region_seq));
----
0

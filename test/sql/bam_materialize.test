# name: test/sql/bam_materialize.test
# description: Exact BAM materialization including empty/missing fields and vector reuse
# group: [duckhts]

require duckhts

# Synthetic SAM is the source authority; no external acquisition or generated oracle.
query TTTTTTT rowsort
SELECT QNAME, CIGAR, SEQ, QUAL, ML::VARCHAR, FZ::VARCHAR, CG::VARCHAR
FROM read_bam('__WORKING_DIRECTORY__/test/data/bam_materialize.sam', standard_tags := true);
----
r1	5M	ACGTN	IIIII	[0, 255]	[0, 65535]	[80]
r2	1S2M1I1M	TGCAN	!!!!!	[0, 1, 2, 3, 4, 5, 6, 7, 8, 255]	[]	NULL
r3	*	*	*	NULL	NULL	NULL

query TTTT rowsort
SELECT QNAME, CIGAR::VARCHAR, SEQ::VARCHAR, QUAL::VARCHAR
FROM read_bam('__WORKING_DIRECTORY__/test/data/bam_materialize.sam',
              cigar_representation := 'binary', sequence_encoding := 'nt16',
              quality_representation := 'phred');
----
r1	[80]	[1, 2, 4, 8, 15]	[40, 40, 40, 40, 40]
r2	[20, 32, 17, 16]	[8, 4, 2, 1, 15]	[0, 0, 0, 0, 0]
r3	[]	[]	NULL

query TTT rowsort
SELECT QNAME, entry.key, entry.value
FROM read_bam('__WORKING_DIRECTORY__/test/data/bam_materialize.sam', auxiliary_tags := true),
UNNEST(map_entries(AUXILIARY_TAGS)) AS tags(entry);
----
r1	CG	I,80
r1	FZ	S,0,65535
r1	ML	C,0,255
r1	X1	c,-128,127
r1	X2	C,0,255
r1	X3	s,-32768,32767
r1	X4	S,0,65535
r1	X5	i,-2147483648,2147483647
r1	X6	I,0,4294967295
r1	X7	f,0,1.25,1e+30
r1	XA	q
r1	XF	1.23457
r1	XH	0A1F
r1	XI	-2147483648
r1	XU	4294967295
r1	XZ	previous
r2	FZ	S
r2	ML	C,0,1,2,3,4,5,6,7,8,255
r2	X7	f,-1.5,2.25
r2	XZ	(empty)

query II
SELECT count(*) FILTER (WHERE AUXILIARY_TAGS IS NULL),
       count(*) FILTER (WHERE map_extract_value(AUXILIARY_TAGS, 'XZ') = '')
FROM read_bam('__WORKING_DIRECTORY__/test/data/bam_materialize.sam', auxiliary_tags := true);
----
1	1

# A record stream larger than one output chunk must reacquire child data.
query II
SELECT count(*), count(*) FILTER (WHERE SEQ = [4] AND QUAL = [40] AND CIGAR = [])
FROM read_bam('__WORKING_DIRECTORY__/test/data/bam_scan_all_unplaced.bam',
              cigar_representation := 'binary', sequence_encoding := 'nt16',
              quality_representation := 'phred');
----
2053	2053

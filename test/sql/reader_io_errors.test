# Physical read failures error independently of projection and BED short-line policy.
# Fixtures: bash test/scripts/reader_io_error_fixtures.sh
# The script uses bgzip and tabix on reader_io_error.bed/.sam, then head -c -36
# to remove the EOF block and eight bytes of the final data block.
require duckhts

statement error
SELECT * FROM read_bed('test/data/reader_io_error.bed.gz', scan_mode := 'sequential');
----

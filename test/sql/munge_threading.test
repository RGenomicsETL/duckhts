# name: test/sql/munge_threading.test
# description: Threaded FASTA-backed munge regression coverage
# group: [duckhts]

require duckhts

statement ok
PRAGMA threads=4

query I
SELECT CASE WHEN success THEN 1 ELSE 0 END
FROM fasta_index(
  '__WORKING_DIRECTORY__/test/data/liftover_src.fa',
  index_path := '__WORKING_DIRECTORY__/test/data/liftover_src.fa.fai'
);
----
1

query III
SELECT
  count(*),
  sum(CASE WHEN alleles_swapped THEN 1 ELSE 0 END),
  sum(CASE WHEN filter IS NULL THEN 1 ELSE 0 END)
FROM duckdb_munge(
  '(SELECT ''chrF'' AS CHR,
           2::BIGINT AS BP,
           CASE WHEN i % 2 = 0 THEN ''A'' ELSE ''C'' END AS A1,
           CASE WHEN i % 2 = 0 THEN ''C'' ELSE ''A'' END AS A2,
           ''rs'' || CAST(i AS VARCHAR) AS SNP,
           0.1::DOUBLE AS FRQ,
           1000::DOUBLE AS N
    FROM range(200000) t(i)) AS duckhts_src',
  column_map := map(['CHR','BP','A1','A2','SNP','FRQ','N'],
                    ['CHR','BP','A1','A2','SNP','FRQ','N']),
  fasta_ref := '__WORKING_DIRECTORY__/test/data/liftover_src.fa'
);
----
200000	100000	200000

query TTTTTTT
SELECT calls[1].format.AD::VARCHAR, calls[2].format.AD::VARCHAR,
       calls[1].format.GL::VARCHAR, calls[1].format.VI::VARCHAR,
       calls[1].format.VF::VARCHAR, calls[1].format.ST::VARCHAR, calls[1].alleles::VARCHAR
FROM selected_format WHERE record_index = 0;
----
[10, NULL, 5]	[NULL, 7, 3]	[0.0, -1.0, NULL, -3.0, -4.0, -5.0]	[1, NULL, 3]	[1.5, NULL, 2.5]	[a, NULL, b]	[NULL, NULL]

query ITTT

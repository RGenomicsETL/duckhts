# Every retained call equals the dense version; the filter does not renumber samples.
query I
SELECT count(*) FROM (
 SELECT record_index, unnest(calls, recursive:=true) FROM read_geno('__WORKING_DIRECTORY__/test/data/geno_calls.${ext}', samples:='S2')
 EXCEPT ALL SELECT * FROM geno_expected WHERE sample_index=1);
----
0

# Native index choice must not change the full-scan ordinal.
query I
SELECT count(*) FROM (
 SELECT * FROM read_geno('__WORKING_DIRECTORY__/test/data/geno_calls.${ext}', scan_mode:='sequential')
 EXCEPT ALL SELECT * FROM read_geno('__WORKING_DIRECTORY__/test/data/geno_calls.${ext}'));
----
0

endloop


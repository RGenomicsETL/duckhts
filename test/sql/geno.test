# EXCEPT ALL in both directions preserves duplicate records and missing values.
query II
WITH actual AS (
  SELECT g.CHROM, g.POS, g.ID, g.REF, g.ALT, s.sample_name,
         c.format.AD, c.format.DP, c.format.GQ, c.format.GL,
         c.format.VI, c.format.VF, c.format.ST
  FROM selected_format g, unnest(g.calls) u(c),
       read_bcf_samples('__WORKING_DIRECTORY__/test/data/geno_format.${ext}') s
  WHERE c.sample_index = s.sample_index
), expected AS (
  SELECT CHROM, POS, ID, REF, ALT, SAMPLE_ID,
         FORMAT_AD, FORMAT_DP, FORMAT_GQ, FORMAT_GL, FORMAT_VI, FORMAT_VF, FORMAT_ST
  FROM read_bcf('__WORKING_DIRECTORY__/test/data/geno_format.${ext}',
                tidy_format := true, scan_mode := 'sequential', decode_error_policy := 'error')
)
SELECT (SELECT count(*) FROM (FROM actual EXCEPT ALL FROM expected)),
       (SELECT count(*) FROM (FROM expected EXCEPT ALL FROM actual));
----
0	0

query III
SELECT count(*), sum(len(calls)), sum(calls[1].sample_index)
FROM read_geno('__WORKING_DIRECTORY__/test/data/geno_format.${ext}',
                format_fields := ['AD'], samples := 'S2');
----
6	6	6

query II
SELECT count(*), sum(len(calls))
FROM read_geno('__WORKING_DIRECTORY__/test/data/geno_format.${ext}',
                format_fields := ['AD'], samples := '');

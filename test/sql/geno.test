query IIIRR
SELECT POS, calls[1].format.SI, calls[2].format.SI, calls[1].format.SF, calls[2].format.SF
FROM read_geno('__WORKING_DIRECTORY__/test/data/bcf_scalar_counts.${ext}',
               format_fields := ['SI', 'SF'], decode_error_policy := '${policy}') ORDER BY POS;

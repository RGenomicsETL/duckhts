# Expand allele slots relationally; preserve the slot-specific phase flag.
query IIITI
WITH records AS (
 SELECT record_index, ALT, unnest(calls) AS call
 FROM read_geno('__WORKING_DIRECTORY__/test/data/geno_calls.bcf', non_reference_only:=true)
), slots AS (
 SELECT record_index, ALT, call.sample_index AS sample_index,
 unnest(call.alleles) AS allele, unnest(call.phase_before) AS phase,
 generate_subscripts(call.alleles,1)-1 AS slot FROM records
)
SELECT record_index,sample_index,slot,phase,allele FROM slots WHERE allele>0 ORDER BY ALL;
----
0	0	1	true	1
0	0	2	false	2
0	1	1	false	1
5	0	0	true	200
5	0	1	true	1
5	1	0	true	1

# More records than a DuckDB vector, including repeated child NULL/reset state.
query TTTT

 SELECT POS, FORMAT_GT_S2 FROM read_bcf('__WORKING_DIRECTORY__/test/data/geno_calls.${ext}', samples:='^S1')
 EXCEPT ALL SELECT POS, FORMAT_GT_S2 FROM read_bcf('__WORKING_DIRECTORY__/test/data/geno_calls.${ext}'));

statement ok
CREATE TEMP TABLE geno_expected(record_index UBIGINT, sample_index UINTEGER, alleles INTEGER[], phase_before BOOLEAN[], phase_set BIGINT);

# Literal HTSlib 1.24 decoded encodings, including leading-slot phase convention
# for VCF 4.2. Missing GT has unknown ploidy (NULL arrays), not a fabricated ./.
statement ok
INSERT INTO geno_expected VALUES
 (0,0,[0,1,2,NULL],[false,true,false,true],10),
 (0,1,[NULL,1],[false,false],NULL),

 (3,0,NULL,NULL,30), (3,1,NULL,NULL,NULL),
 (4,0,NULL,NULL,NULL), (4,1,NULL,NULL,NULL),
 (5,0,[200,1],[true,true],2147483647), (5,1,[1],[true],-1);


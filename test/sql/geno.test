# Selected typed FORMAT values share the sample axis and retain missing ordinals.
foreach ext vcf bcf vcf.gz

statement ok
CREATE OR REPLACE TEMP TABLE selected_format AS
SELECT * FROM read_geno('__WORKING_DIRECTORY__/test/data/geno_format.${ext}',
  format_fields := ['AD', 'DP', 'GQ', 'GL', 'VI', 'VF', 'ST'], decode_error_policy := 'error');

query III
SELECT count(*), sum(len(calls)), count(DISTINCT record_index) FROM selected_format;
----
